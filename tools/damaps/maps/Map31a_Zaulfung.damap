{
 "format": "damap",
 "version": 1,
 "id": "31a",
 "name": "Zaulfung",
 "file": "Map31a_Zaulfung.xml",
 "rooms": [
  {"id":1,"x":40,"y":200,"z":0,"title":"Zaulfung, Crooked Treetop","descriptions":["Feeble branches are all that stand between yourself and a perilous fall to the marsh below.  From this altitude you are afforded a vantage of the swamp stretching out to the east and west, divided by a thick wall of scraggly brush that seems to rise around this very tree.  A single sturdy branch appears to bridge this gap, heading eastward."],"exits":[{"to":2,"exit":"east","move":"east"},{"to":121,"exit":"down","move":"down"}]},
  {"id":2,"x":60,"y":200,"z":0,"title":"Zaulfung, Crooked Treetop","descriptions":["Feeble branches are all that stand between yourself and a perilous fall to the marsh below.  From this altitude you are afforded a vantage of the swamp stretching out to the east and west, divided by a thick wall of scraggly brush that seems to rise around this very tree.  A single sturdy branch appears to bridge this gap, heading westward."],"exits":[{"to":1,"exit":"west","move":"west"},{"to":3,"exit":"down","move":"down"}],"aliases":["Treetop"]},
  {"id":3,"x":140,"y":200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["An expanse of deep swamp and thick, tangled foliage stretches out to the east.  The shrubbery is much more dense here than to the west, and knobby trees twisted by the foul waters rise up like wicked claws draped with creeper vines, creating a canopy of shade to incubate the stagnating, muddy water."],"exits":[{"to":8,"exit":"southeast","move":"swim southeast"},{"to":4,"exit":"northwest","move":"swim northwest"},{"to":2,"exit":"climb","move":"climb sickly tree"}],"color":"#0000FF"},
  {"id":4,"x":120,"y":140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Withered and sickly-looking creeper vines dangle from the canopy of claw-like branches above, resembling lifeless snakes that have met the somber touch of Eylhaar, asphyxiated by the noxious fumes burbling from the murky waters below."],"exits":[{"to":5,"exit":"northeast","move":"swim northeast"},{"to":3,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":5,"x":140,"y":120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A nearby tree lies half sunken into the marsh, severed from a trunk that has been splintered beyond recognition by some unknown act of nature -- or perhaps the unnatural forces that laid waste to this region."],"exits":[{"to":9,"exit":"east","move":"swim east"},{"to":6,"exit":"southeast","move":"swim southeast"},{"to":4,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":6,"x":160,"y":140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A large, clawed footprint has been preserved in a raised portion of the mud here, a foreboding sign to travelers who dare disturb the eerie sense of peace that pervades this sickly wilderness."],"exits":[{"to":9,"exit":"northeast","move":"swim northeast"},{"to":7,"exit":"southeast","move":"swim southeast"},{"to":5,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":7,"x":180,"y":200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A disgusting slurping noise constantly plagues your ears as bubbles rise to the surface of the swamp only to burst and release their noxious fumes into the air.  The looming foliage seems to draw in closer, the canopy above growing more confining as the gasses begin to take their toll."],"exits":[{"to":111,"exit":"east","move":"swim east"},{"to":110,"exit":"southeast","move":"swim southeast"},{"to":8,"exit":"southwest","move":"swim southwest"},{"to":6,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":8,"x":160,"y":220,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick, tangled brush flourishes over this murky swamp, obscured by a lazy black mist that constantly rolls up from the sludge underfoot.  The sickly gas tendrils writhe through the air, incorporating themselves with the sky above like a thick shawl of shadow."],"exits":[{"to":7,"exit":"northeast","move":"swim northeast"},{"to":102,"exit":"south","move":"swim south"},{"to":3,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":9,"x":180,"y":120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The squawk of a vulture echoes above the canopy of tainted trees, a sign of Aldauth's eternal grip on the tilted balance of life in this swamp."],"exits":[{"to":15,"exit":"northeast","move":"swim northeast"},{"to":6,"exit":"southwest","move":"swim southwest"},{"to":5,"exit":"west","move":"swim west"},{"to":10,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":10,"x":160,"y":100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The faint scent of fresh air teases you, stirring from a gap in the thick canopy above the swamp.  The respite offered by the pale breeze is quite welcome, its worth to your lungs like a single diamond chip amidst a pile of coal."],"exits":[{"to":14,"exit":"northeast","move":"swim northeast"},{"to":15,"exit":"east","move":"swim east"},{"to":9,"exit":"southeast","move":"swim southeast"},{"to":11,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":11,"x":120,"y":100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The air is stagnant, laden with the brackish vapor seeping from the festering greenish-black waters of the Zaulfung.  It is unlikely that even a fresh coastal breeze buoyed upon Lemicus' wings could rid the swamp of the stench, the war of time already lost in saving this befouled wetland."],"exits":[{"to":12,"exit":"north","move":"swim north"},{"to":10,"exit":"east","move":"swim east"}],"color":"#0000FF"},
  {"id":12,"x":120,"y":60,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single branch has splintered off a nearby tree, now slowly sinking into the murky quagmire below.  It reaches up like a wretched claw, grasping for what futile semblance of life it had attained in this foul garden."],"exits":[{"to":13,"exit":"northeast","move":"swim northeast"},{"to":11,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":13,"x":140,"y":40,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A choking pall of putrid vapor drifts through the swamp, held prisoner by the canopy of tormented foliage above.  The gas weaves a monstrous miasma of death and destruction, one that no living creature should be subjected to.  It is a ghastly wonder what morbid fate could have created a place as horrid as this."],"exits":[{"to":14,"exit":"southeast","move":"swim southeast"},{"to":12,"exit":"southwest","move":"swim southwest"},{"to":16,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":14,"x":180,"y":80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick reeds jut upward from the murky waters, forming a small burrow for the harmless creatures of the region.  The omnipresent canopy surrounding most of the swamp breaks here, allowing the fumes to drift upward into the sky, escaping the festering quagmire."],"exits":[{"to":22,"exit":"east","move":"swim east"},{"to":15,"exit":"southeast","move":"swim southeast"},{"to":10,"exit":"southwest","move":"swim southwest"},{"to":13,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":15,"x":200,"y":100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The miasma grows thicker, the noxious stench becoming almost too much to bear.  Each step is laborious and fatiguing, the knee-high muddy water making movement much slower than on dry land."],"exits":[{"to":115,"exit":"south","move":"swim south"},{"to":9,"exit":"southwest","move":"swim southwest"},{"to":10,"exit":"west","move":"swim west"},{"to":14,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":16,"x":120,"y":20,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The brush grows denser here, thick tangles of foliage rising right out of the muddy waters, flourishing despite the deathly fumes that coil and swath every semblance of the living, threatening to wring the life from every last pore."],"exits":[{"to":17,"exit":"northeast","move":"swim northeast"},{"to":13,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":17,"x":140,"y":0,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick tangles of thorny brambles cover what little land is elevated enough not to be drowned by the brackish mud, blocking the path on the easiest of routes and making it necessary to trudge through the muck and mire."],"exits":[{"to":18,"exit":"south","move":"swim south"},{"to":16,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":18,"x":140,"y":20,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick reeds jut upward from the murky waters, forming a small burrow for the harmless creatures of the region.  The omnipresent canopy surrounding most of the swamp breaks here, allowing the fumes to drift upward into the sky, escaping the festering quagmire."],"exits":[{"to":17,"exit":"north","move":"swim north"},{"to":19,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":19,"x":160,"y":40,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The miasma grows thicker, the noxious stench becoming almost too much to bear.  Each step is laborious and fatiguing, the knee-high muddy water making movement much slower than on dry land."],"exits":[{"to":20,"exit":"east","move":"swim east"},{"to":18,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":20,"x":200,"y":40,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Putrid fumes rising from the swamp coalesce into a heavy blanket of black fog that flows all through the surrounding air, held in by the ceiling of twisted branches and vines above."],"exits":[{"to":23,"exit":"northeast","move":"swim northeast"},{"to":21,"exit":"southeast","move":"swim southeast"},{"to":19,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":21,"x":240,"y":60,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The subtle, constant slurp of the mire is shattered by the distant throaty cry of a buzzard.  Scanning the trees above, nothing resembling a semblance of life is visible, yet the sound remains imprinted into your mind."],"exits":[{"to":30,"exit":"southeast","move":"swim southeast"},{"to":22,"exit":"southwest","move":"swim southwest"},{"to":20,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":22,"x":220,"y":80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A sickly-looking tree bends in despair beneath an unseen burden, its withered leaves dipping down into the thick, swampy path.  The canopy of trees above seems healthier, but the leaves have taken on a brackish green color that doesn't bode well for their destiny."],"exits":[{"to":21,"exit":"northeast","move":"swim northeast"},{"to":116,"exit":"southeast","move":"swim southeast"},{"to":14,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":23,"x":220,"y":20,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Withered and sickly-looking creeper vines dangle from the canopy of claw-like branches above, resembling lifeless snakes that have met the somber touch of Eylhaar, asphyxiated by the noxious fumes burbling from the murky waters below."],"exits":[{"to":24,"exit":"east","move":"swim east"},{"to":20,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":24,"x":260,"y":20,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A looming blanket of black fog drifts lazily through the air, obscuring the sky and incubating the swamp's noxious gasses in the cramped space beneath the canopy of twisted trees above."],"exits":[{"to":25,"exit":"northeast","move":"swim northeast"},{"to":29,"exit":"southeast","move":"swim southeast"},{"to":23,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":25,"x":320,"y":-40,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A large, clawed footprint has been preserved in a raised portion of the mud here, a foreboding sign to travelers who dare disturb the eerie sense of peace that pervades over this sickly wilderness."],"exits":[{"to":26,"exit":"south","move":"swim south"},{"to":24,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":26,"x":320,"y":20,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A disgusting slurping noise constantly plagues your ears as bubbles rise to the surface of the swamp only to burst and release their noxious fumes into the air.  The looming foliage seems to draw in closer, the canopy above growing more confining as the gasses begin to take their toll."],"exits":[{"to":25,"exit":"north","move":"swim north"},{"to":27,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":27,"x":340,"y":40,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A nearby tree lies half sunken into the marsh, severed from a trunk that has been splintered beyond recognition by some unknown act of nature -- or perhaps the unnatural forces that laid waste to this region."],"exits":[{"to":43,"exit":"southeast","move":"swim southeast"},{"to":28,"exit":"southwest","move":"swim southwest"},{"to":26,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":28,"x":320,"y":60,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Dense thorny foliage obscures most of the structure that stretches out directly to the south, sculpted into the vague form of a jackal's hindquarters, sinking beneath the swamp's rancid surface.  A rigid stone tail rises from amidst the dense vegetation, decidedly not of mammal inspiration to those who created the strange monument."],"exits":[{"to":27,"exit":"northeast","move":"swim northeast"},{"to":32,"exit":"southeast","move":"swim southeast"},{"to":31,"exit":"southwest","move":"swim southwest"},{"to":29,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":29,"x":300,"y":60,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A strange stone monument rises to the east, stretching far to the south.  From this vantage, it appears to be the hindquarters of what has been chiseled to resemble a jackal-like beast.  A strange obelisk of stone juts up where its tail would be, breaking the form of what would otherwise appear to be a quite realistic rendition of the animal."],"exits":[{"to":28,"exit":"east","move":"swim east"},{"to":30,"exit":"southwest","move":"swim southwest"},{"to":24,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":30,"x":260,"y":80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Chisel marks cover the stone wall to the east, somewhat obscured by draping vines and clingy brambles.  The etchings are quite crude, but it is apparent that this is the hindquarters of some sort of beast -- perhaps a hound or even a jackal."],"exits":[{"to":29,"exit":"northeast","move":"swim northeast"},{"to":116,"exit":"south","move":"swim south"},{"to":21,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":31,"x":280,"y":100,"z":0,"title":"Zaulfung, Urrem'tier's Spire","descriptions":["A cloak of dusky darkness shrouds a giant, segmented obsidian tail that arcs out of the foliage behind the southern structure, curving upward to a tall spire far up in the inky midnight sky.  The tail appears remarkably similar to a creature that is more insect in nature, rather than the mammalian jackal depicted in the rest of the ancient stone."],"exits":[{"to":28,"exit":"northeast","move":"swim northeast"}],"aliases":["Spire"]},
  {"id":32,"x":340,"y":80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A dense cloak of sickly vegetation lurks over the surface of a stone structure, rendering it impossible to climb without gaining a host of nasty (and possibly poisonous) laceration wounds.  A tall, shadowy spire is visible a short distance to the west, jutting out of the back of the mammalian stone figure."],"exits":[{"to":41,"exit":"southeast","move":"swim southeast"},{"to":33,"exit":"southwest","move":"swim southwest"},{"to":28,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":33,"x":320,"y":100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The unforgiving mire grapples with every moving thing, ever-vigilant in its quest to devour all within its reach.  An eerie sense of purpose looms over the swamp, as if its very presence on Elanthia is not just simply a foul die cast upon Berengaria's golden plains."],"exits":[{"to":32,"exit":"northeast","move":"swim northeast"},{"to":34,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":34,"x":340,"y":120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A deep gash mars the side of the monument half-sunken into the marsh, a reminder of the horrors that must have befallen this area to send it so far down the spiral, shattered from the equilibrium of nature's cyclical balance."],"exits":[{"to":35,"exit":"south","move":"swim south"},{"to":33,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":35,"x":340,"y":140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A large skeleton of unknown origin lies half-sunken into marsh, tangled within the wicked clutches of the thorny brambles.  Its stature lends to the belief that it may have once been a Gor'Tog, but time and decomposition have mangled it so badly that it may simply be the remnants of one of the foul sluagh."],"exits":[{"to":34,"exit":"north","move":"swim north"},{"to":36,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":36,"x":360,"y":160,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The sludge underfoot yawns open from time to time, releasing bubbles of noxious fumes into the air.  The pall of decay lingers heavily throughout the swamp, permeating everything with the sights, smells, and eerie silence of death."],"exits":[{"to":37,"exit":"northeast","move":"swim northeast"},{"to":57,"exit":"southwest","move":"swim southwest"},{"to":35,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":37,"x":380,"y":140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The bleak surroundings grow even more dismal, viewing the expanse of murky swamp laid out in all directions.  Twisted marsh-dwelling trees reach up like primitive claws, vying for respite in the clean air that exists far above the noxious gasses burbling up from the watery slime underfoot."],"exits":[{"to":38,"exit":"north","move":"swim north"},{"to":44,"exit":"northeast","move":"swim northeast"},{"to":46,"exit":"southeast","move":"swim southeast"},{"to":36,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":38,"x":380,"y":120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A Gor'Tog-sized bubble of brownish-green expands and contracts in the middle of the swamp here, breathing with a life of its own.  Vicious claws loom from the trees overhead, shielding the enigmatic bubble from the elements and incubating the foul stew."],"exits":[{"to":39,"exit":"northeast","move":"swim northeast"},{"to":37,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":39,"x":400,"y":100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Brackish water rises roughly knee-high on a Human throughout this swamp, making it quite laborious to trudge through the slime.  It is unknown what lurks beneath its depths due to the sickly greenish-brown color the mud has taken on."],"exits":[{"to":38,"exit":"southwest","move":"swim southwest"},{"to":40,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":40,"x":380,"y":80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single violet flower blooms from a creeper vine draped between the wretched, clawlike trees above, a faint semblance of unperverted life amidst a garden of death and gloom."],"exits":[{"to":43,"exit":"north","move":"swim north"},{"to":39,"exit":"southeast","move":"swim southeast"},{"to":41,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":41,"x":360,"y":100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The faint scent of fresh air teases you, stirring from a gap in the thick canopy above the swamp.  The respite offered by the pale breeze is quite welcome, its worth to your lungs like a single diamond chip amidst a pile of coal."],"exits":[{"to":40,"exit":"northeast","move":"swim northeast"},{"to":42,"exit":"south","move":"swim south"},{"to":32,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":42,"x":360,"y":120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single violet flower blooms from a creeper vine draped between the wretched, clawlike trees above, a faint semblance of unperverted life amidst a garden of death and gloom."],"exits":[{"to":41,"exit":"north","move":"swim north"}],"color":"#0000FF"},
  {"id":43,"x":380,"y":60,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Tendrils of brackish mist sweep errantly through the area, carried upon wretched zephyrs tainted by the noxious fumes drifting up from the swamp.  It's a wonder that any life can exist here, and that which does seems fouled beyond all hope of salvation."],"exits":[{"to":40,"exit":"south","move":"swim south"},{"to":27,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":44,"x":400,"y":120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Murky slime burbles below, seeming to grow deeper and thicker the more one stands still.  Wild foliage climbs in every direction, the wicked and unintended children of the Zaulfung's inadvertent nourishment."],"exits":[{"to":45,"exit":"east","move":"swim east"},{"to":37,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":45,"x":440,"y":120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick, tangled brush flourishes over this murky swamp, obscured by a lazy black mist that constantly rolls up from the sludge underfoot.  The sickly gas tendrils writhe through the air, incorporating themselves with the sky above like a thick shawl of shadow."],"exits":[{"to":47,"exit":"southeast","move":"swim southeast"},{"to":46,"exit":"southwest","move":"swim southwest"},{"to":44,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":46,"x":400,"y":160,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The air is stagnant, laden with the brackish vapor seeping from the festering greenish-black waters of the Zaulfung.  It is unlikely that even a fresh coastal breeze buoyed upon Lemicus' wings could rid the swamp of the stench, the war of time already lost in saving this befouled wetland."],"exits":[{"to":45,"exit":"northeast","move":"swim northeast"},{"to":49,"exit":"east","move":"swim east"},{"to":56,"exit":"southwest","move":"swim southwest"},{"to":37,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":47,"x":460,"y":140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The squawk of a vulture echoes above the canopy of tainted trees, a sign of Aldauth's eternal grip on the tilted balance of life in this swamp."],"exits":[{"to":48,"exit":"south","move":"swim south"},{"to":45,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":48,"x":460,"y":200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The faint scent of fresh air teases you, stirring from a gap in the thick canopy above the swamp.  The respite offered by the pale breeze is quite welcome, its worth to your lungs like a single diamond chip amidst a pile of coal."],"exits":[{"to":47,"exit":"north","move":"swim north"},{"to":50,"exit":"southwest","move":"swim southwest"},{"to":49,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
