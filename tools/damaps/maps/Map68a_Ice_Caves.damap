{
 "format": "damap",
 "version": 1,
 "id": "68a",
 "name": "Ice Caves - Adan'f Spirit Dancers and Mages",
 "file": "Map68a_Ice_Caves.xml",
 "rooms": [
  {"id":1,"x":280,"y":260,"z":0,"title":"Ice Caves, Stone Forest","descriptions":["Among the great teeth of stone a narrow stream weaves its way down out the darkness.  Revealed by its path is an archway that opens to the west, offering a sloping passage beneath faded markings that have become illegible over time.","Among the great teeth of stone a narrow stream weaves its way down out of the darkness.  Revealed by its path is an archway that opens to the west, offering a sloping passage beneath faded markings that have become illegible over time."],"exits":[{"to":2,"exit":"east","move":"east"},{"to":3,"exit":"go","move":"go arch"}],"color":"#993300"},
  {"id":2,"x":300,"y":260,"z":0,"title":"Ice Caves, Cave Mouth","descriptions":["Like the maw of some great beast, the stalagmite and stalactite-filled cave's stone teeth are as sharp as time and nature can make them.  Beyond the cavern's gaping entrance, a forest of stone rises.  Yet, the pillars are coated in black ice, reminders of the spell that once kept this area frozen -- the area and its inhabitants, feared even by their creators."],"exits":[{"to":1,"exit":"west","move":"west"},{"to":29,"exit":"out","move":"out"}],"color":"#993300"},
  {"id":3,"x":260,"y":260,"z":0,"title":"Ice Caves, Sloping Passageway","descriptions":["Following the steep incline of the passage, the stream flows downhill seeking escape from the dark chill of the caverns.  Scratches mar the rocks that make up the tunnel's walls, showing signs of frantic digging by some sort of clawed beasts."],"exits":[{"to":1,"exit":"east","move":"east"},{"to":4,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":4,"x":240,"y":260,"z":0,"title":"Ice Caves, Frozen Pool","descriptions":["Stalagmites, straining to reach the ceiling, surround a pool of water that rests in the center of the chamber.  The stream cuts through the pool, vanishing under its ice-coated surface, before re-emerging from the pool's far side."],"exits":[{"to":3,"exit":"east","move":"east"},{"to":5,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":5,"x":220,"y":280,"z":0,"title":"Ice Caves, Narrow Tunnel","descriptions":["Floodwater escaping from the shallow stream cutting through the tunnel floor fills the area with mud and grime.  What little ground there is to walk on is a mire that is both slow and treacherous."],"exits":[{"to":4,"exit":"northeast","move":"northeast"},{"to":6,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":6,"x":180,"y":280,"z":0,"title":"Ice Caves, Underground Lake","descriptions":["Years of erosion have cut a shallow stream into the hard rock floor of the tunnel as the lake's waters seek a faster means of escape from the dark confines of the massive cavern.  A bridge of stone rises out from the passageway and offers the only means of crossing the freezing waters."],"exits":[{"to":5,"exit":"east","move":"east"},{"to":7,"exit":"go","move":"go bridge"}],"color":"#993300"},
  {"id":7,"x":180,"y":240,"z":0,"title":"Ice Caves, Underground Lake","descriptions":["Descending out of the darkness, the bridge comes to rest on a narrow ledge that juts from the cavern walls.  Once there was nothing but a void within this hollow mountain, but now melting ice has formed a great lake that spreads out beyond the light's reach."],"exits":[{"to":8,"exit":"northwest","move":"northwest"},{"to":6,"exit":"go","move":"go bridge"}],"color":"#993300"},
  {"id":8,"x":160,"y":220,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":26,"exit":"north","move":"north"},{"to":9,"exit":"northeast","move":"northeast"},{"to":7,"exit":"southeast","move":"southeast"},{"to":15,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":9,"x":180,"y":200,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice.  Several skulls have been piled in a corner, an eerie trophy of some sort."],"exits":[{"to":28,"exit":"north","move":"north"},{"to":10,"exit":"northeast","move":"northeast"},{"to":8,"exit":"southwest","move":"southwest"},{"to":26,"exit":"west","move":"west"},{"to":16,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":10,"x":200,"y":180,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":9,"exit":"southwest","move":"southwest"},{"to":28,"exit":"west","move":"west"},{"to":11,"exit":"northwest","move":"northwest"},{"to":48,"exit":"go","move":"go gap"}],"color":"#993300"},
  {"id":11,"x":180,"y":160,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":22,"exit":"north","move":"north"},{"to":10,"exit":"southeast","move":"southeast"},{"to":28,"exit":"south","move":"south"},{"to":16,"exit":"southwest","move":"southwest"},{"to":27,"exit":"west","move":"west"},{"to":12,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":12,"x":160,"y":140,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":11,"exit":"southeast","move":"southeast"},{"to":27,"exit":"south","move":"south"},{"to":13,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":13,"x":140,"y":160,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":12,"exit":"northeast","move":"northeast"},{"to":27,"exit":"east","move":"east"},{"to":16,"exit":"southeast","move":"southeast"},{"to":25,"exit":"south","move":"south"},{"to":14,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":14,"x":120,"y":180,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":13,"exit":"northeast","move":"northeast"},{"to":25,"exit":"east","move":"east"},{"to":15,"exit":"southeast","move":"southeast"},{"to":17,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":15,"x":140,"y":200,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":25,"exit":"north","move":"north"},{"to":16,"exit":"northeast","move":"northeast"},{"to":26,"exit":"east","move":"east"},{"to":8,"exit":"southeast","move":"southeast"},{"to":20,"exit":"southwest","move":"southwest"},{"to":14,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":16,"x":160,"y":180,"z":0,"title":"Ice Caves, Cavern's Heart","descriptions":["Torches are set up in a circle around a gaping chasm that opens in the hard frozen stone of the cavern's floor.  At the north edge of the void, an iron altar stained with dried blood stands flanked by two large silver braziers.  Light from the fires fill the surrounding cavern and flicker in a light breeze that constantly rises from the chasm."],"exits":[{"to":27,"exit":"north","move":"north"},{"to":11,"exit":"northeast","move":"northeast"},{"to":28,"exit":"east","move":"east"},{"to":9,"exit":"southeast","move":"southeast"},{"to":26,"exit":"south","move":"south"},{"to":15,"exit":"southwest","move":"southwest"},{"to":25,"exit":"west","move":"west"},{"to":13,"exit":"northwest","move":"northwest"},{"to":47,"exit":"climb","move":"climb gaping chasm"}],"color":"#993300"},
  {"id":17,"x":100,"y":160,"z":0,"title":"Ice Caves, Dim Tunnel","descriptions":["Light from the main cavern only barely challenges the darkness that shrouds the tunnel as it turns to dig deeper into the ice coated walls.  Underneath the bloodstained ice that covers the ground, deep scratches mar the dark stone leading further into the black passageway."],"exits":[{"to":14,"exit":"southeast","move":"southeast"},{"to":18,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":18,"x":80,"y":160,"z":0,"title":"Ice Caves, Dim Tunnel","descriptions":["Set into the frozen walls is a large iron door covered in scrollwork that blocks further passage into the tunnel.  Odd symbols are crafted into the framework supporting the door, but aside from vague dragon-like shapes, their meanings are lost."],"exits":[{"to":17,"exit":"east","move":"east"},{"to":19,"exit":"go","move":"go door"}],"color":"#993300"},
  {"id":19,"x":80,"y":140,"z":0,"title":"Ice Caves, Larder","descriptions":["Cold air circulates about this small chamber creating a frosty environment that chills the blood.  In times past the tunnel obviously continued further into the dark stone walls, but because of a cave-in, that option is no longer available.  It has since been transformed into a larder for the Adan'f and bodies are stacked haphazardly about the area, kept fresh by the cold air coming from behind the cave-in."],"exits":[{"to":18,"exit":"go","move":"go door"}],"color":"#993300"},
  {"id":20,"x":120,"y":220,"z":0,"title":"Ice Caves, Dim Tunnel","descriptions":["Dark stone coated with black ice reflects the light from the main cavern, absorbing it and hiding it away.  The result is a dim passageway that leads further into the frozen caves."],"exits":[{"to":15,"exit":"northeast","move":"northeast"},{"to":21,"exit":"south","move":"south"}],"color":"#993300"},
  {"id":21,"x":120,"y":240,"z":0,"title":"Ice Caves, Recessed Alcove","descriptions":["Light rarely finds its way back to this cold dark corner.  Long ago the passage continued further into the black walls, but due to a cave-in in the past the way is completely blocked off.  Gouges in the walls around the cave-in show evidence of digging, but none actually make it through the hard stone."],"exits":[{"to":20,"exit":"north","move":"north"}],"color":"#993300"},
  {"id":22,"x":180,"y":140,"z":0,"title":"Ice Caves, Dim Tunnel","descriptions":["Darkness shrouds this tunnel as it burrows away into the ice coated stone.  From time to time firelight from the main cavern reflects off veins of rock crystal that have been revealed by past digging, their soft glimmering accounting for what little light there is."],"exits":[{"to":23,"exit":"northeast","move":"northeast"},{"to":11,"exit":"south","move":"south"}],"color":"#993300"},
  {"id":23,"x":200,"y":120,"z":0,"title":"Ice Caves, Crevice","descriptions":["Narrowing abruptly, the walls close in tight making passage through the crevice slow going.  The veins of rock crystal in the dark stone grow more evident and seem to be increasing in size as the tunnel gets further from the main chambers."],"exits":[{"to":24,"exit":"north","move":"north"},{"to":22,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":24,"x":200,"y":100,"z":0,"title":"Ice Caves, Crystal Cavern","descriptions":["Cut from the very heart of a massive vein of crystal, the passage ends here in a pocket of precious stone.  Smooth sheets of crystal make up the walls, their multicolored hues of blues and reds and greens sending off bursts of color as light from the main cavern bounces back through the dark stone tunnels to reach this small confine."],"exits":[{"to":23,"exit":"south","move":"south"}],"color":"#993300"},
  {"id":25,"x":140,"y":180,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice.","Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice.","Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":13,"exit":"north","move":"north"},{"to":16,"exit":"east","move":"east"},{"to":15,"exit":"south","move":"south"},{"to":14,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":26,"x":160,"y":200,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":16,"exit":"north","move":"north"},{"to":9,"exit":"east","move":"east"},{"to":8,"exit":"south","move":"south"},{"to":15,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":27,"x":160,"y":160,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":12,"exit":"north","move":"north"},{"to":11,"exit":"east","move":"east"},{"to":16,"exit":"south","move":"south"},{"to":13,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":28,"x":180,"y":180,"z":0,"title":"Ice Caves, Frozen Cavern","descriptions":["Walls coated in black ice surround the massive cavern, closing it off from the rest of the caves.  Faint glimmers of light illuminate the area as torches in the cavern's heart reflect the glow off the ice."],"exits":[{"to":11,"exit":"north","move":"north"},{"to":10,"exit":"east","move":"east"},{"to":9,"exit":"south","move":"south"},{"to":16,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":29,"x":300,"y":200,"z":0,"title":"Whistling Wood, Clearing","descriptions":["The worm-riddled ranks of the whispering woods open onto a great clearing filled with light from the sky above.  A streambed cuts through the ground, running from the mouth of a large cave and towards the east."],"exits":[{"to":0,"exit":"north","move":"north"}],"aliases":["Shard South"],"linksTo":"Map68_Shard_South_Gate.xml"},
  {"id":30,"x":300,"y":60,"z":0,"title":"Whistling Wood, Narrow Path","descriptions":["A dark canopy of leaves hangs over this narrow path through the Whistling Wood.  To the south, a large boulder forces the path to detour around it.  Raw stumps and piles of stones show that the bypass has been recently constructed."],"exits":[{"to":31,"exit":"north","move":"north"},{"to":0,"exit":"southwest","move":"southwest"},{"to":0,"exit":"climb","move":"climb boulder"}],"aliases":["Shard North"],"linksTo":"Map68_Shard_South_Gate.xml"},
  {"id":31,"x":300,"y":40,"z":0,"title":"Whistling Wood, Fissure","descriptions":["Among the worm-riddled trees that crowd this forest clearing, a great fissure has rent the ground opening up a passageway into the dark depths.  Heading off to the south, a weed-choked path offers the only way out of the clearing.","Among the worm-riddled trees that crowd this forest clearing, a great fissure has rent the ground, opening a passageway into the depths.  To the south, a weed-choked path offers the only way out of the clearing."],"exits":[{"to":30,"exit":"south","move":"south"},{"to":32,"exit":"climb","move":"climb deep fissure"}]},
  {"id":32,"x":300,"y":20,"z":0,"title":"Ice Caves, Fissure","descriptions":["Disturbed graves poke from the walls of the fissure as the steep stone tilts to meet the surface.  A partially uncovered coffin juts out of the walls providing a place to rest between climbs, its surface pitted and scarred from whatever ripped it from the ground."],"exits":[{"to":33,"exit":"climb","move":"climb deep gouges"},{"to":31,"exit":"climb","move":"climb fissure walls"}],"color":"#993300"},
  {"id":33,"x":300,"y":0,"z":0,"title":"Ice Caves, Fissure","descriptions":["A narrow niche in the wall, once the home of a large boulder, allows adventurers to rest between climbs through the steep fissure.  Walls of grey granite rise high all around, crumbling in places as cracks weaken the entire area."],"exits":[{"to":34,"exit":"climb","move":"climb narrow niche"},{"to":32,"exit":"climb","move":"climb granite walls"}],"color":"#993300"},
  {"id":34,"x":280,"y":0,"z":0,"title":"Ice Caves, Fissure","descriptions":["Boulders litter the ground of the chamber, having been knocked from the walls by whatever caused the fissure to open.  Decaying remains of various Adan'f cover the floor, their bones crushed in places by falling rocks."],"exits":[{"to":35,"exit":"west","move":"west"},{"to":33,"exit":"climb","move":"climb fissure walls"}],"color":"#993300"},
  {"id":35,"x":260,"y":0,"z":0,"title":"Ice Caves, Crumbling Passageway","descriptions":["Walls of loose black soil surround the passage as it leads through the cold earth.  Towards the east a fissure through the very bedrock has opened up a path to the surface, offering a way to escape from the dark confines of the caves."],"exits":[{"to":34,"exit":"east","move":"east"},{"to":36,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":36,"x":240,"y":20,"z":0,"title":"Ice Caves, Crumbling Passageway","descriptions":["Water from the west has weakened the walls, allowing the loose soil to slip free to clog the ground.  Moss covering the ceiling acts as a net to keep the earth above from joining the mess of mud that slows travel through the passage."],"exits":[{"to":35,"exit":"northeast","move":"swim northeast"},{"to":37,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":37,"x":220,"y":20,"z":0,"title":"Ice Caves, Flooded Tunnel","descriptions":["Swirling whirlpools sweep through the area sending sediment throughout the water, choking off all visibility.  A break in one of the crumbling walls is the cause of the flooded chamber, the current pushing southwest.","Lazy whirlpools float through the area toward the southwest, spreading clouds of sediment in the water that completely obstruct visibility.  A break in one of the crumbling walls is the source of the flood."],"exits":[{"to":36,"exit":"east","move":"swim east"},{"to":38,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":38,"x":200,"y":40,"z":0,"title":"Ice Caves, Flooded Tunnel","descriptions":["Water rushes through the room as currents pull it this way and that through the dark confine.  Near the floor a pitch black hole is barely visible against the lesser grey of the surrounding water, and it is this opening that is causing the currents as it sucks the water down.","A slight current moves the water this way and that, but always toward a dark hole, barely visible near the floor.  The water is draining through the hole, creating the slow surge."],"exits":[{"to":39,"exit":"north","move":"swim north"},{"to":37,"exit":"northeast","move":"swim northeast"}],"color":"#0000FF"},
  {"id":39,"x":200,"y":20,"z":0,"title":"Ice Caves, Flooded Tunnel","descriptions":["Freezing water, clouded with sediment from the loose soil that comprises the walls, fills the tunnel from top to bottom.  Currents within the water make movement difficult as they try to pull you south.","Freezing water clouded with soil from the walls fills the tunnel from floor to ceiling.  A sluggish current does little to hinder movement."],"exits":[{"to":38,"exit":"south","move":"swim south"},{"to":40,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":40,"x":180,"y":20,"z":0,"title":"Ice Caves, Crumbling Passageway","descriptions":["The ground slopes down to the east where it meets and disappears beneath the freezing cold water that has risen to flood the tunnel.  What is left of the remaining dry ground is concentrated in the moldy ceiling, clinging tenaciously above the water as if afraid to drown.","The passageway slopes down to the east and disappears beneath the bone-chilling water that floods the tunnel."],"exits":[{"to":39,"exit":"east","move":"swim east"},{"to":41,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":41,"x":160,"y":40,"z":0,"title":"Ice Caves, Crumbling Passageway","descriptions":["Water seeps through the ground here, making the ground wet and soggy, clinging to anything that touches it.  Puddles gather in old footprints making miniature lakes leading through the passageway.","Water seeps from the ground here, making it wet and soggy, clinging to anything it touches.  Along the passageway, puddles gather in old footprints like miniature lakes."],"exits":[{"to":40,"exit":"northeast","move":"northeast"},{"to":42,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":42,"x":140,"y":60,"z":0,"title":"Ice Caves, Crumbling Passageway","descriptions":["Chunks of rocks jut forth from the loose soil that makes up the walls of the passage.  Here and there ice-coated stones have fallen from the ceiling, making movement through the area difficult at best."],"exits":[{"to":41,"exit":"northeast","move":"northeast"},{"to":43,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":43,"x":120,"y":60,"z":0,"title":"Ice Caves, Crumbling Passageway","descriptions":["Walls of crumbling black dirt packed loosely together make up the sides of this passage.  To the west, a small hole offers the only way to get through a wall of granite that blocks the rest of the tunnel, while to the east the passageway continues further into the darkness."],"exits":[{"to":42,"exit":"east","move":"east"},{"to":44,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":44,"x":80,"y":60,"z":0,"title":"Ice Caves, Dead End","descriptions":["Body parts from all the races litter the bottom of this chasm.  For most of them it appears that this was where they died after a long fall and a terrible meeting with the hard stone floor.  Old blood stains the ground, and the sickening stench of decaying flesh fills the air, challenging even the strongest stomach.  The only way out is through a crumbling passage leading off to the east, or by climbing the towering chasm walls."],"exits":[{"to":43,"exit":"east","move":"east"},{"to":45,"exit":"climb","move":"climb chasm walls"}],"color":"#993300"},
  {"id":45,"x":80,"y":40,"z":0,"title":"Ice Caves, Chasm","descriptions":["Black ice coats the walls of the chasm making climbing in either direction a perilous adventure.","Black ice coats the walls and floor of the chasm, making climbing in either direction a perilous adventure."],"exits":[{"to":44,"exit":"climb","move":"climb wide ledge"},{"to":46,"exit":"climb","move":"climb chasm wall"}],"color":"#993300"},
  {"id":46,"x":80,"y":20,"z":0,"title":"Ice Caves, Chasm","descriptions":["Darkness fills this empty void as it sinks down into the frozen stone of the surrounding caves.  The chasm walls rise upwards around the small ledge that offers a brief respite from the harsh climb above and below."],"exits":[{"to":47,"exit":"climb","move":"climb chasm wall"},{"to":45,"exit":"climb","move":"climb small ledge"}],"color":"#993300"},
  {"id":47,"x":80,"y":0,"z":0,"title":"Ice Caves, Chasm","descriptions":["A ring of firelight breaks the darkness as the steep frozen walls open up above into a large cavern filled with torches."],"exits":[{"to":46,"exit":"climb","move":"climb crumbling ledge"},{"to":16,"exit":"climb","move":"climb chasm wall"}],"color":"#993300"},
  {"id":48,"x":220,"y":180,"z":0,"title":"Ice Caves, Narrow Bridge","descriptions":["Water surges directly below a narrow stretch of stone that connects the cavern walls with a slender pillar of rock that rises up out of the glacial lake.  Although the bridge is made of the same dark stone that makes up the walls, none of the reassuring strength is apparent, and each step across it is a test of willpower."],"exits":[{"to":49,"exit":"east","move":"east"},{"to":10,"exit":"go","move":"go gap"}]},
  {"id":49,"x":240,"y":180,"z":0,"title":"Ice Caves, Rock Pillar","descriptions":["Rising from the depths of the lake, this pillar overlooks much of the hollow mountain.  Waves slap against the slender base and spray from their crests makes the chill even more apparent.  A massive glacier is barely visible to the northeast as it slowly slips beneath the water's surface, and to the southwest, the vague outline of a bridge rises into the darkness."],"exits":[{"to":48,"exit":"west","move":"west"}]}
 ],
 "labels": [
  {"text":"Adan'f Spirit Dancers","x":220,"y":130,"z":0},
  {"text":"Adan'f Shadow Mages","x":220,"y":150,"z":0}
 ]
}
