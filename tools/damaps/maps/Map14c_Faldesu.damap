  {"id":9,"x":340,"y":100,"z":0,"title":"Faldesu River","descriptions":["An enormous slab of rock is upthrust in the river to the north, cutting the water like a knife.  Downriver of the formation a low, forested island lies, a green tail to a stony comet."],"exits":[{"to":0,"exit":"northeast","move":"swim northeast"},{"to":0,"exit":"east","move":"swim east"},{"to":8,"exit":"southeast","move":"swim southeast"},{"to":0,"exit":"south","move":"swim south"},{"to":0,"exit":"southwest","move":"swim southwest"},{"to":0,"exit":"west","move":"swim west"},{"to":10,"exit":"northwest","move":"swim northwest"}],"color":"#00FFFF"},
  {"id":10,"x":320,"y":80,"z":0,"title":"Faldesu River","descriptions":["The rushing waters split around a huge boulder rising out of the river to the east.  The rock formation is worn inward where the water has taken its toll, but higher up on the rock garlands of green vines adorn the crown."],"exits":[{"to":0,"exit":"north","move":"swim north"},{"to":11,"exit":"northeast","move":"swim northeast"},{"to":9,"exit":"southeast","move":"swim southeast"},{"to":0,"exit":"south","move":"swim south"},{"to":0,"exit":"southwest","move":"swim southwest"},{"to":0,"exit":"west","move":"swim west"},{"to":0,"exit":"northwest","move":"swim northwest"}],"color":"#00FFFF","aliases":["boulder"]},
  {"id":11,"x":340,"y":60,"z":0,"title":"Faldesu River","descriptions":["An enormous slab of rock is upthrust in the river to the south, cutting the water like a knife.  Downriver of the formation a low, forested island lies, a green tail to a stony comet."],"exits":[{"to":0,"exit":"north","move":"swim north"},{"to":12,"exit":"northeast","move":"swim northeast"},{"to":0,"exit":"east","move":"swim east"},{"to":0,"exit":"southeast","move":"swim southeast"},{"to":10,"exit":"southwest","move":"swim southwest"},{"to":0,"exit":"west","move":"swim west"},{"to":0,"exit":"northwest","move":"swim northwest"}],"color":"#00FFFF"},
  {"id":12,"x":340,"y":40,"z":0,"title":"Faldesu River","descriptions":["The currents swirl violently in their rush downriver, the swift waters threatening to drag down the unwary swimmer.  To the north, the walls of Riverhaven are visible in the distance."],"exits":[{"to":0,"exit":"north","move":"swim north"},{"to":13,"exit":"northeast","move":"swim northeast"},{"to":0,"exit":"east","move":"swim east"},{"to":11,"exit":"southeast","move":"swim southeast"},{"to":0,"exit":"south","move":"swim south"},{"to":0,"exit":"southwest","move":"swim southwest"},{"to":0,"exit":"west","move":"swim west"},{"to":0,"exit":"northwest","move":"swim northwest"}],"color":"#00FFFF"},
