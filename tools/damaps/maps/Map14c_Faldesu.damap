  {"id":6,"x":340,"y":160,"z":0,"title":"Faldesu River","descriptions":["The swift waters of the river swirl violently, causing an undertow which threatens to drag down unwary swimmers.  In the distance, the ruined bridge on the south bank can be discerned."],"exits":[{"to":0,"exit":"north","move":"swim north"},{"to":7,"exit":"northeast","move":"swim northeast"},{"to":0,"exit":"east","move":"swim east"},{"to":5,"exit":"southeast","move":"swim southeast"},{"to":0,"exit":"south","move":"swim south"},{"to":0,"exit":"southwest","move":"swim southwest"},{"to":0,"exit":"west","move":"swim west"},{"to":0,"exit":"northwest","move":"swim northwest"}],"color":"#00FFFF"},
