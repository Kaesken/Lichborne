 "rooms": [
  {"id":1,"x":340,"y":240,"z":0,"title":"Faldesu River","descriptions":["The swift waters of the river swirl violently, causing an undertow which threatens to drag down unwary swimmers.  To the south, the bank rises like a stony wave, an image belied by the deteriorating ruins of an old stone bridge."],"exits":[{"to":3,"exit":"north","move":"swim north"},{"to":0,"exit":"northeast","move":"swim northeast"},{"to":0,"exit":"east","move":"swim east"},{"to":2,"exit":"southeast","move":"swim southeast"},{"to":0,"exit":"south","move":"swim south"},{"to":0,"exit":"southwest","move":"swim southwest"},{"to":0,"exit":"west","move":"swim west"},{"to":0,"exit":"northwest","move":"swim northwest"}],"color":"#00FFFF"},
  {"id":2,"x":340,"y":260,"z":0,"title":"Faldesu River, South Bank","descriptions":["A high, rocky bank supports the remains of a large stone bridge which once spanned the river.  From across the wide river the sounds of Riverhaven carry.  Further to the east, the swift waters slow near the tall reeds of an encroaching marsh."],"exits":[{"to":0,"exit":"north","move":"swim north"},{"to":1,"exit":"northeast","move":"swim northeast"},{"to":0,"exit":"northwest","move":"swim northwest"},{"to":21,"exit":"climb","move":"climb stone bridge"}],"color":"#00FFFF","aliases":["south"]},
  {"id":3,"x":340,"y":220,"z":0,"title":"Faldesu River","descriptions":["The swift waters of the river swirl violently, causing an undertow which threatens to drag down unwary swimmers.  To the south, the remains of a crumbling bridge can easily be seen on the bank."],"exits":[{"to":0,"exit":"north","move":"swim north"},{"to":4,"exit":"northeast","move":"swim northeast"},{"to":0,"exit":"east","move":"swim east"},{"to":1,"exit":"southeast","move":"swim southeast"},{"to":0,"exit":"south","move":"swim south"},{"to":0,"exit":"southwest","move":"swim southwest"},{"to":0,"exit":"west","move":"swim west"},{"to":0,"exit":"northwest","move":"swim northwest"}],"color":"#00FFFF"},
