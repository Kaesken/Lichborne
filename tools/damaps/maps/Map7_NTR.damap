  {"id":58,"x":400,"y":20,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision."],"exits":[{"to":30,"exit":"north","move":"north","hidden":true},{"to":26,"exit":"northeast","move":"northeast","hidden":true},{"to":22,"exit":"east","move":"east"},{"to":58,"exit":"southeast","move":"southeast","hidden":true},{"to":34,"exit":"south","move":"south","hidden":true},{"to":59,"exit":"southwest","move":"southwest","hidden":true},{"to":33,"exit":"west","move":"west","hidden":true},{"to":45,"exit":"northwest","move":"northwest","hidden":true}]},
  {"id":59,"x":450,"y":170,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision."],"exits":[{"to":15,"exit":"north","move":"north","hidden":true},{"to":12,"exit":"northeast","move":"northeast","hidden":true},{"to":28,"exit":"east","move":"east"},{"to":36,"exit":"southeast","move":"southeast","hidden":true},{"to":8,"exit":"south","move":"south","hidden":true},{"to":13,"exit":"southwest","move":"southwest"},{"to":38,"exit":"west","move":"west","hidden":true},{"to":17,"exit":"northwest","move":"northwest","hidden":true}]},
  {"id":60,"x":480,"y":260,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision."],"exits":[{"to":61,"exit":"north","move":"north","hidden":true},{"to":43,"exit":"northeast","move":"northeast","hidden":true},{"to":24,"exit":"east","move":"east","hidden":true},{"to":20,"exit":"southeast","move":"southeast","hidden":true},{"to":9,"exit":"south","move":"south","hidden":true},{"to":12,"exit":"southwest","move":"southwest","hidden":true},{"to":34,"exit":"west","move":"west","hidden":true},{"to":52,"exit":"northwest","move":"northwest","hidden":true}]},
  {"id":61,"x":450,"y":200,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision."],"exits":[{"to":12,"exit":"north","move":"north","hidden":true},{"to":62,"exit":"northeast","move":"northeast","hidden":true},{"to":25,"exit":"east","move":"east","hidden":true},{"to":26,"exit":"southeast","move":"southeast","hidden":true},{"to":42,"exit":"south","move":"south","hidden":true},{"to":49,"exit":"southwest","move":"southwest","hidden":true},{"to":56,"exit":"west","move":"west","hidden":true},{"to":23,"exit":"northwest","move":"northwest","hidden":true}]},
  {"id":62,"x":580,"y":220,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision."],"exits":[{"to":58,"exit":"north","move":"north","hidden":true},{"to":16,"exit":"northeast","move":"northeast","hidden":true},{"to":24,"exit":"east","move":"east","hidden":true},{"to":19,"exit":"southeast","move":"southeast","hidden":true},{"to":51,"exit":"south","move":"south","hidden":true},{"to":26,"exit":"southwest","move":"southwest","hidden":true},{"to":57,"exit":"west","move":"west","hidden":true},{"to":13,"exit":"northwest","move":"northwest","hidden":true}]},
  {"id":63,"x":550,"y":250,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision."],"exits":[{"to":40,"exit":"north","move":"north","hidden":true},{"to":38,"exit":"northeast","move":"northeast","hidden":true},{"to":45,"exit":"east","move":"east","hidden":true},{"to":25,"exit":"southeast","move":"southeast","hidden":true},{"to":58,"exit":"south","move":"south","hidden":true},{"to":18,"exit":"southwest","move":"southwest"},{"to":30,"exit":"west","move":"west","hidden":true},{"to":63,"exit":"northwest","move":"northwest","hidden":true}]},
  {"id":64,"x":380,"y":350,"z":0,"title":"North Road, Plains","descriptions":["Climbing a small rise, you find a splendid view off to the north.  The hills about you slowly flatten, spreading out into a broad, low valley.  A large river winds its way through the valley like a deep blue ribbon, bordered by a dense band of marshlands."],"exits":[{"to":82,"exit":"east","move":"east"},{"to":65,"exit":"west","move":"west"},{"to":1,"exit":"northwest","move":"northwest"}]},
  {"id":65,"x":360,"y":350,"z":0,"title":"North Road, Plains","descriptions":["Your passage through the plains disturbs rabbits which bound across the road in front of you.  Quail and pheasant nest in the high grass, and hawks and kites drift in silent circles overhead.  Tracks in the dirt reveal the presence of deer, skunks, foxes, and even one set of paw prints from a cougar."],"exits":[{"to":64,"exit":"east","move":"east"},{"to":66,"exit":"west","move":"west"}]},
  {"id":66,"x":340,"y":350,"z":0,"title":"North Road, Plains","descriptions":["A broad patch of low shrubs hugging the ground on the roadside stands in full bloom.  Stunning red flowers on yellow stalks stand out against the green leaves.  Hummingbirds flit from blossom to blossom, dipping their long noses into each before moving on."],"exits":[{"to":65,"exit":"east","move":"east"},{"to":67,"exit":"west","move":"west"}]},
  {"id":67,"x":320,"y":350,"z":0,"title":"North Road, Plains","descriptions":["Sagging wooden fenceposts outline an abandoned farmhouse a short distance away.  The walls have collapsed completely, leaving only a peaked shingle roof resting atop a pile of splintered debris.  Weeds and grass have overrun and choked the once neat rows of tomatoes, corn and barley."],"exits":[{"to":66,"exit":"east","move":"east"},{"to":68,"exit":"west","move":"west"}]},
  {"id":68,"x":300,"y":350,"z":0,"title":"North Road, Plains","descriptions":["An old stone well sits in a secluded glade just to the south.  Alongside the well is a broad stone trough for watering horses, with a rail to tie them. A broad flat slab of sandstone beneath the boughs of an old tree looks like a perfect spot to relax for a moment."],"exits":[{"to":67,"exit":"east","move":"east"},{"to":69,"exit":"northwest","move":"northwest"}]},
  {"id":69,"x":280,"y":330,"z":0,"title":"North Road, Farmlands","descriptions":["A white trail of smoke rises from a lone cottage atop a nearby hill.  The hill itself is covered in a carpet of thick green herbs and plants, interspersed with tall pines and fruit trees.  Off to the north and west, the open plains slowly give way to farmlands.  Looking southward, you see the open grassy plains, low hills, and far off in the distance, the outline of two massive mountains lost in the clouds."],"exits":[{"to":68,"exit":"southeast","move":"southeast"},{"to":70,"exit":"northwest","move":"northwest"}]},
  {"id":70,"x":260,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["Small wooden plaques alongside a myriad of footpaths and trails point the way towards small farms and houses dotting the rolling hillsides.  Patches of golden grain and rows of green vegetables stand out between open stretches of tall prairie grass and clumps of trees."],"exits":[{"to":69,"exit":"southeast","move":"southeast"},{"to":71,"exit":"west","move":"west"}]},
  {"id":71,"x":240,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["Long shadowy rows of vines stretch off to either side of the road like darkened corridors.  A sweet smell drifts on the evening breeze from the ripe grapes hanging in thick bunches from the vines.","Long rows of vines laden with bunches of ripe purple grapes grow over rows of wooden trellises lining both sides of the road. Here and there, brightly dressed Halfling workers wander through the vineyard, carefully picking and gathering the harvest."],"exits":[{"to":70,"exit":"east","move":"east"},{"to":72,"exit":"west","move":"west"}],"color":"#C2B280","aliases":["RTT01","RT-HF-KC"]},
  {"id":72,"x":220,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["A sturdy covered bridge stretches across a narrow irrigation channel.  The banks are covered in a thick green blanket of ivy, and clumps of tall narrow reeds grow up from the slow-moving water.  Farmlands stretch all about you in neat green and gold squares like a patchwork quilt."],"exits":[{"to":71,"exit":"east","move":"east"},{"to":73,"exit":"go","move":"go covered bridge"}]},
  {"id":73,"x":200,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["Long, shadowed lines of apple and cherry trees stretch off all around you, their blossom laden boughs dripping in the evening dew.","The low, relaxing drone of bees flitting from flower to flower rises faintly from neat rows of apple and cherry trees.  The trees stand covered in pink and white blossoms, pouring a sweet fruity fragrance into the quiet breeze."],"exits":[{"to":74,"exit":"west","move":"west"},{"to":72,"exit":"go","move":"go covered bridge"}]},
  {"id":74,"x":180,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["A whitewashed wooden fence stands between you and a cool pond beckoning from beside the road.  White linens hanging from a clothesline wave slowly in the breeze behind a nearby cottage, from which wafts the scent of freshly baking bread."],"exits":[{"to":73,"exit":"east","move":"east"},{"to":75,"exit":"west","move":"west"}],"color":"#C2B280","aliases":["RTT02","RT-HF-XNE"]},
  {"id":75,"x":160,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["Rows of tall elm trees planted on either side of the road obscure your view of the country around you.  Their leaves rustle softly in the wind, and red squirrels dart through the branches overhead.  The sound of bleating sheep echoes from a wooden pen off in the distance."],"exits":[{"to":74,"exit":"east","move":"east"},{"to":76,"exit":"west","move":"west"}]},
  {"id":76,"x":140,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["Empty wooden stalls line the road, and the grass is crushed in neat squares where tents stood during the day.  ","Stalls, tents and carts line the road, bedecked with all manner of fresh produce for sale.  Local farmers wander about hawking baskets of apples, cherries, cages full of squawking fowl, and a bedazzling variety of edibles.  A festive spirit hangs in the air, and the sound of music and dancing rings out over the voices of haggling shopkeepers and hucksters pitching their wares."],"exits":[{"to":75,"exit":"east","move":"east"},{"to":77,"exit":"west","move":"west"}],"color":"#C2B280","aliases":["RTT03","RT-HF-WC"]},
  {"id":77,"x":120,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["Grey shadows float on the placid surface of a stream running near the road, as a family of geese drifts asleep amid the stars twinkling off the water.","Local folk gather alongside a clear running stream, chatting merrily as they wash their clothes on the smooth stones lining the riverbank.  A flock of geese floating regally in the water add their own honking comments to the gossip and chatter on the shore."],"exits":[{"to":76,"exit":"east","move":"east"},{"to":78,"exit":"west","move":"west"}],"color":"#C2B280","aliases":["RTT06","RT-HF-GF"]},
  {"id":78,"x":100,"y":310,"z":0,"title":"North Road, Farmlands","descriptions":["The road seems empty and quiet as you travel along beneath the cool night sky.","The busy flow of commerce fills the road with travellers going to and from the ferry crossing to the north.  The air rings with the sound of horses and camels, and passersby calling out greetings to friends along the way.  Richly-dressed merchants, farmers leading carts full of grain, and fishermen hauling baskets of the day's catch, all jostle together on the busy thoroughfare."],"exits":[{"to":77,"exit":"east","move":"east"},{"to":79,"exit":"northwest","move":"northwest"}]},
  {"id":79,"x":80,"y":290,"z":0,"title":"North Road, Riverbank","descriptions":["A pungent smell rises from racks of salted fish standing like tattered skeletons against the evening sky.  Thatched huts stand in a circle around you, their doors and windows locked against the evening gloom.","A pungent smell rises from racks of salted fish set out to dry amid a circle of small huts.  The huts are mostly simple wooden buildings with roofs thatched with river reeds and built on stilts to protect against flooding.  A group of children gaze in rapt attention as an old man seated on a barrel regales them with stories of his youth."],"exits":[{"to":80,"exit":"north","move":"north"},{"to":78,"exit":"southeast","move":"southeast"}],"color":"#C2B280","aliases":["RTT04","RT-HF-D"]},
  {"id":80,"x":80,"y":270,"z":0,"title":"North Road, Riverbank","descriptions":["This close to the river's edge, dry ground gives way to marshlands.  A thick coat of bright green moss grows over many of the standing pools, and on the groups of elm trees rising from scattered muddy knolls.  Waterfowl swim lazily on the ponds, diving under the water every now and again for a quick snack.  The path runs atop a packed earth dike rising above the sodden ground."],"exits":[{"to":81,"exit":"north","move":"north"},{"to":79,"exit":"south","move":"south"}],"color":"#C2B280","aliases":["RTT05","RT-HF-K"]},
  {"id":81,"x":80,"y":250,"z":0,"title":"North Road, Ferry","descriptions":["A slab of downed cedars, lashed together, rides upon the Faldesu River forming the landing for the ferry's patrons.  The nearby splash of a toad and the squawk of distant waterfowl own this place, until the new day brings the drumming of civilization.","A slab of downed cedars, lashed together, rides upon the Faldesu River forming the landing for the ferry's patrons.  A number of anxious traders shuffle about in anticipation of some future sale.  This simple dock is evidently the commerce bottleneck for Riverhaven."],"exits":[{"to":80,"exit":"south","move":"south"},{"to":640,"exit":"go","move":"go ferry"},{"to":787,"exit":"go","move":"go ferry"}],"aliases":["Ferry"]},
  {"id":82,"x":400,"y":350,"z":0,"title":"North Road, Plains","descriptions":["The road passes into a broad green meadow covered in pretty white and yellow daisies, with tall grass which nearly covers the remains of a broken horsecart lying abandoned alongside the road."],"exits":[{"to":83,"exit":"east","move":"east"},{"to":64,"exit":"west","move":"west"}]},
  {"id":83,"x":420,"y":350,"z":0,"title":"North Road, Plains","descriptions":["A wide placid stream flows slowly against the backdrop of a bare stone hillside.  The bank nearest you is littered with smooth round stones of all sizes, bringing up a childish urge to pick one up and send it skipping across the still clear water."],"exits":[{"to":84,"exit":"east","move":"east"},{"to":82,"exit":"west","move":"west"}]},
  {"id":84,"x":460,"y":350,"z":0,"title":"North Road, Plains","descriptions":["Crickets chirping in the tall weeds provide a musical counterpoint to the sound of your feet plodding along the darkened path.","An ancient ash tree crowns the top of a nearby hillside, spreading its branches outwards like long embracing arms.  A brilliant yellow spray of blooming mustard flowers grows beneath, shining like the early sun against the shaded green backdrop."],"exits":[{"to":85,"exit":"east","move":"east"},{"to":83,"exit":"west","move":"west"}]},
  {"id":85,"x":480,"y":350,"z":0,"title":"North Road, Plains","descriptions":["A roughly carved wooden figure stands upon a polished sandstone slab in the middle of the road, surrounded by piles of drying flowers, food, and other offerings.  As you pass by, a family of ravens cackles at you from the branches of an ancient thorn tree."],"exits":[{"to":86,"exit":"east","move":"east"},{"to":84,"exit":"west","move":"west"}]},
  {"id":86,"x":500,"y":350,"z":0,"title":"North Road, Plains","descriptions":["The packed earth roadway cuts a visible scar through waist-high dried grasses which cover the land like a shimmering golden blanket.  Deep green bands of scrub oak dot the hillsides, and patches of sagebrush growing alongside the road give off a sweet earthy smell as they rustle in the wind."],"exits":[{"to":87,"exit":"east","move":"east"},{"to":85,"exit":"west","move":"west"}]},
  {"id":87,"x":520,"y":350,"z":0,"title":"North Road, Plains","descriptions":["You pass from the open air into a low copse of young oak trees.  Their interlocking branches and broad leaves form a living canopy over your head which rustles softly in the breeze.  To the northeast, the sound of mules and horses comes from a whitewashed wooden barn barely visible through the trees."],"exits":[{"to":88,"exit":"east","move":"east"},{"to":86,"exit":"west","move":"west"}]},
  {"id":88,"x":550,"y":350,"z":0,"title":"North Road, Plains","descriptions":["A broad path stretches north from the road towards a group of cheery wood buildings tucked beneath the boughs of a glade of tall oaks.  Several horses are tethered to a rail in front of the largest structure, and a thin trickle of smoke rises from its red stone chimney."],"exits":[{"to":249,"exit":"north","move":"north"},{"to":89,"exit":"east","move":"east"},{"to":87,"exit":"west","move":"west"}]},
  {"id":89,"x":575,"y":350,"z":0,"title":"North Road, Plains","descriptions":["A stone tower rises above the plains just away to the north, through a sturdy oak door.  A broken pile of logs before the tower might once have been a small shack of some kind, and piles of masonry flanking the road look like they once supported a chain or beam to bar the road to travelers."],"exits":[{"to":90,"exit":"east","move":"east"},{"to":88,"exit":"west","move":"west"},{"to":0,"exit":"go","move":"go door"}]},
  {"id":90,"x":600,"y":350,"z":0,"title":"North Road, Plains","descriptions":["A cool breeze from the north brings the faint tang of moisture to your parched throat.  Low brown grass flanks the road to both sides, and a line of hardy thornbrush follows the course of a small stream off to the east.  A flock of vultures floats in lazy circles against the sky."],"exits":[{"to":91,"exit":"southeast","move":"southeast"},{"to":89,"exit":"west","move":"west"}]},
  {"id":91,"x":620,"y":370,"z":0,"title":"North Road, Plains","descriptions":["A rough trail branches off from the main road, towards a small crevice about a quarter of a mile off to the east.  Bits of green poking out over the crevice rim look like treetops, but you can't be sure from here.  Judging from the ruts and tracks on the trail, it appears fairly well used."],"exits":[{"to":92,"exit":"south","move":"south"},{"to":90,"exit":"northwest","move":"northwest"},{"to":175,"exit":"go","move":"go trail"}]},
  {"id":92,"x":620,"y":390,"z":0,"title":"North Road, Plains","descriptions":["The charred remnants of a small grove of trees surround the road.  The ground is scorched and littered with bits of charcoal and ashes.  Most of the trees have fallen into broken piles of burnt logs, but a few blackened skeletons still stand like shadows cast against the sky.  Fresh green shoots struggle up through the wreckage, bringing a tinge of hope to the devastation."],"exits":[{"to":91,"exit":"north","move":"north"},{"to":93,"exit":"south","move":"south"}]},
  {"id":93,"x":620,"y":410,"z":0,"title":"North Road, Plains","descriptions":["The land all about you is flat, and the plains stretch out as far as you can see to the north and east.  Looking west, you can see foothills rising up to the base of the Greater Fist of Heaven.  The peak itself rises far above the surrounding landscape, its top hidden by a thick wreath of clouds."],"exits":[{"to":92,"exit":"north","move":"north"},{"to":94,"exit":"go","move":"go bridge"}]},
  {"id":94,"x":620,"y":440,"z":0,"title":"North Road, Plains","descriptions":["A rickety wooden bridge spans a dry riverbed to the north.  Tall clumps of grass and thorny bushes grow along the banks, and dried out patches of reeds dot the bottom.  A hawk circles slowly overhead, on the lookout for prey."],"exits":[{"to":95,"exit":"south","move":"south"},{"to":93,"exit":"go","move":"go bridge"}]},
  {"id":95,"x":620,"y":470,"z":0,"title":"North Road, Plains","descriptions":["A bright splash of purple just off the road catches your attention for a moment.  A small patch of wildflowers is growing atop a crumbling slab of reddish stone, their brilliant hue standing out sharply against the greyish backdrop.  You pause for a moment, and wonder what generous god it was that created this tiny miracle."],"exits":[{"to":94,"exit":"north","move":"north"},{"to":96,"exit":"southeast","move":"southeast"},{"to":148,"exit":"west","move":"west"}]},
  {"id":96,"x":640,"y":490,"z":0,"title":"North Road, Plains","descriptions":["Small weeds and tufts of grass grow right up to the road's edge, almost obscuring the faint traces of a trail heading westward.  The trail appears to head towards the volcanoes, but you can see no signs that anyone has used it for quite a while."],"exits":[{"to":97,"exit":"south","move":"south"},{"to":95,"exit":"northwest","move":"northwest"},{"to":149,"exit":"go","move":"go small trail"}]},
  {"id":97,"x":640,"y":510,"z":0,"title":"North Road, Plains","descriptions":["The sound of running water seems strangely out of place here, and draws your attention to a small stream flowing beside you.  Nothing grows along the rocky banks, not even moss, which seems a bit odd on the only open water for miles."],"exits":[{"to":96,"exit":"north","move":"north"},{"to":98,"exit":"southwest","move":"southwest"}]},
  {"id":98,"x":620,"y":530,"z":0,"title":"North Road, Plains","descriptions":["The bleached skeleton of some large animal lies partially buried in the dust just off the roadway.  Its presence serves as a grim reminder of the fate awaiting any who tarry too long in this harsh, devastated land."],"exits":[{"to":97,"exit":"northeast","move":"northeast"},{"to":99,"exit":"southwest","move":"southwest"}]},
  {"id":99,"x":600,"y":550,"z":0,"title":"North Road, Plains","descriptions":["A gnarled scrub oak stands lonely guard off to the side of the road.  Looking south, the ground slopes slowly up to a sharp ridge of smooth black stone.  Northward, the road bends towards your left, skirting the bottom of the eastern volcano."],"exits":[{"to":98,"exit":"northeast","move":"northeast"},{"to":100,"exit":"south","move":"south"}]},
  {"id":100,"x":600,"y":570,"z":0,"title":"North Road, Plains","descriptions":["You pause here for a moment to examine the two monstrous volcanoes dominating the northern horizon.  The easternmost, known as the Greater Fist of Heaven, stretches from the valley floor up into the sky, its snow covered summit disappearing from sight into the clouds.  A faint red glow emanates from the Lesser Fist to the west, lighting up the clouds of smoke pouring from its gaping fiery mouth."],"exits":[{"to":99,"exit":"north","move":"north"},{"to":101,"exit":"south","move":"south"}]},
  {"id":101,"x":600,"y":590,"z":0,"title":"North Road, Plains","descriptions":["Turning your back to the massive obsidian wall to the south, you look out over a broad valley stretching below you to the north.  For miles around, the bare sterile earth is a dull rusty red, scattered with grey and black boulders of pumice and basalt.  Far off in the distance, you can just make out the silvery reflection of water, and even a hint of green."],"exits":[{"to":100,"exit":"north","move":"north"},{"to":102,"exit":"go","move":"go tunnel"}]},
  {"id":102,"x":600,"y":610,"z":0,"title":"North Road, Tunnel","descriptions":["Your footsteps echo off the glassy black tunnel walls, and light from the openings to the north and south glitters off sharp facets in the carved stone.  You carefully pick your way past piles of jagged obsidian shards stacked haphazardly along the floor."],"exits":[{"to":101,"exit":"north","move":"north"},{"to":103,"exit":"south","move":"south"}]},
  {"id":103,"x":600,"y":630,"z":0,"title":"North Road, Lava Field","descriptions":["Your view north is partially blocked by a black obsidian ridge rising from the valley floor.  Someone has laboriously chopped through the massive glassy wall, creating a tunnel which you can pass through.  You can just catch a glimpse of the road north through the tunnel, where it descends into a broad grey valley, and then curves out of sight to the east.  A field of frozen flows of lava stretches out to the south, covered with pools of dull yellow ash."],"exits":[{"to":104,"exit":"south","move":"south"},{"to":102,"exit":"go","move":"go tunnel"}]},
  {"id":104,"x":600,"y":650,"z":0,"title":"North Road, Lava Field","descriptions":["The route descends into the dust filled bowl of an ancient crater.  The crater is miles across and ringed with a jagged stone edge, as if smashed into the plain by the fist of an angry god."],"exits":[{"to":103,"exit":"north","move":"north"},{"to":105,"exit":"southwest","move":"southwest"},{"to":176,"exit":"go","move":"go path"}]},
  {"id":105,"x":580,"y":670,"z":0,"title":"North Road, Lava Field","descriptions":["Occasional flashes of red light up the clouds of smoke pouring from a small cone to the southeast.  To the north, a jagged black ridge cuts across the horizon from east to west.  Old scratches in the pitted stone mark the trail through this dead valley."],"exits":[{"to":104,"exit":"northeast","move":"northeast"},{"to":106,"exit":"go","move":"go old flow"}]},
  {"id":106,"x":560,"y":690,"z":0,"title":"North Road, Lava Field","descriptions":["A tongue of molten lava creeps ponderously towards the trail from a small vent off to the east.  Sporadic sprays of white hot rock burst through the magma's cooling crust and shower the landscape with blistering red rain.  Another flow blocks your way north, but it looks older, and cool enough to cross."],"exits":[{"to":107,"exit":"southwest","move":"southwest"},{"to":105,"exit":"go","move":"go lava flow"}]},
  {"id":107,"x":540,"y":710,"z":0,"title":"North Road, Lava Field","descriptions":["The wind rips a stream of dust from the crumbling face of an upthrust spire of basalt.  The spire is weathered and needle thin, and you wonder how long it can stand through the constant tremors and eruptions which rock this shattered valley."],"exits":[{"to":106,"exit":"northeast","move":"northeast"},{"to":108,"exit":"southwest","move":"southwest"}]},
  {"id":108,"x":520,"y":730,"z":0,"title":"North Road, Lava Field","descriptions":["As the road crosses a low point between two towering mounds of pumice, you are surprised to find yourself wading through slippery knee-deep mud.  Some underground spring or perhaps a small stream trickles through here, turning the omnipresent dust into a pool of viscous greasy muck."],"exits":[{"to":107,"exit":"northeast","move":"rt northeast"},{"to":109,"exit":"south","move":"rt south"}],"color":"#FFBF00"},
  {"id":109,"x":520,"y":750,"z":0,"title":"North Road, Canyon Rim","descriptions":["To the north, the road wends its way between the tall piles of cinders and volcanic rock that comprise the valley floor.  To the south, the way is barred by a huge crevice.  Gazing into it, you see that part of the wall has collapsed, and you should be able to climb down the rockslide there.  The wind blows from the north, bearing away much of the stench from the open pits below."],"exits":[{"to":108,"exit":"north","move":"north"},{"to":110,"exit":"go","move":"go narrow trail"}]},
  {"id":110,"x":520,"y":770,"z":0,"title":"North Road, Canyon","descriptions":["The reek of the gasses escaping the canyon floor is nearly unbearable here.  Although the lava you walk on is clearly ancient, it is still disconcertingly warm to the touch.  The way west is blocked, but the canyon opens up to the east, and a rockslide appears to offer a way up the northern wall."],"exits":[{"to":111,"exit":"east","move":"east"},{"to":109,"exit":"go","move":"go switchback trail"}]},
  {"id":111,"x":540,"y":770,"z":0,"title":"North Rim, Canyon","descriptions":["Deep fissures in the canyon's floor vent steam and smoke into the air.  The haze and stench are so thick you can barely see or breathe, and the cracked uneven surface makes every step a chore."],"exits":[{"to":110,"exit":"west","move":"west"},{"to":112,"exit":"go","move":"go trail"}]},
  {"id":112,"x":560,"y":790,"z":0,"title":"North Road, Canyon Rim","descriptions":["The road north is blocked by a huge chasm carved by some ancient eruption.  The smoke rising from the canyon floor stinks of sulphur and ash, but there seems to be no other way to proceed northward.  To the south, the land slowly dips into a broad valley, and far off in the distance, you see what looks like a cluster of buildings."],"exits":[{"to":113,"exit":"southeast","move":"southeast"},{"to":111,"exit":"go","move":"go trail"}]},
  {"id":113,"x":580,"y":810,"z":0,"title":"North Road, Lava Field","descriptions":["The land about you is still and lifeless.  The silence is broken only by the monotonous sound of your feet plodding through the pools of ash, and a low rumbling coming from under the earth.  A plume of thick white smoke rises from the summit of the mountain to the northeast."],"exits":[{"to":114,"exit":"south","move":"south"},{"to":112,"exit":"northwest","move":"northwest"}]},
  {"id":114,"x":580,"y":830,"z":0,"title":"North Road, Lava Field","descriptions":["Heat rises in palpable waves from the black frozen ocean of lava, making this whole valley seem like some gargantuan oven.  Each step you take raises clouds of gritty yellow ash, coating your clothing and skin with a harsh abrasive layer of soot.  The only breaks in the bleak landscape are occasional spires of rock jutting through the black stone floor, and the menacing profiles of the great volcanoes off in the distance."],"exits":[{"to":113,"exit":"north","move":"north"},{"to":115,"exit":"south","move":"south"}]},
  {"id":115,"x":580,"y":850,"z":0,"title":"North Road","descriptions":["The sound of horses and camels calls your attention to a cluster of stone buildings to the south, bringing thoughts of warm food, cold drinks, and clean beds.  To the north, the route climbs over a small hillock of frozen lava and continues onwards toward two monstrous volcanoes barely visible through the dust and haze."],"exits":[{"to":114,"exit":"north","move":"north"},{"to":116,"exit":"south","move":"south"}]},
  {"id":116,"x":580,"y":870,"z":0,"title":"North Roads Caravansary","descriptions":["The road runs northwest past a cluster of stone buildings and stables to one side.  A narrow path branches off to the east following a rough line of hills while another section continues southeast.  You hear the lowing of sheep and the bleating of goats from nearby and an errant breeze brings the smell of something roasting over a fire.  Elsewhere, you might wonder just what was being cooked that smells so strongly, but here and now you find you are both famished and in dire need of drink."],"exits":[{"to":115,"exit":"north","move":"north"},{"to":130,"exit":"southeast","move":"southeast"},{"to":117,"exit":"northwest","move":"northwest"},{"to":147,"exit":"go","move":"go narrow track"}],"aliases":["Caravansary"]},
  {"id":117,"x":560,"y":850,"z":0,"title":"North Roads Caravansary","descriptions":["You stand amidst a small oasis among the rocks and gullies and blackened hills of this dead land.  A large building to one side has all the earmarks of an Inn.  Across from it are several outbuildings and what smells like a stable.  Behind the stable, a herd of goats bleats dispiritedly in a pen and a few sheep graze inside a small fenced area among some scrawny grass tussocks."],"exits":[{"to":116,"exit":"southeast","move":"southeast"},{"to":129,"exit":"southwest","move":"southwest"},{"to":118,"exit":"west","move":"west"},{"to":213,"exit":"go","move":"go smelly outpost"},{"to":214,"exit":"go","move":"go inn entrance"}]},
  {"id":118,"x":520,"y":850,"z":0,"title":"North Roads Caravansary","descriptions":["Several small buildings cluster here, huddled against the chill wind.  Set some distance away, near the edge of a steep slope, a tiny, unpainted shack stands by itself."],"exits":[{"to":119,"exit":"north","move":"north"},{"to":117,"exit":"east","move":"east"},{"to":120,"exit":"south","move":"south"},{"to":199,"exit":"go","move":"go barn"}]},
  {"id":119,"x":520,"y":830,"z":0,"title":"North Roads Caravansary, Small Shack","descriptions":["You stand in front of a building barely large enough to hold even a couple of people.  A rickety wooden door dangles on dry leather hinges but does not seem locked.  A curious stench emanates from inside and there is a humming of insects as they swarm in and around the little shack."],"exits":[{"to":118,"exit":"south","move":"south"},{"to":198,"exit":"go","move":"go wooden door"}]},
  {"id":120,"x":520,"y":870,"z":0,"title":"North Roads Caravansary, Rustic Circle","descriptions":["Set apart from the other caravansary buildings and away from the hustle and bustle of the Northern Trade Road, this quiet campground provides a peaceful settlement for traders.  In the middle of the circle is a community campsite, where cabin owners can meet and discuss the news of the day."],"exits":[{"to":118,"exit":"north","move":"north"},{"to":129,"exit":"east","move":"east"},{"to":128,"exit":"southwest","move":"southwest"},{"to":121,"exit":"west","move":"west"},{"to":124,"exit":"northwest","move":"northwest"}]},
  {"id":121,"x":420,"y":870,"z":0,"title":"North Roads Caravansary, Campfire","descriptions":["A blazing fire cheerfully crackles in the center of the encampment, surrounded by aged wooden benches and chairs.  Set upon a small tower of chiseled stone overhanging the fire is a small grill where an enterprising young cook works to earn odd coin, chatting companionably to anyone who happens by."],"exits":[{"to":123,"exit":"north","move":"north"},{"to":124,"exit":"northeast","move":"northeast"},{"to":120,"exit":"east","move":"east"},{"to":128,"exit":"southeast","move":"southeast"},{"to":127,"exit":"south","move":"south"},{"to":125,"exit":"southwest","move":"southwest"},{"to":126,"exit":"west","move":"west"},{"to":122,"exit":"northwest","move":"northwest"}],"color":"#FF0000","aliases":["Campfire","Charpig"]},
  {"id":122,"x":400,"y":850,"z":0,"title":"North Roads Caravansary, Rustic Circle","descriptions":["The cabins here have been built right up against the stony mountain face, sheltering them against the harsh winds of the area and providing shade during the long summer months.  The face curves slightly away from the northernmost houses and forms a small indentation in the rock behind them."],"exits":[{"to":123,"exit":"northeast","move":"northeast"},{"to":121,"exit":"southeast","move":"southeast"},{"to":126,"exit":"south","move":"south"},{"to":206,"exit":"go","move":"go rocky indentation"}],"color":"#00FFFF"},
  {"id":123,"x":420,"y":830,"z":0,"title":"North Roads Caravansary, Rustic Circle","descriptions":["Prickly, grey-leaved bushes smother the hill behind the north side houses, their tiny silver blossoms adding a subtle sweet fragrance into the air.  A plume of smoke rises to the south from the ever-blazing fire in the center of camp, reminding one of good food and agreeable company."],"exits":[{"to":124,"exit":"east","move":"east"},{"to":121,"exit":"south","move":"south"},{"to":122,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":124,"x":480,"y":830,"z":0,"title":"North Roads Caravansary, Rustic Circle","descriptions":["An old oak tree shades the houses along this side of the circle as feisty vines tangle around its trunk like young children around their mother's skirt.  Wildflowers line the woodchip path, thriving in the rich black soil of the area."],"exits":[{"to":120,"exit":"southeast","move":"southeast"},{"to":121,"exit":"southwest","move":"southwest"},{"to":123,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":125,"x":400,"y":890,"z":0,"title":"North Roads Caravansary, Rustic Circle","descriptions":["The cries of large birds of prey can be heard at times coming from the large rocky mountain to the northwest.  Occasionally one will take to the air and encircle the campsite, eyeing the central campfire as if attracted by the aromas of food that travel on the wind.  Wild roses twist along the edges of a wood-chip path in front of the houses, trailing dangerously out onto the path like mischievous welkins trying to trip or snag passing inhabitants."],"exits":[{"to":126,"exit":"north","move":"north"},{"to":121,"exit":"northeast","move":"northeast"},{"to":127,"exit":"southeast","move":"southeast"}],"color":"#00FFFF"},
  {"id":126,"x":400,"y":870,"z":0,"title":"North Roads Caravansary, Rustic Circle","descriptions":["A bare rocky mountain lies to the northwest, curling very close to the cabins and causing large pockets of shadow to loom over them regardless of the hour.  Nestled in between the ridges of the mountains as they march towards the northern expanse, this cozy campsite provides a private sheltered area where residents can unwind after a hard day's trading."],"exits":[{"to":122,"exit":"north","move":"north"},{"to":121,"exit":"east","move":"east"},{"to":125,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":127,"x":420,"y":910,"z":0,"title":"North Roads Caravansary, Rustic Circle","descriptions":["A large sunbleached fence bends around the southern edge, covered with the ropy green vines of morning glories that twist and turn to create a solid curtain of flowers.  Several overturned tree stumps have been placed in front of the fence to provide a place to sit and watch neighbors as they pass by on the woodchip path."],"exits":[{"to":121,"exit":"north","move":"north"},{"to":128,"exit":"east","move":"east"},{"to":125,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":128,"x":480,"y":910,"z":0,"title":"North Roads Caravansary, Rustic Circle","descriptions":["Tantalizing aromas of food drift in the air from the northwest, mixing with the delicate smell of honeysuckle coming from the wild brush to the east.  Young spindly trees rise up through the hardy foliage, jutting out from the dark acidic soil as nature continues to replenish the once ash-smothered land."],"exits":[{"to":120,"exit":"northeast","move":"northeast"},{"to":127,"exit":"west","move":"west"},{"to":121,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":129,"x":540,"y":870,"z":0,"title":"North Roads Caravansary","descriptions":["Slabs of rock, roughly fashioned but serviceable, form a small barn for the few livestock and the occasional horse to be found here.  The roof is solid and seems weathertight.  The scent of hay and dried grass wafts from within, a counterpoint to the flinty odor in the wind.  Nearby is a larger building for the stables."],"exits":[{"to":117,"exit":"northeast","move":"northeast"},{"to":120,"exit":"west","move":"west"},{"to":207,"exit":"go","move":"go small barn"},{"to":209,"exit":"go","move":"go stables"}]},
  {"id":130,"x":600,"y":890,"z":0,"title":"Northwest Road, Volcanic Hills","descriptions":["The uneven surface of the road bumps and jars at you as you pass among the lumps and furrows made by frozen lava flows.  Someone has hacked the outline of a path into the unyielding rock to guide you.  To the northwest, you can barely glimpse some huddled buildings that show faint signs of life, judging from the thin trickle of smoke rising from their chimneys."],"exits":[{"to":131,"exit":"southeast","move":"southeast"},{"to":116,"exit":"northwest","move":"northwest"}]},
  {"id":131,"x":620,"y":910,"z":0,"title":"Northwest Road, Volcanic Hills","descriptions":["A raw, new road, scratched from the hard black rock of the hills and mountains, runs straight along from southeast to northwest.  Dead trees, charred to short stumps, form a dismal grove to one side of the pathway.  Up among the barren mounds of ash and cinders, something dislodges a small shower of stones that clatter loudly in the silent air.  A startled bird rises in uneven flight from behind a row of boulders, screeching its outrage and terror at being disturbed."],"exits":[{"to":132,"exit":"southeast","move":"southeast"},{"to":130,"exit":"northwest","move":"northwest"},{"to":256,"exit":"go","move":"go dismal grove"}],"aliases":["Origami Monsters"]},
  {"id":132,"x":640,"y":930,"z":0,"title":"Northwest Road, Volcanic Hills","descriptions":["The road goes ever on, running northwest to southeast along the ragged shoulders of some black hills.  Erratic winds sweep down from their bare crests, bringing with them a constant irritation by means of minute particles of sand and grit and dust.  It gets in your mouth and you spit out a foul, bitter taste.  To one side a ruined cart lies abandoned and stripped of everything useful."],"exits":[{"to":133,"exit":"southeast","move":"southeast"},{"to":131,"exit":"northwest","move":"northwest"}]},
  {"id":133,"x":660,"y":950,"z":0,"title":"Northern Trade Road, Broken Hills","descriptions":["Cracked boulders, segments of large stones, and small pebbles compose the hills that rise up to either side of you, jealously guarding the path from the light of the stars and moons.  The hills gradually become larger as they march northward, growing into glassy, black volcanic hills that all but vanish into the night.","Cracked boulders, segments of large stones, and small pebbles compose the hills that rise up to either side of you, jealously guarding the path from the light of the sun.  The hills gradually become larger as they march northward, growing into glassy, black volcanic hills."],"exits":[{"to":134,"exit":"south","move":"south"},{"to":132,"exit":"northwest","move":"northwest"}]},
  {"id":134,"x":660,"y":970,"z":0,"title":"Northern Trade Road, Broken Hills","descriptions":["The hills to either side are made of the broken remains of rock and debris.  You think you hear the skittering of creatures moving amongst them, but when you look up all you see is a tattered leaf being pushed along by the wind.  To the south the hills gradually turn into cones of ash and cinder, while to the north they continue on."],"exits":[{"to":133,"exit":"north","move":"north"},{"to":135,"exit":"southwest","move":"southwest"}]},
  {"id":135,"x":640,"y":990,"z":0,"title":"Northern Trade Road, Cinder Cones","descriptions":["The cinder cones crowd in uncomfortably close on either side, their shadows throwing eerie shapes across your path.  A fine layer of ash drifts down about you, tickling your nose with its unusually acrid scent.","The shadows of the cinder cones fall down around you, their massive forms blocking the light at any time of the day.  A fine layer of ash drifts down about you, tickling your nose with its unusually acrid scent."],"exits":[{"to":134,"exit":"northeast","move":"northeast"},{"to":136,"exit":"southwest","move":"southwest"}]},
  {"id":136,"x":620,"y":1010,"z":0,"title":"Northern Trade Road, Cinder Cones","descriptions":["To the left and right rise massive cinder cones, the creations of the wind-born fires of Dirge.  Clouds of ash stir with every step you take, and you realize that much of what you mistook for hillocks are actually trees and stones so covered with the choking ash that they are nearly unrecognizable."],"exits":[{"to":135,"exit":"northeast","move":"northeast"},{"to":137,"exit":"southwest","move":"southwest"}]},
  {"id":137,"x":600,"y":1030,"z":0,"title":"Northern Trade Road, Burned Forest","descriptions":["The blackened forms of trees rise up from the cracked earth like skeletons whose feet grew roots.  A scrap of cloth, tied to one of the trees, flutters in a cold wind, grey from years of exposure."],"exits":[{"to":136,"exit":"northeast","move":"northeast"},{"to":138,"exit":"southwest","move":"southwest"}]},
  {"id":138,"x":580,"y":1050,"z":0,"title":"Northern Trade Road, Burned Forest","descriptions":["The scorched remains of trees stand all about you, clawing at the stars as if in complaint of the injustice done to them.  A chill wind winds around you and wails through the branches, sounding for all the world like the ghost of a sobbing child wandering, lost, through the night.","The scorched remains of trees stand all about you, their limbs clawing at the sky as if in complaint of the injustice done to them.  A chill wind wraps around you and wails through the branches, sounding for all the world like the ghost of a sobbing child wandering, lost, through the dreary grove."],"exits":[{"to":137,"exit":"northeast","move":"northeast"},{"to":139,"exit":"south","move":"south"}]},
  {"id":139,"x":580,"y":1070,"z":0,"title":"Northern Trade Road, Wastelands","descriptions":["The lone call of a bird startles you, its cry sounding much like a helpless scream of rage and sadness.  A fine layer of black dust coats every object or creature that lingers too long here, and toward the north you notice the beginnings of a blackened forest.","The lone call of a bird breaks the stillness, its cry sounding much like a helpless scream of rage and sadness.  A fine layer of black dust coats everything that lingers too long here, and toward the north, the beginnings of a blackened forest emerge."],"exits":[{"to":138,"exit":"north","move":"north"},{"to":140,"exit":"south","move":"south"}]},
  {"id":140,"x":580,"y":1090,"z":0,"title":"Northern Trade Road, Wastelands","descriptions":["Blackened rocks and sandy soil that will never yield crops or flowers unfolds around you, encroaching like a spreading disease all the way to the horizon.  Overhead the sky is black, the celestial light filtered by a heavy haze that turns the clean light into a sickly parody of purity.","Blackened rocks and sandy soil that will never yield crops or flowers unfolds around you, encroaching like a spreading disease all the way to the horizon. Overhead the sky is thick with a heavy yellow haze that turns the daylight into a sickly parody of illumination."],"exits":[{"to":139,"exit":"north","move":"north"},{"to":141,"exit":"south","move":"south"}]},
  {"id":141,"x":580,"y":1110,"z":0,"title":"Northern Trade Road, Wastelands","descriptions":["Something has scoured this place of all life, or a harsh god created it with no life at all.  The rocks are oddly smooth and darker than normal agate and granite.  Nothing moves, no birds, no insects, no weeds or wind.  Having looked upon this land, you can easily imagine where evil souls go to when they depart this world."],"exits":[{"to":140,"exit":"north","move":"north"},{"to":142,"exit":"southeast","move":"southeast"}]},
  {"id":142,"x":600,"y":1130,"z":0,"title":"Northern Trade Road, Wastelands","descriptions":["The land lies blasted, the earth revealed in forlorn despair about you.  Silence walks through here freely, accompanied in its journey only by the occasional click of a stone moving."],"exits":[{"to":143,"exit":"southwest","move":"southwest"},{"to":141,"exit":"northwest","move":"northwest"}]},
  {"id":143,"x":580,"y":1150,"z":0,"title":"Northern Trade Road, Stony Plains","descriptions":["An odd sight awaits you here: a single sirese flower, out of place and struggling to live, growing within the shade of a twisted wiir tree.  The tiny plant seems to be surviving on raw defiance alone.","An odd sight awaits you here: a single sirese flower, out of place and struggling to live, growing within the shade of a twisted wiir tree.  The tiny plant seems to be surviving on raw defiance alone. "],"exits":[{"to":142,"exit":"northeast","move":"northeast"},{"to":144,"exit":"south","move":"south"}]},
  {"id":144,"x":580,"y":1170,"z":0,"title":"Northern Trade Road, Stony Plains","descriptions":["The ground is hard and unyielding underfoot, and the moonlight causes the stones to cast eerie shadows you don't like to think about.  Out of the corner of your eye you think you see something move, but when you turn to look, there is nothing there.","The ground is hard and unyielding underfoot.  The massive cracked boulders of this bare land challenge the sky as they thrust upward toward heaven.  A wind sweeps by every now and then, but all it does is stir up a few dustdevils whose only purpose is to remind you of how thirsty you are."],"exits":[{"to":143,"exit":"north","move":"north"},{"to":145,"exit":"south","move":"south"}]},
  {"id":145,"x":580,"y":1190,"z":0,"title":"Northern Trade Road, Stony Plains","descriptions":["Cracked boulders, gravel, and bare earth stretch about you, endlessly gray and grim.  Here and there brittle grasses struggle vainly to peek up, only to be choked by the uncaring stone.  To the south a dark forest blots the horizon."],"exits":[{"to":144,"exit":"north","move":"north"},{"to":146,"exit":"southwest","move":"southwest"}]},
  {"id":146,"x":560,"y":1210,"z":0,"title":"Northern Trade Road, Open Forest","descriptions":["Moss dangles down from stunted, ill-looking trees, lending the impression that they are weeping.  The grass is dry and brittle beneath your feet, and the forest is still and silent, as if in mourning."],"exits":[{"to":145,"exit":"northeast","move":"northeast"},{"to":385,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":147,"x":600,"y":870,"z":0,"title":"Lava Fields, Narrow Trace","descriptions":["Close by, a primitive pathway has been scratched out of the hard rock and basalt to the east, where it wanders into grey shadows of dust and floating ash.  A narrow road lies between high boulders in the other direction.  Faint marks etched into the coarse dark stone point towards the path and away from the caravan road."],"exits":[{"to":116,"exit":"go","move":"go faint roadway"},{"to":0,"exit":"east","move":"east"}],"aliases":["Dirge"],"linksTo":"Map13_Dirge.xml"},
  {"id":148,"x":600,"y":470,"z":0,"title":"Sicle Grove, Gateway","descriptions":["Tall untrimmed hedges of bramble and myrtle grow on either side of an oak-bough gateway.  A neatly carved sign is mounted near the top of the gate's arch.  Tufts of dried brownish grasses poke out in random clumps along the otherwise barren ground."],"exits":[{"to":95,"exit":"east","move":"east"},{"to":150,"exit":"climb","move":"climb oak-bough gateway"}]},
  {"id":149,"x":320,"y":540,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["The evening sky draws her cloak over the rocky path, iridescent bits of cooled lava glittering like stars caught in the earth.  Tiny motes of dust swirl as mottled light from the sky catches them in mid-air.","Dried lava lines the roadside, the ground beneath your feet speckled with iridescent flakes of the cooled molten rock.  The dusky stone winds northwest to a distant volcano, and eastward back to the main road."],"exits":[{"to":645,"exit":"northwest","move":"northwest"},{"to":96,"exit":"go","move":"go small trail"}]},
  {"id":150,"x":500,"y":490,"z":0,"title":"Sicle Grove, Atop Gateway","descriptions":["From atop this arched portal, a dry field of ash and smoke, where verdant lands once lay, is all that is visible.  Except for signs in the dusty ground that someone has climbed down the gateway recently, a search for traces of life yields nothing.  Nearby, a pillar of thick, ash-filled smoke from a fumarole climbs into the air.  Waves of intense heat radiate from the active vent."],"exits":[{"to":151,"exit":"north","move":"north"},{"to":148,"exit":"climb","move":"climb oak-bough gateway"}]},
  {"id":151,"x":500,"y":470,"z":0,"title":"Sicle Grove, West from Fumarole","descriptions":["Thick layers of ash paint the surrounding landscape in a palette of shades of gray.  Each footstep sends a cloud of dust into the air and obscures the already limited view of the lifeless terrain.  From the east, waves of intense heat radiate from the smoking vent as it belches forth black, noxious gases.  Towards the north and northeast, rectangular earthen mounds stand out on the otherwise featureless plain."],"exits":[{"to":152,"exit":"north","move":"north"},{"to":157,"exit":"northeast","move":"northeast"},{"to":150,"exit":"south","move":"south"}]},
  {"id":152,"x":500,"y":450,"z":0,"title":"Sicle Grove, Low Rise","descriptions":["As you wander around, the loose ash crunches as it engulfs footprints, leaving almost no visible traces of your passing.  A dry, hot breeze picks up bits of ash and dances with them in small, dusty whirlwinds.  From this vantage point, other mounds can be seen on the other side of the smoky plume of the fumarole to the east."],"exits":[{"to":153,"exit":"north","move":"north"},{"to":151,"exit":"south","move":"south"},{"to":155,"exit":"northwest","move":"northwest"}]},
  {"id":153,"x":500,"y":430,"z":0,"title":"Sicle Grove, Low Rise","descriptions":["The grade of the rise levels out, but walking does not get easier as your feet sink into the thick layer of volcanic dust.  Small whirlwinds dart about and trace sweeping arcs in the loose ash, giving the bleak landscape an eery artistic quality."],"exits":[{"to":154,"exit":"north","move":"north"},{"to":152,"exit":"south","move":"south"},{"to":156,"exit":"southwest","move":"southwest"},{"to":155,"exit":"west","move":"west"}]},
  {"id":154,"x":500,"y":410,"z":0,"title":"Sicle Grove, Low Rise","descriptions":["A large depression in the ash occupies most of the area.  Walking around its rim causes the surrounding cinders to shift towards the pit's center with a low hissing sound.  From the funnel-shaped hole's size, you do not believe it was dug by hand, but rather is a sinkhole resulting from the cave-in of an underground cavity."],"exits":[{"to":153,"exit":"south","move":"south"},{"to":155,"exit":"southwest","move":"southwest"}]},
  {"id":155,"x":480,"y":430,"z":0,"title":"Sicle Grove, Low Rise","descriptions":["Each footstep falls silently and sinks into the layers of dust and ash that have settled in this area.  On the western horizon, smoke-shrouded mountains, the twin volcanos called the Fists of Heaven, dominate the landscape."],"exits":[{"to":154,"exit":"northeast","move":"northeast"},{"to":153,"exit":"east","move":"east"},{"to":152,"exit":"southeast","move":"southeast"},{"to":156,"exit":"south","move":"south"},{"to":828,"exit":"go","move":"go ash-covered footpath"}]},
  {"id":156,"x":480,"y":450,"z":0,"title":"Sicle Grove, Low Rise","descriptions":["Dust clouds the air and casts ominous shadows against the distant horizon.  The ash-filled terrain continues, but nearby, a heavy wooden beam stands out in the otherwise monotonous, gray landscape."],"exits":[{"to":155,"exit":"north","move":"north"},{"to":153,"exit":"northeast","move":"northeast"},{"to":163,"exit":"go","move":"go gaping hole"}]},
  {"id":157,"x":520,"y":450,"z":0,"title":"Sicle Grove, North of Fumarole","descriptions":["A slight breeze from the south carries the black exhaust of the fumarole through this area, making the air hot and heavily tainted with sulphurous fumes.  This stifling mixture makes breathing difficult and all but eliminates visibility.  Ash from the vent's plume settles to the ground in deep layers and forces one to take careful steps to keep from falling in the loose material."],"exits":[{"to":158,"exit":"east","move":"east"},{"to":151,"exit":"southwest","move":"southwest"}]},
  {"id":158,"x":540,"y":450,"z":0,"title":"Sicle Grove, Northeast of Fumarole","descriptions":["While the air is warm by its proximity to the smoking fumarole, it is made warmer still by the the heat coming from a glowing fissure that cuts through the area.  The ground gives slightly as you explore, but is otherwise stable.  A low mound with a small shack standing on it lies towards the east."],"exits":[{"to":160,"exit":"north","move":"north"},{"to":159,"exit":"east","move":"east"},{"to":157,"exit":"west","move":"west"}]},
  {"id":159,"x":560,"y":450,"z":0,"title":"Sicle Grove, Low Mound","descriptions":["Smoke drifts in on hot gusts of air smelling of sulphur and burnt wood.  Steadily-falling ash blankets the area in a constant attempt to bury the landscape and a small shack in its grey embrace.  A faint footpath leads upwards."],"exits":[{"to":158,"exit":"west","move":"west"},{"to":253,"exit":"go","move":"go footpath"},{"to":254,"exit":"go","move":"go broken window"}]},
  {"id":160,"x":540,"y":430,"z":0,"title":"Sicle Grove, Dusty Mound","descriptions":["Dust and ash hang heavily in the air and limit the distance one can see.  A solitary brickwork chimney rises above the level of the loose ash and is the only notable feature on this mound.  Its size indicates that whatever lies below is more than a simple dwelling."],"exits":[{"to":158,"exit":"south","move":"south"},{"to":161,"exit":"climb","move":"climb brick chimney"}]},
  {"id":161,"x":540,"y":410,"z":0,"title":"Cookhouse, Kitchen","descriptions":["Silence strangely pervades this normally busy room.  Whomever was here has left everything behind.  Soup pots sit quietly upon a cold brick hearth and piles of chopped vegetables and herbs lay dried out and discolored on an oak table.  A putrid smell fills the air.  Most of the effluvium comes from a cast iron stewpot whose contents has scummed over with a foamy, brownish-red crust."],"exits":[{"to":162,"exit":"west","move":"west"},{"to":160,"exit":"climb","move":"climb brick hearth"}]},
  {"id":162,"x":520,"y":410,"z":0,"title":"Cookhouse, Common Room","descriptions":["Smoke fills the air, not enough to stifle one's breath but enough to cast ominous shadows.  Tables, usually filled with hungry patrons, lay in smoldering pieces.  The hearth's mantel is burned through its middle as if the flame had escaped its brick confines.  The walls are discolored by scorching save for a spot along one wall where the wood grain still shows through.  The damage done to the room seems to have removed all of Penelope Burrows' touches that made this a cheerful place to eat."],"exits":[{"to":161,"exit":"east","move":"east"}]},
  {"id":163,"x":460,"y":510,"z":0,"title":"The Shelter, Consultation Area","descriptions":["A gaping hole in the ceiling, the result of a heavy, wooden beam falling, lets in a stream of dust which blankets the room.  A cushioned bench lies snapped in two after taking the brunt of the fallen ceiling rafter, while several others lay scattered about by the impact.  Glass cases, formerly attached to the wooden walls, rest in shattered heaps."],"exits":[{"to":164,"exit":"north","move":"north"},{"to":165,"exit":"east","move":"east"},{"to":156,"exit":"climb","move":"climb heavy beam"}]},
  {"id":164,"x":460,"y":490,"z":0,"title":"The Shelter, Supply Nook","descriptions":["This small storage closet seems to have survived the disaster better than the rest of the building.  Except for a few jars broken on the ground, the remaining jars of herbal remedies and boxes of bandages are still somewhat in order on narrow wooden shelves.  Lard candles and sprigs of dried coneflowers remain hanging from a peg rail.  Fresh globs of wax upon the floor prove someone was here recently and perhaps even took shelter in this room."],"exits":[{"to":163,"exit":"south","move":"south"}]},
  {"id":165,"x":480,"y":510,"z":0,"title":"The Shelter, Dayroom","descriptions":["Gloomy silence fills this place where patients would wait for healing from the empath Timothy.  Decorative blue glazed globes lay in shattered heaps, their contents of willows branches and daylilies trampled and wilted.  A potbelly stove lies prone with large rents in its sides as though something held inside had forceably escaped.  Several needlework hangings covering the rough wooden walls remain in place but are now marred by singeing, their designs obscured."],"exits":[{"to":166,"exit":"north","move":"north"},{"to":163,"exit":"west","move":"west"}]},
  {"id":166,"x":480,"y":490,"z":0,"title":"The Shelter, Recovery Room","descriptions":["Where once divided into separate alcoves by curtained walls, the whole area is now a single room, the curtains in tatters.  The beds lie upturned.  Several have their batting ripped out and another is stained with blood.  A colorful patchwork quilt, hanging from an overhead beam, strangely remains untouched amidst the rest of the damage."],"exits":[{"to":165,"exit":"south","move":"south"},{"to":167,"exit":"go","move":"go small alcove"}],"color":"#400040","aliases":["Depart"]},
  {"id":167,"x":480,"y":470,"z":0,"title":"The Shelter, Children's Wing","descriptions":["Stopped at the entrance to the wing by a wall of debris from the cave-in of the ceiling, there is no way to proceed further into this wing.  Even with careful listening, no cries or other sounds can be heard from within.  A stuffed animal with a pale, motionless arm wrapped around it is barely visible but out of reach deep within the rubble."],"exits":[{"to":166,"exit":"out","move":"out"}]},
  {"id":170,"x":620,"y":330,"z":0,"title":"Under Watchtower, Tunnel","descriptions":["Supported by rotting timbers, this dank tunnel cuts through the earth to the east.  A small ladder, in surprisingly good shape, leans against the wall.  At the back wall of the passage, nearly hidden in the shadowed darkness is the statue of a thin raven."],"exits":[{"to":171,"exit":"east","move":"east"},{"to":0,"exit":"climb","move":"climb ladder"}]},
  {"id":171,"x":640,"y":330,"z":0,"title":"Escape Tunnel","descriptions":["The packed earth that surrounds the tunnel is relatively dry, but a cold chill still runs through the dark passage.  Occasional bits of dirt and chips of timber support fall to the tunnel floor."],"exits":[{"to":172,"exit":"east","move":"east"},{"to":170,"exit":"west","move":"west"}]},
  {"id":172,"x":660,"y":330,"z":0,"title":"Escape Tunnel","descriptions":["The tunnel tightens a bit here, enough to give even the non-claustrophobic a cold sweat and sudden shiver.  The path opens a slightly to the west and levels off, while it drops towards the southeast.  The walls of this cramped space abruptly turn from stone to dirt here, which would have definitely made the digging easier for whomever built this passageway."],"exits":[{"to":173,"exit":"southeast","move":"southeast"},{"to":171,"exit":"west","move":"west"}]},
  {"id":173,"x":680,"y":350,"z":0,"title":"Escape Tunnel","descriptions":["Sporadic drops of water fall from the stone ceiling.  A damp coldness permeates the passage, but a faint light glows to the east, and perhaps warmth."],"exits":[{"to":174,"exit":"southeast","move":"southeast"},{"to":172,"exit":"northwest","move":"northwest"}]},
  {"id":174,"x":700,"y":370,"z":0,"title":"Under Oasis, Tunnel","descriptions":["Bored through the granite, this tunnel has been handworked - not a natural occurrence.  Its entrance hidden behind the wild growth at the oasis suggests that its maker did not want it to be found."],"exits":[{"to":173,"exit":"northwest","move":"northwest"},{"to":175,"exit":"go","move":"go wild growth"}]},
  {"id":175,"x":660,"y":370,"z":0,"title":"North Road, Oasis","descriptions":["Within the crevice is a green oasis, hidden below the barren plains above you.  Water trickles from a spring in the gully's face, collecting in a series of crystal pools in the rock.  Reeds and a few small trees grow up around the water's edge and rustle in the cool moist breeze.  An old firepit built in the shade of the overhanging granite walls shows that you are not the first to seek shelter in this small paradise."],"exits":[{"to":91,"exit":"go","move":"go trail"}]},
  {"id":176,"x":380,"y":760,"z":0,"title":"Blackened Hills, Barren Path","descriptions":["A faint ruddy glow lights the scape with a bloody aura.  Despite the night air, the wind that blows around you is warm and almost balmy.  Layers of shadow cover the ground, stripping it of life and leaving for the blasted earth's only inhabitants the dried out, brittle stalks of what once were plants.","A thin top layer of sifted black and russet brown soil covers the earth, sterile and void of life.  Withered remains of what once were plants litter the ground, and browned stalks of lifeless weeds protrude from the wasted earth, casting long, harsh shadows."],"exits":[{"to":177,"exit":"north","move":"north"},{"to":104,"exit":"go","move":"go path"}]},
  {"id":177,"x":380,"y":740,"z":0,"title":"Blackened Hills, Barren Path","descriptions":["A shadowy black lump of a hill broods on the horizon, like coal waiting in a child's Midwinter Day stocking.  A sere and scorching wind entangles itself with the air, parching your lungs and reminding you just how thirsty you are."],"exits":[{"to":176,"exit":"south","move":"south"},{"to":178,"exit":"west","move":"west"}]},
  {"id":178,"x":360,"y":740,"z":0,"title":"Blackened Hills, Barren Path","descriptions":["Scattered ashes and mounds of unidentifiable burnt paraphernalia lie scattered around the path which, oddly, appears to be swept clean.  Heat comes up in waves off the ground, causing the air to shimmer."],"exits":[{"to":177,"exit":"east","move":"east"},{"to":179,"exit":"northwest","move":"northwest"}]},
  {"id":179,"x":340,"y":720,"z":0,"title":"Blackened Hills, Barren Path","descriptions":["A looming hill rises to the north, its shadow falling heavily over you.  Covered in ashes that look as fine and thick as a new layer of snow, a deep channel of lava carves its way down one side of the hill, finally vanishing behind a steep embankment."],"exits":[{"to":178,"exit":"southeast","move":"southeast"},{"to":180,"exit":"northwest","move":"northwest"},{"to":196,"exit":"climb","move":"climb steep embankment"}]},
  {"id":180,"x":320,"y":700,"z":0,"title":"Skeleton's Crook, Blasted Path","descriptions":["A hill rises to the east, covered in ash and casting a long shadow over everything.  Blasted skeletal structures are all that remain of a handful of small homes that crouch against the hill and beside the road as if they were waiting in ambush.  Broken bones lie scattered within the empty homes, silently relaying the unspeakable."],"exits":[{"to":181,"exit":"north","move":"north"},{"to":179,"exit":"southeast","move":"southeast"}]},
  {"id":181,"x":320,"y":680,"z":0,"title":"Skeleton's Crook, Blasted Path","descriptions":["The path gradually rises to the northeast, sloping upward as it winds around a flat-topped hill.  Smooth waves of hardened lava lash out amongst shadowy remains, the basalt shining glassily against the backdrop of night.","The path gradually rises to the northeast, sloping upward as it winds around an ash-coated flat-topped hill.  Smooth waves of hardened lava lash out amongst the ruins of what once were buildings, the basalt glittering coarsely in the sunlight."],"exits":[{"to":182,"exit":"northeast","move":"northeast"},{"to":180,"exit":"south","move":"south"}]},
  {"id":182,"x":340,"y":660,"z":0,"title":"Skeleton's Crook, Blasted Path","descriptions":["A warm breeze blows dust off the blasted path that skirts the hill, tingling the flesh and parching the lungs.  Silence pervades all around, and here and there the trail is marked by runnels of frozen black that can only be old lava flows that hardened into basalt."],"exits":[{"to":183,"exit":"east","move":"east"},{"to":181,"exit":"southwest","move":"southwest"}]},
  {"id":183,"x":360,"y":660,"z":0,"title":"Skeleton's Crook, Winding Path","descriptions":["The path slopes upward to the southeast and winds gradually downward as it heads around a bend to the west.  Slick rivers of glassy black stripe the hill, darkening the path in a glittering runoff of cooled lava.  A sulfrous tang spikes the air, tracing the inside of your mouth with a metallic flavor."],"exits":[{"to":184,"exit":"southeast","move":"southeast"},{"to":182,"exit":"west","move":"west"}]},
  {"id":184,"x":380,"y":680,"z":0,"title":"Skeleton's Crook, Winding Path","descriptions":["The path steepens sharply as it climbs the hill, eventually vanishing from sight as it dips over the flat summit.  Slick smears of obsidian basalt make walking difficult, causing the path to become as treacherous as any ice-bound slope."],"exits":[{"to":183,"exit":"northwest","move":"northwest"},{"to":185,"exit":"up","move":"up"}]},
  {"id":185,"x":380,"y":560,"z":0,"title":"Skeleton's Crook, Winding Path","descriptions":["The path is almost totally consumed by black basalt, making climbing it a horrendous task.  Waves of frozen lava slip over the sharp lip of the flattened hilltop, creating waterfall structures that give little purchase and would be much more dangerous to clamber over if the slope were any steeper."],"exits":[{"to":186,"exit":"up","move":"up"},{"to":184,"exit":"down","move":"down"}]},
  {"id":186,"x":280,"y":560,"z":0,"title":"Skeleton's Crook, Blasted Hilltop","descriptions":["A desolate scape of scorched shadows and piles of wreckage rolls out around you.  Flattened by forces at present unseen, everything is lit by an eerie, demonic red light the color of blood.  Remains of houses lie in restless piles amongst pools of frozen lava, skeletons of the former village of Crook.","A desolate scape of shattered ruins scorched and covered in a thick layer of ashes rolls out all around you.  Flattened by forces at present unseen, a pale ruddy glow flows up through cracks in the hilltop, filling the air with a demonic light.  Wrecks of houses rest in peace amongst pools of frozen lava, skeletons of the former village of Crook."],"exits":[{"to":187,"exit":"southeast","move":"southeast"},{"to":192,"exit":"southwest","move":"southwest"},{"to":185,"exit":"down","move":"down"}]},
  {"id":187,"x":320,"y":600,"z":0,"title":"Skeleton's Crook, Blasted Hilltop","descriptions":["The flat ground is covered in a thick layer of glass that would be hard to maneuver over were it not for the ashes that cover it, supplying purchase to an otherwise frictionless surface.  A vast view of the lands to the east spreads out before you, unfurled like a map."],"exits":[{"to":189,"exit":"south","move":"south"},{"to":188,"exit":"southwest","move":"southwest"},{"to":186,"exit":"northwest","move":"northwest"}]},
  {"id":188,"x":280,"y":640,"z":0,"title":"Skeleton's Crook, Gate of Souls","descriptions":["Rising in a snubbed tower, the collapsed hill that broods in the center of Skeleton's Crook hilltop is covered in black basalt.  A strong ruddy light seeps from the arterial cracks breaking the mound's surface, each line connecting to one or the other until they form an arch-like pattern reminiscent of a doorway on the hill's north-facing side."],"exits":[{"to":187,"exit":"northeast","move":"northeast"},{"to":189,"exit":"east","move":"east"},{"to":193,"exit":"southeast","move":"southeast"},{"to":190,"exit":"southwest","move":"southwest"},{"to":191,"exit":"west","move":"west"},{"to":192,"exit":"northwest","move":"northwest"},{"to":219,"exit":"go","move":"script gateofsouls"}],"color":"#FFBF00","aliases":["Skeleton's Crook","Gate of Souls"]},
  {"id":189,"x":320,"y":640,"z":0,"title":"Skeleton's Crook, Ruins","descriptions":["A small circle of skeletal buildings are all that remains of the tiny village of Crook.  Blackened wooden beams now dig their foundations into a thick layer of cooled basalt and scorched earth, and the eyesockets of the skulls of those who did not escape the agony of the lava eruption stare blindly up at you.  Toward the west rises a second hill, gleaming dully with the everpresent ruddy glow of the shattered landscape."],"exits":[{"to":187,"exit":"north","move":"north"},{"to":193,"exit":"southwest","move":"southwest"},{"to":188,"exit":"west","move":"west"}]},
  {"id":190,"x":260,"y":660,"z":0,"title":"Skeleton's Crook, Ruins","descriptions":["The hill slopes down toward the southwest, too treacherous and glassy-slick to dare without risking breaking a few bones.  Fine clouds of ashes rise up around you when you walk, filling your nostrils with grit and the stench of death.  A steep channel of lava pushes its way down off the side of the hill, dusted with just enough grit to afford some moderate purchase."],"exits":[{"to":188,"exit":"northeast","move":"northeast"},{"to":193,"exit":"east","move":"east"},{"to":191,"exit":"northwest","move":"northwest"},{"to":194,"exit":"climb","move":"climb lava channel"}]},
  {"id":191,"x":240,"y":640,"z":0,"title":"Skeleton's Crook, Ruins","descriptions":["The hard black glass that covers the surface of the earth is cracked in several places, releasing a faint red glow that spills out and up, creating a hazy veil of blood-colored mist.  A black hill rises to the east, a cancerous lump waiting to be excised."],"exits":[{"to":192,"exit":"north","move":"north"},{"to":188,"exit":"east","move":"east"},{"to":190,"exit":"southeast","move":"southeast"}]},
  {"id":192,"x":240,"y":600,"z":0,"title":"Skeleton's Crook, Blasted Hilltop","descriptions":["The blasted remains of homes and their denizens lie scattered about you.  Composed of cinder and ash, the path of the lava can be clearly followed as it swept over the helpless villagers, incinerating them instantly and capturing what remained in rigid black glass."],"exits":[{"to":186,"exit":"northeast","move":"northeast"},{"to":188,"exit":"southeast","move":"southeast"},{"to":191,"exit":"south","move":"south"}]},
  {"id":193,"x":300,"y":660,"z":0,"title":"Skeleton's Crook, Ruins","descriptions":["A hazy red nimbus lights the horizon in a pale glow.  Emanating from a small black hill that flows up to the northwest, the light is steady and slightly evil looking.  A slick lava channel carves its way down the hillside to the southwest, looking just coarse enough to make it difficult but not necessarily dangerous climbing."],"exits":[{"to":189,"exit":"northeast","move":"northeast"},{"to":190,"exit":"west","move":"west"},{"to":188,"exit":"northwest","move":"northwest"},{"to":194,"exit":"climb","move":"climb lava channel"}]},
  {"id":194,"x":280,"y":680,"z":0,"title":"Hill Slope, Lava Channel","descriptions":["Walls and floors of solid, glittering basalt rise and fall around you, creating the sense that one is walking on a completely still lake of pure liquid black.  The sides sweep up to the northeast and northwest in treacherous channels that look as if they would be harder to climb were it not for the fact that they were dusted in a fine layer of grit that lends friction to their surface."],"exits":[{"to":193,"exit":"northeast","move":"northeast"},{"to":190,"exit":"northwest","move":"northwest"},{"to":195,"exit":"down","move":"down"}]},
  {"id":195,"x":280,"y":700,"z":0,"title":"Hill Slope, Lava Channel","descriptions":["Roughly halfway between the top and bottom of Skeleton's Crook hill, this steep channel is made even more treacherous by the thick coating of hardened black glass that covers the ground and walls.  Large bubbles of cooled lava burst up to the surface in places, and a few are shattered, revealing fragments of razor sharp basalt."],"exits":[{"to":194,"exit":"up","move":"up"},{"to":196,"exit":"down","move":"down"}]},
  {"id":196,"x":280,"y":720,"z":0,"title":"Lava Channel, Basin","descriptions":["Roughly halfway between the top and bottom of Skeleton's Crook hill, this steep channel is made even more treacherous by the thick coating of hardened black glass that covers the ground and walls.  Large bubbles of cooled lava have burst up to the surface in places, and a few are shattered, revealing fragments of razor sharp basalt."],"exits":[{"to":195,"exit":"up","move":"up"},{"to":179,"exit":"climb","move":"climb steep embankment"}]},
  {"id":197,"x":280,"y":30,"z":0,"title":"Faldesu River, South Bank","descriptions":["A high, rocky bank supports the remains of a large stone bridge which once spanned the river.  From across the wide river the sounds of Riverhaven carry.  Further to the east, the swift waters slow near the tall reeds of an encroaching marsh."],"exits":[{"to":0,"exit":"north","move":""},{"to":0,"exit":"northeast","move":""},{"to":0,"exit":"northwest","move":""},{"to":7,"exit":"climb","move":"climb bridge"}],"aliases":["Faldesu"],"linksTo":"Map14c_Faldesu.xml"},
  {"id":198,"x":520,"y":820,"z":0,"title":"North Roads Caravansary, Outhouse","descriptions":["Only the cold dry air prevents this tiny outhouse from being unusable. Set over a simple open pit that slopes away down a steep hill, it offers nothing in the way of comfort or decency.  The seat is merely a rough plank swung across the noisome space above the refuse.  Spider webs hang thickly from the joists overhead waiting for the many flies that buzz about the squalid shack."],"exits":[{"to":119,"exit":"go","move":"go wooden door"}]},
  {"id":199,"x":480,"y":790,"z":0,"title":"The Noble's Barn, Central Walkway","descriptions":["The large double doors of the barn have been removed and lead into a cobbled walkway between two lines of shops, the walkway opening to the road on one side of the structure and a whitewashed carriage house on the other.  Seasoned cedar vaults the roof supporting the building, the only evidence remaining of its previous life housing animals instead of the merchants who once owned them."],"exits":[{"to":201,"exit":"north","move":"north"},{"to":200,"exit":"east","move":"east"},{"to":118,"exit":"south","move":"south"},{"to":202,"exit":"west","move":"west"},{"to":204,"exit":"go","move":"go fireplace shop"},{"to":205,"exit":"go","move":"go furniture shop"}]},
  {"id":200,"x":490,"y":790,"z":0,"title":"The Noble's Barn, Quaint Exteriors for Posh Cabins","descriptions":["Wood and stone samples line the cedar panel walls.  Behind an open counter piled with plain, hand-sized house models is a courteous Halfling standing on a sturdy wooden stool, greeting everyone who enters while seeing to the various needs of his customers."],"exits":[{"to":199,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":201,"x":480,"y":780,"z":0,"title":"The Carriage House, Handcrafted Cases","descriptions":["Gentle breezes drift through the large open windows that cross the wide room.  The sound of footsteps echoes in the air as customers and the shopkeepers walk upon the plank pine flooring, bare and unpolished in appearance.  Displays of weapon racks, armor racks and cases cater to those in the market for home interiors."],"exits":[{"to":199,"exit":"south","move":"south"},{"to":203,"exit":"up","move":"up"}],"color":"#FF0000","aliases":["Cases","Storage"]},
  {"id":202,"x":470,"y":790,"z":0,"title":"The Noble's Barn, Exquisite Interiors","descriptions":["Wall and floor samples line the outer edge of the shop.  Across the length of a beautiful riverstone floor, partially covered by an elegant ivory rug with platinum-banded tassels, is a plain oak desk filled with work orders."],"exits":[{"to":199,"exit":"east","move":"east"}],"color":"#FF0000","aliases":["Interiors","Walls"]},
  {"id":203,"x":480,"y":770,"z":0,"title":"The Carriage House, Loft, Elite Additions","descriptions":["Lamps hanging from the ceiling light up the small loft, pouring wan light onto the lovely merchandise offered."],"exits":[{"to":201,"exit":"down","move":"down"}],"color":"#FF0000"},
  {"id":204,"x":470,"y":780,"z":0,"title":"The Noble's Barn, Fanciful Fireplaces","descriptions":["The floor has been lined with riverstone concrete and the walls covered with brick, creating the feeling of stepping inside the hearth of a fireplace.  A tickling hickory smell lingers in the room in an attempt to fill the customers with thoughts of cozy, comfortable moments beside a flickering fire."],"exits":[{"to":199,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Fireplaces"]},
  {"id":205,"x":490,"y":780,"z":0,"title":"The Noble's Barn, Fit for Royalty Furniture","descriptions":["Pristine marble floors with handwoven burgundy runners accent the fine furniture displayed around this corner of the barn.  Heavy velvet drapes line the windows preventing any light from getting in so as not to fade the lovely floor models.  Instead, a dozen standing candelabras, situated to bring out the color in the show items, light the room to a soft white glow."],"exits":[{"to":199,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Furniture"]},
  {"id":206,"x":400,"y":830,"z":0,"title":"North Roads Caravansary, Rocky Indentation","descriptions":["Neverending shadow looms at the base of the mountain where a small area has been cleared of vegetation and debris.  Under a small overhang next to a smoothed wall of the mountain stands an armed and burly Dwarf, leaning casually against the side of the mountain and eyeing everyone who approaches him."],"exits":[{"to":122,"exit":"go","move":"go rustic campgrounds"}]},
  {"id":207,"x":550,"y":880,"z":0,"title":"North Roads Caravansary, Barn","descriptions":["Wooden slats overhead provide a minute hayloft to store what little excess the barren lands here can offer.  While you have seen grander edifices, this is at least dry and clean and out of the weather."],"exits":[{"to":129,"exit":"out","move":"out"},{"to":208,"exit":"climb","move":"climb wooden beams"}]},
  {"id":208,"x":560,"y":880,"z":0,"title":"North Roads Caravansary, Hayloft","descriptions":["A series of planks have been laid across the stone walls of the lower stalls to form a cramped hayloft.  The sweet smell of the hay clashes with the ever present sulfur dust as well as the odor of manure piled somewhere below.  It looks as if someone has slept here of late, perhaps to avoid the tariff at the inn or simply to escape notice."],"exits":[{"to":207,"exit":"climb","move":"climb wooden beams"}]},
  {"id":209,"x":540,"y":890,"z":0,"title":"North Roads Caravansary, Stableyard","descriptions":["The outdoor section of the stables is nothing more than a level patch of bare ground roughly fenced off with stonework augmented with a few warped and burned wooden planks.  Several dispirited horses wander about cropping at the few tufts of grass that can find root.  A feed trough holds the remnants of some hay as well and there is a good supply of water.  A wooden gate leads into the stable itself."],"exits":[{"to":129,"exit":"out","move":"out"},{"to":210,"exit":"go","move":"go wooden gate"}]},
  {"id":210,"x":540,"y":900,"z":0,"title":"North Roads Caravansary, Stables","descriptions":["This is a low stone building holding half a dozen or so stalls used by individual travellers who can pay to have accommodations for their mounts.  There is no sign of recent use and you wonder when the last lone traveller might have come by.  A roofless stone-walled pen juts out from one side of the building."],"exits":[{"to":211,"exit":"go","move":"go empty stall"},{"to":212,"exit":"go","move":"go roofless pen"},{"to":209,"exit":"go","move":"go wooden gate"}]},
  {"id":211,"x":550,"y":900,"z":0,"title":"North Roads Caravansary, Clean Stall","descriptions":["This clean stall in the far corner of the stable has been converted into a small office with an old sturdy desk and fresh hay on the floor.  Painted red hinges mark where the stall door once was, and on the walls are amateur paintings of open pastures filled with colts and their mares."],"exits":[{"to":210,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Clean Stall","Stall","Horses"]},
  {"id":212,"x":530,"y":900,"z":0,"title":"North Roads Caravansary, Stable Pen","descriptions":["This is a stone-walled pen meant to hold a caravan's camels apart from the horses,  The ground is dusty with dried manure that rises in clouds as you move.  An old watering trough sits at one end with a few inches of dirty liquid still in it.  There was once a slatted roof overhead for shade but the wooden slats have long since been taken for other uses."],"exits":[{"to":210,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Caravan Stable"]},
  {"id":213,"x":560,"y":860,"z":0,"title":"North Roads Caravansary, Furrier","descriptions":["The stench of untreated furs drenches the outpost, coming from the strings of pelts that dangle against the walls on strips of rope.  Sitting on the dirt floor is a heavy counter, piled up with odds and ends of every type of animal imaginable."],"exits":[{"to":117,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Bundles"]},
  {"id":214,"x":560,"y":840,"z":0,"title":"North Roads Inn, Foyer","descriptions":["A tiny foyer leads from the entrance into the common room.  To one side, a small counter serves as front desk and, apparently, dry goods storage.  A steep stairway ascends to the upper story where the sleeping facilites are.  Under the stair, a narrow door leads into the back room of the inn.  The foyer is bare and long in need of paint but, in this wild land, it seems almost cheerful."],"exits":[{"to":215,"exit":"north","move":"north"},{"to":117,"exit":"out","move":"out"},{"to":217,"exit":"climb","move":"climb steep stair"}],"color":"#00FF00","aliases":["Warehouse","Storage"]},
  {"id":215,"x":560,"y":830,"z":0,"title":"North Roads Inn, Common Room","descriptions":["The main room is almost cheery and cozy after the grim atmosphere of the surrounding areas.  A small fire, carefully tended, dispels the worst of the chill and sheepskins cover several wooden benches to give a modicum of comfort.  A stone table awaits the next meal and the air is full of the smell of roasting goat.  The proprietor, a sour-looking Dwarf, makes a show of disdain, though he seems most surprised to actually have guests and bustles about, brushing off the worst of the dust from the seats."],"exits":[{"to":214,"exit":"south","move":"south"},{"to":216,"exit":"go","move":"go quiet alcove"}],"color":"#FF0000","aliases":["North Roads Inn","Inn"]},
  {"id":216,"x":560,"y":820,"z":0,"title":"North Roads Inn, Alcove","descriptions":["This narrow room, almost an alcove off the common room, is meant for those requiring a quieter spot to converse.  Given the overall lack of noise, you must assume there was once a time when the inn was a tad livelier.  An uneven table of crudely shaped stone and a rickety wooden bench provide some small comfort."],"exits":[{"to":215,"exit":"out","move":"out"}]},
  {"id":217,"x":550,"y":840,"z":0,"title":"North Roads Inn, Upper Floor","descriptions":["Much of the upper floor is one open room.  A line of bunks provides a place to sleep and a tiny iron stove gives off a feeble heat.  One small area has been partitioned off to allow a bit of privacy for those caring to pay the higher fee.  A small washstand with a cistern and some rough towels are the only other amenities besides a pair of slightly better beds."],"exits":[{"to":218,"exit":"go","move":"go narrow door"},{"to":214,"exit":"climb","move":"climb steep stair"}]},
  {"id":218,"x":550,"y":830,"z":0,"title":"North Roads Inn, Private Room","descriptions":["This small room is minimally furnished.  A window is covered with a panel of thick, oiled leather.  A wide but thin mattress stuffed with fresh straw is supported by a few leather straps from the rafters overhead so that it sways and rocks to a gentle touch.  An iron tripod supports a small brazier that has some coals burning in it to remove the worst of the chill from the room at the cost of a thin deposit of soot everywhere."],"exits":[{"to":217,"exit":"go","move":"go narrow door"}]},
  {"id":219,"x":180,"y":660,"z":0,"title":"Before the Gate of Souls","descriptions":["Coarse black grit blows in swirling eddies around the mouth of the cavern, stinging the eyes and clogging the throat.  The ruddy glow of the lava field beyond lends a surreal quality to the rock walls around you, playing off the glistening edges of basalt shards.  Once, a river of lava flowed northwards through the passage.  Now, time and erosion have left just enough room to squeeze through the tunnel known to locals as the Gate of Souls."],"exits":[{"to":220,"exit":"go","move":"go lava field"},{"to":188,"exit":"go","move":"script gateleave"}]},
  {"id":220,"x":180,"y":700,"z":0,"title":"Beyond the Gate of Souls, Blasted Plain","descriptions":["The landscape shimmers as heat rises from parched soil.  In deserts or in grassland, the effect is usually caused by the sun baking the earth, but here, glowing streams of lava flow slowly across the blasted plain, gradually cooling and forming mounds of pumice, only to branch off into a new path.  Travel is difficult as it is frequently impossible to retrace your steps in the harsh environment."],"exits":[{"to":0,"exit":"southeast","move":"","hidden":true},{"to":223,"exit":"southwest","move":"southwest"},{"to":219,"exit":"go","move":"go low cavern"},{"to":0,"exit":"northeast","move":"","hidden":true},{"to":0,"exit":"east","move":"","hidden":true},{"to":0,"exit":"northwest","move":"","hidden":true}]},
  {"id":221,"x":180,"y":720,"z":0,"title":"Beyond the Gate of Souls, Blasted Plain","descriptions":["The earth rumbles underfoot as tremors ripple through the arid soil.  Over time, old fissures, worn by the elements, close and new ones open, releasing the restless pressure of the lava to flow in shifting red-gold streams across the plain.  Hot as an inferno during the day, night offers no relief from the hammer blows of heat pounding against skin and scale alike."],"exits":[{"to":220,"exit":"north","move":"north"},{"to":0,"exit":"south","move":"south","hidden":true},{"to":0,"exit":"southwest","move":"southwest","hidden":true},{"to":222,"exit":"northwest","move":"northwest"},{"to":223,"exit":"west","move":"west"},{"to":0,"exit":"northeast","move":"","hidden":true},{"to":0,"exit":"east","move":"","hidden":true},{"to":0,"exit":"southeast","move":"","hidden":true}]},
  {"id":222,"x":160,"y":700,"z":0,"title":"Beyond the Gate of Souls, Blasted Plain","descriptions":["Waves of heat blast against skin and scale, fur and flesh, sapping energy and dulling senses with its constant hammering.  Around you, glowing threads of lava criss-cross the parched plain, slowly cooling to a dull black in some places, only to break free in others.  The paths that skirt the molten rock are forever shifting in response."],"exits":[{"to":220,"exit":"east","move":"east"},{"to":221,"exit":"southeast","move":"southeast"},{"to":223,"exit":"south","move":"south"},{"to":0,"exit":"north","move":"","hidden":true},{"to":0,"exit":"southwest","move":"","hidden":true},{"to":0,"exit":"west","move":"","hidden":true},{"to":0,"exit":"northeast","move":"","hidden":true},{"to":0,"exit":"northwest","move":"","hidden":true}]},
  {"id":223,"x":160,"y":720,"z":0,"title":"Beyond the Gate of Souls, Blasted Plain","descriptions":["Waves of heat blast against skin and scale, fur and flesh, sapping energy and dulling senses with its constant hammering.  Around you, glowing threads of lava criss-cross the parched plain, slowly cooling to a dull black in some places, only to break free in others.  The paths that skirt the molten rock are forever shifting in response."],"exits":[{"to":223,"exit":"north","move":"north"},{"to":220,"exit":"northeast","move":"northeast"},{"to":221,"exit":"east","move":"east"},{"to":224,"exit":"go","move":"sandstone temple"},{"to":0,"exit":"southeast","move":"","hidden":true},{"to":0,"exit":"southwest","move":"","hidden":true},{"to":0,"exit":"west","move":"","hidden":true},{"to":0,"exit":"northwest","move":"","hidden":true}]},
  {"id":224,"x":120,"y":760,"z":0,"title":"Before the Temple of Ushnish","descriptions":["Stable is a relative term, as the ground beneath your feet quivers with tiny tremors deep within the earth.  Yet the lava is held in abeyance beyond the tumbled walls which surround the sandstone temple.  Tall columns in the shape of rearing vipers support the roof, but the massive tiles of the floor are cracked by years of neglect and dizzying vapors rise to swirl around you."],"exits":[{"to":225,"exit":"south","move":"south"},{"to":223,"exit":"go","move":"go lava field"}]},
  {"id":225,"x":120,"y":780,"z":0,"title":"Temple of Ushnish, Northern Colonnade","descriptions":["Concentric rows of columns support the carved sandstone pediment of the Temple of Ushnish.  Oval in shape, the building features carved images of gold and scarlet vipers twisting in an intricate knotwork pattern at the base of the columns around the entry.  The massive bronze doors have been knocked askew by the earth's fretful motion, leaving just enough room to slip past the guardian statues poised on either side."],"exits":[{"to":224,"exit":"north","move":"north"},{"to":226,"exit":"go","move":"go bronze door"}],"aliases":["Temple of Ushnish"]},
  {"id":226,"x":120,"y":800,"z":0,"title":"Temple of Ushnish, Northern Entry Hall","descriptions":["Flaking patches of paint and plaster fall from the murals adorning the temple's once-grand entry, gathering in little piles along the base of the sandstone walls.  The stone is warm to the touch, though still cooler than the searing heat that marks the blasted plane outside."],"exits":[{"to":227,"exit":"southeast","move":"southeast"},{"to":234,"exit":"southwest","move":"southwest"},{"to":225,"exit":"go","move":"go bronze door"}]},
  {"id":227,"x":140,"y":820,"z":0,"title":"Temple of Ushnish, Library","descriptions":["Charred wooden boards lean against each other at odd angles, supporting the ashen remains of scrolls and books.  Nothing remains now save a few scraps of leather binding or metal scrollcaps, twisted and deformed by heat.  A wrought iron lantern sways at the end of a fallen pole in the midst of the wreckage."],"exits":[{"to":228,"exit":"east","move":"east"},{"to":235,"exit":"west","move":"west"},{"to":226,"exit":"northwest","move":"northwest"}]},
  {"id":228,"x":160,"y":820,"z":0,"title":"Temple of Ushnish, Common Room","descriptions":["Searing skin and scale alike, a vague breath of air moves ponderously about the room, nudging feathers fallen from torn silk cushions and briefly swirling piles of dust before moving on.  Once upon a time, this must have been a pleasant room with high golden sandstone walls and wide windows.  Now, all lies abandoned to the elements."],"exits":[{"to":229,"exit":"southeast","move":"southeast"},{"to":233,"exit":"southwest","move":"southwest"},{"to":227,"exit":"west","move":"west"}]},
  {"id":229,"x":180,"y":840,"z":0,"title":"Temple of Ushnish, Infirmary","descriptions":["Low cots, just high enough for easy cleaning, rest on the bare sandstone floor.  High ceilings allow heat to rise which, combined with the once water-filled urns mounted between each bed, would have kept the air near the patients at a comfortable temperature despite the baking temperatures outside.  The wide shuttered windows provide ventilation as well as a view of the dried vines clinging to the walls of the temple."],"exits":[{"to":230,"exit":"south","move":"south"},{"to":228,"exit":"northwest","move":"northwest"}]},
  {"id":230,"x":180,"y":880,"z":0,"title":"Temple of Ushnish, Healer's Chambers","descriptions":["An outstretched hand holding a wreath of healing herbs is picked out in the stained glass window of the Healer's quarters.  Some of the glass fragments have fallen, allowing gentle beams of moonlight to illuminate a workbench that remains relatively free of the clouds of dust which mark the rest of the temple.","An outstretched hand holding a wreath of healing herbs is picked out in the stained glass window of the Healer's quarters.  Some of the glass fragments have fallen, allowing bright rays of sunlight to pour through the window and illuminate a workbench that remains relatively free of the clouds of dust which mark the rest of the temple."],"exits":[{"to":229,"exit":"north","move":"north"},{"to":231,"exit":"southwest","move":"southwest"}]},
  {"id":231,"x":160,"y":900,"z":0,"title":"Temple of Ushnish, Meditation Chamber","descriptions":["Dried reeds bound by once-bright blue cords cover the floor of the chamber, trapping dust and grit between the ridges.  A few gnawed scraps of prayer rugs or cushions are visible near a central table on which rests a red glass lamp etched with a knotwork design of serpents against a backdrop of flames."],"exits":[{"to":230,"exit":"northeast","move":"northeast"},{"to":242,"exit":"west","move":"west"},{"to":232,"exit":"northwest","move":"northwest"}]},
  {"id":232,"x":140,"y":880,"z":0,"title":"Temple of Ushnish, Monk's Quarters","descriptions":["High arched ceilings and sandstone walls keep the sleeping quarters cool in the hot climate.  Little remains to give clues to the personalities of the residents - a carved serpent pendant fallen from a broken leather thong, mounds of anonymous robes heaped upon the foot of one of the beds.  The cloth is tattered by the ravages of mice and insects."],"exits":[{"to":233,"exit":"north","move":"north"},{"to":231,"exit":"southeast","move":"southeast"},{"to":245,"exit":"northwest","move":"northwest"}]},
  {"id":233,"x":140,"y":840,"z":0,"title":"Temple of Ushnish, Novice's Quarters","descriptions":["Moonlight streams through a broken skylight.  Birds have made their nests in the rafters of the dormitory, leaving behind the mute evidence of their presence.  White blotches mar the cots and the pinkish-gold sandstone floors, while piles of cracked bones tangled with rodent skins and a few stray feathers litter the corners of the room.","Sunlight streams through a broken skylight.  Birds have made their nests in the rafters of the dormitory, leaving behind the mute evidence of their presence.  White blotches mar the cots and the pinkish-gold sandstone floors, while piles of small bones tangled with rodent skins and a few stray feathers litter the corners of the room."],"exits":[{"to":228,"exit":"northeast","move":"northeast"},{"to":232,"exit":"south","move":"south"},{"to":245,"exit":"southwest","move":"southwest"}]},
  {"id":234,"x":100,"y":820,"z":0,"title":"Temple of Ushnish, Chamber of Serpents","descriptions":["Away from the massive bronze doors at the north end of the once ornately decorated hall, the air cools slightly, making each breath somewhat less of a burden.  Intricately carved knotwork borders painted in shades of crimson and vermilion form abstract images of serpents and lava along the base of the walls.  The tessellated floor tiles have been pushed up at irregular intervals by the restless movement of Ushnish's wrath."],"exits":[{"to":226,"exit":"northeast","move":"northeast"},{"to":235,"exit":"east","move":"east"},{"to":236,"exit":"west","move":"west"}]},
  {"id":235,"x":120,"y":820,"z":0,"title":"Temple of Ushnish, Scriptorium","descriptions":["Worm-eaten wooden tables lie in splintered ruins scattered about the remains of the Temple's scriptorium.  Faint remains of ink stains are still visible in the wood, as is an occasional shattered clay inkpot left behind when the priests were unable to appease the wrath of Ushnish.  Sooty streaks mar the ceiling and wall over the eastern door, but the fire seems to have left this room mostly untouched."],"exits":[{"to":227,"exit":"east","move":"east"},{"to":234,"exit":"west","move":"west"}]},
  {"id":236,"x":80,"y":820,"z":0,"title":"Temple of Ushnish, Anteroom","descriptions":["Toppled benches, cracked and splintered by the heat, line the walls of the empty chamber where once visitors waited to consult the famed oracle of Ushnish.  Tall terra cotta urns stand sentry on either side of a passage to the southeast, their gold leaf accents peeling away from the graceful pottery curves."],"exits":[{"to":234,"exit":"east","move":"east"},{"to":243,"exit":"southeast","move":"southeast"},{"to":237,"exit":"southwest","move":"southwest"}]},
  {"id":237,"x":60,"y":840,"z":0,"title":"Temple of Ushnish, Western Hall","descriptions":["In times past, temple maidens clad in filmy gowns tended the serpents of the god.  Murals along the outer curve of the hallway depict them offering up meals on gilded platters, or dancers weaving their way along a snake-covered floor.  The theme is echoed in the hall's floor, where tessellated serpents intertwine in uneven sandstone tiles."],"exits":[{"to":236,"exit":"northeast","move":"northeast"},{"to":238,"exit":"south","move":"south"}]},
  {"id":238,"x":60,"y":880,"z":0,"title":"Temple of Ushnish, Western Hall","descriptions":["The murals in this part of the hallway depicts the rituals of appeasement, from offerings of the harvest to the sacrifice of mortals to the gaping maw of the volcano in attempts to turn aside the wrath of Ushnish.  While the offerings were accepted, given the shifting lava fields surrounding the temple grounds they were not necessarily acceptable."],"exits":[{"to":237,"exit":"north","move":"north"},{"to":239,"exit":"southeast","move":"southeast"}]},
  {"id":239,"x":80,"y":900,"z":0,"title":"Temple of Ushnish, Anteroom","descriptions":["A single uncomfortable-looking bench remains in the anteroom of the High Priestess' office.  Baked by long exposure to the hot dry air, the wood is splintered and rough.  A faint, lingering fragrance drifts from the broken shards of a pierced terra cotta incense holder."],"exits":[{"to":244,"exit":"northeast","move":"northeast"},{"to":240,"exit":"east","move":"east"},{"to":238,"exit":"northwest","move":"northwest"}]},
  {"id":240,"x":100,"y":900,"z":0,"title":"Temple of Ushnish, Guest Hall","descriptions":["Lumpy straw mattresses line the floor, once the communal bedding for wayfarers spending the night at the temple, now merely a tattered nesting place for mice and small lizards.  A few wisps of frayed straw float through the air from time to time to gather in dusty piles along the corners."],"exits":[{"to":241,"exit":"east","move":"east"},{"to":246,"exit":"southeast","move":"southeast"},{"to":239,"exit":"west","move":"west"}]},
  {"id":241,"x":120,"y":900,"z":0,"title":"Temple of Ushnish, Dining Hall","descriptions":["Mounds of melted wax lie twisted into deformed puddles atop the baked oak surface of a refractory table.  One of several, judging by the worm-eaten fragments of wood chips along the floor, this is the only one to survive the years since the temple's abandonment.  Oddly enough, half a dozen three-fingered handprints are branded deeply into the wood."],"exits":[{"to":242,"exit":"east","move":"east"},{"to":240,"exit":"west","move":"west"}]},
  {"id":242,"x":140,"y":900,"z":0,"title":"Temple of Ushnish, Kitchens","descriptions":["Mice and other rodents have long-since devoured any remains of food stored in the pantry, leaving behind only the scattered remains of bones and a few tufts of fur.  An iron cauldron sways from a swinging metal bracket over the open fire pit.  Though hinges creak with each movement, the metal shows no trace of rust in the hot dry air."],"exits":[{"to":231,"exit":"east","move":"east"},{"to":246,"exit":"southwest","move":"southwest"},{"to":241,"exit":"west","move":"west"}]},
  {"id":243,"x":100,"y":840,"z":0,"title":"Temple of Ushnish, Oracle's Chamber","descriptions":["Dizzying vapors rise from vents in the floor to swirl about the ceiling.  Rough carved sandstone and a low roof give the room an oppressive air of closeness, as if the earth enveloped those who sought the wisdom of the god.  The only illumination is a sullenly glowing basalt cone jutting up from the floor, surrounded by blood-streaked offerings."],"exits":[{"to":245,"exit":"southeast","move":"southeast"},{"to":244,"exit":"south","move":"south"},{"to":236,"exit":"northwest","move":"northwest"}]},
  {"id":244,"x":100,"y":880,"z":0,"title":"Temple of Ushnish, High Priest's Chamber","descriptions":["Unlike the sandstone walls of the rest of the temple, the High Priest's chamber has been plastered and painted a deep shade of red.  Darker rectangles along the walls mark the spots where once paintings would have hung.  Most of the furniture has been removed, either by the priests or by looters after the abandonment of the temple, but a single prayer lamp still sways from the ceiling."],"exits":[{"to":243,"exit":"north","move":"north"},{"to":245,"exit":"northeast","move":"northeast"},{"to":239,"exit":"southwest","move":"southwest"}]},
  {"id":245,"x":120,"y":860,"z":0,"title":"Temple of Ushnish, Central Altar","descriptions":["The central altar is austere, lacking the carvings found in other areas of the temple.  No vipers coil along the sandstone walls, no elaborate paintings adorn the chamber.  All attention is focused upon an upthrust slab of polished black basalt veined with a natural serpentine pattern of deep green olivine."],"exits":[{"to":233,"exit":"northeast","move":"northeast"},{"to":232,"exit":"southeast","move":"southeast"},{"to":244,"exit":"southwest","move":"southwest"},{"to":243,"exit":"northwest","move":"northwest"}],"color":"#A6A3D9","aliases":["Ushnish","shrine"]},
  {"id":246,"x":120,"y":920,"z":0,"title":"Temple of Ushnish, Southern Hall","descriptions":["A hot, dry breeze from the south stirs up whorls of gritty dust that spiral about in dense clouds before subsiding.  Thin layers of grey-white powder coat the walls and obscure the vibrant colors of the murals beneath.  Elusive hints of sandalwood perfume the air, though the source of the fragrance is not apparent."],"exits":[{"to":242,"exit":"northeast","move":"northeast"},{"to":247,"exit":"south","move":"south"},{"to":240,"exit":"northwest","move":"northwest"}]},
  {"id":247,"x":120,"y":940,"z":0,"title":"Temple of Ushnish, Southern Colonnade","descriptions":["Twisted fragments of bronze hinges cling to one side of the sandstone doorframe, though the door itself lies in ash-covered splendor upon the floor.  Crumbling columns continue to support the roof over the wide colonnade, though each shifting movement of the earth renders that support more dubious."],"exits":[{"to":246,"exit":"north","move":"north"},{"to":248,"exit":"climb","move":"climb steep cliff","hidden":true}]},
  {"id":248,"x":120,"y":980,"z":0,"title":"The Fangs of Ushnish, Lava Field","descriptions":["Jagged shards of obsidian thrust up from the parched earth at odd angles, formed by the shifting lava flows.  Faint hints of olivine streak the glassy surface.  The sharp edges and poisonous green color give rise to the local name for this area, the Fangs of Ushnish.  As lava cools, it hardens, only to break out again in another location.  The path through the field is never constant as nature's wrath, or that of the god, makes itself known in molten rock."],"exits":[{"to":0,"exit":"south","move":"south","hidden":true},{"to":247,"exit":"climb","move":"climb steep cliff"},{"to":0,"exit":"northeast","move":"","hidden":true},{"to":0,"exit":"east","move":"","hidden":true},{"to":0,"exit":"southeast","move":"","hidden":true},{"to":0,"exit":"southwest","move":"","hidden":true},{"to":0,"exit":"west","move":"","hidden":true},{"to":0,"exit":"northwest","move":"","hidden":true}]},
  {"id":249,"x":550,"y":330,"z":0,"title":"North Road, Caravansary","descriptions":["A sprawling ranch-style house sits nestled beneath the boughs of a grove of tall old oaks.  The smell of fresh baking wafts invitingly from its open door. Beside the house lies a small, carefully tended garden, with vegetables and herbs lined up in neat rows around an old stone well.  The sound of whinnying horses rings out from the broad doors of a red painted barn to the east."],"exits":[{"to":88,"exit":"south","move":"south"},{"to":250,"exit":"go","move":"go barn"},{"to":251,"exit":"go","move":"go small workshop"},{"to":252,"exit":"go","move":"go ranch house"}]},
  {"id":250,"x":560,"y":330,"z":0,"title":"Caravansary, Barn","descriptions":["A long stone trough runs along the center of the barn, between two rails for hitching horses and camels.  Light slanting through the wood slat roof falls in shining pinstripes on the neat dirt floor and glistens off the hay stacked in feeders along the walls."],"exits":[{"to":249,"exit":"out","move":"out"}]},
  {"id":251,"x":540,"y":330,"z":0,"title":"Caravansary, Workshop","descriptions":["A small sign on the door bids you welcome as you enter Dokker's workshop and trading post.  The scent of freshly tanned leather hangs in the air like musty perfume.  The walls are hung with racks of finely crafted backpacks, belts and pouches, and the floor is covered with crates of hides and boxes of trade goods.  A catalog sits atop a cluttered workbench."],"exits":[{"to":249,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Workshop","Dokker"]},
  {"id":252,"x":550,"y":320,"z":0,"title":"Caravansary, Common Room","descriptions":["Light from a grey stone fireplace glistens off rows of copper pots and pans hanging from the whitewashed walls of the large common room.  Piles of clean warm furs lie stacked in the open area before the fire, where tired travellers may lay down for a good nights sleep.  Long wooden tables with benches alongside await the hungry guest, and the promise of delicious food and refreshing drink drifts through the air from the swinging kitchen door."],"exits":[{"to":249,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Common Room","Bar","Food","Drink","Leela"]},
  {"id":253,"x":580,"y":450,"z":0,"title":"Greater Fist Footpath, Large Boulder","descriptions":["Cinders, ash, and mud mixed with rocky debris have collected at the base of the footpath.  Once past the mounds littering the trail, the path continues towards the summit of the volcano, twisting amid the cooling flows and ruined vegetation."],"exits":[{"to":0,"exit":"east","move":"east"}],"aliases":["Greater Fist"],"linksTo":"Map14b_Greater_Fist.xml"},
  {"id":254,"x":560,"y":470,"z":0,"title":"Burrows Dwelling, Sleeping Loft","descriptions":["This dusty loft overlooks a main room.  A wooden cupboard bed, built into one corner, remains the upright item in this room.  A writing desk and bow-backed chair lay overturned across the room.  Some rag rugs, formerly covering the bare planks of the floor, lay heaped in a single pile in the corner.  A bloody stain on the floor indicates that someone was grievously injured but there are no signs as to who was hurt."],"exits":[{"to":159,"exit":"out","move":"out"},{"to":255,"exit":"climb","move":"climb wooden ladder"}]},
  {"id":255,"x":580,"y":470,"z":0,"title":"Burrows Dwelling, Main Room","descriptions":["Normally this would be a quiet place to rest after a long day of work but now all is in disarray.  Hand-carved toys, laying on the dust-covered floor, tell of a hasty departure.  A crushed rocking chair and fragments of yellow earthenware lay beneath an upturned wooden cupboard.  Gusts of wind coming down the hearth's flue stir clouds of dust into the hazy air.  A closed, wooden door bows inward, as though under a strain and shows signs of charring around the edges of its jamb."],"exits":[{"to":254,"exit":"climb","move":"climb wooden ladder"}]},
  {"id":256,"x":500,"y":950,"z":0,"title":"Dismal Grove, Paper Mill","descriptions":["Surrounded by boulders and jagged rocks, a small wooden paper mill sits in the center of the circle of dead poplars, appearing to be relatively newly built.  Several younger trees near the building struggle valiantly against the harsh environment, providing patches of green that sharply contrast the barren landscape."],"exits":[{"to":131,"exit":"go","move":"go main road"},{"to":257,"exit":"go","move":"go mill's door"}]},
  {"id":257,"x":510,"y":960,"z":0,"title":"Paper Mill, Entrance","descriptions":["The paper mill's high walls are crafted from planks of untreated wood, held together with bare nails in even rows.  Wooden beams hold up the high ceiling, and sawdust is scattered over the dirt floor.  The building has an unfinished air about it, as if aesthetics were sacrificed solely for function."],"exits":[{"to":258,"exit":"west","move":"west"},{"to":256,"exit":"go","move":"go mill's door"}],"aliases":["Paper Mill","origami factory"]},
  {"id":258,"x":500,"y":960,"z":0,"title":"Paper Mill, Narrow Hallway","descriptions":["The smell of sawdust hangs heavily in the air, and a fine wooden powder covers everything.  A boarded-up window on the western wall lets in light through a few cracks, and motes of dust float lazily through the air.  An eerie silence hangs over the mill, punctuated occasionally by the sound of rustling paper.","The smell of sawdust hangs heavily in the air, and a fine wooden powder covers everything.  Light from an old gaethzen orb flickers above a boarded-up window, the aged sphere constantly threatening to go out.  The sound of crickets occasionally breaks the silence, and occasionally a rustle of paper echoes through the mill."],"exits":[{"to":257,"exit":"east","move":"east"},{"to":259,"exit":"south","move":"south"}]},
  {"id":259,"x":500,"y":970,"z":0,"title":"Paper Mill, Drying Chambers","descriptions":["Enormous sheets of white paper hang from wooden dowels over narrow troughs of water, arranged in diagonals to make the most of the mill's space.  The ceiling rises high, occasional lines of light from outside shining through cracks in the untreated wood.  A faint chemical smell hangs in the air, mixing with the constant scent of sawdust."],"exits":[{"to":258,"exit":"north","move":"north"},{"to":260,"exit":"east","move":"east"}]},
  {"id":260,"x":510,"y":970,"z":0,"title":"Paper Mill, Drying Chambers","descriptions":["A constant drip, drip, drip sound comes from a slanted tin panel hanging over a trough of water.  Apparently set up as an attempt to remove moisture from the drying area, the mechanism is attached to a fist-wide drainage pipe that leads outside.  In the southern portion of the expansive room, freshly made sheets of paper hang from wooden dowels, waiting to be moved."],"exits":[{"to":259,"exit":"west","move":"west"},{"to":261,"exit":"go","move":"go narrow door"}]},
  {"id":261,"x":540,"y":970,"z":0,"title":"Paper Mill, Chemical Baths","descriptions":["Steel troughs filled with steaming water line rows of thick shelves, each long basin delivering an acrid smell into the air.  Softening wood chips line the bottom of each one, preparing them to be turned into pulp for paper.  Shallow puddles mar the floor next to the troughs, slowly sinking into the dirt floor, while small piles of sawdust lie discarded in the corners."],"exits":[{"to":262,"exit":"south","move":"south"},{"to":260,"exit":"go","move":"go narrow door"}],"aliases":["Chemical Baths"]},
  {"id":262,"x":540,"y":990,"z":0,"title":"Paper Mill, Chemical Baths","descriptions":["An enormous pile of wood chips dominates the eastern side of the room, underneath a large chute fixed in the ceiling.  Stuck halfway into the mound is a rusty shovel, apparently made for shoveling the wood chips into nearby troughs filled with water and chemicals.  The scent of sawdust hangs heavy in the air, and the chirping of birds can distantly be heard from outside.","An enormous pile of wood chips dominates the eastern side of the room, underneath a large chute fixed in the ceiling.  Stuck halfway into the mound is a rusty shovel, apparently made for shoveling the wood chips into nearby troughs filled with water and chemicals.  The scent of sawdust hangs heavy in the air, and the occasional hooting of an owl can be heard from nearby outside."],"exits":[{"to":261,"exit":"north","move":"north"},{"to":263,"exit":"west","move":"west"},{"to":265,"exit":"go","move":"go large window"}]},
  {"id":263,"x":530,"y":990,"z":0,"title":"Paper Mill, Working Stations","descriptions":["Towering stacks of square wooden frames filled with thin layers of wood pulp take up most of the floor space in this warehouse.  Set out to begin the curing process, each of the frames is large enough to make a full yard of paper.  The plain floor is simply hardened dirt, packed tight and scattered with a fine layer of sawdust."],"exits":[{"to":264,"exit":"north","move":"north"},{"to":262,"exit":"east","move":"east"}],"aliases":["Working Stations"]},
  {"id":264,"x":530,"y":980,"z":0,"title":"Paper Mill, Working Stations","descriptions":["The center of the room is dominated by a pair of rollers, apparently used to squeeze chemical-laced water from freshly made paper.  Nearby a wide, shallow vat filled with water holds several large sheets of paper, sitting ready to be put through the wringer.  The walls and equipment show some signs of neglect: spots of rust appearing on the metallic parts of the equipment."],"exits":[{"to":263,"exit":"south","move":"south"},{"to":788,"exit":"climb","move":"climb narrow stairs"}]},
  {"id":265,"x":560,"y":1010,"z":0,"title":"Paper Mill, Sawdust Heap","descriptions":["An enormous pile of sawdust mixed with bits of bark, metals and discarded paper makes a huge heap in this corner of the scrap yard, apparently unsuited for creating paper.  The mixture spreads over the entire yard, choking what little grass there is and mixing with the dirt underfoot.  A few barrels have been shoved next to the building, giving off a somewhat chemical smell."],"exits":[{"to":266,"exit":"west","move":"west"},{"to":262,"exit":"go","move":"go large window"}],"aliases":["Sawdust Heap"]},
  {"id":266,"x":550,"y":1010,"z":0,"title":"Paper Mill, Scrap Yard","descriptions":["Sheared scraps of discarded bark, broken and rusty equipment, crumpled paper and other waste line the edges of the yard.  A relatively clear path leads east, where an enormous sawdust pile can be seen.  A compost bin has been shoved into the corner of the room, the rotting greens casting off an earthy smell."],"exits":[{"to":265,"exit":"east","move":"east"}],"aliases":["Scrap Yard"]},
  {"id":267,"x":360,"y":2570,"z":0,"title":"Northeast Wilds, Birder Lane","descriptions":["One of the gates of the Crossing lies before you to the northwest, and a steady stream of adventurers flows by.  You notice a high proportion of wizards, grey-bearded and fierce-eyed, leaning on staves or muttering to themselves or their familiars.  A small lizard barely escapes death underfoot, and you pay more attention to where you tread, lest you inadvertently do in some Mage's favorite pet."],"exits":[{"to":270,"exit":"east","move":"east"},{"to":268,"exit":"northwest","move":"northwest"}],"color":"#C2B280","aliases":["RTZ02","RT-XNE-HF"]},
  {"id":268,"x":280,"y":2450,"z":0,"title":"Northeast Wilds, Outside Northeast Gate","descriptions":["You are before the Northeast Gate of the Crossing, surrounded by wayfarers and adventurers also in mid-journey.  Above, guardsmen stare down from the thick stone wall that encloses the city, wary for hostile visitors.  Whether they travel to destinations in town or farther west, or to the north and east, they all appear to be seeking something beyond themselves."],"exits":[{"to":312,"exit":"north","move":"north"},{"to":269,"exit":"east","move":"east"},{"to":267,"exit":"southeast","move":"southeast"},{"to":349,"exit":"go","move":"go northeast gate"},{"to":348,"exit":"go","move":"go footpath"},{"to":641,"exit":"climb","move":"climb battlement wall"}],"color":"#FF00FF","aliases":["Northeast Gate","NE Gate to Crossing","Gate to Crossing","Kraelyst start point","travel start point"]},
  {"id":269,"x":300,"y":2450,"z":0,"title":"Northeast Wilds, Bramble Thicket","descriptions":["A small, thin path meanders through an otherwise daunting thicket of brambles here.  Directly to the north is a dark, slate outcropping, while east lies a tall, attenuated tower.  The exterior of the tower is covered with carvings of fantastic and legendary beings and creatures, whose awesome and powerful visages you can discern even from this distance.  Through the foliage, you see the town gate to the west."],"exits":[{"to":268,"exit":"west","move":"west"},{"to":296,"exit":"go","move":"go trail"},{"to":402,"exit":"go","move":"go path"}]},
  {"id":270,"x":380,"y":2570,"z":0,"title":"Northeast Wilds, Birder Lane","descriptions":["Flocks of screeching ravens cloud the sky overhead, and wrens, larks and other feathered creatures seem to be hovering about as if awaiting something.  An enormous black crow stoops and whooshes past your ear, only to land on the head of one of the more hideous gargoyles projecting from the facade of the black tower due east.  The crow appears to be watching your every move."],"exits":[{"to":271,"exit":"east","move":"east"},{"to":267,"exit":"west","move":"west"}]},
  {"id":271,"x":400,"y":2570,"z":0,"title":"Northeast Wilds, Grimsage Way","descriptions":["The once pristine tower of the Warrior Mages is now no more than a memorial.  The stresses of the great fire have shattered the crystalline spire.  The building stands broken and raw against the sky.  One onyx door tilts wildly to the side, its hinges melted to slag, while the other has been reduced to rubble."],"exits":[{"to":272,"exit":"northeast","move":"northeast"},{"to":274,"exit":"southeast","move":"southeast"},{"to":270,"exit":"west","move":"west"},{"to":294,"exit":"go","move":"go onyx door"},{"to":809,"exit":"none","move":"join airship"}]},
  {"id":272,"x":420,"y":2550,"z":0,"title":"Northeast Wilds, Grimsage Way","descriptions":["The tower's immolation has opened the area to new lighting where once the mighty shadow lay.  A profusion of new growth will thrive amongst the rubble.  The circle of life repeats itself, creation from destruction."],"exits":[{"to":273,"exit":"southeast","move":"southeast"},{"to":271,"exit":"southwest","move":"southwest"}]},
  {"id":273,"x":460,"y":2570,"z":0,"title":"Northeast Wilds, Grimsage Way","descriptions":["The small path skirts the shattered remains of Arhat's tower to the west, and branches off to the east.  The low mound that forms the ruins of Motte Fort lies to the southeast, and just east of that the solid stone walls of the Keep of the Ughtensgard.  Another tower, capped with a gleaming crystal dome, is visible farther southeast.","The small path skirts the shattered remains of Arhat's tower to the west, and branches off to the east.  The low mound that forms the ruins of Motte Fort lies to the southeast, and just east of that are the devastated walls of what was once the Keep of the Ughtensgard.  Another tower, capped with a gleaming crystal dome, is visible farther southeast."],"exits":[{"to":275,"exit":"east","move":"east"},{"to":274,"exit":"southwest","move":"southwest"},{"to":272,"exit":"northwest","move":"northwest"}]},
  {"id":274,"x":420,"y":2590,"z":0,"title":"Northeast Wilds, Grimsage Way","descriptions":["The narrow path here is bounded on the south by mats of decomposing water plants and swamp grasses.  The stench of marsh gas and the thrashing of slimy, watery things in the rotting reeds keep you from exploring in that direction."],"exits":[{"to":273,"exit":"northeast","move":"northeast"},{"to":271,"exit":"northwest","move":"northwest"}]},
  {"id":275,"x":480,"y":2570,"z":0,"title":"Northeast Wilds, Grimsage Way","descriptions":["The small path curves slowly northwards, heading farther and farther away from the protection of the Crossing's gates.  Arhat's tower, once home of the Warrior Mage Guild, lies in a crumbling heap of stone to the west."],"exits":[{"to":276,"exit":"northeast","move":"northeast"},{"to":273,"exit":"west","move":"west"}]},
  {"id":276,"x":500,"y":2550,"z":0,"title":"Northeast Wilds, Grimsage Way","descriptions":["Rising above the surrounding lands, the stone walls of Arhat's tower end in jagged edges that pierce the sky.  The small path continues to the north, leading towards a larger tower of freshly-cut silvery-grey stone."],"exits":[{"to":277,"exit":"north","move":"north"},{"to":275,"exit":"southwest","move":"southwest"}]},
  {"id":277,"x":500,"y":2530,"z":0,"title":"Northeast Wilds, Grimsage Way","descriptions":["An enormous tower of grey marble rises imposingly from the ground, its stones fitted so closely that it appears to be one seamless spear of earth.  The top of the tower gleams brightly, the light reflecting from the panes of a skylight set into the roof.  A set of gleaming ebonwood doors inlaid with gold lead into the tower."],"exits":[{"to":276,"exit":"south","move":"south"},{"to":278,"exit":"go","move":"go door"}],"aliases":["Grimsage Way"]},
  {"id":278,"x":500,"y":2510,"z":0,"title":"Warrior Mage Guild, Foyer","descriptions":["Slate grey walls span the tower interior, faint reflections fading in and out of its glassy sheen.  A long steep staircase cut into the walls spirals its way up the tapering interior.  Two gruesome and fierce-countenanced dvarapalas stare sullenly at a set of gleaming ebonwood doors leading outside.  Set precisely in the center of the floor is a large golden wheel engraved with the crest of the Warrior Mage guild."],"exits":[{"to":279,"exit":"go","move":"go marble arch"},{"to":280,"exit":"climb","move":"climb staircase"},{"to":277,"exit":"go","move":"go door"}],"aliases":["Warrior Mage"]},
  {"id":279,"x":480,"y":2510,"z":0,"title":"Warrior Mage Guild, Gauthus' Office","descriptions":["A pink marble arch connects the office with the foyer of the guildhall, allowing Gauthus to keep a watchful eye on visitors and apprentices alike from his seat behind a bare pine desk.  Gazing about with impartial interest, a red-banded hawk moves restlessly on her wooden perch, shifting from foot to foot or ruffling her feathers.  High transom windows along the walls provide ventilation and light in what might otherwise be a small, airless room.","A pink marble arch connects the office with the foyer of the guildhall, allowing Gauthus to keep a watchful eye on visitors and apprentices alike from his seat behind a bare pine desk.  Gazing about with impartial interest, a red-banded hawk moves restlessly on her wooden perch, shifting from foot to foot or ruffling her feathers.  Gaethzen spheres sway in the breeze from the high transom windows, providing light for the small room."],"exits":[{"to":278,"exit":"go","move":"go marble arch"}],"color":"#FF8000","aliases":["GL WM","GL Warrior Mage","Gauthus"]},
  {"id":280,"x":500,"y":2490,"z":0,"title":"Warrior Mage Guild, Landing","descriptions":["The second floor landing is paneled in softly-colored woods that start at a pleasant gold at the north and south, and shade gently to a pale pink at the east and west.  A large goldenwood door to the north blends perfectly with the paneling, and is flanked by two archways of pale pink marble to the east and west."],"exits":[{"to":282,"exit":"east","move":"east"},{"to":281,"exit":"west","move":"west"},{"to":283,"exit":"up","move":"up"},{"to":278,"exit":"climb","move":"climb staircase"},{"to":434,"exit":"go","move":"go goldenwood door"}]},
  {"id":281,"x":480,"y":2490,"z":0,"title":"Warrior Mage Guild, Library","descriptions":["Pale pink marble walls and ceiling, a luxurious white carpet, and an abundance of comfortable but unadorned furniture are the only features of this pleasantly warm room.  A large rosewood shelf lined with tomes of history and lore matches the pale pink marble of the archway to the east."],"exits":[{"to":280,"exit":"east","move":"east"},{"to":280,"exit":"go","move":"go archway"}],"aliases":["Library"]},
  {"id":282,"x":520,"y":2490,"z":0,"title":"Warrior Mage Guild, Hall of History","descriptions":["Thickly woven tapestries adorn the dull granite walls, each depicting something different.  Iron sconces shaped like human hands, each holding a brightly lit gaethzen sphere, are affixed to the walls at regular intervals around the hall.  A few mages read quietly in plush, high-backed chairs sitting atop the thick, bright red carpet."],"exits":[{"to":280,"exit":"west","move":"west"},{"to":291,"exit":"go","move":"go wood door"}],"aliases":["Hall of History","RS Warrior Mage"]},
  {"id":283,"x":560,"y":2450,"z":0,"title":"Warrior Mage Guild, Landing","descriptions":["The slate grey walls of the tower end, and large panes of glass taper to a point above, creating a massive skylight and window to the heavens above.  Five archways ring the room, each one etched with a curious symbol at its apex.  Dangling from the skylight, a wooden ladder hangs almost directly over a spiraling staircase that leads into the floor."],"exits":[{"to":280,"exit":"down","move":"down"},{"to":284,"exit":"climb","move":"climb staircase"},{"to":285,"exit":"go","move":"go fire arch"},{"to":286,"exit":"go","move":"go steel archway"},{"to":287,"exit":"go","move":"go electricity archway"},{"to":288,"exit":"climb","move":"climb ladder"},{"to":289,"exit":"go","move":"go water archway"},{"to":290,"exit":"go","move":"go aether archway"}]},
  {"id":284,"x":560,"y":2470,"z":0,"title":"Warrior Mage Guild, Chamber of Earth","descriptions":["This small cavern, held secret within the depths of the earth, seems to pulse with the very heartbeat of Elanthia.  Phospherein lines the ceiling, emitting a steady, pearlescent green glow.  Roots of various plants, some ancient as the Gods themselves, entwine together to form a small couch upon the ground."],"exits":[{"to":283,"exit":"climb","move":"climb staircase"}],"aliases":["Chamber of Earth"]},
  {"id":285,"x":540,"y":2450,"z":0,"title":"Warrior Mage Guild, Chamber of Fire","descriptions":["Walls of obsidian blackness reflect the light from a fire-pit in the center of this room.  Smoking braziers of flame-kissed gold line the walls, filling the room with pleasant heat.  Spiderweb traces of rhodonite line the ceiling, glowing in the firelight with the stylized image of a flame."],"exits":[{"to":283,"exit":"go","move":"go fire archway"}],"aliases":["Chamber of Fire"]},
  {"id":286,"x":540,"y":2470,"z":0,"title":"Warrior Mage Guild, Chamber of Steel","descriptions":["This plain white room is unadorned, save for a large map of the realms upon the northern wall, and a small weapons rack.  Several rows of benches cluster about the map, obviously used for strategy sessions, and war games."],"exits":[{"to":283,"exit":"go","move":"go steel archway"}],"aliases":["Chamber of Steel"]},
  {"id":287,"x":540,"y":2430,"z":0,"title":"Warrior Mage Guild, Chamber of Electricity","descriptions":["An anticipatory hum resonates through the air, as though everything in this room were filled with the power of a lightning strike.  Columns of pure ilmenite line the walls, glowing from within with pent-up force.  All traces of metal are conspicuously absent from the room's furnishings."],"exits":[{"to":283,"exit":"go","move":"go electricity archway"}],"aliases":["Chamber of Electricity"]},
  {"id":288,"x":560,"y":2430,"z":0,"title":"Warrior Mage Guild, Chamber of Air","descriptions":["Dominated by the translucent panes of the massive skylight, the roof of the tower provides an unparalleled view of the lands around the Crossing, including the shattered remains of Arhat's Tower to the south.  Fickle breezes and gusty gales swirl about the stone, causing the tower to resonate in a never-ending song of change glorifying the dance of the winds."],"exits":[{"to":283,"exit":"climb","move":"climb ladder"}],"aliases":["Chamber of Air"]},
  {"id":289,"x":580,"y":2450,"z":0,"title":"Warrior Mage Guild, Chamber of Water","descriptions":["Perpetually frozen, a great stalactite of ice hangs from the ceiling, reaching almost to the floor.  As the end slowly melts, drops of water fall into a pool below and flow along cracks in the stone to form an intricate lattice-work beneath.  Fog slowly rolls off of the ice, cooling the air and settling into a dream-like haze upon the blue marble."],"exits":[{"to":283,"exit":"go","move":"go water archway"}],"aliases":["Chamber of Water"]},
  {"id":290,"x":580,"y":2430,"z":0,"title":"Warrior Mage Guild, Chamber of Aether","descriptions":["Silvery-blue wall hangings cover the base stone walls of the room, matching the cushions scattered about the floor.  Floating in the center of the room is a sphere of white-gold which glows with an inner fire.  Undefined patterns of light and color swirl about the wall hangings, as though this room were not entirely within the Plane of Abiding."],"exits":[{"to":283,"exit":"go","move":"go aether archway"}],"aliases":["Chamber of Aether"]},
  {"id":291,"x":540,"y":2490,"z":0,"title":"Warrior Mage Guild, Chamber of Reflection","descriptions":["From the peaked ceiling hangs an enormous gaethzen sphere which casts a bright, white light onto the room.  Polished marble walls intensify the light, creating an aura effect around everything.  In the center of the floor sits a fountain where a tall marble statue of a robed Elven male sends water arching into the pool below from cupped hands.  Large, fluffy cushions circle the fountain, creating a comfortable spot to rest."],"exits":[{"to":292,"exit":"go","move":"go vault arch"},{"to":293,"exit":"go","move":"go marble arch"},{"to":282,"exit":"go","move":"go wood door"},{"to":796,"exit":"go","move":"go iron door"}],"aliases":["Chamber of Reflection"]},
  {"id":292,"x":560,"y":2510,"z":0,"title":"Warrior Mage Guild, Target Range","descriptions":["Blackened marks mar the surface of the grey stones which form this room.  The charred remains of a tapestry hang on one wall, now only a narrow border of blue surrounding a black-edged hole.  From time to time, young apprentices sidle in to practice their magic upon one of the constructs, only to hurry off to classes.  They leave behind new pits in the stone walls, though perhaps not much damage to the construct they had aimed at."],"exits":[{"to":291,"exit":"go","move":"go vaulted arch"}],"aliases":["Target Range"]},
  {"id":293,"x":540,"y":2510,"z":0,"title":"Warrior Mage Guild, Archery Range","descriptions":["A wide marble archway opens up into a spacious room.  Grey stones form the vaulted ceiling and smooth walls, giving this space a somewhat austere feel.  Affixed to the front of a bale of hay is a small target.  The target has been sloppily painted on a square of canvas, streaks of paint running down onto the hay.  Some paint has been splattered liberally on a tree branch from which the canvas hangs."],"exits":[{"to":291,"exit":"go","move":"go marble arch"}],"aliases":["Archery Range"]},
  {"id":294,"x":400,"y":2550,"z":0,"title":"Arhat's Tower, Foyer","descriptions":["Scorched walls span the tower, and faint reflections of emerald green onyx are visible beneath the ash.  A long steep staircase has been cut into the walls, spiraling its way up the tapering interior.  A soot-blackened door, hanging precariously from one hinge, leads out."],"exits":[{"to":295,"exit":"up","move":"up"},{"to":271,"exit":"go","move":"go onyx door"}],"aliases":["Arhat's Tower"]},
  {"id":295,"x":400,"y":2530,"z":0,"title":"Arhat's Tower, Workshop","descriptions":["Very little is recognizable from the workshop's original contents.  The walls are broken off at half their intended height and the area lies open to the elements.  The only obvious sign of the room's prior function, odd glowing stains marking the floor, are most likely the result of past experiments gone awry."],"exits":[{"to":294,"exit":"down","move":"down"}]},
  {"id":296,"x":460,"y":2410,"z":0,"title":"Forest, A Quiet Path","descriptions":["A cool wind twists through the air, carrying the crisp scent of pine.   A generous carpet of needles and loam lines the ground, churning up dust that offsets the sharper smells with a sweet mustiness.  In the distance, a sparrow whistles, calling out an ancient melody that only others of its kind can recall the words to."],"exits":[{"to":297,"exit":"northwest","move":"northwest"},{"to":269,"exit":"go","move":"go trail"}]},
  {"id":297,"x":420,"y":2390,"z":0,"title":"Forest, A Quiet Path","descriptions":["Solitary and overbearing, the trees of the forest loom over all they behold.  Caught in a game of one-upsmanship, the trees clump in groups that attempt to outgrow the other.  One particular tree, a massive blackwood, overtowers them all, its boughs extending outward in an embrace that gathers up the forest with arms of shadow and leaf.","Solitary and overbearing, the trees of the forest loom over all that they behold.  Caught in a game of one-upsmanship, the trees clump in groups that attempt to outgrow the other.  Through the dimness of the night, you can make out the blurred lines of a massive blackwood, its boughs extending vastly outward, and its crown brushing back the stars to occlude the sky and moons with thick black leaves."],"exits":[{"to":298,"exit":"north","move":"north"},{"to":296,"exit":"southeast","move":"southeast"}]},
  {"id":298,"x":420,"y":2370,"z":0,"title":"Forest, Thinning Trees","descriptions":["A scattering of trees marks the edge of the forest as it fades away into a wide field to the north and thickens to the south.  Clumps of grass and wildflowers grow in smooth rolling hollows and hillocks of green, and a pleasant breeze cools the air to an amiable degree."],"exits":[{"to":297,"exit":"south","move":"south"},{"to":299,"exit":"go","move":"go doorway"}]},
  {"id":299,"x":420,"y":2350,"z":0,"title":"Northeast Wilds, Fields","descriptions":["Tawny grasses wave in a breeze rendered vocal by the whisper of the stalks rubbing together.  Here and there the field has been tramped down by the passage of careless feet, making paths that wind through the grasses in mazed patterns.  To the south a forest edges up against the horizon, clamoring for attention from the sky they would swallow whole.","The moonlight turns the gold of the tall grasses of the field into silver.  Here and there the field has been tramped down by the passage of careless feet, making paths that wind through the grasses in mazed patterns.  To the south a forest edges up against the horizon, clamoring for attention from the sky they would swallow whole."],"exits":[{"to":300,"exit":"northeast","move":"northeast"},{"to":298,"exit":"south","move":"south"},{"to":311,"exit":"west","move":"west"}]},
  {"id":300,"x":460,"y":2330,"z":0,"title":"Northeast Wilds, Fields","descriptions":["The subtle scent of hay and butter-yellow blossoms infuses the air with a fragrance that brings to mind summer breezes.  Crushed and tattered grasses form a ragged path through the growth, and the constant hum and buzz of insects lends a sense of drowsy solitude to the empty lands.","The subtle scent of hay and jes-rose blossoms infuses the air with a pungent scent.  Crushed and tattered grasses glimmer in the pale light of the stars as they form a ragged path through the growth.  The sense of solitude and emptiness is overwhelming."],"exits":[{"to":301,"exit":"northeast","move":"northeast"},{"to":299,"exit":"southwest","move":"southwest"}]},
  {"id":301,"x":480,"y":2310,"z":0,"title":"Northeast Wilds, Fields","descriptions":["Tiny, annoying gnats and flies whirr through the field, flying into faces and darting quickly away before they can meet their doom.  From time to time you catch a flash of movement as one of the local avians zooms in to snatch any particularly attractive or plump-looking bugs, but the sense of poetic justice is quickly erased as another buzzes in to take the place of the one that was consumed.","Cool breezes sweep the fields, visiting unto the parched vegetation release from the naked heat of day."],"exits":[{"to":300,"exit":"southwest","move":"southwest"},{"to":302,"exit":"northwest","move":"northwest"}]},
  {"id":302,"x":460,"y":2290,"z":0,"title":"Northeast Wilds, Fields","descriptions":["The grass stirs in slow patterns as a breeze -- the only permanent resident of the empty hinterland -- swirls over it.  Like a wave searching for a shore, the wind pushes back and forth over the changing shades and hues of the growth, hunting for a haven it will never find."],"exits":[{"to":303,"exit":"north","move":"north"},{"to":301,"exit":"southeast","move":"southeast"},{"to":306,"exit":"northwest","move":"northwest"}]},
  {"id":303,"x":460,"y":2210,"z":0,"title":"Northeast Wilds, Fields","descriptions":["An ocean of grass edges around the beaten-down path that curls precariously through the field's vastness.  With the wind steadily running its fingers through the grasses, the stalks rise and fall in a continual show of motion as inexorable and reflexive as a heartbeat."],"exits":[{"to":302,"exit":"south","move":"south"},{"to":304,"exit":"southwest","move":"southwest"}]},
  {"id":304,"x":420,"y":2230,"z":0,"title":"Northeast Wilds, Fields","descriptions":["The soft chirr of insects hidden in the tall grasses mingles with the trilling of the nesting field larks that make their homes in the protective shade of the narrow-bladed but profuse growth.  You can catch glances of the tiny dun-colored creatures, their soft brown eyes peering up from between the criss-crossing stalks and their voices twittering questions that remain forever unanswered.","The inquisitive chirring of grasshoppers and the floating brilliance of glowbugs mingles in a complex dance through the air.  Moving to the sleepy tune of drowsing field larks, you can catch nothing but glances of the tiny creatures, their forms rendered shadowy and supple by the curtain of night."],"exits":[{"to":303,"exit":"northeast","move":"northeast"},{"to":305,"exit":"west","move":"west"}]},
  {"id":305,"x":320,"y":2230,"z":0,"title":"Northeast Wilds, Fields","descriptions":["Great, rolling fields swallow up the world from one end of the sky to the next.  The natural perfection of the pristine grass is only marred by the paths that have been grudgingly trodden through them by the heavy feet of adventurers and their prey."],"exits":[{"to":304,"exit":"east","move":"east"},{"to":309,"exit":"south","move":"south"}]},
  {"id":306,"x":420,"y":2270,"z":0,"title":"Northeast Wilds, Grove","descriptions":["Leaves dance in the swirl of a cool breeze as tall oaks and slim pines crowd against one another in a race for light and space.  Fallen pine needles and grass form a luxurious carpet, muffling footsteps and releasing sharp, clean scents into the air."],"exits":[{"to":302,"exit":"southeast","move":"southeast"},{"to":310,"exit":"west","move":"west"},{"to":307,"exit":"northwest","move":"northwest"}]},
  {"id":307,"x":400,"y":2250,"z":0,"title":"Northeast Wilds, Grove","descriptions":["Vines curl around the trunks of the trees, displaying glossy green leaves with powdery grey underbellies.  The branches of the aesaigos shirk against one another, a mysterious sound."],"exits":[{"to":306,"exit":"southeast","move":"southeast"},{"to":308,"exit":"southwest","move":"southwest"}]},
  {"id":308,"x":380,"y":2270,"z":0,"title":"Northeast Wilds, Grove","descriptions":["Slender aesaigo trees link their limbs and leaves together to form a loose screen of shade against the light.  The grass fades from amber to emerald as it sweeps west to east, its changing surface dotted with starflowers and buttercups.","Slender aesaigo trees link their limbs and leaves together to form a loose latticework through which the moonlight slips.  The grass is darkened to a monotone shade of grey, the flowers that dot its surface closed for the evening."],"exits":[{"to":307,"exit":"northeast","move":"northeast"},{"to":310,"exit":"east","move":"east"},{"to":309,"exit":"west","move":"west"}]},
  {"id":309,"x":320,"y":2270,"z":0,"title":"Northeast Wilds, Fields","descriptions":["A sea of multi-hued grasses rises and falls all around.  From the deep greens of serrated seregrass to the tawny spun gold of common stalks, the panorama of color is incredible to consider, the palette of a crazed and yet highly imaginative painter."],"exits":[{"to":305,"exit":"north","move":"north"},{"to":308,"exit":"east","move":"east"},{"to":311,"exit":"southeast","move":"southeast"}]},
  {"id":310,"x":400,"y":2270,"z":0,"title":"Northeast Wilds, Washing Well","descriptions":["Couched amidst a bed of shrubbery is an old stone and mortar well.  A rusted winch assures that the bucket that last descended down into the construction's depths remains a permanent resident.  Grasses grow up to spill down in streams around it, gathering in a thick crescent.  A small pool of water is cupped by the lush growth that collects at the foot of the well, the gossiping grounds of housewives long since gone."],"exits":[{"to":306,"exit":"east","move":"east"},{"to":308,"exit":"west","move":"west"},{"to":439,"exit":"go","move":"go silent glade"}]},
  {"id":311,"x":400,"y":2350,"z":0,"title":"Northeast Wilds, Fields","descriptions":["Weathered beams of wood poke up through the grass like children peering cautiously around for signs of a malevolent bully.  Bits of cloth and paper still cling to the greyed and splintered wood, remnants of a happier time now long gone."],"exits":[{"to":299,"exit":"east","move":"east"},{"to":309,"exit":"northwest","move":"northwest"}]},
  {"id":312,"x":280,"y":2430,"z":0,"title":"Northern Trade Road, Farmlands","descriptions":["Rich farmland surrounds the road on both sides.  The fresh scent of the tilled soil rises all about you.  Southward, the walls of a fair-sized city rise near the banks of a glistening river.  A faint haze of smoke hovers over the town, blurring the outlines slightly.  To the north, distant hills rear up against the grey-blue horizon."],"exits":[{"to":313,"exit":"north","move":"north"},{"to":268,"exit":"south","move":"south"}],"color":"#C2B280","aliases":["RTZ01","RT-XNE-K"]},
  {"id":313,"x":280,"y":2410,"z":0,"title":"Northern Trade Road, Farmlands","descriptions":["The scent of freshly-tilled earth rises from the farms on both sides of the road.  Heavily-loaded wagons and carts brimming with produce wend their way southward towards the walls of a city set near a glimmering river.  You note an amazing variety of races and types that are driving their goods into the town."],"exits":[{"to":314,"exit":"north","move":"north"},{"to":312,"exit":"south","move":"south"},{"to":794,"exit":"go","move":"go freshly-planted pathway"}]},
  {"id":314,"x":280,"y":2390,"z":0,"title":"Northern Trade Road, Farmlands","descriptions":["Neatly planted rows of grain mingle with tidy plots of vegetables covering the rich earth of well-tended farms along the wide road as it wanders across the land.  A farmer waves at you as he toils along behind a yoke of sturdy oxen that pull a heavy iron plow through the fertile soil.","Empty fields lie sleeping beneath the blanket of night.  The scent of plowed earth mingles with the fragrance of fresh growing things."],"exits":[{"to":315,"exit":"northeast","move":"northeast"},{"to":313,"exit":"south","move":"south"},{"to":350,"exit":"go","move":"go winding trail"}]},
  {"id":315,"x":300,"y":2370,"z":0,"title":"Northern Trade Road, Farmlands","descriptions":["Open grassland mingles with small farmsteads as the wide road passes through a cut where a low hill rises.  The road is edged with tall hedges, apparently to keep cattle from wandering into the orchards and vegetable plots you see beyond the heavy, guarding branches.  Some distance to the south, you see the smoke and haze of a city of some size.  Northwards, low hills rise against the sky."],"exits":[{"to":316,"exit":"northeast","move":"northeast"},{"to":314,"exit":"southwest","move":"southwest"}],"color":"#C2B280","aliases":["RTZ03","RT-XNE-D"]},
  {"id":316,"x":320,"y":2350,"z":0,"title":"Northern Trade Road, Grasslands","descriptions":["Cattle wander aimlessly across the road as they crop at the rich grass growing in the rolling fields.  You spy a lone cow-herd nodding under a shade tree off to one side as his charges amble into your path in large numbers, enormous brown eyes gazing soulfully at you as they pass.","Dark shapes of cattle stand, outlined against the night sky, as they huddle together in sleep.  Somewhere nearby you hear the bark of a dog -- the herd has not been left unguarded."],"exits":[{"to":317,"exit":"north","move":"north"},{"to":315,"exit":"southwest","move":"southwest"},{"to":435,"exit":"go","move":"go thin trail"}]},
  {"id":317,"x":320,"y":2330,"z":0,"title":"Northern Trade Road, Grasslands","descriptions":["Open grassland mingles with a thinning forest from the north.  Here and there among the trees cattle wander.  They casually dine on the lush grass and occasionally reach up to consume the delicate leaves on the lower branches of the trees.  To the north, low hills rise up gently from the plains.  Southward, a heavy haze or smoke can be made out.","Open fields to either side can be dimly seen.  Faintly, there comes a trace of woodsmoke, perhaps from the campfires of local herdsmen warming themselves against the night chill.  Nearby, a rounded shape proves to be that of a sleeping cow."],"exits":[{"to":316,"exit":"south","move":"south"},{"to":318,"exit":"northwest","move":"northwest"},{"to":436,"exit":"go","move":"go wooded trail"}]},
  {"id":318,"x":300,"y":2310,"z":0,"title":"Northern Trade Road, Open Forest","descriptions":["Trees to both sides of the road thin out southward where the land changes to open grassland.  Large grey squirrels leap across the road overhead from branch to branch and chitter down at you as they regard you with curious eyes.","Trees rise dimly along the roadway and you can faintly hear a quiet chittering, perhaps from sleepy squirrels annoyed at your disturbing their rest."],"exits":[{"to":317,"exit":"southeast","move":"southeast"},{"to":347,"exit":"west","move":"west"},{"to":319,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":319,"x":280,"y":2290,"z":0,"title":"Northern Trade Road, Open Forest","descriptions":["Trees grow tall here, but they are scattered enough to allow sunlight and a good view of the sky.  Northwards, the land rises into low hills that disappear against the black sky of the night.  To the south, a gentle plain opens outward.  A soft breeze rustles the leaves in the boughs overhead in a pleasant susurration.","Trees grow tall here, but they are scattered enough to allow moonlight and a good view of the sky.  Northwards, the land rises into low hills that disappear against the black sky of the night.  To the south, a gentle plain opens outward.  A soft breeze rustles the leaves in the boughs overhead in a pleasant susurration."],"exits":[{"to":320,"exit":"north","move":"north"},{"to":318,"exit":"southeast","move":"southeast"}],"color":"#008000"},
  {"id":320,"x":280,"y":2270,"z":0,"title":"Northern Trade Road, Open Woods","descriptions":["Widely scattered trees stand aloof, like strangers at a party, barely noticing one another's presence.  Northwards, the open land nearby changes into a few low, rolling hills.  Like a bare head rising above thinning hair, the hills stand out from a fringe of trees about their base."],"exits":[{"to":321,"exit":"north","move":"north"},{"to":319,"exit":"south","move":"south"}]},
  {"id":321,"x":280,"y":2250,"z":0,"title":"Northern Trade Road, Rolling Hills","descriptions":["The road winds among low, rounded hills barely deserving of the name.  Clumps of trees around the base of the hills thin out rapidly as bare rock rises out of the good earth.  The ragged summits are worn and weathered with age."],"exits":[{"to":322,"exit":"northeast","move":"northeast"},{"to":320,"exit":"south","move":"south"}]},
  {"id":322,"x":300,"y":2230,"z":0,"title":"Northern Trade Road, Rolling Hills","descriptions":["The road crests the highest of the low hills, wandering among the cracked and worn rocks scattered across it.  Removed from the road and set gently upon a hill, like a princess on her ivory pedestal, stands a rough circle of tall stones arranged in two concentric rings.  Rising unsteadily from the crown of the hill, many of the stones lean against one another or are completely toppled.  Perhaps a place of worship in ancient times, not even legend recalls who came here or what gods they served."],"exits":[{"to":321,"exit":"southwest","move":"southwest"},{"to":323,"exit":"northwest","move":"northwest"}]},
  {"id":323,"x":280,"y":2210,"z":0,"title":"Northern Trade Road, Rolling Hills","descriptions":["Winding north and south over the brow of a low hill, the road is partly blocked by several roughly shaped stones that appear to have tumbled down from the hill crest above.  Small curls of a deep green vine have begun to wind the fallen stones into their embrace, and the tiny white flowers scattered among the leaves brighten the dull blue-grey of the stone."],"exits":[{"to":324,"exit":"north","move":"north"},{"to":322,"exit":"southeast","move":"southeast"}]},
  {"id":324,"x":280,"y":2170,"z":0,"title":"Northern Trade Road, Rolling Hills","descriptions":["A series of low hills, barely worthy of note, rise to the south while northwards, wide open grasslands run unhindered into the distance.  Far off to the north, at the edge of the horizon, the faint shape of distant mountains can just be made out."],"exits":[{"to":325,"exit":"north","move":"north"},{"to":323,"exit":"south","move":"south"}]},
  {"id":325,"x":280,"y":2130,"z":0,"title":"Northern Trade Road, Rolling Hills","descriptions":["Low hills to the south rise up from marshy land to the north.  Clouds of insects and tiny birds feeding upon them dart here and there.  The whine of millions of quivering wings combines with the thin rustle of the darting birds to form an annoying, discordant noise."],"exits":[{"to":344,"exit":"east","move":"east"},{"to":324,"exit":"south","move":"south"},{"to":326,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":326,"x":260,"y":2110,"z":0,"title":"Northern Trade Road, Marshy Meadows","descriptions":["The ground underfoot squishes with each movement, and moisture oozes into the traces left.  Low rocks set in ragged rows appear to mark a path along the swampy ground.  Gnats and midges clog your nostrils and fly into your eyes and ears in an endless cloud.  The air is thick with rotting vegetable matter and less identifiable odors."],"exits":[{"to":325,"exit":"southeast","move":"southeast"},{"to":327,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":327,"x":240,"y":2090,"z":0,"title":"Northern Trade Road, Marshy Meadows","descriptions":["You travel in the midst of a boggy meadow.  The air is thick with a chill mist that blurs the outlines of anything not close by.  Pale rocks set along the path show the safest way to go among the almost trackless wastes."],"exits":[{"to":328,"exit":"north","move":"north"},{"to":326,"exit":"southeast","move":"southeast"}],"color":"#008000"},
  {"id":328,"x":240,"y":2070,"z":0,"title":"Northern Trade Road, Marshy Meadows","descriptions":["The ground beneath you is boggy and soft.  Swarms of flies close about you, and some land to drill into your flesh for a morsel of blood and to leave a stinging welt as a souvenir of your visit to their lands.  Northwards, the ground rises from the bog into open lands, while southward a mist obscures the view."],"exits":[{"to":329,"exit":"north","move":"north"},{"to":327,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":329,"x":240,"y":2050,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["Southward, the road dips into a boggy lowland, while to the north, open grasslands stretch.  No sign of habitation breaks the rippling waves of grass that grow shoulder-high to a tall Elf.  The air is alternately fresh with the smell of growing things and thick with the stench of the bog, as the wind veers aimlessly across the open land."],"exits":[{"to":330,"exit":"north","move":"north"},{"to":328,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":330,"x":240,"y":2030,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["Thick grass grows up to the edge of the road.  Despite the isolation and empty land, the road itself is in surprisingly good shape.  Large paving stones rest on a level bed, each one tightly fitted to its neighbor so that nary a weed or seedling can force a way between them.  Perhaps some vanished town lay near here that knew the value of good roads."],"exits":[{"to":331,"exit":"northeast","move":"northeast"},{"to":329,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":331,"x":260,"y":2010,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["The road runs straight as an arrow through the endless sea of tall grasses.  An occasional ripple among the stalks moving counter the wind shows there is life hidden beneath the green and gold surface.  The desperate flight of a covey of birds, as they break cover and scatter, shows that peace here is a shallow illusion.  For always the hunter awaits the careless and the weak."],"exits":[{"to":332,"exit":"northeast","move":"northeast"},{"to":330,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":332,"x":280,"y":1990,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["A ruined building sits alongside the tidy stone road.  The remains perhaps of an ancient tollhouse or inn, it lies at the edge of a forest that rises up from a wide swathe of grassland."],"exits":[{"to":333,"exit":"northeast","move":"northeast"},{"to":331,"exit":"southwest","move":"southwest"},{"to":438,"exit":"go","move":"go ruined building"}],"color":"#008000"},
  {"id":333,"x":300,"y":1970,"z":0,"title":"Northern Trade Road, Forest","descriptions":["The trees grow about you in abundance, their tops brushing the sky, their leaves shimmering with the breeze.  The chirping of birds flows on the wind and there seems to be an almost sentient life to the wood, as if someone or something smiles beneficently on all the denizens and events that occur within the forest's boundaries.","The trees grow in abundance about you, their tops brushing the dark sky above, their leaves flittering against each other in the night breeze.  The soft sound of wings alerts you to the presence of a night hunter, and the broken-off cry that follows tells you that the hunter's prey has been found once more."],"exits":[{"to":334,"exit":"east","move":"east"},{"to":332,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":334,"x":320,"y":1970,"z":0,"title":"Northern Trade Road, Forest","descriptions":["Low-lying taffelberry bushes grow about the tall deobar trees of the forest.  The scent of loam hangs thick and sweet in an almost tangible cloud.  The floor is carpeted with fallen leaves in the process of returning to the elements from whence they came, and some of the trees show evidence of having had their branches chopped off."],"exits":[{"to":335,"exit":"east","move":"east"},{"to":333,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":335,"x":340,"y":1970,"z":0,"title":"Northern Trade Road, Deep Forest","descriptions":["The trees cluster close, weaving a dark green canopy through which light slants cautiously, making tiny pools that flaunt dancing motes of dust.  The air is heavy and still, thick with silence without even a birdsong to break the enclosing stillness.","The trees cluster close, weaving a dark green canopy through which no real light penetrates.  The eerie echoing cry of an owl as it hunts for prey threads through the latticework of the trees, shattering the deceptive peace of the forest."],"exits":[{"to":336,"exit":"east","move":"east"},{"to":334,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":336,"x":360,"y":1970,"z":0,"title":"Northern Trade Road, Deep Forest","descriptions":["This is the heart of the wood, where the trees are the thickest and the outside world of skies and unforested land is the farthest away.  The trees grow close to each other, their leaves whispering back and forth, their crowns bowed in quiet conversation.  The silence is broken only by the sounds of a squirrel or similar creature's movements and the rush of a river coming from somewhere in the distance."],"exits":[{"to":337,"exit":"north","move":"north"},{"to":335,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":337,"x":360,"y":1950,"z":0,"title":"Northern Trade Road, Deep Forest","descriptions":["Deobar trees tower over you, their leaves rustling in time with the sounds of the river to the north.  Quiet and serene, this part of the forest has a rich scent to it, the overlapping canopy making pools of gloom that collect beneath the trees."],"exits":[{"to":338,"exit":"north","move":"north"},{"to":336,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":338,"x":360,"y":1930,"z":0,"title":"Northern Trade Road, Meadowlands","descriptions":["The forest to the south is thick and dark, a stark comparison to the open meadow around you.  Short, springy grass grows in soft mounds over hillocks and hollows.  Tiny white wildflowers peek out amongst the greenery, their petals open to accept the sunlight.","The forest to the south is thick and dark, a stark comparison to the open meadow around you.  Short, springy grass grows in soft mounds over hillocks and hollows.  Pale jes-roses dot the greenery, their sweet, nightblooming fragrance creating a heady perfume."],"exits":[{"to":339,"exit":"north","move":"north"},{"to":337,"exit":"south","move":"south"}],"color":"#008000","aliases":["RTZ07","RT-K-HF"]},
  {"id":339,"x":360,"y":1910,"z":0,"title":"Northern Trade Road, Meadowlands","descriptions":["The land here is open and welcome, the grass thinning on the western horizon as it makes way for a farmstead.  Nearby you can hear the babble of a river, and the vegetation shows signs that something, probably cattle, has been here recently to grab a quick snack.  The air is clean and sweet, inviting you to take deeper breaths."],"exits":[{"to":340,"exit":"north","move":"north"},{"to":338,"exit":"south","move":"south"}]},
  {"id":340,"x":360,"y":1890,"z":0,"title":"Northern Trade Road, Farmstead","descriptions":["Vast, empty fields lie fallow about you.  The remains of an abandoned farmhouse dominates your view to the northeast, its doorways gaping, its windows wide open like empty eye sockets.  Nearby, a plow lies rusting, its blade sunk a good two feet into dirt whose only future crop will be grass.  To the south the land is gradually returning to the meadow it originally was, the edge of creeping green vivid against the bare brown of exposed earth."],"exits":[{"to":341,"exit":"north","move":"north"},{"to":339,"exit":"south","move":"south"}]},
  {"id":341,"x":360,"y":1870,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["The darker colors of the serrated wirgars grasses that grow in this particular part of the plains stand out against their lighter cousins.  You catch the scent of sirese on the wind, the fragrance of the tiny wildflower wrapping around you.  To the south the land turns a rough brown, shifting abruptly from plains to farming land."],"exits":[{"to":342,"exit":"north","move":"north"},{"to":340,"exit":"south","move":"south"}],"color":"#C2B280","aliases":["Sirese","RTZ06","RT-K-XNE"]},
  {"id":342,"x":360,"y":1850,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["Blue sky and sweet winds mingle with vibrant greens and yellows to create a place that seems blessed by Hodierna herself.  Restless clouds chase each other through the sky, and the blithely cheerful songs of birds create a natural, if chaotic, symphony to be enjoyed by all.","The sky overhead creates an inky canvas upon which stars have been liberally splattered.  An evening wind, fragrant with the scent of night-blooming flowers, ruffles your clothing and cools the air.  Somewhere, a nightingale sings, whistling for its lover. "],"exits":[{"to":343,"exit":"northeast","move":"northeast"},{"to":341,"exit":"south","move":"south"}]},
  {"id":343,"x":380,"y":1830,"z":0,"title":"Northern Trade Road, Kaerna Village Outskirts","descriptions":["The grasslands shimmer slightly, the gentle hand of the wind running its fingers through the plant life.  Here and there colorful wildflowers dare to peep their heads up through the endless browns and greens of the plains.  Dominating the gentle sighing of the grass can be heard the bustling sounds of the tiny village of Kaerna, surrounded by a wooden town wall which masks the village's graceless sprawl against the northern horizon."],"exits":[{"to":342,"exit":"southwest","move":"southwest"},{"to":351,"exit":"go","move":"go town gate"}]},
  {"id":344,"x":300,"y":2130,"z":0,"title":"Hilltop, Road","descriptions":["A peaceful valley, sheltered by the surrounding hills, is laid out before you like a patchwork quilt of flowery meadows and neatly arranged farmland.  Centered in this multicolored vista is a small village.  You pause on the hilltop to enjoy this delightful view.  A meadowlark circles overhead for a moment, warbling its song to you, before swooping down toward the village, following the line of a well-traveled road.","The moonlight reveals a small valley stretched out between the surrounding hills.  You can see a multitude of tiny lamplights twinkling in the darkness below, and faroff sounds of laughter and singing hover in the sweet evening air.  The faint outline of a road descends down into the night-cloaked valley."],"exits":[{"to":325,"exit":"west","move":"west"},{"to":345,"exit":"down","move":"down"}],"aliases":["cornmaze"]},
  {"id":345,"x":320,"y":2130,"z":0,"title":"Hillside, Road","descriptions":["A gentle breeze, carrying the sweet earthy scent of fresh herbs and flowers, rustles through the grass in the valley below you, making it flow like waves on an ocean.  A well-traveled road winds like a ribbon from a small village up to the top of the hill."],"exits":[{"to":344,"exit":"up","move":"up"},{"to":346,"exit":"down","move":"down"}]},
  {"id":346,"x":420,"y":2130,"z":0,"title":"Valley, Village Gate","descriptions":["A large gate stands here, usually open to welcome travelers -- but wisely capable of closing to defend the residents within.  Traders, adventurers and farmers from the surrounding valley mingle here, moving in or out of the village at a leisurely pace, many of them Halflings.  A wooden wagon, carrying racks of freshly-baked meat pies, trundles into the gates, followed by several yapping dogs.  A neatly painted wooden sign is displayed in a prominent place."],"exits":[{"to":345,"exit":"up","move":"up"},{"to":514,"exit":"go","move":"go village gate"},{"to":515,"exit":"go","move":"go winding road"}],"aliases":["Death Squirrels"]},
  {"id":347,"x":220,"y":2310,"z":0,"title":"Northwall Trail, Open Forest","descriptions":["Growing in the shade of towering oak and fir trees, azalea bushes add bright splashes of color to the brown-green gloom of the forest.  Tangles of ivy creep alongside the trail and cloak the trees in jade filigree.","The darkness of night grips the forest tightly, like a black-gloved fist holding back the light of dawn.  The staccato questions of owls echo from the boughs far above, while lower to the ground the cries of unseen creatures ring through the trees."],"exits":[{"to":318,"exit":"east","move":"east"},{"to":0,"exit":"southwest","move":"southwest"}],"aliases":["N Gate","Brambles"],"linksTo":"Map6_Crossing_North_Gate.xml"},
  {"id":348,"x":280,"y":2490,"z":0,"title":"Outside East Wall, Footpath","descriptions":["Under the shadow of eastern section of The Crossing's stone town wall, this footpath serves as a shortcut.  Barely wide enough for one person, thick brambles and brush allow passage in single file.   A few crevices in the wall make adequate handholds as you squeeze your way along the uneven ground and past thorny branches."],"exits":[{"to":268,"exit":"north","move":"north"},{"to":0,"exit":"south","move":"south"}],"aliases":["E Gate"],"linksTo":"Map8_Crossing_East_Gate.xml"},
  {"id":349,"x":240,"y":2450,"z":0,"title":"The Crossing, Northeast Customs","descriptions":["Here stands the Northeast Gate, two massive doors of steel-banded ironwood securely attached to the masonry of the town walls.  The traffic here is thick with travelers, and the Customs Officers are alert to any sign of trouble."],"exits":[{"to":0,"exit":"west","move":"west"},{"to":268,"exit":"go","move":"go gate"}],"aliases":["Crossing"],"linksTo":"Map1_Crossing.xml"},
  {"id":350,"x":240,"y":2390,"z":0,"title":"Northeast Vineyard, Farmhouse","descriptions":["Nestled at the base of a terraced hillside, a small stone farmhouse seems caught in a struggle with the tendrils of ivy which seek to pull it down.  Though the farmhouse survives, the outcome of the battle is really not in doubt.  The ivy has already pulled over half the chimney, now a pile of rust-colored bricks lying in an untidy heap on the west side of the house.  To the north, a path leads to a small building behind the house, while a trail to the south leads back into the forest."],"exits":[{"to":0,"exit":"north","move":"north"},{"to":314,"exit":"go","move":"go trail"}],"aliases":["Vineyard"],"linksTo":"Map7a_Vineyard.xml"},
  {"id":351,"x":400,"y":1810,"z":0,"title":"Kaerna Village, By the Well","descriptions":["The Northern Trade road runs like an arrow through the small town of Kaerna.  Composed mostly of ramshackle daub and wattle houses, the most distinguishing feature of Kaerna is its inn, which looms protectively over the other, smaller establishments.  Less a town and more a waystation than anything else, the tiny wooden-walled village hugs the road with a tenacious determination."],"exits":[{"to":352,"exit":"north","move":"north"},{"to":343,"exit":"go","move":"go town gate"},{"to":480,"exit":"go","move":"go town well"}]},
  {"id":352,"x":400,"y":1790,"z":0,"title":"Kaerna Village, Intersection","descriptions":["Even in the cool of the night the village remains active.  A soft, cheery glow shines from the windows and open doorway of the Gilded Unicorn Inn, and a few traders are yet about checking their camels, inspecting their wagons, or preparing for the morning's excursions to come.  The stars overhead seem to stretch on forever, the moons smiling benevolently down on the sleeping village.","The main activity of the town seems to be concentrated here where traders, villagers, and travellers from afar gather to exchange information or engage in a bit of bartering.  Presiding over all of this is the Gilded Unicorn Inn, the largest building in the village as well as the best kept.  Far from the bustle and turmoil of the big city, its doors are always open, a lantern or candle always lit."],"exits":[{"to":386,"exit":"northeast","move":"northeast"},{"to":351,"exit":"south","move":"south"},{"to":353,"exit":"west","move":"west"},{"to":506,"exit":"go","move":"go gilded inn"}],"aliases":["Kaerna Village"]},
  {"id":353,"x":380,"y":1790,"z":0,"title":"Journalai Route, Kaerna Outskirts","descriptions":["The grasslands lap like waves at the edge of Kaerna Village to the east.  The small, dun-colored houses of the town endure silently, islands in a sea of green.  To the west the land begins to take on a more rolling form, an abrupt and unusual change from the endless plains that stretch to the north and south."],"exits":[{"to":352,"exit":"east","move":"east"},{"to":400,"exit":"west","move":"west"}],"color":"#FF00FF"},
  {"id":354,"x":460,"y":1750,"z":0,"title":"Northern Trade Road, Kaerna Outskirts","descriptions":["The wooden wall surrounding the tiny waystop of Kaerna is a visible line drawn between the plains and hamlet.  Thick grasses and shrubs growing against the protective barrier seem intent upon reclaiming the village's side-by-side buildings for the prairie.  Off to one side stands an abandoned militia shack, a silent casualty to the ongoing war between civilization and nature."],"exits":[{"to":355,"exit":"northwest","move":"northwest"},{"to":386,"exit":"go","move":"go town gate"},{"to":388,"exit":"go","move":"go militia shack"}],"color":"#C2B280","aliases":["RTZ08","RT-K-D"]},
  {"id":355,"x":420,"y":1730,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["The wind rushes through the grass, making a soft shirring sound.  Occasionally you catch the crackle of movement or the twitterings of birds, but any sounds of civilization generated by something other than yourself seem like the sort of thing you would think up in a dream."],"exits":[{"to":354,"exit":"southeast","move":"southeast"},{"to":356,"exit":"northwest","move":"northwest"}]},
  {"id":356,"x":400,"y":1710,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["Miles upon miles of uncivilized land lie before you, devoid of any sign of humanity.  A shifting sea of brown, green, and tan grasses rises about you, rustling with the movement of the occasional bird or butterfly that dares to plunge down into the vegetation.  A line of dark mountains rises to the north, shadowed and gloomy, they climb abruptly from the grasslands."],"exits":[{"to":357,"exit":"north","move":"north"},{"to":355,"exit":"southeast","move":"southeast"}],"color":"#C2B280","aliases":["RTZ09","RT-K-KC"]},
  {"id":357,"x":400,"y":1690,"z":0,"title":"Northern Trade Road, Foothills","descriptions":["The road rises along the curve of a low hill that slopes down to the south into open grasslands.  The rocky crest of the hill rises sharply above you as you toil along the well-kept roadway.  Local stones from the hillside have been smoothed and shaped to form the roadbed and the footing is good.  Northwards though, the hills shift quickly into steep mountains."],"exits":[{"to":358,"exit":"east","move":"east"},{"to":356,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":358,"x":420,"y":1690,"z":0,"title":"Northern Trade Road, Foothills","descriptions":["You crest a low hill that gives a far-reaching view.  To the north a line of mountains rises steeply from the surrounding hills, while southward the hills fade out to forest and plain.  Far to the south, a heavy haze obscures the view, but you glimpse the occasional flash of open water."],"exits":[{"to":359,"exit":"east","move":"east"},{"to":357,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":359,"x":460,"y":1690,"z":0,"title":"Northern Trade Road, Foothills","descriptions":["You travel through a small dell that rises northwards into a narrow pass.  You follow the path with your eyes until it fades from view among the steeply rising mountains.  Southward a low hill rises, bearing the roadway along its shoulders.  A Trader's Guild outpost sits alongside the stony trail."],"exits":[{"to":360,"exit":"north","move":"north"},{"to":358,"exit":"west","move":"west"},{"to":395,"exit":"climb","move":"climb stony trail"},{"to":643,"exit":"go","move":"go guild stables"},{"to":644,"exit":"go","move":"go outpost"},{"to":513,"exit":"go","move":"go small cave"}],"color":"#008000"},
  {"id":360,"x":460,"y":1670,"z":0,"title":"Northern Trade Road, Mountain Trail","descriptions":["The roadway is made from cracked stone that seems to have fallen from the steep rocky shoulders of a mountain whose flank forms a boundary along your path.  Rising steeply to the north and falling away to low hills to the south, the road cuts a narrow path among the mountains."],"exits":[{"to":361,"exit":"north","move":"north"},{"to":359,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":361,"x":460,"y":1650,"z":0,"title":"Northern Trade Road, Mountain Trail","descriptions":["You edge along a steep drop as the road narrows sharply in order to work its way along a narrow ridge of rock.  Snow-capped peaks tower overhead and an occasional eagle or hawk can be seen soaring on the high-road of the sky far overhead.  You envy them their direct routes as you gaze over the lip of the road and note the crumbling stone along its rim."],"exits":[{"to":362,"exit":"northeast","move":"northeast"},{"to":360,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":362,"x":480,"y":1630,"z":0,"title":"Northern Trade Road, Mountain Pass","descriptions":["The road passes onto an almost level area as you work your way through a narrow gap in the mountains.  Huge boulders that have tumbled loose from the escarpments above you cause you to keep a wary eye out for more such unwelcome fellow-travellers.  A tiny roadside shrine has been erected here, perhaps by someone who made a lucky escape from such an avalanche of stone."],"exits":[{"to":363,"exit":"north","move":"north"},{"to":361,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":363,"x":480,"y":1610,"z":0,"title":"Northern Trade Road, Mountain Trail","descriptions":["A huge boulder blocks much of the road, but room remains to squeeze by between it and the mountain wall.  One broken and shattered bone shows you that someone or something was far less fortunate in times past.  You look nervously up at the rock-strewn slopes above you and mutter a short prayer that the boulders rest easily these days."],"exits":[{"to":364,"exit":"east","move":"east"},{"to":362,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":364,"x":500,"y":1610,"z":0,"title":"Northern Trade Road, Mountain Trail","descriptions":["The road rises sharply to the west as it wends among the steep mountains.  Eastward, it falls away into a narrow, heavily-wooded valley.  Evidence of frequent landslides shows in the piles of rock and small boulders that make passage here uneven and slightly risky."],"exits":[{"to":365,"exit":"east","move":"east"},{"to":363,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":365,"x":520,"y":1610,"z":0,"title":"Northern Trade Road, Wooded Valley","descriptions":["Thick woods grow heavily along the shoulders of the roadway, blocking both the sky and your sight after a short distance.  You spy several sets of wolf tracks in the heavy leaf mould under some of the trees and you cast a nervous eye about you.  Travelers' tales you've heard rise unbidden to trouble your mind as you pass among the close-set trees.","Thick woods grow heavily along the shoulders of the roadway, blocking both sky and sight after a short distance.  Several sets of wolf tracks are evident in the heavy leaf mould under some of the trees.  Troublesome travelers' tales describing the forest's dangers come to mind as the journey continues through the close-set trees."],"exits":[{"to":366,"exit":"northeast","move":"northeast"},{"to":364,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":366,"x":540,"y":1590,"z":0,"title":"Northern Trade Road, Wooded Valley","descriptions":["You come upon a small clearing in the heavy woods that allows a view of the sky.  A faint path can be made out that wanders into the trees, but it fades off before you can wonder about where it might lead.  There is an unnerving quiet here, even the wind seems to have died.  You feel a stranger in this wild place, perhaps an unwelcome stranger."],"exits":[{"to":367,"exit":"northeast","move":"northeast"},{"to":365,"exit":"southwest","move":"southwest"},{"to":394,"exit":"go","move":"go faint path"}],"color":"#008000"},
  {"id":367,"x":560,"y":1570,"z":0,"title":"Northern Trade Road, Wooded Valley","descriptions":["Tall trees grow close along both sides of the road.  Small animals skitter among the branches overhead and dart among low-growing shrubs that eke out an existence in the deep shade of the forest.  Something taller than you has clawed the bark off a tree trunk several feet overhead and you wonder just where the beast that wore such claws is currently."],"exits":[{"to":366,"exit":"southwest","move":"southwest"},{"to":368,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":368,"x":540,"y":1550,"z":0,"title":"Northern Trade Road, Foothills","descriptions":["Tall trees grow thickly to the south as the road climbs into a narrow valley.  Northwards, the land opens out into rolling hills that fade off into the looming shadow of several sharp mountain peaks, each distinct from the other."],"exits":[{"to":369,"exit":"north","move":"north"},{"to":367,"exit":"southeast","move":"southeast"}],"color":"#008000"},
  {"id":369,"x":540,"y":1530,"z":0,"title":"Northern Trade Road, Foothills","descriptions":["Heavily wooded hills rise on both sides as the roadway winds among them.  The air is dead and stale, any breeze is blocked by the trees and hills.  Clouds of gnats and worse seem to follow you, getting in your mouth and hair.  There is a faint smell of damp earth and rotting vegetation."],"exits":[{"to":370,"exit":"north","move":"north"},{"to":368,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":370,"x":540,"y":1510,"z":0,"title":"Northern Trade Road, Rolling Hills","descriptions":["Massive flocks of small black birds wheel and dive among the low hills on either side.  They seem to be feeding on the dense swarms of midges and other insects that lurk in the heavy air.  A miasma of musty smells and unknown odors roils in your nostrils.  The ground to the north descends into a faint mist or cloud in the air."],"exits":[{"to":642,"exit":"north","move":"north"},{"to":369,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":371,"x":540,"y":1470,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["Eroded wagon ruts cause you to notice that this road was once travelled with a greater frequency than it is now.  While safe from becoming overgrown by the dying grasses of the plains, this part of the trail is crumbling from disuse and the encroaching dust."],"exits":[{"to":372,"exit":"north","move":"north"},{"to":642,"exit":"south","move":"south"}]},
  {"id":372,"x":540,"y":1450,"z":0,"title":"Northern Trade Road, Open Grasslands","descriptions":["The winds veer around you, catching the grasses and your clothing in their grip and tugging like beggars vying for attention.   Flowers, closed for the evening, bob along in time with the lonely music the breezes create with the plains.  You can hear the babble of rushing water coming from the north.","The winds veer around you, catching the grasses and your clothing in their grip and tugging like beggars vying for attention.  Flowers nod in the breeze like dancers moving to an unheard rhythm, their brightly colored heads catching your eye.  You can hear the sound of rushing water coming from the north."],"exits":[{"to":373,"exit":"north","move":"north"},{"to":371,"exit":"south","move":"south"}]},
  {"id":373,"x":540,"y":1430,"z":0,"title":"Northern Trade Road, River's Bank","descriptions":["A narrow river rushes past you on its way southwest, its turbulent gray waters creating a deafening roar.  To the north the land changes dramatically from plains to the darker, more verdant green of meadows.  To the south stretches a narrow strip of grassland.  A sturdy wood and stone bridge spans the river, allowing safe passage.","A narrow river rushes past you on its way southwest, its turbulent grey waters creating a deafening roar.  To the north the land changes dramatically from plains to the darker, more verdant green of meadows.  To the south stretches a narrow strip of grassland.  A sturdy wood and stone bridge spans the river, allowing safe passage."],"exits":[{"to":374,"exit":"east","move":"east"},{"to":372,"exit":"south","move":"south"},{"to":376,"exit":"go","move":"go wood bridge"},{"to":479,"exit":"go","move":"search go concealed path"}]},
  {"id":374,"x":560,"y":1430,"z":0,"title":"Stream Bank","descriptions":["Smooth rounded pebbles, bleached by the sun to a pearly white, line the rocky bed of a sparkling stream.  Not much wider than a strong leap could carry you, the brook flows gently over clean stones, occassionally parting for a large rock thrust from its center.  Green clumps of reeds prospering along the grassy bank offer a safe haven to the shy water creatures which make their home here."],"exits":[{"to":375,"exit":"southeast","move":"southeast"},{"to":373,"exit":"west","move":"west"}]},
  {"id":375,"x":580,"y":1450,"z":0,"title":"Silvery Pool, Waterfall","descriptions":["Cool tendrils of water slip down the rough surface of the mammoth stone outcropping, cascading to the rock's base with a sibilant whisper.  Water dances and leaps jubilantly beneath the waterfall, before rippling away in great waves, to finally die away and lie still at the pool's farthest reaches.  Along the banks, tall vilt reeds provide privacy for modest swimmers."],"exits":[{"to":374,"exit":"northwest","move":"northwest"},{"to":398,"exit":"go","move":"go silvery pool"}]},
  {"id":376,"x":540,"y":1410,"z":0,"title":"Northern Trade Road, On the Bridge","descriptions":["The deafening roar of the Journalai River below you drowns out all other sound as you make your way across the bridge.  Droplets of water hit your face, and every now and then the flash of silver scales in the water catches your eye."],"exits":[{"to":377,"exit":"north","move":"north"},{"to":373,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":377,"x":540,"y":1390,"z":0,"title":"Northern Trade Road, Meadowlands","descriptions":["The grass is a thick, dark green carpet that spreads over the land in rolling abundance.  A few holes, large enough to admit a small animal, mar the landscape, creating openings that lead down into the dark home of burrowing creatures.  A river runs to the south, over which spans a sturdy wood and stone bridge."],"exits":[{"to":378,"exit":"north","move":"north"},{"to":376,"exit":"go","move":"go wood bridge"}],"color":"#008000"},
  {"id":378,"x":540,"y":1370,"z":0,"title":"Northern Trade Road, Meadowlands","descriptions":["The tips and edges of the grass are slightly yellowed, and you get the vague feeling that there should be more flowers here.  To the south the meadows gradually shift into the lush emerald they should be, and to the north you see the beginning of a treeline."],"exits":[{"to":379,"exit":"northeast","move":"northeast"},{"to":377,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":379,"x":560,"y":1350,"z":0,"title":"Northern Trade Road, Open Forest","descriptions":["The land has suffered from something malignant judging by the yellowish tinge to the grass and leaves of the trees.  Even the resilient deobar are having trouble in these conditions, and most of the trees are stunted, a sickly hue creeping through their bark.  The only thing that appears to be thriving is a grey-green woodmoss that covers the trees in abundance."],"exits":[{"to":380,"exit":"north","move":"north"},{"to":378,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":380,"x":560,"y":1330,"z":0,"title":"Northern Trade Road, Deep Forest","descriptions":["Chalky green woodmoss drapes from the trees of the forest, falling in tiers that bring to mind waterfalls or a crone's hair.  There is a disturbing lack of birds and animals about."],"exits":[{"to":379,"exit":"south","move":"south"},{"to":381,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":381,"x":540,"y":1310,"z":0,"title":"Northern Trade Road, Deep Forest","descriptions":["The trees grow close together, as if in fear of something.  The trail is free of debris and a tree, fallen across the road, has been carved through that the trail might continue despite the obstruction."],"exits":[{"to":380,"exit":"southeast","move":"southeast"},{"to":382,"exit":"northwest","move":"northwest"},{"to":799,"exit":"go","move":"go narrow trail"}],"color":"#008000"},
  {"id":382,"x":520,"y":1290,"z":0,"title":"Northern Trade Road, Forest Clearing","descriptions":["Jagged-edged grass grows thick about you, brushing and clinging to clothing and skin.  A fire ring has been built by the side of the road, evidence that someone felt the flat ground and relative safety of this area would make it the perfect place to stop and rest."],"exits":[{"to":383,"exit":"north","move":"north"},{"to":381,"exit":"southeast","move":"southeast"}],"color":"#008000"},
  {"id":383,"x":520,"y":1270,"z":0,"title":"Northern Trade Road, Forest Clearing","descriptions":["The grass is flourishing here despite the apparent blight of the rest of the wood.  Facing east beside the road is a squat stone monolith with an indentation in its top.  Some carvings adorn its polished gray surface, and an odd rust-colored residue stains it."],"exits":[{"to":384,"exit":"north","move":"north"},{"to":382,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":384,"x":520,"y":1250,"z":0,"title":"Northern Trade Road, Deep Forest","descriptions":["The trees rise about you like looming tombstones in a graveyard, each one draped in shawls of sickly gray lichen.  The air is thick with a pressing sense of gloom, and you get the distinct impression that you are being watched."],"exits":[{"to":385,"exit":"northeast","move":"northeast"},{"to":383,"exit":"south","move":"south"},{"to":437,"exit":"go","move":"go dense copse"}],"color":"#008000"},
  {"id":385,"x":540,"y":1230,"z":0,"title":"Northern Trade Road, Deep Forest","descriptions":["Heavy, still air hangs in pockets about you, weighing down sound and movement.  Silent in their misery, the trees hunch over each other, their boughs and trunks hidden by clinging moss.  They pull the sickly-colored stuff about them the way a Human child hides under a security blanket."],"exits":[{"to":146,"exit":"northeast","move":"northeast"},{"to":384,"exit":"southwest","move":"southwest"},{"to":399,"exit":"go","move":"go forest path"}],"color":"#008000","aliases":["Faenrae Reavers","Reavers","Wind Hounds"]},
  {"id":386,"x":420,"y":1770,"z":0,"title":"Kaerna Village, By the General Store","descriptions":["A few residences huddle here, alternately shouldered up against the back of the Gilded Unicorn Inn and the sides of the general store.  The store is squat but neat, its exterior newly whitewashed and a small garden carefully cultivated outside it."],"exits":[{"to":352,"exit":"southwest","move":"southwest"},{"to":354,"exit":"go","move":"go town gate"},{"to":387,"exit":"go","move":"go general store"}]},
  {"id":387,"x":420,"y":1760,"z":0,"title":"Grek's Food and Supplies","descriptions":["This store is larger on the inside than it seems from the outside, its wares proudly displayed on the walls or stacked neatly in corners.  Seated behind the counter on a specially-made stool is the proprietor, Grek the Dwarf.  He gives you a wary look as you enter, then seems to relax, the Dwarvish equivalent of a smile on his face."],"exits":[{"to":386,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Grek's Food and Supplies","General"]},
  {"id":388,"x":480,"y":1770,"z":0,"title":"The Militia Shack, Inside","descriptions":["Not much is left of this building except mice and a few ratty blankets.  It seems well and truly abandoned, of no significant notice whatsoever."],"exits":[{"to":354,"exit":"out","move":"out"},{"to":389,"exit":"go","move":"go dark hole"}],"aliases":["Militia Shack"]},
  {"id":389,"x":500,"y":1750,"z":0,"title":"A Dark Tunnel","descriptions":["Were it not for some lanterns that someone has hung from the ceiling of this burrow, you wouldn't be able to see a thing.  The total silence that pervades this underground tunnel isn't helping much, either.  What little you do see of the architecture is expertly made, possibly even Dwarven in construction."],"exits":[{"to":390,"exit":"west","move":"west"},{"to":388,"exit":"go","move":"go dark hole"}]},
  {"id":390,"x":476,"y":1750,"z":0,"title":"A Dark Tunnel","descriptions":["There is a strong light leaking in from a hole above you, and weaker lantern light to the east.  Roots stick out from the wood-braced dirt walls, the glittering minerals in the earth catching what little light there is and reflecting it back."],"exits":[{"to":389,"exit":"east","move":"east"},{"to":391,"exit":"up","move":"rt up"}]},
  {"id":391,"x":476,"y":1730,"z":0,"title":"Near Kaerna Village, A Dirt Path","descriptions":["Here a dirt path leads to a dark grove of trees.  A tree stump, its trunk featuring a sizable hole and the base covered with odd carvings that would appear to be symbols, stands where the trail terminates."],"exits":[{"to":392,"exit":"go","move":"go dirt path"},{"to":390,"exit":"go","move":"rt go tree stump"}]},
  {"id":392,"x":496,"y":1730,"z":0,"title":"Near Kaerna Village, A Dark Grove","descriptions":["Around you grow trees in a circle so even and perfect they warrant suspicion.  In the center of the grove is a deep pool, its surface smooth and glassy, undisturbed by the wind.  Sunlight slants through the leaves and falls in dappled pools of light.  A nest has been built in one of the tallest trees, its occupant a sleeping night owl, its head tucked under its wing.","Around you grow trees in a circle so even and perfect they warrant suspicion.  In the center of the grove is a deep pool, its surface smooth and glassy, undisturbed by the wind.  Peering into it, it takes you a moment to realize that your face is not reflected in the pool and another to realize that neither are the trees.  In fact, the only thing that can be seen are stars -- thousands and thousands of endless stars, some of which you know you have never seen in the sky above you."],"exits":[{"to":391,"exit":"go","move":"go dirt path"},{"to":393,"exit":"go","move":"go still pool"}],"color":"#A6A3D9","aliases":["Shrine1-10","Damaris"]},
  {"id":393,"x":516,"y":1730,"z":0,"title":"A Dark Grove, A Deep Pool","descriptions":["The sand below your feet is soft as silk and as black and absolute as night.  The waters are deathly cold, causing you to shiver.  All is still, and even the ripples your movements cause soon fade back into pure, untouched water.","The sand below your feet is soft as silk and as black as the night about you.  The waters are colder than death, causing you to shake violently.  A deep stillness enfolds the obsidian waters, which seem to close about your body like enveloping folds of the thickest onyx velvet."],"exits":[{"to":392,"exit":"out","move":"out"}]},
  {"id":394,"x":500,"y":1550,"z":0,"title":"Wilderness, Overgrown Path","descriptions":["A faint trail fades to nothing more than a thin break in the undergrowth, but seems to faintly curve east to southwest.  The heavy brush scratches and whips any exposed skin with each step forward.  An occasional rustle from areas unseen is a soft reminder that the solitude of the area is only an illusion.","Though deep, the darkness isn't complete and the chirring sounds of insects fills the air.  Pressing in all around, a thicket of scrub and brush make passage difficult.  What little light there is comes from the east.  All other directions stare back with an opaque blackness as thick as tar."],"exits":[{"to":366,"exit":"go","move":"go faint path"}],"aliases":["Thicket Vipers","Vipers","Black Leucros","Leucros","Rock Guardians","Guardians"],"linksTo":"Map11_Vipers_Rock_Guardians.xml"},
  {"id":395,"x":500,"y":1690,"z":0,"title":"Foothills, Stony Incline","descriptions":["Taking the opportunity to examine the distant countryside, large green forests in the southwest, flatlands to the south and the large ocean expanse to the southeast all catch the eye.  All seem more attractive than the forbidding set of cliffs up ahead."],"exits":[{"to":396,"exit":"up","move":"up"},{"to":359,"exit":"climb","move":"climb stony trail"},{"to":397,"exit":"go","move":"search go overgrown path"}]},
  {"id":396,"x":560,"y":1720,"z":0,"title":"Lairocott Brach, Entrance","descriptions":["Placed in the wall of the sheer cliff that stands before you is a large stone door, currently blasted open.  Two large lifelike sentinels, one on either side of the door, have been scorched black.","Placed in the wall of the sheer cliff is a huge stone door with an arched top.  Two large lifelike sentinels, one on either side of the door, stand at attention in silence."],"exits":[{"to":0,"exit":"west","move":"west"},{"to":395,"exit":"down","move":"down"}],"aliases":["Abandoned Mine","Stone Clan"],"linksTo":"Map10_Abandoned_Mine_Lairocott.xml"},
  {"id":397,"x":540,"y":1690,"z":0,"title":"Foothills, Abandoned Road","descriptions":["The path underfoot is overgrown with weeds and almost completely covered with dried, fallen branches yet still feels surprisingly firm.  A few pine saplings off to one side struggle to push up through the heavy soil."],"exits":[{"to":0,"exit":"northeast","move":"northeast"},{"to":395,"exit":"west","move":"west"}],"aliases":["Sorrow's Reach"],"linksTo":"Map9b_Sorrow's_Reach.xml"},
  {"id":398,"x":600,"y":1470,"z":0,"title":"Silvery Pool","descriptions":["Sunlight sparkles over the pool like a thousand tiny gems among the ripples.  The cool water laps against your skin in a soothing repetitive rhythm, relaxing your muscles and drawing you out of the shallows.  Beneath your feet the pure white sand is smooth and clear of weeds.  A lulling, meditative aura settles over the water.","Cool tendrils of water slip down the rough surface of the mammoth stone outcropping, cascading to the rock's base with a sibilant whisper.  Water dances and leaps jubilantly beneath the waterfall, before rippling away in great waves, to finally die away and lie still at the pool's farthest reaches.  Along the banks, tall vilt reeds provide privacy for modest swimmers.","Moonlight dances over the pool like a thousand stars among the dark ripples.  The cool water laps against your skin in a soothing repetitive rhythm, relaxing your muscles and drawing you out of the shallows.  Beneath your feet the pure white sand is smooth and clear of weeds.  A lulling, meditative aura settles over the water."],"exits":[{"to":375,"exit":"out","move":"out"}],"color":"#A6A3D9","aliases":["Shrine1-11","Eluned","Crystal Cavern","Silvery Pool"]},
  {"id":399,"x":520,"y":1210,"z":0,"title":"Forest Path","descriptions":["The trees seem to hold an aura of fragility about them, as if the burden of the moss that drips from their boughs weighs them down to the point of snapping.  Odd carvings have been hung from the branches of the trees, their stone and wooden visages stirring on the wind and clattering against one another."],"exits":[{"to":385,"exit":"southeast","move":"southeast"},{"to":717,"exit":"west","move":"west"}]},
  {"id":400,"x":360,"y":1790,"z":0,"title":"Journalai Route, Open Grasslands","descriptions":["The grasslands here are caught between the presence of rolling hills to the west and the small village of Kaerna to the east.  To the north and south is nothing but empty plains, wind-twisted and long ignored by humanity."],"exits":[{"to":353,"exit":"east","move":"east"},{"to":401,"exit":"climb","move":"rt climb heavy barricade"}],"color":"#FFBF00","aliases":["Rock Trolls"]},
  {"id":401,"x":340,"y":1790,"z":0,"title":"Journalai Route, Foothills","descriptions":["A set of rolling green hills rise up to the west, gradually flattening out into grasslands to the east.  A barricade blocks off further passage toward the east along the Journalai Route."],"exits":[{"to":441,"exit":"west","move":"west"},{"to":400,"exit":"climb","move":"rt climb heavy barricade"}],"color":"#FFBF00"},
  {"id":402,"x":542,"y":2412,"z":0,"title":"Northeast Wilds, Bramble Thicket","descriptions":["The bramble thicket is not very dense here, and its tangled, matted shrubs seem to shrink back from the north side of the clearing, almost as if shunning it.  Just beyond the clearing rises a massive gate.  Sere vines and dead vermin are scattered about its base, but nothing, not even moss, mars its surface."],"exits":[{"to":403,"exit":"north","move":"north"},{"to":269,"exit":"go","move":"go thin path"}]},
  {"id":403,"x":542,"y":2392,"z":0,"title":"Hilltop Cemetery, Lich Gate","descriptions":["The ground beneath your feet is black and dead, as though it had once been engulfed in a great inferno.  Oddly enough, the Lich Gate before you appears pristine and intact, unscathed by the apparent waste and desolation that surround or perhaps radiate from it."],"exits":[{"to":402,"exit":"south","move":"south"},{"to":404,"exit":"go","move":"go lich gate"}],"aliases":["Lich Gate"]},
  {"id":404,"x":560,"y":2370,"z":0,"title":"Hilltop Cemetery, Inside Fence","descriptions":["A cold breeze blows through the area changing its direction when you turn, as if guided by some unseen force.  Several paths lead off to the north into the trees.  Along the perimeter, a low wrought-iron fence serves as a token boundary for the cemetery."],"exits":[{"to":408,"exit":"north","move":"north"},{"to":407,"exit":"northeast","move":"northeast"},{"to":405,"exit":"northwest","move":"northwest"},{"to":403,"exit":"go","move":"go lich gate"}]},
  {"id":405,"x":540,"y":2350,"z":0,"title":"Hilltop Cemetery, Winding Footpath","descriptions":["The path begins to weave its way through dense trees, snaking around small burial sites that contain several old stone grave markers.  The grounds have been kept clear and the grass is cut low around each tombstone.  Someone must visit this place regularly."],"exits":[{"to":406,"exit":"northeast","move":"northeast"},{"to":408,"exit":"east","move":"east"},{"to":404,"exit":"southeast","move":"southeast"}]},
  {"id":406,"x":560,"y":2330,"z":0,"title":"Hilltop Cemetery, Winding Footpath","descriptions":["Just beyond the iron fence that runs along the path to the southeast, you hear something moving about in the underbrush.  Faint pinpoints of light fade in and out of the trees and you would swear the temperature just dropped.  The outline of a square structure lies to the south, while a faint trail heads northwest through low-hanging trees."],"exits":[{"to":407,"exit":"southeast","move":"southeast"},{"to":408,"exit":"south","move":"south"},{"to":405,"exit":"southwest","move":"southwest"},{"to":409,"exit":"northwest","move":"northwest"},{"to":413,"exit":"go","move":"go crypt"}]},
  {"id":407,"x":580,"y":2350,"z":0,"title":"Hilltop Cemetery, Graves","descriptions":["Each of the graves in this part of the cemetery is marked with a simple wax candle.  Despite the constant breeze, the flames of every candle continue to burn and flicker, lighting the ground with an eerie orange glow."],"exits":[{"to":404,"exit":"southwest","move":"southwest"},{"to":408,"exit":"west","move":"west"},{"to":406,"exit":"northwest","move":"northwest"}],"aliases":["Graves"]},
  {"id":408,"x":560,"y":2350,"z":0,"title":"Hilltop Cemetery, Before Mausoleum","descriptions":["The trees have given way to a mausoleum crafted from white marble.  The entrance is marked by two smooth columns and perched just above, a solemn-looking stone gargoyle surveys the surroundings."],"exits":[{"to":406,"exit":"north","move":"north"},{"to":407,"exit":"east","move":"east"},{"to":404,"exit":"south","move":"south"},{"to":405,"exit":"west","move":"west"}],"aliases":["Cemetery"]},
  {"id":409,"x":540,"y":2310,"z":0,"title":"Hilltop Cemetery, Worn Path","descriptions":["Branches reach out towards you, groping at your clothing.  Just beyond the path, misty vapors weave their way between the trees, seeking unknown prey.  A worn path bends around from the southwest to southeast.  To the northwest, you spot some sort of clearing."],"exits":[{"to":406,"exit":"southeast","move":"southeast"},{"to":411,"exit":"southwest","move":"southwest"},{"to":410,"exit":"northwest","move":"northwest"}]},
  {"id":410,"x":520,"y":2290,"z":0,"title":"Hilltop Cemetery, Cenote","descriptions":["You are standing on the edge of a deep sinkhole, about eighty feet wide and perfectly round.  Peering into the deep hole, you find that it's filled with water, the surface about thirty feet below you.  Judging from the smoothness of the walls and a skeleton still clinging to the rocks below, you surmise that jumping into this cenote might be a bad idea."],"exits":[{"to":409,"exit":"southeast","move":"southeast"}],"aliases":["Cenote","triage"]},
  {"id":411,"x":520,"y":2330,"z":0,"title":"Hilltop Cemetery, Shady Path","descriptions":["The trees hang low over the path along the westward curve, forming an eerie tunnel of foliage.  From somewhere in the darkness, the hoot of an owl echoes through the woods."],"exits":[{"to":409,"exit":"northeast","move":"northeast"},{"to":412,"exit":"west","move":"west"}]},
  {"id":412,"x":500,"y":2330,"z":0,"title":"Hilltop Cemetery, Ring of Stones","descriptions":["The tunnel of trees opens up into a round clearing where eight gravestones have been placed in a circle.  The stone markers face inward, towards a small stone altar resting in the center.  There are ash marks across its surface, leading you to believe something was once set aflame upon it."],"exits":[{"to":411,"exit":"east","move":"east"}],"aliases":["Ring of Stones"]},
  {"id":413,"x":560,"y":2310,"z":0,"title":"Graveyard, Inside Crypt","descriptions":["A low stone altar heaped with dried flowers, old rotted offerings of food and streaked with ancient pools of melted wax, stands opposite the heavy iron gateway which leads out of the crypt.  The walls are lined with closed graves, sealed with heavy marble facings, each bearing a polished bronze plaque with the name of one of the departed.  A lone flickering candle standing atop the stone fights a precarious battle against the heavy oppressive darkness of the crypt."],"exits":[{"to":406,"exit":"out","move":"out"},{"to":414,"exit":"go","move":"go crack"}],"aliases":["Ghouls","Crypt","Graveyard"]},
  {"id":414,"x":580,"y":2310,"z":0,"title":"Graveyard, Tunnels","descriptions":["The ceiling and walls are mostly dirt aside from one bright patch of cracked marble overhead.  Two burning torches fixed to the ceiling in heavy iron brackets light up the tunnel with a deep reddish glow, glinting off bits of ivory bone and old wood in the walls.  The tunnel slopes downwards and to the east, fading into inky blackness beyond the light."],"exits":[{"to":419,"exit":"east","move":"east"},{"to":413,"exit":"up","move":"up"}]},
  {"id":415,"x":620,"y":2330,"z":0,"title":"Graveyard, Tunnels","descriptions":["The flat bottom of a wooden coffin hangs down from the ceiling overhead, glistening darkly in the torchlight, with a dark ragged hole ripped in its side.  The floor is damp and slimy with mud and deeply rutted, as if someone or something has been dragged through it."],"exits":[{"to":416,"exit":"east","move":"east"},{"to":419,"exit":"northwest","move":"northwest"}]},
  {"id":416,"x":640,"y":2330,"z":0,"title":"Graveyard, Tunnels","descriptions":["A gaping hole branches off from the main tunnel to the north, an inky blackness against the dark walls.  The black earth is scattered with tiny pale flecks, like stars on a cloudy night.  An ivory shard juts from the wall, standing out in the flickering light."],"exits":[{"to":417,"exit":"north","move":"north"},{"to":420,"exit":"northeast","move":"northeast"},{"to":415,"exit":"west","move":"west"}]},
  {"id":417,"x":640,"y":2310,"z":0,"title":"Graveyard, Tunnels","descriptions":["Tiny trickles of mud drip down from overhead as if disturbed by your passage.  This section of tunnel seems more freshly excavated, and the earth less packed down.  The dirt roof overhead is uneven and pitted with holes."],"exits":[{"to":416,"exit":"south","move":"south"},{"to":418,"exit":"northwest","move":"northwest"}]},
  {"id":418,"x":620,"y":2290,"z":0,"title":"Graveyard, Tunnels","descriptions":["This branch of the tunnel dead-ends in a nightmare tableau revealed in the tenuous light.  Someone or something has piled stacks of polished bones into neat sorted piles, along with bits of stained rotting cloth."],"exits":[{"to":417,"exit":"southeast","move":"southeast"}]},
  {"id":419,"x":600,"y":2310,"z":0,"title":"Graveyard, Tunnels","descriptions":["Dark dripping branches hang down from the low earth ceiling like knotted, grasping fingers reaching towards you.  Tiny rivulets of dirty water run in narrow branching grooves, pooling in strangely distorted tracks in the hard packed mud."],"exits":[{"to":415,"exit":"southeast","move":"southeast"},{"to":414,"exit":"west","move":"west"}]},
  {"id":420,"x":660,"y":2310,"z":0,"title":"Graveyard, Tunnels","descriptions":["The musty cavern air clings to the ground like a thick blanket of decay and old death.  Black glistening insects hang from the walls, grown fat and complacent living off the rich bounty buried overhead."],"exits":[{"to":427,"exit":"northeast","move":"northeast"},{"to":421,"exit":"southeast","move":"southeast"},{"to":416,"exit":"southwest","move":"southwest"}]},
  {"id":421,"x":695,"y":2345,"z":0,"title":"Graveyard, Tunnels","descriptions":["Glistening pearly snail tracks paint luminescent stripes along the underside of a stone slab forming part of the ceiling.  Although the slab is still unbroken, deep gashes along its surface reveal the labors of some clawed would-be intruder."],"exits":[{"to":425,"exit":"northeast","move":"northeast"},{"to":422,"exit":"southeast","move":"southeast"},{"to":420,"exit":"northwest","move":"northwest"}]},
  {"id":422,"x":720,"y":2370,"z":0,"title":"Graveyard, Tunnels","descriptions":["Matted branches tangled together like worms form a living roof overhead, seeming almost to wiggle in the flickering light.  Pale patches in the dark walls reveal the location of ancient graves, so old that nothing remains but a faint ivory taint to the soil."],"exits":[{"to":423,"exit":"east","move":"east"},{"to":421,"exit":"northwest","move":"northwest"}]},
  {"id":423,"x":740,"y":2370,"z":0,"title":"Graveyard, Tunnels","descriptions":["An old wooden coffin sticks part way out of the southern wall, its side ripped open and its contents gone.  Bits of wood and less identifiable things lie strewn about, sticking up like thorns from the muddy cave floor."],"exits":[{"to":424,"exit":"northeast","move":"northeast"},{"to":422,"exit":"west","move":"west"}]},
  {"id":424,"x":800,"y":2310,"z":0,"title":"Graveyard, Tunnels","descriptions":["A sickening stench of decay rises from a noxious pool formed in a dip in the tunnel.  Bits of unidentifiable something float over the oily surface of the water, and somewhere in the darkness something makes a splashing sound.  The muddy tunnel floor rises to the west and southwest."],"exits":[{"to":423,"exit":"southwest","move":"southwest"},{"to":425,"exit":"west","move":"west"}]},
  {"id":425,"x":730,"y":2310,"z":0,"title":"Graveyard, Tunnels","descriptions":["The tunnel branches off in three directions, bent and forked like a lightning stroke through the damp dark earth.  The constant wet dripping from the walls forms tiny rivulets which flow down the sloped branch to the east."],"exits":[{"to":426,"exit":"north","move":"north"},{"to":424,"exit":"east","move":"east"},{"to":421,"exit":"southwest","move":"southwest"}]},
  {"id":426,"x":730,"y":2300,"z":0,"title":"Graveyard, Tunnels","descriptions":["The tunnel makes a sharp bend, skirting the edges of a huge limestone boulder which looms over the passage to the west.  The stone's face is slick with sickly growths of dank moss.  To the north, the tunnel narrows quickly and dead-ends in solid rock.  A narrow crack in the stone looks passable."],"exits":[{"to":425,"exit":"south","move":"south"},{"to":432,"exit":"go","move":"go crack"}]},
  {"id":427,"x":680,"y":2290,"z":0,"title":"Graveyard, Tunnels","descriptions":["A line of ants climbs along the tunnel walls, passing busily in and out of a dark hole dug into the dirt.  Several other pits have been dug into the moist ground, but seem to have been picked clean of anything they might once have contained."],"exits":[{"to":428,"exit":"east","move":"east"},{"to":420,"exit":"southwest","move":"southwest"}]},
  {"id":428,"x":700,"y":2290,"z":0,"title":"Graveyard, Tunnels","descriptions":["A hollow thump echoes as you travel down the tunnel, sounding strangely muffled against the dry earthen walls.  Looking down, you realize you are standing on a coffin lid, half buried in the dirt beneath your feet."],"exits":[{"to":429,"exit":"northeast","move":"northeast"},{"to":427,"exit":"west","move":"west"}]},
  {"id":429,"x":720,"y":2270,"z":0,"title":"Graveyard, Tunnels","descriptions":["The narrow tunnel walls change abruptly here, as smooth ancient limestone to the east gives way to packed earth.  Jagged shards fallen from the wall litter the floor, forcing visitors to step carefully.  A blazing fire to the east casts a faint reddish light over the whole area."],"exits":[{"to":431,"exit":"east","move":"east"},{"to":428,"exit":"southwest","move":"southwest"},{"to":430,"exit":"northwest","move":"northwest"}]},
  {"id":430,"x":700,"y":2250,"z":0,"title":"Graveyard, Tunnels","descriptions":["A faint scratching sound out of sight sets your teeth on edge, as if tiny claws were scrabbling across a wooden table.  Staring yellow eyes flicker by the firelight and vanish quickly as half-seen shadows darting across the tunnel."],"exits":[{"to":429,"exit":"southeast","move":"southeast"}]},
  {"id":431,"x":730,"y":2270,"z":0,"title":"Graveyard, Tunnels","descriptions":["A natural cavern in the surrounding limestone forms a great bowl overhead, lit by a huge bonfire towards the eastern side.  The firelight glows red off an onyx slab piled high with unmentionable offerings set before a carved niche in the stone.  Piles of old gnawed bones are stacked in haphazard fashion along the northern wall, ending in a rounded opening heading west."],"exits":[{"to":432,"exit":"south","move":"south"},{"to":429,"exit":"west","move":"west"},{"to":433,"exit":"go","move":"go niche"}]},
  {"id":432,"x":730,"y":2290,"z":0,"title":"Graveyard, Tunnel","descriptions":["Towering walls of greenish stone rise to either side and seem to press inward as you make your way through a natural crack in the stone.  Misshapen muddy tracks on the stone floor look almost like rat tracks, but are far too large.  Some of the tracks are smeared as if something had been dragged over them."],"exits":[{"to":431,"exit":"north","move":"north"},{"to":426,"exit":"south","move":"south"}]},
  {"id":433,"x":730,"y":2250,"z":0,"title":"Graveyard, Tunnels","descriptions":["A broad round slab of polished marble dominates this tiny niche, covered in strange runic inscriptions.  The walls are made of chiseled granite blocks, clashing with the natural limestone of the cavern outside.  The floor around the slab is scratched and gouged, as if some burrowing animal has been digging at it."],"exits":[{"to":431,"exit":"out","move":"out"}]},
  {"id":434,"x":500,"y":2470,"z":0,"title":"Warrior Mage Guild, Workshop","descriptions":["The stench of sulfur vies with the tingling effect of ozone in this cluttered workshop.  An eclectic assortment of arcane ingredients line the cabinets and shelves.  Odd glowing stains mark the floor, most likely the result of past experiments possibly gone awry, reflecting the light from twin gaethzen spheres set on marble pedestals."],"exits":[{"to":280,"exit":"go","move":"go goldenwood door"},{"to":795,"exit":"west","move":"west"}],"aliases":["donation1","workshop"]},
  {"id":435,"x":300,"y":2350,"z":0,"title":"Jadewater Mansion, Rear Entrance","descriptions":["A single heavy iron door breaks the monotony of the massive town wall.  The triangular and flat rooftops of the north side of The Crossing rise above it, crowning the mansion directly beyond the wall in a dramatic cityscape.  A narrow trail winds its way through patches of weeds and grasses into the northern wilds.  There is a small window near the bottom of the wall, but the glass is covered in dirt."],"exits":[{"to":316,"exit":"go","move":"go thin trail"},{"to":639,"exit":"go","move":"go iron door"}]},
  {"id":436,"x":340,"y":2330,"z":0,"title":"Baearholt's Farmhold","descriptions":["Just off the Northern Trade Route stands an ivy-covered small brick building which houses Baearholt's Tavern.  Part of the family farmhold, it is renowned for its meads and ale, all of which are brewed on the premises under Ivor Baearholt's exacting supervision."],"exits":[{"to":317,"exit":"go","move":"go wooded trail"},{"to":0,"exit":"go","move":"go tavern"}],"aliases":["Baearholt's Farmhold"],"linksTo":"Map7a_Vineyard.xml"},
  {"id":437,"x":540,"y":1250,"z":0,"title":"Dense Copse","descriptions":["The branches of pine and birch trees loom overhead, overlapping to create a canopy that nearly chokes off almost all light from hitting what little green undergrowth is here.  Dried needles and dead branches crackle underfoot with every step, the only sound that can be heard save those of the forlorn cries of a wood thrush in the distance."],"exits":[{"to":0,"exit":"east","move":"east"}],"aliases":["Misenseor Abbey"],"linksTo":"Map12a_Misenseor_Abbey.xml"},
  {"id":438,"x":270,"y":1980,"z":0,"title":"Ruined Tollhouse, Interior","descriptions":["Heavy stone walls lean drunkenly on each other, like tipsy soldiers staggering into the night.  Somehow, the roof has remained mostly intact, providing a modicum of shelter and warmth.  The remains of a fire, now cold and lifeless, show that others have sought refuge here as well.  A broken stone table is the only furnishing yet left to this abandoned station.  In all, a sad reminder of busier times on this ancient road, when traffic and trade must have been much heavier."],"exits":[{"to":332,"exit":"go","move":"go sagging doorway"}]},
  {"id":439,"x":400,"y":2290,"z":0,"title":"Northeast Wilds, Handfaster's Glade","descriptions":["The soft, subtle fragrance of pine and roses mingles in an intoxicating cloud that perfumes the air and lingers in hair and clothing.  A luxurious carpet of dark green unrolls within a circle of trees, the glowing reds, golds, and butter-yellow of dayroses adding color to the sea of emerald.  A small path winds away from the glade and back toward a small well that seems as far away as a dream.","The soft, subtle fragrance of pine and orchids mingles in an intoxicating cloud that perfumes the air and lingers in hair and clothing.  A luxurious carpet of muted green unrolls within a circle of trees, the glowing white of moonflowers adding flecks of creamy ivory to the sea of emerald.  A small path winds away from the glade and back toward a small well that seems as far away as a dream."],"exits":[{"to":440,"exit":"south","move":"south"},{"to":310,"exit":"go","move":"go small path"}]},
  {"id":440,"x":400,"y":2310,"z":0,"title":"Handfaster's Glade, Shrine to Saemaus","descriptions":["Soft-scented air fills the glade where patches of blooming tulips splash color against velvety grass tailor-made for bare feet.  A lattice arch, covered with the pink blooms of jasmine honeysuckle, embraces and frames a small altar created from a living plant.  Benches of polished wood invite couples to stop and bask in the beauty of the area and the warmth of heart's devotion."],"exits":[{"to":439,"exit":"north","move":"north"}],"color":"#A6A3D9","aliases":["Shrine1-08","Saemaus","Handfaster's Glade"]},
  {"id":441,"x":320,"y":1790,"z":0,"title":"Journalai Route, Rolling Hills","descriptions":["The old, abandoned Journalai Route runs through the rolling hills outside of the village of Kaerna like a winding brownish-green ribbon someone dropped and forgot.  A few stones that might have been road markers still remain, cracked and weathered and lying, forsaken, to one side of the road."],"exits":[{"to":401,"exit":"east","move":"east"},{"to":442,"exit":"west","move":"west"},{"to":0,"exit":"go","move":"go rough dirt"}]},
  {"id":442,"x":300,"y":1790,"z":0,"title":"Journalai Route, Rolling Hills","descriptions":["The Route continues to the east and west, while to the north you notice a dirt path that looks to have been tread by the passage of feet, not the passage of wagons.  A trickling stream passes over the road, leaving mud and muck in its wake as it vanishes into the grasses of the surrounding hillside."],"exits":[{"to":443,"exit":"north","move":"north"},{"to":441,"exit":"east","move":"east"},{"to":460,"exit":"west","move":"west"}]},
  {"id":443,"x":300,"y":1770,"z":0,"title":"Rolling Hills, Trickling Stream","descriptions":["A dirt path cuts its way along the grassy bank of a thin stream, winding northwards to untamed hills, and southward back to the Journalai Route.  The size of the stream's bed suggests that it must have been bigger once, but upheaval has changed it to a fraction of the size it used to be."],"exits":[{"to":442,"exit":"south","move":"south"},{"to":444,"exit":"northwest","move":"northwest"}]},
  {"id":444,"x":280,"y":1750,"z":0,"title":"Rolling Hills, Trickling Stream","descriptions":["The stream splashes its way southeast, springing forth from underneath a set of rocks that jut out of the hill in front of you.  A hollow log lies next to the creek, looking a tad out of place in this mostly treeless land."],"exits":[{"to":443,"exit":"southeast","move":"southeast"},{"to":445,"exit":"go","move":"go hollow log"}]},
  {"id":445,"x":280,"y":1730,"z":0,"title":"Rolling Hills, Inside the Log","descriptions":["It is pitch black in here, too dark to see anything but light coming from a round hole to the south that is probably one end of the log, and a hole in the roof that leads up into dim light.","The log is surprisingly large inside, big enough for an Elf to crouch in without being cramped.  The faint scent of rot that fills it does not make it a pleasant place to stay, however, and you feel oddly relieved that it is too dark in here to tell exactly what it is you are stepping in that squishes so."],"exits":[{"to":446,"exit":"up","move":"up"},{"to":444,"exit":"out","move":"out"}]},
  {"id":446,"x":280,"y":1710,"z":0,"title":"Rolling Hills, Clear Pool","descriptions":["The hills close in about you, monuments to greenery and life.  A pool is cupped at the base of one of the hills, its surface constantly moving from unseen currents.  A good-size hole opens up in the ground by one of the largest, steepest hills.  It leads down into darkness, giving no hint of where it might go."],"exits":[{"to":447,"exit":"northwest","move":"northwest"},{"to":462,"exit":"go","move":"go clear pool"},{"to":445,"exit":"go","move":"go dark hole"}]},
  {"id":447,"x":260,"y":1690,"z":0,"title":"Rolling Hills, Grassy Knoll","descriptions":["The hills rise like frozen waves of cooled lava, their slopes leading down to a grassy knoll, as if in homage to something or someone.  A ghostly night breeze gusts down from the high, untouched hilltops, creating a lonely song that whistles eerily through the night blackened stones of the knoll.","The hills rise like frozen waves, their slopes leading down to a grassy knoll, as if in homage to something or someone.  A brisk breeze gusts downs from the high, untouched hilltops, creating a lonely song that whistles through the stones of the knoll."],"exits":[{"to":446,"exit":"southeast","move":"southeast"},{"to":448,"exit":"west","move":"west"}]},
  {"id":448,"x":240,"y":1690,"z":0,"title":"Rolling Hills, Green Slope","descriptions":["Drained of their color, the hills display several hues of gray that ripples over them, creating a shadowy illusion of movement.  The side of the hill you stand on slopes downward toward a tiny vale, while to the east it climbs back toward a dip where several hills meet.","Dazzling green hues spread over the surrounding hillside, creating a rippling illusion of movement.  The side of the hill you stand on slopes downward toward a tiny vale, while to the east it climbs back toward a dip where several hills meet."],"exits":[{"to":447,"exit":"east","move":"east"},{"to":449,"exit":"down","move":"down"}]},
  {"id":449,"x":240,"y":1710,"z":0,"title":"Rolling Hills, A Sheltered Vale","descriptions":["The grass grows thick and lush beneath your feet, while above you rise tall wiir trees in full flourish.  The only disturbances are a set of large, unusual footprints that have crushed the tall grass, and the long marks, as if something heavy had been dragged through here, that accompany them."],"exits":[{"to":450,"exit":"southwest","move":"southwest"},{"to":448,"exit":"up","move":"up"}]},
  {"id":450,"x":220,"y":1730,"z":0,"title":"Rolling Hills, A Sheltered Vale","descriptions":["The grass grows in a dark, soft circle here, inviting you to rest and relax, while tall wiir trees make a ring around the patch of green, their boughs intertwining in defense against the wind and rain.  An opening in a set of rocks piled up by the side of a hill creates a cave-like shelter to further protect you from the elements."],"exits":[{"to":449,"exit":"northeast","move":"northeast"},{"to":451,"exit":"west","move":"west"},{"to":461,"exit":"go","move":"go dark opening"}]},
  {"id":451,"x":200,"y":1730,"z":0,"title":"Rolling Hills, A Sheltered Vale","descriptions":["The night leaches the grass of all color, turning everything to the color of ashes.  Hillocks that rise up from the ground look strangely like corpses that have been covered in weeds and dirt, slowly boiling up out of the earth in shades of gray.","The grass grows in lush clumps beneath your feet, carpeting the tiny hillocks that rise up from the ground.  A butterfly floats through the air as it makes its way from wildflower to wildflower, its wings bright and vivid."],"exits":[{"to":450,"exit":"east","move":"east"},{"to":452,"exit":"up","move":"up"}]},
  {"id":452,"x":200,"y":1710,"z":0,"title":"Rolling Hills, Rocky Slope","descriptions":["The ground is sprinkled with bits of gravel and stone, making this steep slope an adventure in and of itself.  Split boulders strewn across the ground prove to be good for catching your balance when dexterity gives way to gravity and the slippery mixture of skree and grass."],"exits":[{"to":453,"exit":"southwest","move":"southwest"},{"to":451,"exit":"down","move":"down"}]},
  {"id":453,"x":180,"y":1730,"z":0,"title":"Rolling Hills","descriptions":["The hills shoulder the Route, observing all that passes down its fading trail with silent, unseen eyes."],"exits":[{"to":452,"exit":"northeast","move":"northeast"},{"to":454,"exit":"west","move":"west"}]},
  {"id":454,"x":160,"y":1730,"z":0,"title":"Rolling Hills","descriptions":["Mountains to the west loom protectively over their smaller siblings, the hills.  Somewhere to the northeast you can catch the occasional splishing sound that signals the presence of a river or stream nearby."],"exits":[{"to":453,"exit":"east","move":"east"},{"to":455,"exit":"climb","move":"climb rocky path"}]},
  {"id":455,"x":160,"y":1790,"z":0,"title":"Journalai Route, Rockslide","descriptions":["A massive rockslide has cut off any further western passage along the Journalai Route by caravan, and the slide itself looks too unstable and massive to climb safely.  You can catch a glimpse of sweeping forested mountainside just beyond the barrier, the caps of the peaks frosted with eternal snows."],"exits":[{"to":456,"exit":"east","move":"east"},{"to":454,"exit":"climb","move":"climb rocky path"},{"to":463,"exit":"go","move":"go massive rockslide"}]},
  {"id":456,"x":180,"y":1790,"z":0,"title":"Journalai Route, Rocky Hills","descriptions":["The ground is extremely stony here, and the sides of the hills are dotted with the broken remains of boulders.  To the west you see mountain peaks, broken-edged etchings against the sky.  Patches of grass grow sporadically amongst the gravel and stones through which you pick your way, and it is hard to distinguish where the sides of the Route end, and where the hills begin."],"exits":[{"to":457,"exit":"east","move":"east"},{"to":455,"exit":"west","move":"west"}]},
  {"id":457,"x":200,"y":1790,"z":0,"title":"Journalai Route, Rolling Hills","descriptions":["Large stones crop out from the sides of the hills, bones jutting from the round flesh of the earth.  Wild shrubs climb over the hillsides, their thorny vines tangling into one another.  A gentle breeze rustles their leaves, passing like a ghost between the slopes.  It is not enough, however, to dispel the faint tinge of rot that seems to hang in the air.","Large stones crop out from the sides of the hills, bones jutting from the round flesh of the earth.  Wild roses climb over the hillsides, their bushes tangling into one another, and their fresh scent encircling you.  It is not enough, however, to dispel the faint tinge of rot that seems to hang in the air."],"exits":[{"to":458,"exit":"southeast","move":"southeast"},{"to":456,"exit":"west","move":"west"}]},
  {"id":458,"x":220,"y":1810,"z":0,"title":"Journalai Route, Rolling Hills","descriptions":["Slender, willowy trees grow along the side of the road on this part of the Route, their boughs intertwining to form a wild, beautiful arch of leaf and branch.  From somewhere in the trees you hear the soft twitter of a single bird, the first you have heard in your entire time here."],"exits":[{"to":459,"exit":"east","move":"east"},{"to":457,"exit":"northwest","move":"northwest"}]},
  {"id":459,"x":240,"y":1810,"z":0,"title":"Journalai Route, Rolling Hills","descriptions":["From here, the top of one of the tallest hills, you can see the lay of the land, rising and falling before and behind you.  The Route winds onward to the east, and dwindles slowly toward the west."],"exits":[{"to":460,"exit":"northeast","move":"northeast"},{"to":458,"exit":"west","move":"west"}]},
  {"id":460,"x":260,"y":1790,"z":0,"title":"Journalai Route, Rolling Hills","descriptions":["The silence here would be peaceful, if it weren't so intrusive.  No birdsong, no movement of wildlife, just an empty, all-encompassing stillness, as if the green, wild hills that rise about you were holding their breath."],"exits":[{"to":442,"exit":"east","move":"east"},{"to":459,"exit":"southwest","move":"southwest"}]},
  {"id":461,"x":240,"y":1730,"z":0,"title":"Rolling Hills, Inside a Small Cave","descriptions":["The floor of the cave is sandy, while the back of it seems to be made of dirt.  It is relatively small, but well-lit, its opening leading out into a lush vale.  A small firering composed of blackened stones and cold ashes occupies the center of the cave."],"exits":[{"to":450,"exit":"out","move":"out"}]},
  {"id":462,"x":260,"y":1710,"z":0,"title":"A Clear Pool","descriptions":["Around you stand the high hills of the countryside, their broken reflections rippling in the pool, while all about you spreads cool, cold water, running deep and moving slowly with unseen currents.  From time to time a bubble pops on the surface, creating a gentle stir over the water."],"exits":[{"to":446,"exit":"out","move":"out"}],"color":"#0000FF","aliases":["Clear Pool","Pool"]},
  {"id":463,"x":140,"y":1790,"z":0,"title":"Journalai Route, Rocky Pass","descriptions":["High walls of stone rise up on either side of the rocky pass as this hidden spur of the Journalai Route branches off toward forested mountain slopes.  Small clumps of heather find unreliable purchase alongside the road where time and nature have pulverized the fallen boulders to ragged piles of gravel."],"exits":[{"to":464,"exit":"west","move":"west"},{"to":455,"exit":"go","move":"go massive rockslide"}]},
  {"id":464,"x":120,"y":1790,"z":0,"title":"Journalai Route, Rocky Pass","descriptions":["Westward, the high stone walls close in more tightly overhead, completely blocking the view of the nearby mountains.  A chance avalanche would be disastrous for anyone passing along the road."],"exits":[{"to":463,"exit":"east","move":"east"},{"to":465,"exit":"west","move":"west"},{"to":810,"exit":"climb","move":"climb tumbled boulders"}]},
  {"id":465,"x":100,"y":1790,"z":0,"title":"Journalai Route, Rocky Pass","descriptions":["The walls are barely shoulder-width here, closing out all but a narrow strip of sky above.  Shattered slabs of fallen granite clog most of the path and stray breezes bring showers of tiny pebbles and stone dust from above.  The faint light makes maneuvering difficult as the fallen boulders appear no more than vague shadows within the gloom."],"exits":[{"to":464,"exit":"east","move":"east"},{"to":468,"exit":"southwest","move":"southwest"},{"to":466,"exit":"go","move":"go narrow fissure"}]},
  {"id":466,"x":100,"y":1770,"z":0,"title":"Journalai Cavern, Narrow Fissure","descriptions":["Squeezing through the small gap is hard going as the rough walls seem to grasp for exposed skin at every chance.  The fissure extends back a good distance into the northern cliff, then vanishes around a corner."],"exits":[{"to":467,"exit":"northeast","move":"northeast"},{"to":465,"exit":"go","move":"go fallen boulders"}]},
  {"id":467,"x":120,"y":1750,"z":0,"title":"Journalai Cavern, Abandoned Camp","descriptions":["Someone has used this small hidden cavern as a refuge in the past.  There's a circle of stones containing the remains of a campfire and a narrow vent in the ceiling provides ample ventilation for escaping smoke."],"exits":[{"to":466,"exit":"southwest","move":"southwest"}],"aliases":["Camp"]},
  {"id":468,"x":80,"y":1810,"z":0,"title":"Journalai Route, Shadowy Cul-de-sac","descriptions":["The road ends in this dark cul-de-sac, providing no visible means of escape for anyone caught unaware from behind.  Scattered bones from some unidentifiable victim gleam softly in the darkness.  Deep shadows surround the perimeter of the area and the faint scent of burning charcoal hangs in the air."],"exits":[{"to":465,"exit":"northeast","move":"northeast"},{"to":469,"exit":"go","move":"go narrow trail"}]},
  {"id":469,"x":60,"y":1810,"z":0,"title":"Journalai Route, Dim Passage","descriptions":["The dim passage is a good deal larger than it looks from a distance.  From the texture of the walls and the chips of granite covering the floor, it's apparent the tunnel is not a natural formation.  Someone carved a trail between the cul-de-sac and whatever lies beyond the wall."],"exits":[{"to":470,"exit":"northwest","move":"northwest"},{"to":468,"exit":"go","move":"go narrow trail"}]},
  {"id":470,"x":40,"y":1790,"z":0,"title":"Limestone Valley, Dim Tunnel","descriptions":["The path underfoot is treacherous and strewn with gravel chips painstakingly carved from the rock wall.  This end of the tunnel opens through a granite arch onto a limestone valley.  The scent of burning charcoal is much stronger here."],"exits":[{"to":469,"exit":"southeast","move":"southeast"},{"to":471,"exit":"go","move":"go granite arch"}]},
  {"id":471,"x":40,"y":1770,"z":0,"title":"Limestone Valley, Granite Arch","descriptions":["A granite arch opens into the base of an unusual stone wall.  Nearly thirty feet tall, the granite wall is encrusted with shimmering quartz crystals.  Although the crystals have been removed as high as can be readily reached, the remaining strip extends along the southern wall of the valley in brilliant display."],"exits":[{"to":472,"exit":"east","move":"east"},{"to":478,"exit":"west","move":"west"},{"to":470,"exit":"go","move":"go granite arch"}]},
  {"id":472,"x":60,"y":1770,"z":0,"title":"Limestone Valley, Crystal Wall","descriptions":["The crystals end abrubtly at the eastern wall of the valley, refracting pinpoints of light against a limestone backdrop.  The slight inward tilt of the limestone cliffs precludes any possibility of scaling them."],"exits":[{"to":473,"exit":"northeast","move":"northeast"},{"to":471,"exit":"west","move":"west"}]},
  {"id":473,"x":80,"y":1750,"z":0,"title":"Limestone Valley, Eastern Wall","descriptions":["The greyish-white wall leans in over the tar pit where the path narrows to a few feet across.  A fine rain of chalky powder continually drifts down from above, dislodged by stray breezes."],"exits":[{"to":472,"exit":"southwest","move":"southwest"},{"to":474,"exit":"northwest","move":"northwest"}]},
  {"id":474,"x":60,"y":1730,"z":0,"title":"Limestone Valley, Northern Wall","descriptions":["Thin striations of pure pink marble can be seen embedded in the limestone.  The veins are scarce, but time will create a rich harvest for future miners."],"exits":[{"to":473,"exit":"southeast","move":"southeast"},{"to":475,"exit":"west","move":"west"}]},
  {"id":475,"x":40,"y":1730,"z":0,"title":"Limestone Valley, Marble Gate","descriptions":["A tall arch is carved into the wall and set with a solid marble gate.  Although there's no apparent locking mechanism, the gate is solidly closed.  Fresh air drifts through the narrow crack around the slab carrying a hint of pine."],"exits":[{"to":474,"exit":"east","move":"east"},{"to":476,"exit":"west","move":"west"}],"aliases":["Marble Gate"]},
  {"id":476,"x":20,"y":1730,"z":0,"title":"Limestone Valley, Northern Wall","descriptions":["The skeleton of a mid-size feline lies here in disarray and several large chunks of limestone are shattered beneath the remains.  It appears the edge of the cliff gave way while the luckless animal investigated the valley from above.  A far quicker death than the slowly suffocating fumes of the pit."],"exits":[{"to":475,"exit":"east","move":"east"},{"to":477,"exit":"southwest","move":"southwest"}]},
  {"id":477,"x":0,"y":1750,"z":0,"title":"Limestone Valley, Western Wall","descriptions":["The path here is thick with spatters from the pit, making each step a challenge.  An extremely large bubble of tar hisses and burbles, slowly releasing a steady stream of gas and black ooze."],"exits":[{"to":476,"exit":"northeast","move":"northeast"},{"to":478,"exit":"southeast","move":"southeast"}]},
  {"id":478,"x":20,"y":1770,"z":0,"title":"Limestone Valley, Marble Vein","descriptions":["Between the crystal-encrusted granite and the chalky lime runs a thick vein of pure ivory marble.  An ambitious Halfling miner was unsuccessful in attempts to reap some of nature's bounty before being overcome by the fumes.  Nothing but a skeleton and a few tattered scraps of clothing are left."],"exits":[{"to":471,"exit":"east","move":"east"},{"to":477,"exit":"northwest","move":"northwest"}]},
  {"id":479,"x":520,"y":1430,"z":0,"title":"River's Bank, Eddy","descriptions":["An outcropping of rock juts into the river, breaking the flow of the current just enough to create an eddy.  Over time, a small sandbar has formed at the base of the stone bridge and occasionally catches floating debris.  High grasses along the bank nearly hide a small path that leads up and around to the top of the bridge on the southern bank."],"exits":[{"to":373,"exit":"climb","move":"climb path"}]},
  {"id":480,"x":420,"y":1810,"z":0,"title":"Kaerna Village, At the Well","descriptions":["The well has been craftily made of smooth interlocking stones.  A closer look reveals that no mortar was used in its construction despite its circular shape.  A wooden roof protects it from dirt and debris, and a fruitless modwyn vine twines all around.  Dappled shadows created by the moonlight give this place a sense of mystery and wonder.","The well has been craftily made of smooth interlocking stones.  A closer look reveals that no mortar was used in its construction, despite its circular shape.  A wooden roof protects it from dirt and debris, and a fruitless modwyn vine twines all around.  The grass beneath you is springy and soft, inviting you to lie down and dream the days away in the warmth of the sun."],"exits":[{"to":481,"exit":"east","move":"east"},{"to":351,"exit":"west","move":"west"}],"aliases":["Well"]},
  {"id":481,"x":460,"y":1810,"z":0,"title":"Kaerna Village, Near The Well","descriptions":["Meandering eastward from the village well, a grassy footpath follows a gentle decline away from the bustle of the Northern Trade road and through a small copse of oak and aspen trees.  Wildflowers grow in abundant banks on either side of the path, their delicate blossoms evolving with the seasons in an endless, ever-changing cycle of color and fragrance."],"exits":[{"to":480,"exit":"west","move":"west"},{"to":482,"exit":"down","move":"down"}],"color":"#C2B280","aliases":["RTZ10","RT-K-WC"]},
  {"id":482,"x":480,"y":1830,"z":0,"title":"Kaerna Village, A Grassy Footpath","descriptions":["A chattering brook traverses the footpath in a stony bed, its crystal waters dancing and sparkling over smooth grey rocks and the deep brown remnants of long-fallen logs.  Embedded in the soft earth either side of the stream, a broad ironwood plank forms a narrow bridge, allowing visitors to balance across the brook and continue eastward toward the village gate."],"exits":[{"to":481,"exit":"up","move":"up"},{"to":483,"exit":"go","move":"go ironwood plank"}],"color":"#00FFFF"},
  {"id":483,"x":500,"y":1850,"z":0,"title":"Lower Kaerna, Village Gate","descriptions":["A low sandstone wall runs around Lower Kaerna, the modest proportions of the perimeter suggesting the villagers have few enemies other than the occasional adventurous bovine.  The village gate struggles with the attentions of a voracious ivy that pokes its brazen fingers into every nook and cranny of the surrounding stone and clings determinedly to the pristine paintwork.  An ironwood plank leads west across a nearby stream."],"exits":[{"to":484,"exit":"go","move":"go village gate"},{"to":482,"exit":"go","move":"go ironwood plank"}],"color":"#00FFFF"},
  {"id":484,"x":520,"y":1850,"z":0,"title":"Lower Kaerna, Village Green","descriptions":["The gate opens onto a charming village green surrounded by quaint cottages and tranquil rural lanes.  In remarkable contrast with the fervent activity of Kaerna's west end, the rustic simplicity of Lower Kaerna envelopes the senses and blots out any memory of life on the trade routes.  No matter what activity might be taking place on or around the green, nothing here is done at any pace greater than an amble."],"exits":[{"to":485,"exit":"north","move":"north"},{"to":496,"exit":"east","move":"east"},{"to":483,"exit":"go","move":"go village gate"}],"color":"#00FFFF"},
  {"id":485,"x":520,"y":1830,"z":0,"title":"Lower Kaerna, Village Green","descriptions":["The village pond occupies the best part of the northwest green, its brown waters rippling with the fussy antics of ducks and the occasional splash of a jumping fish.  Around the edge of the pond, tall bulrushes sway gently in the breeze, parting just enough to grant a glimpse of moorhens and a pair of haughty swans nesting silently in the shallows."],"exits":[{"to":484,"exit":"south","move":"south"},{"to":486,"exit":"climb","move":"climb wooden stile"},{"to":504,"exit":"go","move":"go pond"}]},
  {"id":486,"x":520,"y":1810,"z":0,"title":"Lower Kaerna, High Street","descriptions":["Overlooking the lilies and willows growing in and around the village pond, the homes here have a sleepy look about them, their light curtains blowing softly from the wide-open windows which typify this safe and peaceful hamlet.  There is little activity to disturb the tranquil silence, save for the intermittent chirp of a bird or a soft splash of fin or feather in the quiet waters."],"exits":[{"to":487,"exit":"north","move":"north"},{"to":503,"exit":"east","move":"east"},{"to":485,"exit":"climb","move":"climb wooden stile"}],"color":"#00FFFF"},
  {"id":487,"x":520,"y":1790,"z":0,"title":"Lower Kaerna, Lady Alice Drive","descriptions":["A narrow, cobbled lane leads off from the quiet end of High Street and forms a gently arcing crescent from one side of the tiny village to the other.  Lined with quaint thatched cottages and charming sandstone dwellings, Lady Alice Drive meanders through the serene village like a lazy smile, encouraging travelers along its sedate curve to adopt a pleasureable, unhurried gait."],"exits":[{"to":488,"exit":"northeast","move":"northeast"},{"to":486,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":488,"x":540,"y":1770,"z":0,"title":"Lower Kaerna, Lady Alice Drive","descriptions":["The drive narrows to little more than a carriage width here, squeezing between two matching whitewashed cottages that stand aside the passageway as if expecting to take tolls from passers-by.  A lush modwyn vine climbs recklessly up the side of each building, attracting a wide variety of dazzling butterflies and tiny birds to the deep tangle of its foliage and slender branches."],"exits":[{"to":489,"exit":"northeast","move":"northeast"},{"to":487,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":489,"x":560,"y":1750,"z":0,"title":"Lower Kaerna, Lady Alice Drive","descriptions":["A constant, fresh breeze slips around the crescent, its long journey down from the mountains and moorland beyond Kaerna drawing to a close in the sleepy hamlet.  From time to time, the sharp fragrance of pine and the peaty smell of damp earth wends its way into the village, giving a gentle reminder that there is indeed a wider, wilder world outside the encircling walls."],"exits":[{"to":490,"exit":"east","move":"east"},{"to":488,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":490,"x":580,"y":1750,"z":0,"title":"Lower Kaerna, Lady Alice Drive","descriptions":["The tantalizing aroma of fresh-baked bread and cakes wafts about on a light breeze regardless of the time of day, as if many of the locals spend most of their time steadfastly producing confections in industrious and cozy kitchens.  A trestle table standing in the garden of one cottage bears a tempting selection of the day's culinary produce, proudly offered to passers-by for the sampling."],"exits":[{"to":491,"exit":"southeast","move":"southeast"},{"to":489,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":491,"x":600,"y":1770,"z":0,"title":"Lower Kaerna, Lady Alice Drive","descriptions":["Carefully planted in evenly spaced rows of fat wooden buckets, miniature fir and poplar trees line the drive with splashes of deep green.  Complementing the neat display, oaken planters bursting with seasonal blooms adorn the windowsills of many of the homes, combining the beauty of the wild with the modest gentility of the village."],"exits":[{"to":492,"exit":"southeast","move":"southeast"},{"to":490,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":492,"x":620,"y":1790,"z":0,"title":"Lower Kaerna, Lady Alice Drive","descriptions":["Just north of the comparative bustle of Fourways, Lady Alice Drive begins its easy dawdle around the upper end of the village.  Countless rows of neat cobbles run the length of the lane as it curves past immaculate cottages and snug lodges, each home a picture-perfect tribute to the houseproud families who populate this tiny town."],"exits":[{"to":493,"exit":"south","move":"south"},{"to":491,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":493,"x":620,"y":1810,"z":0,"title":"Lower Kaerna, Fourways","descriptions":["By Lower Kaerna standards, Fourways is a throbbing thoroughfare, given that the only two roads of any size meet here.  Even so, the pace of life is relaxing to say the least, and those few folk who do choose to pass a moment here do little more than watch the world go by.  A small bronze statue on a stone pedestal occupies the central point of the crossroads."],"exits":[{"to":492,"exit":"north","move":"north"},{"to":500,"exit":"east","move":"east"},{"to":494,"exit":"south","move":"south"},{"to":503,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":494,"x":620,"y":1830,"z":0,"title":"Lower Kaerna, Village Green","descriptions":["Overlooking the carefully-tended lawns of the village green, a row of smart stone and thatch cottages enjoys a pleasing, scenic location.  Four vast oak trees stand aside the narrow road at the edge of the green, their thick trunks and spreading boughs dark with age.  Rooks' nests form a rambling roost along many of the branches, sending forth the occasional raucous squawk as one feathered resident disputes territory with another."],"exits":[{"to":493,"exit":"north","move":"north"},{"to":497,"exit":"east","move":"east"},{"to":495,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":495,"x":620,"y":1850,"z":0,"title":"Lower Kaerna, Village Green","descriptions":["An old wagon wheel idles in one corner of the Green, as if to remind visitors to leave their work behind them and succumb to a more placid way of life.  Between its spokes, the green-keepers have planted a variety of low shrubs, the contrasting hues of their foliage creating a fascinating monument to indolence resplendent with different textures and colors."],"exits":[{"to":494,"exit":"north","move":"north"},{"to":496,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":496,"x":570,"y":1850,"z":0,"title":"Lower Kaerna, Village Green","descriptions":["Running along the south side of the green, a narrow path leads past a group of tiny cabins that almost disappear into a thick copse of aspen and sweet chestnut trees.  Despite their modesty, each humble dwelling appears spotlessly clean and diligently maintained, their secluded location in the village's only uncombed spot is clearly a careful choice made by fastidious and discerning people."],"exits":[{"to":495,"exit":"east","move":"east"},{"to":484,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":497,"x":640,"y":1830,"z":0,"title":"Lower Kaerna, Blythe Lane","descriptions":["Between a pair of whitewashed lodges, the rustic beginnings of Blythe Lane lead off from the green to bring a pleasing impression of the surrounding countryside into the village.  The lane itself is actually a narrow, stony path bordered by vigorous cowslips and flowering nettles which flourish in cool, verdant banks outside snug homesteads and at the feet of overhanging sycamores."],"exits":[{"to":498,"exit":"southeast","move":"southeast"},{"to":494,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":498,"x":660,"y":1850,"z":0,"title":"Lower Kaerna, Blythe Lane","descriptions":["Enclosing the path, a tall hawthorn and beech hedge thins out periodically to allow passage through to the cottages and cabins which nestle peacefully in their woodsy lots.  Thin plumes of blue-grey smoke drift from squat chimneys and waft across the lane in a faintly shifting haze, bringing to mind reassuring memories of hearth and home."],"exits":[{"to":499,"exit":"southeast","move":"southeast"},{"to":497,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":499,"x":680,"y":1870,"z":0,"title":"Lower Kaerna, Blythe Lane","descriptions":["Blythe Lane draws to a drowsy close inside the village wall, where a bank of aromatic thyme and lavender grows strong and robust beneath the vine-clad grey and yellow sandstone.  Several of the homes in this area boast a similar display of scented herbs in their front gardens, infusing the air with a memorably pungent perfume reminiscent of a warm, dewy morning in the countryside."],"exits":[{"to":498,"exit":"northwest","move":"northwest"}],"color":"#00FFFF","aliases":["Blythe Lane"]},
  {"id":500,"x":640,"y":1810,"z":0,"title":"Lower Kaerna, High Street","descriptions":["High Street continues its gentle progress to the east, its smooth sandstone paving diligently swept free of any dust and debris which might settle for half a moment.  The homes which claim this part of town are slightly larger than the average Lower Kaerna cottage, and each owner clearly takes great pride in preserving the superiority of the neighborhood."],"exits":[{"to":501,"exit":"east","move":"east"},{"to":493,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":501,"x":660,"y":1810,"z":0,"title":"Lower Kaerna, High Street","descriptions":["Many of the homes here have matching curtains and gardens displaying identical selections of shrubs and blossoms, suggesting the sense of community in Lower Kaerna is particularly strong.  Large, wrought-iron flower baskets hang from tall blackwood poles at intervals along High Street, their lively displays of trailing ivy and seasonal wildflowers adding a simple yet elegant adornment to the street."],"exits":[{"to":502,"exit":"east","move":"east"},{"to":500,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":502,"x":680,"y":1810,"z":0,"title":"Lower Kaerna, High Street","descriptions":["High Street draws to a close in a crescent following the curve of the village wall.  A half-circle of homes occupies the spacious turnaround, their sparkling windows and glossy paintwork a gleaming reflection of their owners' pride.  A box privet hedge borders the walkway around the crescent, intermittently giving way to numerous white gravel paths that lead to the front door of each dwelling."],"exits":[{"to":501,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":503,"x":570,"y":1810,"z":0,"title":"Lower Kaerna, High Street","descriptions":["A row of neat homes runs across the northern side of the green, the grandly-named High Street more of a country lane than the major artery its nomenclature might suggest.  Each dwelling here seems to take great pride in its prime location, presenting to the public a meticulously maintained facade complete with colorful curtains and window-boxes brimming with seasonal blooms."],"exits":[{"to":493,"exit":"east","move":"east"},{"to":486,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":504,"x":540,"y":1830,"z":0,"title":"Lower Kaerna, Village Pond","descriptions":["A group of wooden benches sits at the edge of the pond beneath a swaying willow that dabbles its long fingers in the shallow waters.  Broad lilypads cover the surface of the pond, their white and purple flowers smiling up at the sky.  Fat fish swim lazily among the trailing mass of roots and reeds under a rickety jetty, taunting local anglers with the intermittent flash of light on silver scales."],"exits":[{"to":505,"exit":"go","move":"go old jetty"},{"to":485,"exit":"go","move":"go green"}]},
  {"id":505,"x":560,"y":1830,"z":0,"title":"Village Pond, The Old Jetty","descriptions":["Jutting out from a marshy section of the pond shore, an elderly jetty hovers over the water.  The wobbly, uneven surface of the walkway, and the occasional gap where one plank has fallen away completely, conspire to make an unplanned trip into the dark waters a distinct likelihood.  Bits of old bait and scraps of fishing line have attached themselves determinedly to splinters in the ancient wood."],"exits":[{"to":504,"exit":"go","move":"go shore"}]},
  {"id":506,"x":380,"y":1770,"z":0,"title":"The Gilded Unicorn, Entry Hall","descriptions":["A front desk manned by a young Elven woman is all that composes this corridor-like room.  She smiles gently up at you from where she is working on embroidering a linen tunic with simple but bright flowers.  A sign behind her states the inn's fees for lodging, and stairs to her right lead up to the inn's bedrooms.","A front desk manned by a small Elven boy is all that composes this corridor-like room.  The boy nods at you as you enter, his elbows on an open ledger book and a bored look on his impish face.  A sign behind him states the inn's fees for lodging, and stairs to his right lead up to the inn's bedrooms."],"exits":[{"to":507,"exit":"north","move":"north"},{"to":352,"exit":"out","move":"out"},{"to":510,"exit":"go","move":"go rough door"},{"to":511,"exit":"go","move":"go worn stairs"}]},
  {"id":507,"x":380,"y":1760,"z":0,"title":"The Gilded Unicorn, Tavern","descriptions":["Spacious and open, the tavern allows for plenty of breathing room.  Axes, swords, and shields decorate the walls, all scratched with the wear of battle and all safely nailed in place that a patron might not grab one in a fit of drunken rage.  Situated behind the bar is a tall, muscular Elven woman with long red braids.  Judging from her demeanor and the way she handles the people who work and eat here, this can only be the owner, Savrin Kaerna."],"exits":[{"to":506,"exit":"south","move":"south"},{"to":508,"exit":"go","move":"go deobar door"},{"to":509,"exit":"go","move":"go secluded booth"}],"color":"#FF0000","aliases":["Gilded Unicorn","Savrin","Tavern"]},
  {"id":508,"x":390,"y":1760,"z":0,"title":"The Gilded Unicorn, Private Room","descriptions":["Small but comfortable, a cheery fireside takes up a good part of the eastern wall.  The floor is covered with fur throws and a few overstuffed chairs complement the feeling of security and warmth."],"exits":[{"to":507,"exit":"go","move":"go deobar door"}],"aliases":["Private Room"]},
  {"id":509,"x":370,"y":1760,"z":0,"title":"The Gilded Unicorn, Secluded Booth","descriptions":["This booth has been set aside from the rest of the tavern for those who wish more intimate conversation.  There is a clean table with a vase here, and padded seats for the weary.  Someone has gone to the trouble to make sure that there are real candles to light the otherwise darkened corner, and every now and then a server comes over to check the wicks and replenish the ones that are beginning to gutter."],"exits":[{"to":507,"exit":"out","move":"out"}],"aliases":["Secluded Booth"]},
  {"id":510,"x":390,"y":1770,"z":0,"title":"The Gilded Unicorn, Quarters","descriptions":["This room is so tidy it is militant.  A small iron stove provides warmth, and a few cots in a corner are set up for sleeping purposes.  Someone has carelessly left a doll lying on the floor."],"exits":[{"to":506,"exit":"go","move":"go rough door"}]},
  {"id":511,"x":370,"y":1770,"z":0,"title":"The Gilded Unicorn, Top of the Stairs","descriptions":["Plain instead of fancy, this corridor of rooms is spotless, the wood solid and slightly gray from the wear and tear of time.  You can just make out the sounds of the tavern proper below you, the noise creeping through the scuffed floorboards and faded red carpeting."],"exits":[{"to":512,"exit":"go","move":"go white door"},{"to":506,"exit":"go","move":"go worn stairs"}]},
  {"id":512,"x":360,"y":1770,"z":0,"title":"The Gilded Unicorn, A Cozy Room","descriptions":["This room is set up with the intent of making one person comfortable and two people snug.  The floor is wooden but freshly swept, and a set of faded yellow curtains have been drawn back from the window.  A dresser with a water-filled basin set on top of it and a bed are the only pieces of furniture here, but you get the feeling that any more would have left the room cramped and cluttered."],"exits":[{"to":511,"exit":"go","move":"go white door"}]},
  {"id":513,"x":480,"y":1670,"z":0,"title":"Drathrok's Cave, Dance Training Area","descriptions":["A pungent animal odor pervades this somewhat cramped cave, with its moist dirt floor and undulating rock walls.  Several timbers placed end to end mark off a mounded patch of earth at the widest point in the room, where the light of several dim torches also reveals deep claw markings in stones leaning against a long, narrow table."],"exits":[{"to":359,"exit":"out","move":"out"}],"aliases":["Drathrok's Cave","Dance Training Area"]},
  {"id":514,"x":480,"y":2130,"z":0,"title":"Arthe Dale, Village Gate","descriptions":["A picturesque village extends north from the town gate.  Quaint buildings, built specifically for those of short stature, border the lanes.  A kaleidoscopic array of color is displayed in every direction ... in the clothing of the Halflings, the painted buildings, and the lushly-hued blossoms covering the neatly tended beds and flowering trees.  A house, constructed to accommodate the hired Human guard, is situated next to the gate.  He stands at ease, casually perusing the incoming traffic."],"exits":[{"to":535,"exit":"north","move":"north"},{"to":346,"exit":"go","move":"go village gate"}],"aliases":["Arthe Dale","Dale"]},
  {"id":515,"x":420,"y":2150,"z":0,"title":"Marja Tee, Tula Veraja","descriptions":["A well-worn road winds its way through the valley, between a small town and the adjoining farmlands.  A proliferation of berry bushes crowds the edges as if trying to reclaim the portion of land heavily rutted by wagon and cart wheels.  To the north a village gate beckons weary travelers."],"exits":[{"to":346,"exit":"north","move":"north"},{"to":516,"exit":"southeast","move":"southeast"}]},
  {"id":516,"x":460,"y":2170,"z":0,"title":"Marja Tee, Tula Veraja","descriptions":["Berry bushes and green shrubs grow between the trunks of elm and birch trees.  Overhead, the soft hoot of an owl calls to its mate.  Numerous golden lights of a small community flicker to the distant northwest.","Berry bushes and green shrubs grow between the trunks of elm and birch trees.  Sparrows flutter out of the high branches to light gracefully on a twig, grab a ripe berry, and wing back to their perches.  In the distant northwest a small village can be seen."],"exits":[{"to":517,"exit":"southeast","move":"southeast"},{"to":515,"exit":"northwest","move":"northwest"}]},
  {"id":517,"x":480,"y":2190,"z":0,"title":"Marja Tee, Musikaz Masi","descriptions":["Tracks left by wagons laden with heavy cargo mar the road with deep ruts.  A multitude of blackberry bushes, full of plump berries, mingle with a few scattered trees that line each side of this wide byway."],"exits":[{"to":518,"exit":"southeast","move":"southeast"},{"to":516,"exit":"northwest","move":"northwest"}]},
  {"id":518,"x":500,"y":2210,"z":0,"title":"Marja Tee, Musikaz Masi","descriptions":["The road crests a small hill covered with ripe blackberry bushes.  Dozens of squashed berries have been imbedded into the packed earth by the wheels of overloaded wagons.  Occasionally a bird swoops down to greedily grab a tiny black treasure from a mature bush."],"exits":[{"to":519,"exit":"east","move":"east"},{"to":517,"exit":"northwest","move":"northwest"}]},
  {"id":519,"x":520,"y":2210,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["Small shrubs growing in tight clumps line the road on both sides.  Nestled in the brush are dense clusters of briarberry bushes with tiny berries hanging from woody stems."],"exits":[{"to":520,"exit":"east","move":"east"},{"to":518,"exit":"west","move":"west"}]},
  {"id":520,"x":540,"y":2210,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["Meandering gently through a dense meadow, the road is evenly covered in tiny stones laid to smooth the rough terrain.  Endless rows of briarberry bushes, cultivated and harvested for their woody roots, border each side of the wide road."],"exits":[{"to":521,"exit":"northeast","move":"northeast"},{"to":519,"exit":"west","move":"west"}]},
  {"id":521,"x":560,"y":2190,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["The road continues its trek through the lush meadow.  Flowers of all kinds grow haphazardly among dense groupings of briarberry bushes filled with bright red berries.  Irrigation ditches filled with rainwater line both sides of the road."],"exits":[{"to":522,"exit":"northeast","move":"northeast"},{"to":520,"exit":"southwest","move":"southwest"}]},
  {"id":522,"x":580,"y":2170,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["A wooden cart filled with freshly dug briarberry bushes is parked on the side of the roadway.  Coveted for their woody roots in the making of tobacco pipes, briarberry bushes are carefully harvested annually by the local Olvi families of the area.","A wooden cart filled with freshly dug briarberry bushes is parked on the side of the roadway.  Coveted for their woody roots in the making of tobacco pipes, briarberry bushes are carefully harvested annually by the local Olvi families of the area.  Deep in the meadow, you can see a small group of Olvi thinning the denser clumps."],"exits":[{"to":523,"exit":"southeast","move":"southeast"},{"to":521,"exit":"southwest","move":"southwest"}]},
  {"id":523,"x":600,"y":2190,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["The road narrows a little here, as briarberry bushes laden with heavy plump berries mingle with wild cinnamon shrubs that fight to reclaim this well traveled byway.  Scattered amidst the dense brush are a few birch and elm trees, with occasional clumps of pink clover peeking through the heavy brambles."],"exits":[{"to":524,"exit":"east","move":"east"},{"to":522,"exit":"northwest","move":"northwest"}]},
  {"id":524,"x":620,"y":2190,"z":0,"title":"Marja Tee, Girio Masi","descriptions":["Hardy, wild cinnamon shrubs grace both sides of the road as the path widens.  Their leathery leaves offer an open invitation to a mass influx of butterflies that migrate to this area in the spring.  Occasionally, the sound of small wildlife can be heard scurrying beneath the compact bushes."],"exits":[{"to":525,"exit":"east","move":"east"},{"to":523,"exit":"west","move":"west"}]},
  {"id":525,"x":640,"y":2190,"z":0,"title":"Marja Tee, Girio Masi","descriptions":["The road crests a small hill flanked by dense clumps of wild cinnamon shrubs.  The shadowed bushes resemble tiny gnomelike creatures tottering imperceptibly as the night breeze causes the leaves to gently sway.","The road crests a small hill flanked by dense clumps of wild cinnamon shrubs.  A multitude of migrating butterflies can be seen fluttering amidst the bushes, their beautifully colored wings complimenting the deep green of the leathery leafed shrubs."],"exits":[{"to":526,"exit":"east","move":"east"},{"to":524,"exit":"west","move":"west"}]},
  {"id":526,"x":660,"y":2190,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["A shallow gully runs across the road at the bottom of a small hill.  Thick walls of bushes grow wildly like untamed hedgerows bordering the road."],"exits":[{"to":527,"exit":"northeast","move":"northeast"},{"to":525,"exit":"west","move":"west"}]},
  {"id":527,"x":680,"y":2170,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["The road here snakes through some of the thickest bushes and brambles.  Fragrant cinnamon mixes with sweet raspberry in a panoply of earthy, spiced scents."],"exits":[{"to":528,"exit":"southeast","move":"southeast"},{"to":526,"exit":"southwest","move":"southwest"}]},
  {"id":528,"x":700,"y":2190,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["Bushes and vines grow wildly, high enough to block out most of the sky.  The road dips and weaves through high bushes and snarls of vicious brambles."],"exits":[{"to":529,"exit":"northeast","move":"northeast"},{"to":527,"exit":"northwest","move":"northwest"}]},
  {"id":529,"x":720,"y":2170,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["The narrow road rises up to the peak of a small hill, rife with tangled bushes.  A broken, berry-stained wooden pail lies shattered on the side of the road."],"exits":[{"to":530,"exit":"east","move":"east"},{"to":528,"exit":"southwest","move":"southwest"}]},
  {"id":530,"x":740,"y":2170,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["The path glides gently down a low rise toward the open ocean.  A small step ladder stands to one side of the road, overcome by creeping vines of bramble and raspberry."],"exits":[{"to":531,"exit":"east","move":"east"},{"to":529,"exit":"west","move":"west"}]},
  {"id":531,"x":760,"y":2170,"z":0,"title":"Marja Tee, Kaber Jise","descriptions":["A soft breeze carries the faint scent of the sea from the east.  The road begins to widen as if to hasten travelers towards the shore.  Interspersed with bramble and berry bushes are wild sirese flowers, their bright blooms swaying gently in the wind."],"exits":[{"to":532,"exit":"east","move":"east"},{"to":530,"exit":"west","move":"west"}]},
  {"id":532,"x":780,"y":2170,"z":0,"title":"Marja Tee, Babukaz Masi","descriptions":["Dozens of wild raspberry bushes intermingled with clumps of sweet woodruff attempt to encroach upon the widening road.  Small woodland critters scamper beneath the brush, knocking ripe berries to the ground."],"exits":[{"to":533,"exit":"east","move":"east"},{"to":531,"exit":"west","move":"west"}]},
  {"id":533,"x":800,"y":2170,"z":0,"title":"Marja Tee, Babukaz Masi","descriptions":["Atop a small hill, the road crests just high enough to see a bay to the east.  The fresh smell from the sea is strong and mingles with the scent of ripe raspberries that hang from the many bushes attempting to trespass upon the widening road."],"exits":[{"to":534,"exit":"east","move":"east"},{"to":532,"exit":"west","move":"west"}]},
  {"id":534,"x":820,"y":2190,"z":0,"title":"Arthe Dale, Busar Saaf","descriptions":["A small harbor with several brightly painted docks cheerfully greets seafaring visitors to the small community of Arthe Dale.  A few seagulls can be seen greedily pecking at ripe berries pilfered from the many bushes that flank a road leading westward."],"exits":[{"to":533,"exit":"go","move":"go road"}],"aliases":["Harbor"]},
  {"id":535,"x":480,"y":2090,"z":0,"title":"Arthe Dale, Taffelberry Path","descriptions":["Taffelberry Path, named after the favorite food of the Arthe Dale residents, is a straight, well-kept lane that heads further into the village to the north and back to the village gate to the south.  A group of rollicking Halfling lads passes you, laughing and elbowing each other, as they move eagerly toward an attractive red building to the east."],"exits":[{"to":536,"exit":"north","move":"north"},{"to":553,"exit":"east","move":"east"},{"to":514,"exit":"south","move":"south"}]},
  {"id":536,"x":480,"y":2070,"z":0,"title":"Arthe Dale, Taffelberry Path","descriptions":["Open areas flank both sides of the path at this point.  A charming little park extends to the west, and an open-air marketplace is situated to the east.  A Halfling pushing a wheelbarrow filled with fresh vegetables heads toward one of the market's wooden stands."],"exits":[{"to":538,"exit":"north","move":"north"},{"to":554,"exit":"east","move":"east"},{"to":535,"exit":"south","move":"south"},{"to":537,"exit":"west","move":"west"}]},
  {"id":537,"x":460,"y":2070,"z":0,"title":"Arthe Dale, Greensward","descriptions":["This charming park is alive with a medley of brilliant colors and sachet scents coming from the beds of primrose, hollyhock, larkspur and delphinium.  An iridescent green hummingbird darts from flower to flower, trying to avoid a group of giggling Halfling children who are rolling and somersaulting in the grass.  The carved garden bench looks like a pleasant spot to sit and enjoy the scene.  You can see a small shrine to the west, while a thumping sound comes from beyond the bushes to the north.","The park takes on a special magic at night when the tall spires of white delphinium and the beds of evening primrose luminously reflect the moonlight with a silvery glow, adding a delicate perfume to the night air.  A young Halfling couple passes you, strolling hand in hand and whispering softly to each other.  A carved garden bench provides a peaceful place to sit and enjoy the pleasant stillness of the night."],"exits":[{"to":544,"exit":"north","move":"north"},{"to":536,"exit":"east","move":"east"},{"to":546,"exit":"south","move":"south"},{"to":545,"exit":"west","move":"west"}]},
  {"id":538,"x":480,"y":2050,"z":0,"title":"Arthe Dale, Taffelberry Path","descriptions":["The path continues north and south, lined with a row of colorful sicle trees to the east and low bushes to the west.  A small meadow mouse, alarmed by your approach, scurries through an opening in the bushes."],"exits":[{"to":539,"exit":"north","move":"north"},{"to":536,"exit":"south","move":"south"},{"to":544,"exit":"west","move":"west"}]},
  {"id":539,"x":480,"y":2030,"z":0,"title":"Arthe Dale, Crossroads","descriptions":["The village's three main paths meet at this intersection.  Attractive shops with brightly colored awnings line Glaysker Lane to the east.  The quiet, shrub-bordered Tanglefoot Row heads north to the residential section, and you can see the village gate at the end of Taffelberry Path to the south."],"exits":[{"to":540,"exit":"north","move":"north"},{"to":579,"exit":"east","move":"east"},{"to":538,"exit":"south","move":"south"},{"to":543,"exit":"west","move":"west"}]},
  {"id":540,"x":480,"y":2010,"z":0,"title":"Arthe Dale, Tanglefoot Row","descriptions":["Tall, neatly-pruned hedgerows line the street, providing some privacy for the homes beyond, where Halfling residents move about, absorbed in domestic chores.  On one side a small woman hangs freshly washed pink and yellow sheets from a line, and on the other a man works at whitewashing a fence.  A small dragonfly whirs past you, alighting on one of the hedges briefly before continuing on its journey.","Tall, neatly-pruned hedgerows line the street, providing some privacy for the homes beyond, where warm lights glow in the darkness.  In one window, you can see a small man playing a fiddle, and a foot-tapping tune is carried down the lane with the breeze.  Another frames a Halfling couple standing in a lit doorway, lovingly gazing at their sleeping children.  A radiant firebug hovers in front of you for a moment before continuing on its journey through the night."],"exits":[{"to":541,"exit":"north","move":"north"},{"to":539,"exit":"south","move":"south"}]},
  {"id":541,"x":480,"y":1990,"z":0,"title":"Arthe Dale, Tanglefoot Row","descriptions":["A small dwelling has been built into the side of a hill here.  White curtains flutter in the windows that open out from the sod-covered walls.  Several small carving tools have been left on a wooden bench, and bits of wood shavings lay discarded below it."],"exits":[{"to":542,"exit":"north","move":"north"},{"to":540,"exit":"south","move":"south"},{"to":570,"exit":"go","move":"go small dwelling"}]},
  {"id":542,"x":480,"y":1970,"z":0,"title":"Arthe Dale, Tanglefoot Row","descriptions":["The lane ends to the north at the eccentric home of Arthe Dale's oldest, largest and wealthiest family, the Tanglefoots.  A freshly-painted white picket fence surrounds the property, and you can see a large well-tended yard beyond it."],"exits":[{"to":541,"exit":"south","move":"south"},{"to":571,"exit":"go","move":"go arched gateway"}]},
  {"id":543,"x":460,"y":2030,"z":0,"title":"Arthe Dale, Cul-de-sac","descriptions":["The path circles around a bed of dark green ivy that has grown up over a white statue standing in the center.  A bright yellow building with blue shutters and colorful flowerboxes faces you.  There is a painted sign mounted next to the open doorway.  A Halfling female, her nose stuck in a notebook, wanders by, almost bumping into you as she heads toward the building.  She absentmindedly knocks on the sign (for luck?), as she enters the doorway, still concentrating on her notes."],"exits":[{"to":539,"exit":"east","move":"east"},{"to":569,"exit":"go","move":"go yellow building"}]},
  {"id":544,"x":460,"y":2050,"z":0,"title":"Arthe Dale, Greensward","descriptions":["This section of the park is an unadorned grassy strip, edged with low bushes.  At the far end a painted target has been set up.  A large number of rocks lay discarded at its base.  A Halfling man whirls his sling and sends a stone hurtling toward the target, hitting it dead center with a loud thunk."],"exits":[{"to":538,"exit":"east","move":"east"},{"to":537,"exit":"south","move":"south"}]},
  {"id":545,"x":420,"y":2070,"z":0,"title":"Arthe Dale, Shrine","descriptions":["A simple shrine has been erected in the niche of a large stony outcrop.  Moonflower vines climb the column, twining their way around the opening, their brilliant white blossoms providing a festive border.  A carved figure of Glythtide has been set inside the niche."],"exits":[{"to":537,"exit":"east","move":"east"}],"color":"#A6A3D9","aliases":["Shrine1-09","Glythtide"]},
  {"id":546,"x":460,"y":2090,"z":0,"title":"Arthe Dale, Greensward","descriptions":["A giant oak tree stands erect here, its massive branches reaching out to form a canopy over the local swimming hole.  Some sort of wooden structure is nestled in the foliage high up in the tree.  The grassy area surrounding the swimming hole appears to be a perfect spot for picnicking or lounging."],"exits":[{"to":537,"exit":"north","move":"north"},{"to":547,"exit":"climb","move":"climb oak tree"}],"aliases":["Greensward"]},
  {"id":547,"x":450,"y":2080,"z":0,"title":"Arthe Dale, Tree House","descriptions":["This wooden house has been constructed in the upper branches of the old oak tree as a play area for any of the village children daring enough to venture up to this height.  A colorful rug braided from strips of yellow, blue and green cloth covers the floor, and several plump pillows are scattered around it.  One wall opens out to a narrow ramp that extends along a heavy branch."],"exits":[{"to":546,"exit":"climb","move":"climb oak tree"},{"to":548,"exit":"go","move":"go narrow ramp"}]},
  {"id":548,"x":420,"y":2080,"z":0,"title":"Tree House, Ramp","descriptions":["The narrow wooden ramp extends out from the tree along one of its branches.  Oak leaves rustle softly around you, and through them the lights from Arthe Dale's homes twinkle like bright fireflies.  From somewhere off in the distance, the sweet melody of a lone flute hovers in the air.  Suspended high above the swimming hole, the branch is a good place for making an impressive dive into the water directly below.  An open doorway behind you leads back into the treehouse.","The narrow wooden ramp extends out from the tree along one of its branches.  Oak leaves rustle softly around you, and through them a panoramic view of Arthe Dale is spread out in all directions. Suspended high above the swimming hole, it occurs to you that you could make an impressive dive into the deep water from this height.  An open doorway behind you leads back into the treehouse."],"exits":[{"to":547,"exit":"go","move":"go open doorway"},{"to":549,"exit":"none","move":"dive swimming hole"}]},
  {"id":549,"x":420,"y":2090,"z":0,"title":"Arthe Dale, Swimming Hole","descriptions":["Clear water fills this natural swimming hole - cool and briskly refreshing, it ripples over the smooth rock bottom.  Rays of moonlight filter through the oak tree's branches that form a leafy roof overhead.","Clear water fills this natural swimming hole - cool and briskly refreshing, it ripples over the smooth rock bottom.  Rays of light filter through the oak tree's branches that form a leafy roof overhead."],"exits":[{"to":552,"exit":"south","move":"swim south"},{"to":550,"exit":"west","move":"swim west"},{"to":546,"exit":"climb","move":"climb embankment"}],"color":"#0000FF","aliases":["Swimming Hole"]},
  {"id":550,"x":400,"y":2090,"z":0,"title":"Arthe Dale, Swimming Hole","descriptions":["A flowering crabtree grows beside the pond, stretching out its branches over the still waters and casting its pale pink blossoms in the breeze.  Tall hedges edge the swimming hole here, blocking off the view of the surrounding greensward."],"exits":[{"to":549,"exit":"east","move":"swim east"},{"to":551,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":551,"x":400,"y":2110,"z":0,"title":"Arthe Dale, Swimming Hole","descriptions":["Tiny brown pondskippers hop along the cool clear water, creating ripples of outwardly expanding circles.  Tall hedges edge the swimming hole here, blocking off the view of the surrounding greensward."],"exits":[{"to":550,"exit":"north","move":"swim north"},{"to":552,"exit":"east","move":"swim east"}],"color":"#0000FF"},
  {"id":552,"x":420,"y":2110,"z":0,"title":"Arthe Dale, Swimming Hole","descriptions":["Creamy white water lilies float lazily along the surface of the water, emitting a sweet, heady scent in the air.  Tall hedges edge the swimming hole here, blocking off the view of the surrounding greensward."],"exits":[{"to":549,"exit":"north","move":"swim north"},{"to":551,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":553,"x":500,"y":2090,"z":0,"title":"Arthe Dale, Inn Courtyard","descriptions":["This is the courtyard of an old-fashioned country inn, stoutly constructed of red brick.  Beds of cheery marigolds border the building, while a colorful signboard hangs from a sunflower-yellow awning above the door.  Sounds of laughter and happy conversation drift from an open window.  A little dirt path curves around toward the rear of the inn.","The door of this stout brick building stands open, and warm light pours out invitingly.  A large signboard hanging from an awning sways in the breeze, making creaking noises that accompany the sounds of laughter, singing and merriment coming from an open window.  A little dirt path curves around toward the rear of the inn."],"exits":[{"to":554,"exit":"north","move":"north"},{"to":535,"exit":"west","move":"west"},{"to":555,"exit":"go","move":"go open stable"},{"to":560,"exit":"go","move":"go country inn"}]},
  {"id":554,"x":500,"y":2070,"z":0,"title":"Arthe Dale, Farmers' Market","descriptions":["The Arthe Dale market is bustling with activity day and night.  Early morning travelers often stop in to chat with other adventurers, as they look over the local farmers' bountiful displays of fresh produce and home-baked treats, while late night visitors to the adjacent inn's common room usually come by for a sobering cup of hot coffee before heading home.  Plain wooden tables and benches offer a place for snacking, rest or conversation."],"exits":[{"to":553,"exit":"south","move":"south"},{"to":536,"exit":"west","move":"west"},{"to":556,"exit":"go","move":"go path"},{"to":559,"exit":"go","move":"go refreshment booth"}]},
  {"id":555,"x":510,"y":2090,"z":0,"title":"Arthe Hollow Inn, Caravan Stable","descriptions":["The fresh smell of hay and the sounds of snorts and whinnies fill the immaculately-tended stable.  The ponies belonging to the guests and the Burdock family are diligently looked after here by young Nubbin Burdock.  The young Halfling boy pauses in his grooming chores to pull a sicle fruit from his pocket and feed it to one of the ponies."],"exits":[{"to":553,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Caravan Stable Arthe Dale"]},
  {"id":556,"x":500,"y":2050,"z":0,"title":"Arthe Dale, Community Garden","descriptions":["Row upon row of cabbages, carrots, potatoes and turnips have been planted in this garden plot.  The industrious Halflings of Arthe Dale have maintained it well.  The rows are neatly arranged, and there is not a weed in sight.  A tiny ladybug flutters from plant to plant, sometimes thrown off her course by the gentle breeze."],"exits":[{"to":557,"exit":"east","move":"east"},{"to":554,"exit":"go","move":"go path"}],"aliases":["Garden","Community Garden"]},
  {"id":557,"x":520,"y":2050,"z":0,"title":"Arthe Dale, Community Garden","descriptions":["A large section of the garden plot has been set aside for the small shrubs of deep green glossy leaves that bear the village's beloved taffelberries.  The branches of the low-growing bushes are laden with juicy black berries."],"exits":[{"to":558,"exit":"east","move":"east"},{"to":556,"exit":"west","move":"west"}]},
  {"id":558,"x":540,"y":2050,"z":0,"title":"Arthe Dale, Community Garden","descriptions":["A modwyn vine arbor stands on the eastern edge of the garden.  Heavy clusters of grape-like modwyn fruit hang temptingly, waiting to be picked.  A large, low vat sits off to the side of the arbor."],"exits":[{"to":557,"exit":"west","move":"west"}]},
  {"id":559,"x":510,"y":2070,"z":0,"title":"Farmer's Market, Refreshment Stand","descriptions":["The mouth-watering aroma of baking dough and cinnamon makes your stomach rumble as you examine the tempting treats displayed in the glass case.  A Halfling lass adds a tray of freshly baked crullers to the tantalizing array."],"exits":[{"to":554,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Refreshment Stand"]},
  {"id":560,"x":500,"y":2110,"z":0,"title":"Arthe Hollow Inn, Front Room","descriptions":["The Arthe Hollow Inn has a warm, homey atmosphere, accentuated by the comfortably low ceilings and the acanth wood paneling.  The murmur of conversation and a ripple of laughter come from an open archway.  Wilibald Burdock, the exceptionally short (even by Halfling standards) and completely round innkeeper, is carefully polishing the paneling to a glossy finish."],"exits":[{"to":553,"exit":"out","move":"out"},{"to":561,"exit":"go","move":"go secluded corner"},{"to":562,"exit":"go","move":"go small hallway"},{"to":564,"exit":"go","move":"go large corridor"},{"to":566,"exit":"go","move":"go open archway"}]},
  {"id":561,"x":490,"y":2100,"z":0,"title":"Arthe Hollow Inn, Secluded Corner","descriptions":["A pitted brass sconce bearing a sputtering candle casts a cheerful glow upon this cozy niche.  Nestled close to a small oak table is a wooden chair with a colorful soft cushion tied to the seat with bright orange twine.  Securely attached to the acanth wood paneling is a sturdy shelf."],"exits":[{"to":560,"exit":"out","move":"out"}],"aliases":["Inn Library"]},
  {"id":562,"x":490,"y":2110,"z":0,"title":"Arthe Hollow Inn, Hallway","descriptions":["The small low hallway leads to some of the guests' chambers.  Judging from the height of the ceiling, only a Halfling would enjoy a stay in this section of the inn.  A round green door leads to one of the rooms."],"exits":[{"to":560,"exit":"out","move":"out"},{"to":563,"exit":"go","move":"go round door"}],"color":"#00FFFF"},
  {"id":563,"x":490,"y":2120,"z":0,"title":"Arthe Hollow Inn, Sicle Room","descriptions":["The apple green walls of this cheerful room are accented with three still-life paintings of bright red sicle fruit.  A small feather bed is covered with a soft down comforter, and a canary yellow chair sits next to a round window.  A bowl of fresh sicle fruit has been placed on a small table next to the chair."],"exits":[{"to":562,"exit":"go","move":"go round door"}]},
  {"id":564,"x":500,"y":2120,"z":0,"title":"Arthe Hollow Inn, Corridor","descriptions":["The upward sloping ceilings and tall doors make this area more comfortable for the guests of a larger size.  The acanth wood paneling from the front room continues down the hall, and the walls above it are painted a creamy pale yellow.  A carved wooden door is trimmed with a flowery design."],"exits":[{"to":560,"exit":"out","move":"out"},{"to":565,"exit":"go","move":"go wooden door"}],"color":"#00FFFF"},
  {"id":565,"x":500,"y":2130,"z":0,"title":"Arthe Hollow Inn, Rose Room","descriptions":["A sizable four-poster bed, covered with a deep green flowery comforter, is the focal point of this tasteful room.  A wing chair, upholstered in the same forest green print, sits in the corner next to a mahogany end table.  The walls are the palest doeskin tan, and the windows are draped with milky white fabric.  A rosy water pitcher in a matching ceramic bowl has been placed on the table."],"exits":[{"to":564,"exit":"go","move":"go wooden door"}]},
  {"id":566,"x":510,"y":2110,"z":0,"title":"Arthe Hollow Inn, Common Room","descriptions":["The room is filled with jovial conversation, laughter, much toasting and a layer of smoky haze.  Guests of all races mingle at the long, low tables.  A Halfling holding a very large mug of beer jumps in front of the stone fireplace, lets out a whoop and bursts into a spontaneous song.  Daisy Burdock, the inn's waitress, maneuvers adeptly through the crowd carrying a tray of mugs and occasionally glancing out the window.  A menu is posted at the archway next to a prominent sign.","The room is filled with long, low tables and stools, where several people sit eating hearty bowls of Arthe Hollow's popular lamb stew.  A large stone fireplace dominates one wall.  Daisy Burdock, the inn's cook and waitress, crosses the room carrying a precarious arrangement of bowls and plates.  She stops briefly to tease and joke with a regular customer or glance out the window.  A sign is posted prominently next to the archway."],"exits":[{"to":560,"exit":"out","move":"out"},{"to":567,"exit":"go","move":"go open doorway"},{"to":568,"exit":"climb","move":"climb wooden stairs"}],"color":"#FF0000","aliases":["Arthe Hollow Inn"]},
  {"id":567,"x":510,"y":2120,"z":0,"title":"Arthe Hollow Inn, Dance Hall","descriptions":["This low, snug hall is filled with music and laughter at all hours of the day and night, as the village residents never seem to lose their passion for dance and drink.  Silk streamers dyed with vibrant reds, blues and yellows drape out from the center of the ceiling and hang down the walls.  Lively music is provided by a group of Halfling minstrels, and the heady aroma of roasted meat wafts through the air."],"exits":[{"to":566,"exit":"out","move":"out"}]},
  {"id":568,"x":520,"y":2110,"z":0,"title":"Arthe Hollow Inn, Cellar","descriptions":["Candle sconces light the stone cellar, revealing walls lined with wine racks and rows of beer kegs.  A worktable takes up the center of the room, and a wooden cabinet sits nearby.  Despite the dimly lit dampness, the room is immaculately neat with not a cobweb in sight."],"exits":[{"to":566,"exit":"climb","move":"climb wooden stairs"}]},
  {"id":569,"x":450,"y":2030,"z":0,"title":"Swotting Hall, Public Foyer","descriptions":["Traders mill about in the foyer, dressed in fine clothing of colorful silken or woolen fabrics sparkled with gleaming gold and jewels.  You pick up bits of conversation about the current prices or the quality of goods in various areas, as the tradesmen wander past you.  Occasionally, a young student, notebook in hand, moves meekly among them with a wide-eyed, awed expression."],"exits":[{"to":543,"exit":"out","move":"out"},{"to":637,"exit":"go","move":"go wood door"}]},
  {"id":570,"x":470,"y":1990,"z":0,"title":"Small Dwelling, Main Room","descriptions":["The walls of this one-room cottage are painted a dappled pale blue and white.  Woven blue-green fabric shot with pale peach covers the bed and adjacent loveseat.  The white curtains on the window rise and fall gently with the breeze.  A carved walking stick rests on a workbench surrounded by tiny curls of wood."],"exits":[{"to":541,"exit":"out","move":"out"}]},
  {"id":571,"x":480,"y":1960,"z":0,"title":"Arthe Dale, Front Yard","descriptions":["This long, low building is a strange and fascinating sight to behold.  Enlarged over the years by various creative builders, it contains several add-on sections, each constructed from completely different materials and each displaying its own oddly-shaped windows in the forms of circles, crosses, crescents and stars.  The many clashing parts manage to merge together into a whimsically enchanting whole.  A painted sign is mounted on the carved wooden door.","Bright shapes of circles, crosses, crescents and stars glow mysteriously, floating in the darkness in front of you like a row of jack-o-lanterns.  You notice the dim silhouette of an oddly shaped building behind them, and you realize that the glowing shapes are brightly lit windows.  A sign has been mounted on the door of the house."],"exits":[{"to":542,"exit":"out","move":"out"},{"to":572,"exit":"go","move":"go wooden door"}]},
  {"id":572,"x":480,"y":1950,"z":0,"title":"Tanglefoot House, Living Room","descriptions":["This cheerful room might once have been considered pleasantly decorated.  The lustrous sheen of the dark wood paneling and the artfully carved trim can still be seen in places, but much of the pleasant decor has been obscured by the incredible collection of souvenirs, knick-knacks, and various odds and ends that fill every nook and cranny.  As a result, the room has the same comfortable, thrown-together appeal as the outside of the house.  Several chairs are gathered cozily in front of a stone fireplace.","The glow from the burning fireplace fills the room with a warm light.  An incredible collection of souvenirs, knickknacks, toys and various odds and ends fills every nook and cranny of the room, casting peculiarly-shaped shadows on the walls."],"exits":[{"to":575,"exit":"north","move":"north"},{"to":573,"exit":"east","move":"east"},{"to":574,"exit":"west","move":"west"},{"to":571,"exit":"go","move":"go wooden door"}],"aliases":["Tanglefoot House"]},
  {"id":573,"x":490,"y":1950,"z":0,"title":"Tanglefoot House, Woolly's Room","descriptions":["This austere room belongs to the head of the Tanglefoot family.  A narrow bed covered with a brown flannel blanket and a plain wooden table and chair are the only furnishings here.  An old worn duffel bag sits in the corner, unused for years, but never forgotten.  A small sword is mounted on the wall above a wooden rack holding several hand-carved pipes."],"exits":[{"to":572,"exit":"west","move":"west"}]},
  {"id":574,"x":470,"y":1950,"z":0,"title":"Tanglefoot House, Nursery","descriptions":["This is the room that houses the youngest of the Tanglefoot clan.  The ceiling has been fancifully painted sky blue with fleecy white clouds.  There are several short beds here, each neatly covered with a colorful quilt.  A large wooden cupboard takes up most of one wall, and occasionally a tiny Halfling child rushes into the room, grabs something from the cupboard, and bounces out happily.  Star-shaped windows overlook the garden, and stalks of snapdragons peek over the sills.","This is the room that houses the youngest of the Tanglefoot clan.  There are several short beds here, each neatly covered with a colorful quilt, and each quilt covering the form of a small sleeping child.  A large wooden cupboard takes up most of one wall."],"exits":[{"to":572,"exit":"east","move":"east"}]},
  {"id":575,"x":480,"y":1940,"z":0,"title":"Tanglefoot House, Dining Room","descriptions":["A huge oaken table dominates this large room.  This is the gathering place for the entire Tanglefoot clan.  A large assortment of straight-backed wooden chairs surround the long table, and a white runner edged with embroidered yellow butterflies and blue morning glories spans the length.  White ceramic candle sconces with the same butterflies and flowers are spaced regularly around the walls at a convenient height."],"exits":[{"to":572,"exit":"south","move":"south"},{"to":576,"exit":"west","move":"west"}]},
  {"id":576,"x":470,"y":1940,"z":0,"title":"Tanglefoot House, Kitchen","descriptions":["This cheery room is kept immaculately clean.  Round windows, curtained in bright yellow gingham, open out to the garden.  A reed basket, overflowing with crisp lettuce and bright red radishes, has been placed on a trestle table in front of the windows.  A brilliant blue pitcher filled with yellow tulips sits next to the basket.  The delicious aroma of baking bread wafts from a large oven.","The kitchen is quiet and dark at this time of the night, but there are signs of someone's late snack left next to an old ice box.  The windows are open, and an evening breeze ruffles the curtains.  Ingredients for tomorrow morning's bread have been neatly arranged on the trestle table."],"exits":[{"to":575,"exit":"east","move":"east"},{"to":577,"exit":"go","move":"go back door"}]},
  {"id":577,"x":460,"y":1940,"z":0,"title":"Tanglefoot House, Kitchen Garden","descriptions":["A small kitchen garden is set conveniently close to the back door of the house.  Neat rows of lettuce and spinach fill the plot with alternating stripes of pale and deep greens.  Off in the corner, you can see old Woolly Tanglefoot's personal crop of pipeweed.  A stone path curves from the door around to a small wooden shed.","The bright moonlight reveals row after row of leafy plants in this orderly little garden.  A large snail leaves a wet iridescent trail across the back door stoop.  In the corner of the yard you can see the vague outline of a squat shed. "],"exits":[{"to":578,"exit":"go","move":"go small shed"},{"to":576,"exit":"go","move":"go back door"}]},
  {"id":578,"x":450,"y":1940,"z":0,"title":"Tanglefoot House, Shed","descriptions":["Neatly arranged hoes, rakes, spades and other garden tools line the walls.  Woven gathering baskets, some empty, some filled with bags of seeds, occupy one corner of the shed.  A wooden wheelbarrow has been left next to the door.  Bunches of drying herbs and flowers hang from the low ceiling."],"exits":[{"to":577,"exit":"out","move":"out"}]},
  {"id":579,"x":500,"y":2030,"z":0,"title":"Arthe Dale, Glaysker Lane","descriptions":["The pale lavender-pink glaysker flowers that have been planted along the length of this cobblestone street breathe a subtle sweet fragrance into the air.  Your eye is caught by an attractive display in the window of a simple white cottage with a thatched roof and a light purple awning."],"exits":[{"to":580,"exit":"east","move":"east"},{"to":539,"exit":"west","move":"west"},{"to":584,"exit":"go","move":"go white cottage"},{"to":585,"exit":"go","move":"go painted door"}],"aliases":["Glaysker Lane"]},
  {"id":580,"x":520,"y":2030,"z":0,"title":"Arthe Dale, Glaysker Lane","descriptions":["A curious arrangement of objects has been grouped on either side of the doorway of a building, which is almost completely obscured by the entangled maiden's tress vines that grow up the sides and over the roof.  Stuffed animals, stone statues, pieces of furniture, a sundial, and assorted carved walking staves form a bizarre tableau.  A statue next to the door holds a plaque."],"exits":[{"to":581,"exit":"east","move":"east"},{"to":579,"exit":"west","move":"west"},{"to":586,"exit":"go","move":"go door"}]},
  {"id":581,"x":540,"y":2030,"z":0,"title":"Arthe Dale, Glaysker Lane","descriptions":["Small shops line the lane that bends from the northeast to the west.  A shamrock green awning tops the doorway to a yellow building with a matching green sign mounted on the wall.  A single pure note from a melancholy flute floats out from the doorway."],"exits":[{"to":582,"exit":"northeast","move":"northeast"},{"to":580,"exit":"west","move":"west"},{"to":587,"exit":"go","move":"go yellow building"}]},
  {"id":582,"x":560,"y":2010,"z":0,"title":"Arthe Dale, Glaysker Lane","descriptions":["As you pause for a moment on the cobblestoned lane, your eye is caught by the entrance to a squat stone building with a blue awning.  A dazzling silver sword has been securely mounted to the arched entryway above a small engraved plaque."],"exits":[{"to":583,"exit":"northeast","move":"northeast"},{"to":581,"exit":"southwest","move":"southwest"},{"to":638,"exit":"go","move":"go arched entryway"}]},
  {"id":583,"x":580,"y":1990,"z":0,"title":"Arthe Dale, Glaysker Lane","descriptions":["The festive glaysker blossoms that edge the lane provide a striking contrast to a homely wooden shack that sits unadorned and colorless at the side of the path.  A plain wooden signpost stands at the shack's entrance."],"exits":[{"to":606,"exit":"east","move":"east"},{"to":589,"exit":"southeast","move":"southeast"},{"to":582,"exit":"southwest","move":"southwest"},{"to":588,"exit":"go","move":"go wooden shack"}]},
  {"id":584,"x":500,"y":2020,"z":0,"title":"Phoebe's Fashions, Sales Room","descriptions":["Racks and shelves are filled with a kaleidoscopic display of small clothing for men and women.  Phoebe Woodcock, talented village seamstress, is standing in front of a rack methodically arranging shirts according to color.  She pauses to give a flirtatious smile to an attractive male Halfling customer."],"exits":[{"to":579,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Phoebe's Fashions","Clothing"]},
  {"id":585,"x":500,"y":2040,"z":0,"title":"Quellia's Thread Shop, Sales Room","descriptions":["Sturdy white fabric hangs on three of the walls in the shop, displaying colorful designs and patterns of embroidery stitchwork, and long swatches of masterfully dyed thread display a myriad of colors.  Nearly hidden by fabrics and patterns piled on the counter is the shop's catalog, embellished with a delicately embroidered cotton cover."],"exits":[{"to":579,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Quellia's Thread Shop","Embroidery"]},
  {"id":586,"x":520,"y":2020,"z":0,"title":"Odds 'n Ends, Sales Room","descriptions":["A gilded birdcage containing a wind-up parrot is suspended near the doorway.  Glass cases line the walls, displaying practical items alongside rare oddities.  A stuffed leucro head, which has been mounted on the wall, stares down at you with its sharp teeth exposed.  The owner of the shop, Rufus Tanglefoot, looks up from combing his foothair and smiles at you expectantly."],"exits":[{"to":580,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Odds 'n Ends","Rufus"]},
  {"id":587,"x":550,"y":2030,"z":0,"title":"Barley Bulrush, Bardic Ballads","descriptions":["The walls of this small shop are lined with pigeonholes filled with scrolls.  The proprieter, Barley Bulrush, sits at the back behind a desk that also serves as a counter.  A carved wooden flute sits on the countertop, always near to him.  A thick black curtain behind him marks the division between the shop and the owner's dwelling."],"exits":[{"to":581,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Bardic Ballads","Barley","Music"]},
  {"id":588,"x":580,"y":1980,"z":0,"title":"Feta's Kitchen, Fresh Dairy and Baked Goods","descriptions":["A tidy room more reminiscent of a country kitchen than a shop, this is a bright and cheerful place filled with the aroma of fresh cheeses, breads and other foods.  Attached to one wall, a straw basket of fresh flowers brings a splash of color to the room.  An open window reveals a clean, straw-filled stable."],"exits":[{"to":583,"exit":"out","move":"out"},{"to":858,"exit":"north","move":""}],"color":"#FF0000","aliases":["Feta's Kitchen"]},
  {"id":589,"x":640,"y":2050,"z":0,"title":"Berry Knolls, Taffelberry Trail","descriptions":["Large oak trees line this well-traveled trail as it winds its way towards a secluded community nestled among the surrounding low-lying hills.  Wind-borne glaysker seeds have found a cozy home at the base of some of the trees, growing in an array of lavender and pink blooms.  Clay pots of carefully tended taffelberry bushes sit at measured intervals along the path."],"exits":[{"to":590,"exit":"east","move":"east"},{"to":583,"exit":"northwest","move":"northwest"}]},
  {"id":590,"x":660,"y":2050,"z":0,"title":"Berry Knolls, Taffelberry Trail","descriptions":["The hills encircle diminutive knolls clustered about a small village green within the valley.  The hardened earth of the trail forks to meander its way past humble homes constructed within each knoll.  The scent of ripened berries wafts on the breeze."],"exits":[{"to":601,"exit":"northeast","move":"northeast"},{"to":591,"exit":"east","move":"east"},{"to":589,"exit":"west","move":"west"}],"color":"#00FFFF","aliases":["Berry Knolls"]},
  {"id":591,"x":700,"y":2050,"z":0,"title":"Berry Knolls, Loganberry Place","descriptions":["Simple white arbors stand at the entrance of each path to the knolls.  Plump purple loganberries dangle amongst the deep green leaves of the bushes.  A copse of oak trees lines the back of the lots, creating pools of ever-changing shadows upon the ground."],"exits":[{"to":600,"exit":"northeast","move":"northeast"},{"to":592,"exit":"east","move":"east"},{"to":590,"exit":"west","move":"west"},{"to":601,"exit":"northwest","move":"northwest"},{"to":603,"exit":"go","move":"go narrow path"}],"color":"#00FFFF"},
  {"id":592,"x":720,"y":2050,"z":0,"title":"Berry Knolls, Loganberry Place","descriptions":["The stone-lined road continues from the northeast to the west, separating the grass-covered knolls to the south from an enormous tree at the center of the community.  Yellow and orange mums circle around the base of a a smaller oak at the side of the path, bobbing their bright, flowery heads in the breeze as if dancing in a merry child's game."],"exits":[{"to":600,"exit":"north","move":"north"},{"to":593,"exit":"northeast","move":"northeast"},{"to":591,"exit":"west","move":"west"},{"to":605,"exit":"go","move":"go narrow path"}],"color":"#00FFFF"},
  {"id":593,"x":760,"y":2030,"z":0,"title":"Berry Knolls, Strawberry Way","descriptions":["A strawberry patch has found its way from a nearby home to a white picket fence that borders the east side of the village green.  Weaving their way around each wooden picket, the strawberry vines create a tapestry of bright red teardrop fruits nestled among deep green leaves."],"exits":[{"to":594,"exit":"north","move":"north"},{"to":592,"exit":"southwest","move":"southwest"},{"to":600,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":594,"x":760,"y":2010,"z":0,"title":"Berry Knolls, Strawberry Way","descriptions":["The scent of sweet strawberries fills the air surrounding the stone-lined path.  A cord of wood sits neatly stacked by one of the colorful round doors that decorate the surrounding knolls.  Near the woodpile, a hatchet sits partially buried in a stump, awaiting its next call to duty."],"exits":[{"to":595,"exit":"northeast","move":"northeast"},{"to":593,"exit":"south","move":"south"},{"to":600,"exit":"west","move":"west"},{"to":599,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":595,"x":790,"y":1980,"z":0,"title":"Berry Knolls, Olallieberry Circle","descriptions":["A large, round hill separates this exclusive part of the community from the daily hustle and bustle nearby.  The deep green grass on this side of the hill is carefully manicured to the perfect height, nary a blade poking above the heads of its neighbors.  An olallieberry bush with its large, ruby-red fruits weaves itself through a picket fence that borders the brick path."],"exits":[{"to":594,"exit":"southwest","move":"southwest"},{"to":596,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":596,"x":760,"y":1950,"z":0,"title":"Berry Knolls, Olallieberry Circle","descriptions":["Ornately carved round doors mark the entrances to the affluent homes set in perfectly manicured knolls of dark, grass-covered earth.  Well-tended gardens filled with an abundance of flowers hug closely to each doorway, showing a year-round display of bright colors and pleasant scents."],"exits":[{"to":595,"exit":"southeast","move":"southeast"},{"to":597,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":597,"x":740,"y":1950,"z":0,"title":"Berry Knolls, Olallieberry Circle","descriptions":["A paved brick road circles around the large hillside to meander through this affluent portion of the village.  Trained to grow over a pristine white wood arbor, a nearby olallieberry bush tempts passersby with its brightly colored fruits dangling amidst bright, green leaves."],"exits":[{"to":596,"exit":"east","move":"east"},{"to":598,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":598,"x":720,"y":1970,"z":0,"title":"Berry Knolls, Boysenberry Crest","descriptions":["Brightly painted round doors mark the entrances to the grassy knolls that border the northwest side of the road.  A single boysenberry plant in the corner of one yard has been trained to grow as a tree, its tangled branches reaching down to sweep along the ground."],"exits":[{"to":597,"exit":"northeast","move":"northeast"},{"to":599,"exit":"east","move":"east"},{"to":600,"exit":"south","move":"south"},{"to":602,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":599,"x":740,"y":1990,"z":0,"title":"Berry Knolls, Boysenberry Crest","descriptions":["Skirting along the southwest base of a large hill, the road curves its way easterly past peaceful dwellings as it continues to wrap the edge of the village green.  Small tended gardens of herbs and flowers snuggle up to the walkways of the homes within the knolls."],"exits":[{"to":594,"exit":"southeast","move":"southeast"},{"to":600,"exit":"southwest","move":"southwest"},{"to":598,"exit":"west","move":"west"},{"to":769,"exit":"go","move":"go red-painted door"}],"color":"#00FFFF"},
  {"id":600,"x":720,"y":2010,"z":0,"title":"Berry Knolls, Village Green","descriptions":["An immense oak tree shelters a clear, sparkling pond beneath its leafy branches that canopy the village green from the weather.  The thick roots of the tree have broken through the compacted earth in several places, lending themselves as places of rest to the local citizens.  Stone-lined dirt pathways, like spokes of a wheel, venture toward the surrounding knolls."],"exits":[{"to":598,"exit":"north","move":"north"},{"to":599,"exit":"northeast","move":"northeast"},{"to":594,"exit":"east","move":"east"},{"to":593,"exit":"southeast","move":"southeast"},{"to":592,"exit":"south","move":"south"},{"to":591,"exit":"southwest","move":"southwest"},{"to":601,"exit":"west","move":"west"},{"to":602,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":601,"x":680,"y":2010,"z":0,"title":"Berry Knolls, Blueberry Lane","descriptions":["Thick groves of oak trees lightly forest the surrounding hills of the valley.  Neatly trimmed blueberry hedges line this quiet lane that runs along the west side of the village green.  A thick carpet of lush green grass encases the cozy knoll homes that sit off the lane up stone-lined walkways."],"exits":[{"to":602,"exit":"north","move":"north"},{"to":600,"exit":"east","move":"east"},{"to":591,"exit":"southeast","move":"southeast"},{"to":590,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":602,"x":680,"y":1990,"z":0,"title":"Berry Knolls, Blueberry Lane","descriptions":["The lane rises slightly to the northeast as is continues to circle around the edge of the valley.  A small circle of simple wooden chairs shelters beneath the boughs of a nearby oak, offering a place to sit at the day's end.  Trimmed mounds of blueberry bushes, laden with their deep blue pearls of sweetness, border the green to the southeast."],"exits":[{"to":598,"exit":"northeast","move":"northeast"},{"to":600,"exit":"southeast","move":"southeast"},{"to":601,"exit":"south","move":"south"},{"to":771,"exit":"go","move":"go wooden gate"}],"color":"#00FFFF"},
  {"id":603,"x":700,"y":2070,"z":0,"title":"Berry Knolls, Gooseberry Loop","descriptions":["A copse of brown, dried trees blocks all view of the community to the north.  The pot-holed path continues to the east, past abandoned knolls covered with patches of dried grass and the occasional tall, green weed.  Torn curtains flutter in the breeze through a nearby broken window."],"exits":[{"to":604,"exit":"east","move":"east"},{"to":591,"exit":"go","move":"go narrow path"}],"color":"#00FFFF"},
  {"id":604,"x":710,"y":2070,"z":0,"title":"Berry Knolls, Gooseberry Loop","descriptions":["Dry, matted grass and tall weeds cover the nearby abandoned knolls.  A gooseberry bush near the edge of the path has turned feral from neglect, becoming a wild tangle of thorny branches with nary a single berry in evidence among its browning leaves."],"exits":[{"to":605,"exit":"east","move":"east"},{"to":603,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":605,"x":720,"y":2070,"z":0,"title":"Berry Knolls, Gooseberry Loop","descriptions":["Islands of undaunted weeds appear in a sea of bare, parched earth along the path.  Broken pieces of furniture lie scattered across the yard of one home, some of them burned, others merely torn apart as if for sport."],"exits":[{"to":604,"exit":"west","move":"west"},{"to":592,"exit":"go","move":"go narrow path"}],"color":"#00FFFF"},
  {"id":606,"x":620,"y":1990,"z":0,"title":"Arthe Dale, Glaysker Lane","descriptions":["A rounded building with a turf and flower-covered roof sits here at a sharp bend in the lane.  The round white door almost seems to provide entry into a small flowery hill.  Large beds of purple glaysker and bright yellow oralana flowers border the building."],"exits":[{"to":617,"exit":"north","move":"north"},{"to":583,"exit":"west","move":"west"},{"to":607,"exit":"go","move":"go white door"}]},
  {"id":607,"x":620,"y":2000,"z":0,"title":"Yulugri Wala, Lobby","descriptions":["During performances, the lobby bustles with activity as customers view the souvenirs and necessities for sale displayed within and on top of the counter down one side of the room, and various other items in the glass display cases down the opposite side.  A long narrow carpet leads theatergoers toward the archway into the seating area."],"exits":[{"to":608,"exit":"west","move":"west"},{"to":606,"exit":"out","move":"out"},{"to":798,"exit":"go","move":"go archway"}],"color":"#FF0000","aliases":["Yulugri Wala","theater"]},
  {"id":608,"x":610,"y":2000,"z":0,"title":"Yulugri Wala, Bar","descriptions":["A long oak bar extends the length of the room, each end decorated with a carved depiction of Glythtide.  Neatly stacked behind the bar, ornately labeled barrels line the wall, some with taps in them, others waiting to replace empties.  Oak bar stools and small tables fill most of the room, with the exception of a stage in the corner opposite the door.  Between the stage and the bar, a doorway reveals stairs leading upward.  A matching set of steps leading downward is roped off to limit access."],"exits":[{"to":607,"exit":"east","move":"east"},{"to":609,"exit":"climb","move":"climb steps"},{"to":616,"exit":"climb","move":"climb stairs"}]},
  {"id":609,"x":580,"y":2050,"z":0,"title":"Yulugri Wala, Backstage","descriptions":["The men's and women's dressing rooms to the southeast and southwest and the prop storage room directly south are all accessed from this central hub of behind-the-scenes activity, resulting in a hectic atmosphere during rehearsals or performances.  All traffic seems to flow to the northeast, where the stage wing awaits performers, musicians, and on occasion, nervous financiers."],"exits":[{"to":610,"exit":"northeast","move":"northeast"},{"to":612,"exit":"southeast","move":"southeast"},{"to":613,"exit":"south","move":"south"},{"to":614,"exit":"southwest","move":"southwest"},{"to":608,"exit":"climb","move":"climb steps"}]},
  {"id":610,"x":590,"y":2040,"z":0,"title":"Yulugri Wala, Stage Wing","descriptions":["In contrast to the main backstage area, which is alive with activity when the theater is in use, this stage wing is quiet.  Performers and stage hands wait here for their cues to pass through the curtain and onto the stage."],"exits":[{"to":609,"exit":"southwest","move":"southwest"},{"to":611,"exit":"northwest","move":"northwest"},{"to":615,"exit":"go","move":"go curtain"}]},
  {"id":611,"x":580,"y":2030,"z":0,"title":"Yulugri Wala, Musicians' Pit","descriptions":["Stools and music stands wait in rows for use during performances.  Facing the stage, the conductor's stand is strategically located to allow for the direction of musicians and vocalists alike.  Off to the side, a box holds a bizarre collection of objects to be used for sound effects for productions."],"exits":[{"to":610,"exit":"southeast","move":"southeast"}]},
  {"id":612,"x":590,"y":2060,"z":0,"title":"Yulugri Wala, Men's Dressing Room","descriptions":["Shelves are available for costumes used in the current production, or for storing actors' own clothes during performances.  Padded benches and plush carpets provide comfort for those changing, and mirrors above a long narrow table allow performers to apply stage makeup or check their appearance before going to the wings."],"exits":[{"to":609,"exit":"northwest","move":"northwest"}]},
  {"id":613,"x":580,"y":2060,"z":0,"title":"Yulugri Wala, Prop Storage","descriptions":["Shelves and racks line every available portion of wall space, providing ample storage for props and costumes when not in use for the current show.  Gaethzen globes brightly light the room, so that needed items can be quickly located."],"exits":[{"to":609,"exit":"north","move":"north"}]},
  {"id":614,"x":570,"y":2060,"z":0,"title":"Yulugri Wala, Women's Dressing Room","descriptions":["Shelves are available for costumes used in the current production, or for storing actors' own clothes during performances.  Padded benches and plush carpets provide comfort for those changing, and mirrors above a long shared vanity allow performers to apply stage makeup or check their appearance before going to the wings."],"exits":[{"to":609,"exit":"northeast","move":"northeast"}]},
  {"id":615,"x":600,"y":2040,"z":0,"title":"Yulugri Wala, Stage","descriptions":["A row of lights illuminates the boards and those who take their place upon them.  Dark curtains block sight of the wings."],"exits":[{"to":610,"exit":"go","move":"go curtain"}]},
  {"id":616,"x":620,"y":2010,"z":0,"title":"Yulugri Wala, Smoking Room","descriptions":["Glass cabinets along the walls display cases of rolled cigars and loose tobacco.  Wing chairs of padded green leather face each other in small groupings, each accented with mahogany tables polished to a rich shine.  Matching paneling covers exposed portions of the walls, and frosted gaethzen orbs provide a soft light to the room.  Thick carpets dampen noise, allowing those who gather to debate the merits of one tobacco over another to do so in comfort and encouraging them to linger."],"exits":[{"to":608,"exit":"climb","move":"climb stairs"}],"color":"#FF0000","aliases":["Smoking Room","Tobacco"]},
  {"id":617,"x":620,"y":1970,"z":0,"title":"Arthe Dale, Apple Blossom Lane","descriptions":["An old-fashioned country lane wends its way east beneath the sheltering overhang of flowering cherry trees.  Tiny thatched-roof cottages and other homes line the lane, surrounded by picket fences and neatly tended flower gardens.  The faint sound of children's laughter can be heard from some of the homes."],"exits":[{"to":618,"exit":"north","move":"north"},{"to":625,"exit":"east","move":"east"},{"to":606,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":618,"x":620,"y":1950,"z":0,"title":"Arthe Dale, Gooseberry Road","descriptions":["The road runs alongside a sparkling brook that splashes as the water tumbles over smooth rocks lining the streambed.  Several homes nestle in the low-lying land around the brook, surrounded by neatly tended gardens.  A bench swing hangs from a tree branch beside the road, swaying gently in a passing breeze."],"exits":[{"to":619,"exit":"northeast","move":"northeast"},{"to":617,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":619,"x":640,"y":1930,"z":0,"title":"Arthe Dale, Gooseberry Road","descriptions":["Several homes nestle in a hollow at the base of a hill, sheltered from the elements by tall poplars and fir trees.  A brook runs nearby, surrounded by mossy rocks and deep green ferns which thrive in the shady setting.  Lush patches of wild lady's slippers bob their pink and purple petals as a breeze gently brushes across the orchids."],"exits":[{"to":620,"exit":"east","move":"east"},{"to":618,"exit":"southwest","move":"southwest"}],"color":"#00FFFF","aliases":["Gooseberry Road"]},
  {"id":620,"x":660,"y":1930,"z":0,"title":"Arthe Dale, Gooseberry Road","descriptions":["The road rises to the crest of a low hill, giving a view of the nearby town.  Farmland spreads out around the village, while neatly thatched cottages and brick homes line the streets."],"exits":[{"to":621,"exit":"east","move":"east"},{"to":619,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":621,"x":680,"y":1930,"z":0,"title":"Arthe Dale, Gooseberry Road","descriptions":["Pale white jasmine blossoms dangle amidst deep green waxy leaves on a whitewashed trellis, their fragrant nectar attracting a flock of brightly colored hummingbirds.  A low-pitched drone fills the air as chubby bumblebees float amidst the blossoms, their legs covered with a profusion of yellow pollen.  A local homeowner has taken advantage of the nearby flowers, erecting a beehive on the lawn to produce his winter's supply of honey."],"exits":[{"to":622,"exit":"southeast","move":"southeast"},{"to":620,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":622,"x":690,"y":1940,"z":0,"title":"Arthe Dale, Gooseberry Road","descriptions":["A tangled thicket of gooseberry bushes lines the road to the south.  Nearby, several small homes are scattered about, some near the road, others set back a ways to offer a modicum of privacy.  Cheerful windowboxes filled with pansies and geraniums add a splash of color to the tiny houses."],"exits":[{"to":623,"exit":"southeast","move":"southeast"},{"to":621,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":623,"x":700,"y":1950,"z":0,"title":"Arthe Dale, Apple Blossom Lane","descriptions":["The lane ends at a shallow pond surrounded by weeping willow trees.  A weathered pier juts out over the water, where residents from nearby homes may relax near the cool water in the summertime or catch a fish or two for the evening's meal."],"exits":[{"to":624,"exit":"southwest","move":"southwest"},{"to":622,"exit":"northwest","move":"northwest"},{"to":626,"exit":"go","move":"go large knoll"},{"to":632,"exit":"go","move":"go grey pier"}],"color":"#00FFFF"},
  {"id":624,"x":680,"y":1970,"z":0,"title":"Arthe Dale, Apple Blossom Lane","descriptions":["A stunted apple tree stands beside the lane, blackened and broken by a lightning strike.  The splintered branches have been carefully trimmed and stacked, drying for use in the winter's fires.  Several cottages stand nearby, their neatly cropped lawns and tended gardens evidence of industry on the part of their owners."],"exits":[{"to":623,"exit":"northeast","move":"northeast"},{"to":625,"exit":"west","move":"west"}],"color":"#00FFFF","aliases":["Apple Blossom Lane"]},
  {"id":625,"x":650,"y":1970,"z":0,"title":"Arthe Dale, Apple Blossom Lane","descriptions":["Apple blossoms drift in the wind, fallen from the flower-laden branches of the gnarled trees which shade the narrow lane.  Neat cottages stand side by side, some of brick, others of weathered cedar shingles, others with whitewashed wooden clapboards.  A covered well, gathering place for local housewives, stands beside the road."],"exits":[{"to":624,"exit":"east","move":"east"},{"to":617,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":626,"x":650,"y":1960,"z":0,"title":"Thipbeet's Tart Boutique, Lobby","descriptions":["Leading down from the circular door, a small set of hardwood steps guides patrons to the welcoming entrance area of the bakery.  Thick, woven rugs cover the dirt floor, enhancing the rustic feel set in place by the handcrafted furniture.  Various aromas drift through the room from the bounty of tasty treats available for purchase in the depths of the shop."],"exits":[{"to":627,"exit":"northeast","move":"northeast"},{"to":631,"exit":"west","move":"west"},{"to":623,"exit":"go","move":"go circular door"}],"aliases":["Thipbeet's Tart Boutique","Tarts"]},
  {"id":627,"x":660,"y":1950,"z":0,"title":"Thipbeet's Tart Boutique, Fabulously Fruity","descriptions":["Hung from the ceiling, decorative vines dangle painted wooden strawberries and tiny silk blossoms.  Orange gingham cloths cover the counter and tables set up around the room, each surface piled high with pastries to tempt the palate.  Despite the dirt floor, the area retains an aura of cleanliness and refinement."],"exits":[{"to":626,"exit":"southwest","move":"southwest"},{"to":628,"exit":"northwest","move":"northwest"}],"color":"#FF0000"},
  {"id":628,"x":650,"y":1940,"z":0,"title":"Thipbeet's Tart Boutique, Liquored Loveliness","descriptions":["Hung from the ceiling, decorative vines dangle stained glass bottles and small brass goblets.  White gingham cloths cover the counter and tables set up around the room, each surface piled high with pastries to tempt the palate.  Despite the dirt floor, the area retains an aura of cleanliness and refinement."],"exits":[{"to":627,"exit":"southeast","move":"southeast"},{"to":629,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":629,"x":650,"y":1950,"z":0,"title":"Thipbeet's Tart Boutique, Meatlicious Meatiness","descriptions":["Hung from the ceiling, decorative vines dangle miniature leather steaks and thin strips of paper bacon.  Red gingham cloths cover the counter and tables set up around the room, each surface piled high with pastries to tempt the palate.  Despite the dirt floor, the area retains an aura of cleanliness and refinement."],"exits":[{"to":628,"exit":"north","move":"north"},{"to":630,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":630,"x":640,"y":1950,"z":0,"title":"Thipbeet's Tart Boutique, Charmingly Chocolate","descriptions":["Hung from the ceiling, decorative vines dangle diminutive spotted cows and real cocoa beans.  Brown gingham cloths cover the counter and tables set up around the room, each surface piled high with pastries to tempt the palate.  Despite the dirt floor, the area retains an aura of cleanliness and refinement."],"exits":[{"to":629,"exit":"east","move":"east"},{"to":631,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":631,"x":640,"y":1960,"z":0,"title":"Thipbeet's Tart Boutique, Enchanting Exotics","descriptions":["Hung from the ceiling, decorative vines dangle sparkling gem-dusted leaves and brightly colored feathers.  Indigo gingham cloths cover the counter and tables set up around the room, each surface piled high with pastries to tempt the palate.  Despite the dirt floor, the area retains an aura of cleanliness and refinement."],"exits":[{"to":630,"exit":"north","move":"north"},{"to":626,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":632,"x":720,"y":1930,"z":0,"title":"Arthe Dale, Willow Pond Pier","descriptions":["Brightly painted low wooden chairs sit along the edge of the dock, allowing fishermen to relax as they cast their lines over the side in an attempt to lure the trout that lurk beneath the pilings.  Towels lie scattered upon the wooden surface, evidently the property of swimmers cavorting in the pond's cool green waters."],"exits":[{"to":623,"exit":"southwest","move":"southwest"},{"to":633,"exit":"none","move":"dive willow pond"}],"aliases":["Willow Pond Pier"]},
  {"id":633,"x":740,"y":1930,"z":0,"title":"Arthe Dale, Willow Pond","descriptions":["Water splashes down a slick rock chute built into the hillside on the far side of the pond, tumbling into the dark green water to send ripples shimmering across the surface.  A weathered grey pier juts out into the pond, giving residents a launching point from which to dive.  At night, the sound of crickets mingles with the hoarse croaks of frogs serenading the moons.","Water splashes down a slick rock chute built into the hillside on the far side of the pond, tumbling into the dark green water to send ripples shimmering across the surface.  A weathered grey pier juts out into the pond, giving residents a launching point from which to dive.  During the day, the air is filled with the screams and laughter of children at play."],"exits":[{"to":634,"exit":"go","move":"go rocky hillside"},{"to":632,"exit":"go","move":"go grey pier"}],"color":"#0000FF"},
  {"id":634,"x":760,"y":1930,"z":0,"title":"Arthe Dale, Low Hillside","descriptions":["Water bubbles up from a crystal clear spring before overflowing into a smooth rock chute in the hillside.  The chute twists and turns as it runs down the slope until it finally ends a few feet above the deep green waters of Willow Pond."],"exits":[{"to":633,"exit":"go","move":"rt go stone chute"}],"aliases":["Waterslide"]},
  {"id":635,"x":410,"y":2030,"z":0,"title":"Swotting Hall, Trader's Pit","descriptions":["An explosion in a dye factory can best describe this cramped little room at the very back of Swotting Hall.  Brightly-colored curtains in asymmetrical patterns pick up the vibrant primary hues used to upholster some plush arm chairs, and a rainbow-inspired throw rug shields the pale wooden floor.  A rotund clerk occasionally peers up at the pricing board before making notes in a faded leatherbound journal."],"exits":[{"to":637,"exit":"east","move":"east"}],"aliases":["Commodities Pit"]},
  {"id":636,"x":420,"y":2020,"z":0,"title":"Swotting Hall, Study Chamber","descriptions":["Simplicity seems to have been the goal in decorating this room.  Plain chairs have been neatly arranged in a half-circle facing the center of the room.  Unadorned beige walls and bare windows surround you.  Hildegrim Hornbeam stands in the center, dressed in an austere style that matches the decor.  She nods curtly at you as you enter."],"exits":[{"to":637,"exit":"south","move":"south"}]},
  {"id":637,"x":420,"y":2030,"z":0,"title":"Swotting Hall, Trader's Center","descriptions":["The walls of this large room are painted a rich, deep doeskin tan.  Finely detailed tapestries of deep red, midnight blue and forest green cover three of the walls.  Several prosperous-looking traders saunter over to a board mounted on the remaining wall.  They peruse it quickly and move away to make room for others.  A young Halfling lad scurries to the north, a notebook clasped firmly to his chest."],"exits":[{"to":636,"exit":"north","move":"north"},{"to":635,"exit":"west","move":"west"},{"to":569,"exit":"go","move":"go wood door"}],"color":"#00FF00","aliases":["Trading Outpost Arthe Dale"]},
  {"id":638,"x":560,"y":2000,"z":0,"title":"Bobba's Arms and Armor","descriptions":["Three Halfling-size figures stand along the entranceway, each clad in a different style of armor with weapon poised to attack.  They do not move, however, the room's steady light betraying them as cunning display dummies crafted from straw and wooden poles.  Smallish weapon racks and diminutive suits of leather line the walls, indicating the proprietor's select group of clientele."],"exits":[{"to":582,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Bobba's Arms and Armor","Weapons","Armor"]},
  {"id":639,"x":280,"y":2350,"z":0,"title":"Jadewater Mansion, Kitchen","descriptions":["Bearing more resemblance to a magical workshop than a place to prepare meals, the kitchen has many oddities filling it.  Herbs overflow from oak shelves while a cart and counter have food and drink waiting to be served.  A small bronze dragon with gaping jaws serves as garbage disposal."],"exits":[],"aliases":["Jadewater Mansion"],"linksTo":"Map1_Crossing.xml"},
  {"id":640,"x":60,"y":220,"z":0,"title":"Her Opulence","descriptions":["Long, wide and low, this vessel is built for utility, but the hand of luxury can be discerned in the ornately carved walnut railings, down-cushioned benches and the well polished deck.  Six lanterns along the ferry's rail fill the boat with a soft light, creating a feeling of closure from the surrounding blackness."],"exits":[{"to":81,"exit":"go","move":"go north docks"},{"to":0,"exit":"go","move":"go riverhaven docks"}],"linksTo":"Map998_Transports.xml"},
  {"id":641,"x":240,"y":2420,"z":0,"title":"Crossing, Northeast Gate Battlements","descriptions":["Straddling the Northeast Gate, the stone battlements overlook the busiest entrance to the city.  Stone merlons offer some cover to those fighting, and the embrasures appear designed to accommodate either onager or archer.  The cobbled walk only stretches a short distance to the west and south, where it is broken by the tall but unfinished expanse of the town wall."],"exits":[{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"west","move":"west"}],"linksTo":"Map1_Crossing.xml"},
  {"id":642,"x":540,"y":1490,"z":0,"title":"Northern Trade Road, Grasslands","descriptions":["A cloud of flint-dry dust rises on every breeze, making you sneeze.  For the most part, you see the grasslands about you in a state of decay and near death.  Mountains rising sharply in the south form a counterpoint to others, sharper yet, that loom northwards.  Saw-edged peaks and broken crowns indicate their origins as volcanoes in the not-so-distant past."],"exits":[{"to":371,"exit":"north","move":"north"},{"to":370,"exit":"south","move":"south"}]},
  {"id":643,"x":460,"y":1710,"z":0,"title":"Guild Outpost, Caravan Stables","descriptions":["Constructed of thick stone walls supporting heavy oak beams, this stable was obviously built with Dwarven stature in mind.  Despite its smallness and the earthy smells of its animal inhabitants, it's a surprisingly cheerful place.  Brass lanterns hung about at regular intervals light the interior and make it easy to read a large notice chiselled deeply into the stone. "],"exits":[{"to":359,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Caravan Stable Stone Clan","SC Caravan Stable"]},
  {"id":644,"x":420,"y":1710,"z":0,"title":"Stone Clan, Trader's Guild Outpost","descriptions":["This outpost is built of heavy, massive rockwork in the Dwarven style, plain but durable.  Designed for safe storage, as well as easy buying and selling of bulk goods by Guild members, it is crammed and jammed with crates, boxes and packages of all manner and value.  A stern-looking Guild trade minister is at hand to expedite transactions and to make sure nothing leaves or arrives without the proper fees and monies being exchanged."],"exits":[{"to":359,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Trading Outpost Stone Clan","SC Outpost"]},
  {"id":645,"x":300,"y":520,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["Rocks are pushed to one side of the road to make a slender path through debris.  It looks scarcely traveled, the way lined by sparse vegetation."],"exits":[{"to":149,"exit":"southeast","move":"southeast"},{"to":646,"exit":"west","move":"west"}]},
  {"id":646,"x":280,"y":520,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["Patterns of leaves and paw prints are barely visible in the walls of stone nearby.  The fossilized remains are an eerie reminder of the life trapped forever within the ash."],"exits":[{"to":645,"exit":"east","move":"east"},{"to":647,"exit":"west","move":"west"}]},
  {"id":647,"x":260,"y":520,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["A withering flower rests to one side of the road.  Its dusk-colored leaves flail in the slight breeze, their color the brown of age and decay.","The evening smiles down on a small flower lingering near the road side.  It appears withered and dying at first glance, but as the night unfolds, so does a pure white snowblossom - one spot of beauty within a realm of decay and death."],"exits":[{"to":646,"exit":"east","move":"east"},{"to":648,"exit":"northwest","move":"northwest"}]},
  {"id":648,"x":240,"y":500,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["Splintered wagon wheels lie alongside a corroding iron frame.  It appears as if a Trader ran into some difficulty -- difficulty he was unable to recover from."],"exits":[{"to":647,"exit":"southeast","move":"southeast"},{"to":649,"exit":"northwest","move":"northwest"}]},
  {"id":649,"x":220,"y":480,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["A dried watering hole stands forlorn amidst the skeletons of animals large and small.  All scraps of flesh have been worn or torn away leaving only the dusty ivory bone beneath."],"exits":[{"to":648,"exit":"southeast","move":"southeast"},{"to":650,"exit":"west","move":"west"}]},
  {"id":650,"x":200,"y":480,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["The silhouette of the Greater Fist looms in the far distant horizon.  The Lesser Fist lingers closer, its shadow rising almost haughtily before you.","Darkness trails over the shadows of both volcanoes - the Greater and Lesser Fists.  Standing tall and proud, they serve as silent sentinels beneath the night's unsleeping eye."],"exits":[{"to":649,"exit":"east","move":"east"},{"to":651,"exit":"northwest","move":"northwest"}]},
  {"id":651,"x":180,"y":460,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["Coarse gravel lines the earth, a bed of sharp stones, like jagged teeth peering out of the earth.  Ready to pierce the foot of the unwary traveler, they stand sparkling against the spartan dirt."],"exits":[{"to":650,"exit":"southeast","move":"southeast"},{"to":652,"exit":"northwest","move":"northwest"}]},
  {"id":652,"x":160,"y":440,"z":0,"title":"Lava Flow, Rocky Path","descriptions":["Fronds of wilting palm trees scatter on the ground, the wind blowing them across the loose dirt.  Trunks and stalks lie half-buried by ash and crumbling stone."],"exits":[{"to":653,"exit":"north","move":"north"},{"to":651,"exit":"southeast","move":"southeast"}]},
  {"id":653,"x":160,"y":420,"z":0,"title":"Lava Flow, Standing Stones","descriptions":["Tall stones rise in small circular patterns, their forms eroded by wind and water both.  The designs they held have long since faded into invisibility, their meaning now undecipherable."],"exits":[{"to":654,"exit":"north","move":"north"},{"to":652,"exit":"south","move":"south"}]},
  {"id":654,"x":160,"y":400,"z":0,"title":"Lava Flow, Standing Stones","descriptions":["Pieces of once-tall pillars lie skewed and broken.  Debris from past volcanic eruptions blanket stone and statue, hearth and fallen home.","The dark side of evening seems to linger here, languidly basking over the ruins as if gloating.  The shadows seem to tug and pull at the fallen buildings, as if taunting them, whispering seeds of unrest to long-dead spirits."],"exits":[{"to":653,"exit":"south","move":"south"},{"to":655,"exit":"northwest","move":"northwest"}]},
  {"id":655,"x":140,"y":380,"z":0,"title":"Lava Flow, Standing Stones","descriptions":["The ancient frieze of a tall arch is slowly crumbling to dust, paint and tile flaking off.  Burn marks streak the mural, obscuring what images were once there."],"exits":[{"to":654,"exit":"southeast","move":"southeast"},{"to":656,"exit":"west","move":"west"}]},
  {"id":656,"x":120,"y":380,"z":0,"title":"Lava Flow, Path of Thorns","descriptions":["Dried and cracking brambles wrapped around a wrought iron fence line the road.  Flanking the dusky earth, the brackish thorns peek out from withering branches, daring to jab and stab at passers by."],"exits":[{"to":655,"exit":"east","move":"east"},{"to":657,"exit":"west","move":"west"}]},
  {"id":657,"x":100,"y":380,"z":0,"title":"Lava Flow, Path of Thorns","descriptions":["A heart-shaped wrought iron sculpture is overgrown, writhing vines coiled around it.  The thick spike-like thorns appear to pierce the center, the sharp points gleaming with moisture."],"exits":[{"to":656,"exit":"east","move":"east"},{"to":658,"exit":"west","move":"west"}]},
  {"id":658,"x":80,"y":380,"z":0,"title":"Lava Flow, Path of Thorns","descriptions":["A tangled mass of thorny bushes guard the roadside, making passage beyond the slender path impossible.  Small birds find ways to hide unscathed amidst the brambles, tiny forms huddled inside small cathedrals of withering vines."],"exits":[{"to":657,"exit":"east","move":"east"},{"to":659,"exit":"northwest","move":"northwest"}]},
  {"id":659,"x":60,"y":360,"z":0,"title":"Lava Flow, Path of Thorns","descriptions":["The masses of thorny growths thin to the north.  Wrought iron sculptures where vines of roses once grew stand bare, metal corroding and long untended.  The eerie shapes stand like hollow souls over the dead ash-covered earth below."],"exits":[{"to":660,"exit":"north","move":"north"},{"to":658,"exit":"southeast","move":"southeast"}]},
  {"id":660,"x":60,"y":340,"z":0,"title":"Lava Flow, Path of Jade","descriptions":["Flecks of shattered jade lie strewn amidst the rough gravel of the road.  Images etched into the flat panels of rock that were once a busy street are now worn to nothingness, their patterns long forgotten."],"exits":[{"to":659,"exit":"south","move":"south"},{"to":661,"exit":"northwest","move":"northwest"}]},
  {"id":661,"x":40,"y":320,"z":0,"title":"Lava Flow, Path of Jade","descriptions":["Slender jade obelisks mottled with dust and ash stand guard over the narrow road.  The way is clear, footprints from recent travel constantly being worn over one another in the soft earth below."],"exits":[{"to":660,"exit":"southeast","move":"southeast"},{"to":662,"exit":"west","move":"west"}]},
  {"id":662,"x":20,"y":320,"z":0,"title":"Lava Flow, Path of Jade","descriptions":["An ornate jade plant rests amidst a circle of pale white stones.  Each leaf is delicately carved from the blushing green stone.  Despite being covered in filth, it remains a beautiful work of art."],"exits":[{"to":661,"exit":"east","move":"east"},{"to":663,"exit":"northwest","move":"northwest"}]},
  {"id":663,"x":0,"y":300,"z":0,"title":"Lava Flow, Path of Jade","descriptions":["An elaborate golden stand is firmly bolted to the stone of the road.  Remnants of a jade-green glass sphere lie in sharp slivers on the surrounding grass.  Bits of coarse vegetation grow between the pieces of glass."],"exits":[{"to":662,"exit":"southeast","move":"southeast"},{"to":664,"exit":"northwest","move":"northwest"}]},
  {"id":664,"x":-20,"y":280,"z":0,"title":"Lava Flow, Path of Jade","descriptions":["Prickly, spine-covered bushes grow close to the ground.  Ripe red fruit tauntingly dangles from behind long, sharp thorns."],"exits":[{"to":663,"exit":"southeast","move":"southeast"},{"to":665,"exit":"west","move":"west"}]},
  {"id":665,"x":-40,"y":280,"z":0,"title":"Lava Flow, Wall of Swords","descriptions":["A tall barrier lines each side of the road, bladed edges topping the polished wooden beams that compose the wall."],"exits":[{"to":664,"exit":"east","move":"east"},{"to":666,"exit":"northwest","move":"northwest"},{"to":774,"exit":"go","move":"go dusty archway"}]},
  {"id":666,"x":-60,"y":260,"z":0,"title":"Lava Flow, Wall of Swords","descriptions":["Wooden panels in the fence are carved into the jagged images of swords and weapons from lands far and near.  The barbed metal partitions holding them together make touching the wall a most unpleasant thought."],"exits":[{"to":667,"exit":"north","move":"north"},{"to":665,"exit":"southeast","move":"southeast"}]},
  {"id":667,"x":-60,"y":240,"z":0,"title":"Lava Flow, Wall of Swords","descriptions":["The volcano of the Lesser Fist looms over the barricade.  It ominously shadows all below it.  A glimpse of something reflective glints from near the maw of the fortress."],"exits":[{"to":666,"exit":"south","move":"south"},{"to":668,"exit":"west","move":"west"}]},
  {"id":668,"x":-80,"y":240,"z":0,"title":"Lava Flow, Way of Swords","descriptions":["Ashes and dust coat the stone wall, covering the rock with a granulated layer of grey that abates only near an inset bronze plaque.  A sparkling crystal hand is attached over the polished metal, also clear of the choking dust."],"exits":[{"to":667,"exit":"east","move":"east"},{"to":669,"exit":"west","move":"west"},{"to":710,"exit":"go","move":"go stone wall"}]},
  {"id":669,"x":-100,"y":240,"z":0,"title":"Lava Flow, Esouvar's Rest","descriptions":["The signs of ancient battle mark the area.  A tall statue, at least thirty feet in height, towers far above the parched landscape.  Eyes of faceted blue crystal sparkle brightly from the ash-streaked marble face."],"exits":[{"to":668,"exit":"east","move":"east"},{"to":670,"exit":"northwest","move":"northwest"}]},
  {"id":670,"x":-120,"y":220,"z":0,"title":"Lava Flow, Esouvar's Rest","descriptions":["A red-veined marble fountain proudly shimmers with droplets of clear, cool water.  Small flameroses grow up its sides, their tender green tendrils bearing small jade-green leaves that perfume the air with a heady scent."],"exits":[{"to":669,"exit":"southeast","move":"southeast"},{"to":671,"exit":"west","move":"west"}]},
  {"id":671,"x":-140,"y":220,"z":0,"title":"Lava Flow, Garden of Ash","descriptions":["Once a lovely garden, little remains of its original beauty.  Recent plantings line the roadside, clippings and trees freshly cultivated in an attempt to renew the land."],"exits":[{"to":670,"exit":"east","move":"east"},{"to":672,"exit":"northwest","move":"northwest"}]},
  {"id":672,"x":-160,"y":200,"z":0,"title":"Lava Flow, Garden of Ash","descriptions":["A delicate moonflower bush, petals closed as the flowers sleep during the day, stands encircled by an almost fragile iron trellis.  The clean area and well-tended soil betray an unseen caretaker overseeing the beautiful plant.","The soft blue-white blossoms of a moonflower bush open their luminous faces to the night sky."],"exits":[{"to":671,"exit":"southeast","move":"southeast"},{"to":673,"exit":"west","move":"west"}]},
  {"id":673,"x":-180,"y":200,"z":0,"title":"Lava Flow, Garden of Ash","descriptions":["The long shadow of the Lesser Fist of Heaven dominates the small garden.  The formidable fortress to the west rises high above the ground below, with the silhouette of the Greater Fist behind it towering yet farther into the reaches of the sky."],"exits":[{"to":672,"exit":"east","move":"east"},{"to":674,"exit":"west","move":"west"}]},
  {"id":674,"x":-200,"y":200,"z":0,"title":"Lava Path, Dwindling Way","descriptions":["A volcano lies to the west.  Fortified and well-guarded, it serves as the Fortress of the Crystal Hand.  The dark path, made from hardened lava, is streaked with veins of polished obsidian that glisten with a dull satin sheen."],"exits":[{"to":673,"exit":"east","move":"east"},{"to":675,"exit":"west","move":"west"}]},
  {"id":675,"x":-220,"y":200,"z":0,"title":"Lava Path, The Stone Stairway","descriptions":["A large stone staircase winds its way down the front of the volcano, carved into the face of the rock.  A glimmering crystal formation to the west seems to catch the scarce light, glowing with a scintillating aura."],"exits":[{"to":674,"exit":"east","move":"east"},{"to":687,"exit":"climb","move":"climb stone staircase"}]},
  {"id":687,"x":-220,"y":180,"z":0,"title":"Outside the Fortress, Obsidian Doors","descriptions":["The door to the volcanic fortress is comprised of two enormous obsidian panels, both ornately carved.  The slender path, chiseled from the lava, leads to a large stone staircase descending to the ground below.  Embedded in the dense rock above the entrance rests a crystal hand encircled by angular runes.","Shadows of night embrace the stalwart doors leading into the fortress.  The dark obsidian panels glisten with the light of the crystal hand set into the volcanic rock above them, their spiraling patterns and angular runes shimmering in the sparse illumination.  A spartan staircase travels down the face of the stone walls.","The once mighty obsidian doors are fallen, shattered, and the way clogged with ruin.  All that remains of its former occupants are bits of bone and the remnants of a large crystal hand, scattered when it was dashed to the ground.  A spartan staircase, chiseled from lava, winds down the face of the stony wall."],"exits":[{"to":688,"exit":"go","move":"go obsidian doors"},{"to":675,"exit":"climb","move":"climb stone staircase"}]},
  {"id":688,"x":-220,"y":160,"z":0,"title":"Inside the Fortress, Atrium","descriptions":["Light floods in from above, the only outlet to the distant skies being the gaping mouth of the volcano.  The slender outline of a catwalk is thrown against the canvas of the sky, a barely noticeable line.","The night sky peeks through the mouth of the volcano, the crystal dome sparkling far above.  A quiet settles over the atrium, a serene calmness that drifts through the air and the soul."],"exits":[{"to":689,"exit":"north","move":"north"},{"to":687,"exit":"go","move":"go obsidian doors"}]},
  {"id":689,"x":-220,"y":140,"z":0,"title":"Inside the Fortress, Atrium","descriptions":["A statue carved from a pale grey rock rests inside a circular path of dark stones at the center of the atrium.  Offerings of flowers and incense are left before it, testament to the monks' ever-enduring memories.  A rough obsidian path leads west toward the Guild library.","The coolness of evening drapes itself around the atrium and mottled shadows are cast over a tall marble statue.  Burning incense drifts through the air, its heady scent almost dizzying."],"exits":[{"to":690,"exit":"northeast","move":"northeast"},{"to":688,"exit":"south","move":"south"},{"to":695,"exit":"northwest","move":"northwest"},{"to":698,"exit":"go","move":"go winding path"}]},
  {"id":690,"x":-200,"y":120,"z":0,"title":"Inside the Fortress, Weapon Salle","descriptions":["Racks upon racks of weapons line the walls, most staves or keen-edged spears.  Some blades, well-polished and edged, gleam from among their wooden, practice counterparts.  The floor is clean and well-kept, the signs of monks recently training lingering about."],"exits":[{"to":691,"exit":"east","move":"east"},{"to":689,"exit":"southwest","move":"southwest"}]},
  {"id":691,"x":-180,"y":120,"z":0,"title":"Inside the Fortress, Rough Stairway","descriptions":["A tall stairway carved into the rock of the volcano winds its way precariously upwards, leading to a slender catwalk far above.  It appears impossibly steep, but several monks ascend the way with no problem."],"exits":[{"to":690,"exit":"west","move":"west"},{"to":692,"exit":"climb","move":"climb winding stairway"}]},
  {"id":692,"x":-180,"y":100,"z":0,"title":"On the Catwalk","descriptions":["The skies open above, visible through a crystal dome capping the volcano.  Daylight makes the slender catwalk seem extremely treacherous as it stretches most precariously over the vast expanse below.","The dark evening blankets the slender catwalk masking its treacherous positioning as it stretches most precariously over a vast expanse of darkness."],"exits":[{"to":693,"exit":"west","move":"west"},{"to":691,"exit":"climb","move":"climb winding stair"}]},
  {"id":693,"x":-200,"y":100,"z":0,"title":"On the Catwalk, Above the Foyer","descriptions":["The thin platform extends further west, the expansive sky above seeming close indeed.  The crystal dome capping the volcano exposes the vast horizon, hiding nothing.","The heavenly bodies dance and spiral, taunting the mortal hand to step from the catwalk just an inch closer.  The night sky descends over the crystal dome and through it, stars surrounding you, close enough to seemingly touch them."],"exits":[{"to":692,"exit":"east","move":"east"},{"to":694,"exit":"west","move":"west"}]},
  {"id":694,"x":-220,"y":100,"z":0,"title":"Platform's Edge, Seat of the Guildmaster","descriptions":["A large circular stone platform rests suspended in mid-air over the center of the volcano.  The precarious catwalk extends to its edge."],"exits":[{"to":693,"exit":"east","move":"east"}],"color":"#FF8000","aliases":["GL Moon Mage","Tiv","RS Moon Mage"]},
  {"id":695,"x":-240,"y":120,"z":0,"title":"Inside the Fortress, Stone Garden","descriptions":["Small iridescent grey rocks carpet the rough lava floor.  They are meticulously raked into ornate spiraling patterns.  A slender obsidian walkway winds geometrically through the garden, dividing the crushed stone into abstract triangular shapes."],"exits":[{"to":689,"exit":"southeast","move":"southeast"},{"to":696,"exit":"northwest","move":"northwest"}]},
  {"id":696,"x":-260,"y":100,"z":0,"title":"Inside the Fortress, Stone Garden","descriptions":["A dark walkway of obsidian frames the field of grey crushed stone at the center of the room.  Monks wander along the path, heads bowed in quiet contemplation."],"exits":[{"to":697,"exit":"east","move":"east"},{"to":695,"exit":"southeast","move":"southeast"}],"color":"#FF00FF","aliases":["Emalerje","Grazhir","Ways","Astral Plane"]},
  {"id":697,"x":-240,"y":100,"z":0,"title":"Inside the Fortress, Meditation Room","descriptions":["The walls and ceiling are featureless grey rock with a smooth polished surface.  Dark linen pillows, flat and hard to the touch, are placed around the area.  A small censer lets the potent scent of sweet incense drift lazily about."],"exits":[{"to":696,"exit":"west","move":"west"}]},
  {"id":698,"x":-200,"y":140,"z":0,"title":"Inside the Fortress, Guild Library","descriptions":["Monks kneel and sit on the charcoal gunny pillows scattered about the room.  In hushed whispers, they read and debate combative and mystical theory alike.  Glowing orbs of polished crystal illuminate the room, providing a gentle light for study and the gaining of wisdom."],"exits":[{"to":699,"exit":"east","move":"east"},{"to":689,"exit":"go","move":"go obsidian path"}]},
  {"id":699,"x":-180,"y":140,"z":0,"title":"Library, Archive Room","descriptions":["The silence of the archives is broken only by the soft sound of scratching pens as monks work copying ancient texts that have begun to decay.  Files, treatises and endless scrolls of parchment line the bookcases to aid visitors in their researches."],"exits":[{"to":698,"exit":"west","move":"west"},{"to":700,"exit":"go","move":"go onyx arch"}],"aliases":["Library"]},
  {"id":700,"x":-160,"y":140,"z":0,"title":"Archive Room, Museum Foyer","descriptions":["The foyer to the Guild museum is sparsely decorated.  Featureless walls of polished lava rise up to the crystal dome, the edge of the catwalk barely in sight.  A winding spiral staircase descends into the stronghold below."],"exits":[{"to":699,"exit":"go","move":"go onyx arch"},{"to":701,"exit":"climb","move":"climb spiral stair"}]},
  {"id":701,"x":-100,"y":120,"z":0,"title":"Beneath the Fortress, Hallway Foyer","descriptions":["An elegant staircase made from polished stone spirals upwards to the main level.  A passage north leads to a series of catacombs carved into the base of the volcano."],"exits":[{"to":702,"exit":"north","move":"north"},{"to":700,"exit":"climb","move":"climb ironwood staircase"}]},
  {"id":702,"x":-100,"y":100,"z":0,"title":"Beneath the Fortress, Hall of Relics","descriptions":["The chambers of the museum appear to be carved from the basalt rock of the volcano.  A dark indigo silk runner lines the cold stone of the floor.  Silver sconces embracing small orbs of glowing tzgaa line the walls."],"exits":[{"to":703,"exit":"southeast","move":"southeast"},{"to":701,"exit":"south","move":"south"},{"to":709,"exit":"southwest","move":"southwest"}]},
  {"id":703,"x":-80,"y":120,"z":0,"title":"Beneath the Fortress, Hall of Relics","descriptions":["Three panels of cloth hang from the walls depicting various scenes from the Guild's past.  One notable portrayal is that of Katzel's execution."],"exits":[{"to":704,"exit":"southeast","move":"southeast"},{"to":702,"exit":"northwest","move":"northwest"}]},
  {"id":704,"x":-60,"y":140,"z":0,"title":"Beneath the Fortress, Hall of Relics","descriptions":["A bold bright blue banner hangs above this exhibit.  Older monks pass by, nodding and winking at each other, the occasional one bowing reverently towards the large painting on display."],"exits":[{"to":705,"exit":"southwest","move":"southwest"},{"to":703,"exit":"northwest","move":"northwest"}]},
  {"id":705,"x":-80,"y":160,"z":0,"title":"Beneath the Fortress, Promenade","descriptions":["Tapestries and paintings from various provinces of Elanthia cover the walls in this area.  Sculptures and other remnants from past civilizations attest to their age."],"exits":[{"to":704,"exit":"northeast","move":"northeast"},{"to":706,"exit":"southwest","move":"southwest"}]},
  {"id":706,"x":-100,"y":180,"z":0,"title":"Beneath the Fortress, Hall of Relics","descriptions":["Swaths of velvet lie draped over this exhibit, one curtain drawn back to reveal a cracked oval mirror.  Ropes cordon off the display.  Most people lower their eyes as they pass, not daring to look, nervously shuffling onward."],"exits":[{"to":705,"exit":"northeast","move":"northeast"},{"to":707,"exit":"northwest","move":"northwest"}],"aliases":["Mirror"]},
  {"id":707,"x":-120,"y":160,"z":0,"title":"Beneath the Fortress, Hall of Relics","descriptions":["This room is plain and spartan, containing only an enclosed glass case bearing a treasure from ancient days.  Even the obsidian walls are featureless, the black rock smooth and polished.  A silverwillow sign hangs from delicate chains over the display."],"exits":[{"to":706,"exit":"southeast","move":"southeast"},{"to":708,"exit":"northwest","move":"northwest"}]},
  {"id":708,"x":-140,"y":140,"z":0,"title":"Beneath the Fortress, Hall of Relics","descriptions":["A large contraption, composed of many gears and glassine parts, focuses one thick crystal lens over an almost invisible specimen.  A sliver of something almost imperceptably small glitters beneath."],"exits":[{"to":709,"exit":"northeast","move":"northeast"},{"to":707,"exit":"southeast","move":"southeast"}]},
  {"id":709,"x":-120,"y":120,"z":0,"title":"Beneath the Fortress, Hall of Relics","descriptions":["A large glass panel flanks the wall, parchment pages held securely in place behind the protective display.  A small brass plaque is tacked to the wall beneath it."],"exits":[{"to":702,"exit":"northeast","move":"northeast"},{"to":708,"exit":"southwest","move":"southwest"}]},
  {"id":710,"x":-160,"y":320,"z":0,"title":"Ith'Draknari Halls, Entry Chamber","descriptions":["Pillars of stone, decorated in simple hues of red and gold, hold the low, flat ceiling in place.  Bells and tassels dangle from dry pine poles that crisscross between the columns, turning the area above into an elaborately textured contrast to the smoothness of the stone.  A large bowl carved from ivory-hued alabaster rests in the center of the room, the air surrounding it strangely cool."],"exits":[{"to":668,"exit":"out","move":"out"},{"to":711,"exit":"go","move":"go modwir door"}],"aliases":["Monks of the Crystal Hand","Crystal Hand"]},
  {"id":711,"x":-180,"y":300,"z":0,"title":"Ith'Draknari Halls, Passage of the Self","descriptions":["The faceless stone walls of the chamber are lined by copper statues, each one representing a member of the eleven races.  Along the southeastern and southwestern walls, the original seven are arranged in a curving row, facing north towards the remaining four.  Occasionally, a monk walks through, pausing to carefully dust off each of the statues in turn before journeying on."],"exits":[{"to":716,"exit":"northeast","move":"northeast"},{"to":712,"exit":"northwest","move":"northwest"},{"to":710,"exit":"go","move":"go modwir door"}]},
  {"id":712,"x":-200,"y":280,"z":0,"title":"Ith Draknari Halls, Passage of the Stairway to Enlightenment","descriptions":["Thousands of golden yellow tassels shift back and forth as they hang from the ceiling, moving in unison with a gentle draft.  An orange sunset fills the western wall, forever frozen in its painted descent below an unreal horizon.  Leading up to the center of the mock solar orb is a carefully stacked pile of white granite, arranged like stairs.  Their destination is nowhere, stopping at the solid, but brilliantly painted rock."],"exits":[{"to":713,"exit":"north","move":"north"},{"to":711,"exit":"southeast","move":"southeast"}]},
  {"id":713,"x":-200,"y":260,"z":0,"title":"Ith Draknari Halls, Passage of the Foundation of Identity","descriptions":["Painted wooden panels adorn every wall, depicting crowds of silhouettes and ghostly images.  Many of the murals show individuals ascending mountains, or pointing at the stars and moons as they teach the figures around them.  A real monk passes through every once in a while to brush off the art and to check the status of the goods arranged for purchase."],"exits":[{"to":714,"exit":"northeast","move":"northeast"},{"to":712,"exit":"south","move":"south"}],"color":"#FF0000","aliases":["Ith Draknari Halls"]},
  {"id":714,"x":-180,"y":240,"z":0,"title":"Ith Draknari Halls, Chamber of the Burning Truth","descriptions":["The air is intensely heated due to the fires burning within three large stone troughs around the chamber.  Two of the fiery containers flank an alcove in the back wall and the copper hand that rests within.  Where the walls are not covered with soot or candle-covered shelves, the green flames and red letters that have been painted upon them are clearly visible."],"exits":[{"to":715,"exit":"southeast","move":"southeast"},{"to":713,"exit":"southwest","move":"southwest"}]},
  {"id":715,"x":-160,"y":260,"z":0,"title":"Ith'Draknari Halls, Passage of the Sky","descriptions":["Images of clouds swirling endlessly in peaceful currents of wind cover the walls, some painted and others made of tattered wool glued upon the stone.  Long horsehair tassels hang from the corners of the room, their ends drifting across the floor in the gentle breezes that descend from the open ceiling."],"exits":[{"to":716,"exit":"south","move":"south"},{"to":714,"exit":"northwest","move":"northwest"}]},
  {"id":716,"x":-160,"y":280,"z":0,"title":"Ith'Draknari Halls, Passage of the Eternal Ocean","descriptions":["A light blue shade has been dabbed over the walls, blended into a frothy white as it reaches the ceiling, which itself is painted to appear as a midnight sky.  To augment the stars upon that ebony background, delicate shards of crystal have been inlaid upon each of the constellations' key points.  With the exception of these gems, only a few pale tassels adorn the ceiling."],"exits":[{"to":715,"exit":"north","move":"north"},{"to":711,"exit":"southwest","move":"southwest"}]},
  {"id":717,"x":500,"y":1210,"z":0,"title":"Forest Path","descriptions":["Signs of sickening cling to the trees and the whisper of unseen creatures moving about alerts you to the fact that you are not alone.  The ground is a blasted, black color, and dry stalks of grass that hold no promise of life poke up from the barren earth.  To the northwest clamber a set of mountains that look less than a mile away, if that."],"exits":[{"to":399,"exit":"east","move":"east"},{"to":718,"exit":"northwest","move":"northwest"}]},
  {"id":718,"x":480,"y":1190,"z":0,"title":"Forest Path","descriptions":["The trees that grow here just barely comprise a forest, their tortured, claw-like branches scraping the sky and rendering them so malformed it is impossible to tell what type of tree they are.  A matted layer of thick, molding leaves cover the floor, filling the air with a miasma-like stench that makes your stomach cringe."],"exits":[{"to":717,"exit":"southeast","move":"southeast"},{"to":719,"exit":"northwest","move":"northwest"}]},
  {"id":719,"x":460,"y":1170,"z":0,"title":"Forest Path, Rocky Shore","descriptions":["The trees grow unsteadily along this rocky patch of ground, and in many places they have fallen.  The lapping of water greets your ears to the west, and glancing in that direction you can see a small lake the color of dull lead, its shores reaching all the way to the edge of a mountain range that makes an ugly black slash across the horizon."],"exits":[{"to":718,"exit":"southeast","move":"southeast"},{"to":720,"exit":"northwest","move":"northwest"},{"to":765,"exit":"go","move":"go shore"}]},
  {"id":720,"x":420,"y":1150,"z":0,"title":"Forest Path, Rocky Shore","descriptions":["The trees cling to a tedious life along the path that winds around the shore of the Silverwater Lake.  The ground is firmly packed, and ruts dig deeply into the earth on either side, remnants of a once thriving community.  The dead slap of water against water brings an eerie echo up from the lake shore."],"exits":[{"to":721,"exit":"north","move":"north"},{"to":719,"exit":"southeast","move":"southeast"}]},
  {"id":721,"x":420,"y":1130,"z":0,"title":"Forest Path, Rocky Shore","descriptions":["A shattered wood beam crosses your path here, the remnants of a house that has now long since vanished.  Fragments of rocks lie scattered across the ground, turning treacherously underfoot.  The ground creates odd embankments, as if the hand of a god pushed it back with one quick, idle brush."],"exits":[{"to":722,"exit":"north","move":"north"},{"to":720,"exit":"south","move":"south"}]},
  {"id":722,"x":420,"y":1110,"z":0,"title":"Silverwater Mines, Entrance","descriptions":["A jagged rip lies flush against the ebony mountainside, a layer of darkness against blackness against night.  Fine onyx sand lines the ground, its surface riddled with deep gouges, shattered glass, and broken support beams.  From within the mine's entrance you can hear odd snickering noises.","A jagged rip in the mountainside marks the entrance to the Silverwater Mines.  Broken support beams, shattered lanterns, and deep gouges in the fine sand that lie around the opening are all that remain of a once prosperous establishment.  You can barely make out what lies beyond, save for a few dark shapes and odd snickering noises."],"exits":[{"to":723,"exit":"north","move":"north"},{"to":721,"exit":"south","move":"south"},{"to":729,"exit":"west","move":"west"}]},
  {"id":723,"x":420,"y":1090,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["Strange noises bounce off the ragged stone ceiling, amplified by the quiet air of the night.  The dark is so thick that you can hardly see ahead, and the only thing clueing you toward the exit is the lapping sound of the lake shore coming from the south.  To the north the tunnel is choked with debris, but maneuverable."],"exits":[{"to":727,"exit":"north","move":"rt north"},{"to":724,"exit":"northeast","move":"northeast"},{"to":722,"exit":"south","move":"south"}]},
  {"id":724,"x":460,"y":1070,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["Luminescent fungi on the walls manages to lend light to this small, damp chamber.  Deep gouges cut through the ground, leaving glassy tracks and making the floor uneven."],"exits":[{"to":725,"exit":"east","move":"east"},{"to":723,"exit":"southwest","move":"southwest"},{"to":726,"exit":"northwest","move":"northwest"}]},
  {"id":725,"x":480,"y":1070,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["A rusting steel track is embedded into the cave floor here, running east ten feet before vanishing behind a wall of solid rock.  It is apparent from the stops at the visible end of the track that it began here, but hard to determine how it came to go through a wall, or how a wall came to grow up around it.  In the distance a repetitious dripping sound echoes through the cavern, doing nothing for the nerves."],"exits":[{"to":724,"exit":"west","move":"west"}]},
  {"id":726,"x":420,"y":1050,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["The mine opens up into a somewhat larger room here, the walls extending up some fifty feet before shading off into darkness.  In the center of the chamber is a deep shaft that plunges as far down as the walls climb up.  The floor is oddly free of the debris that litters the rest of the mines."],"exits":[{"to":728,"exit":"north","move":"north"},{"to":724,"exit":"southeast","move":"southeast"},{"to":727,"exit":"south","move":"rt south"},{"to":730,"exit":"down","move":"rt down"}]},
  {"id":727,"x":420,"y":1070,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["Broken stones, abandoned tools, and wooden beams choke this bottleneck passageway.  The smooth stone walls rise up to either side, constricting movement and creating a pretty place for an ambush."],"exits":[{"to":726,"exit":"north","move":"rt north"},{"to":723,"exit":"south","move":"rt south"}]},
  {"id":728,"x":420,"y":1030,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["The tunnel dead-ends here, choked by a wall of rubble and stone that blocks all further passage.  Chunks of rock lie strewn around you, and from beyond the stones you can hear a faint snickering sound.  A fine layer of dust lies over everything, and here and there you notice the faint tracings of footprints."],"exits":[{"to":726,"exit":"south","move":"south"}]},
  {"id":729,"x":400,"y":1110,"z":0,"title":"Wilderness, Clearing","descriptions":["The trees and undergrowth stop abruptly at the edge of this small clearing, the hard, cracked soil underfoot showing no sign of vegetation.  A broken cart lies near a cold fire pit in the center of the clearing, several pieces of unused firewood poking their heads over its splintered sides.  A small cave leads into the rocky hillside."],"exits":[{"to":722,"exit":"east","move":"east"},{"to":753,"exit":"go","move":"go small cave"}],"color":"#00FFFF"},
  {"id":730,"x":400,"y":1060,"z":0,"title":"Silverwater Mines, Shaft","descriptions":["The smooth walls of the mine shaft rise up to either side, a glossy black color.  Some fifty feet of sheer wall rests between this platform, the opening above, and the next platform below."],"exits":[{"to":726,"exit":"up","move":"rt up"},{"to":731,"exit":"down","move":"rt down"}]},
  {"id":731,"x":380,"y":1060,"z":0,"title":"Silverwater Mines, Shaft","descriptions":["The smooth walls of the mine shaft rise up to either side of you, a glossy black color.  Some fifty feet of sheer wall rests between the platform you stand on, the one above you, and the next platform below."],"exits":[{"to":730,"exit":"up","move":"rt up"},{"to":732,"exit":"down","move":"rt down"},{"to":747,"exit":"go","move":"go sheltered ledge"}]},
  {"id":732,"x":360,"y":1060,"z":0,"title":"Silverwater Mines, Shaft","descriptions":["The smooth walls of the mine shaft rise up to either side of you, a glossy black color.  Some fifty feet of sheer wall rests between the platform you stand on, the one above you, and the mine floor far below."],"exits":[{"to":731,"exit":"up","move":"rt up"},{"to":733,"exit":"down","move":"rt down"}]},
  {"id":733,"x":320,"y":1040,"z":0,"title":"Silverwater Mines, Cavern of Glass","descriptions":["This room is breathtakingly massive in size.  The walls shimmer like sheer glass, and the floor itself is made of a black, bubbled obsidian.  Cut into the low ceiling is a narrow opening that leads up to an abandoned mine shaft.  Faint light trickles through it, the only illumination and the one thing that still connects the cavern to the world that waits outside it."],"exits":[{"to":746,"exit":"north","move":"north"},{"to":735,"exit":"northeast","move":"northeast"},{"to":734,"exit":"east","move":"east"},{"to":744,"exit":"northwest","move":"northwest"},{"to":732,"exit":"up","move":"rt up"}]},
  {"id":734,"x":340,"y":1040,"z":0,"title":"Silverwater Mines, Cavern of Glass","descriptions":["A monstrous image awaits you here: the backside of a Human, preserved in the glass.  Shoved face-first into the obsidian walls, it is hard to tell what this hapless man's last expression was, but a guess would estimate that it was not a happy one.  Fickle light from the west plays off the pristine white of his clothing, preserved forever within the opaque surface."],"exits":[{"to":733,"exit":"west","move":"west"}]},
  {"id":735,"x":360,"y":1000,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["The floor of this bell-shaped room is smooth and level and so free of debris that it warrants suspicion.  An arching roof of smooth rock flies up overhead, fading off into the cave's natural darkness.  A pale greenish light from the north fills the cavern partially, becoming gradually watered down and consumed as it tries to reach south."],"exits":[{"to":736,"exit":"north","move":"north"},{"to":733,"exit":"southwest","move":"southwest"}]},
  {"id":736,"x":360,"y":980,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["Twin pillars of limestone divide the center of the tunnel into three graceful arches of equal size.  The fancy that these creations are of nature is shattered when you notice the glowing emeralds inset at the top of each arch, filling the room with a feverish green glow that reflects starkly off the limestone.  Toward the south the tunnel opens up more, which is compensated for by its narrowing to the north."],"exits":[{"to":737,"exit":"north","move":"north"},{"to":735,"exit":"south","move":"south"}]},
  {"id":737,"x":360,"y":960,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["The steady drip drip drip of water echoes in from somewhere close, but for some reason you cannot divine the direction the sound is coming from.  The unsettling rhythm it sets is more than grating on the nerves.  Toward the south you can see the faint shine of the eerie green light that fills all the tunnels, while toward the west the shadows thicken and seem to draw into themselves."],"exits":[{"to":736,"exit":"south","move":"south"},{"to":738,"exit":"northwest","move":"rt northwest"},{"to":745,"exit":"go","move":"search go small alcove"}]},
  {"id":738,"x":350,"y":950,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["Large chunks of rocks lie thrown about here, natural born ruins of Hodierna's heart.  The tunnel twists at a right angle ahead, moving with the sharp grace of the World Dragon itself."],"exits":[{"to":737,"exit":"southeast","move":"rt southeast"},{"to":739,"exit":"northwest","move":"rt northwest"}]},
  {"id":739,"x":340,"y":940,"z":0,"title":"Silverwater Mines, Rubble","descriptions":["Mounds of clutter and rubble lie packed around this room, the remains of a mining site that was abandoned before it could be properly dealt with."],"exits":[{"to":738,"exit":"southeast","move":"rt southeast"},{"to":740,"exit":"west","move":"rt west"}]},
  {"id":740,"x":320,"y":940,"z":0,"title":"Silverwater Mines, Gentle Slope","descriptions":["The floor climbs slowly upward toward the south and west while the roof remains level, lending an appearance of awkwardness to the tunnel.  Rough shapes protrude from the walls, and it is only after a moment of staring that you realize the shapes bear a strong resemblance to Human faces, mouths wide open in shock and terror, and Human arms, desperately trying to claw their way out through a grave of stone."],"exits":[{"to":739,"exit":"east","move":"rt east"},{"to":741,"exit":"southwest","move":"southwest"}]},
  {"id":741,"x":300,"y":960,"z":0,"title":"Silverwater Mines, Desolate Cavern","descriptions":["This underground chamber is filled with a pale, eerie green light that comes from no visible source.  Broken bits of stone, mangled remains of bodies, and rotting mementos of a past now scattered and gone are the only sign that this was once an active mining site."],"exits":[{"to":740,"exit":"northeast","move":"northeast"},{"to":742,"exit":"west","move":"west"},{"to":745,"exit":"go","move":"search go hidden alcove"}]},
  {"id":742,"x":260,"y":960,"z":0,"title":"Silverwater Mines, Desolate Cavern","descriptions":["A massive cavern yawns open about you, endlessly huge.  The ceiling and floors are lined in jagged stumps that were once whole stalactites and stalagmites, and shattered skeletal remains lie strewn about.  A deathly silence hangs heavy in the air, like a palpable curtain waiting to be drawn back.  The walls are scratched by claw marks, and the whole panorama hearkens to a raging tempest that whirlwinded through, tearing all within its path to shreds."],"exits":[{"to":741,"exit":"east","move":"east"},{"to":743,"exit":"southeast","move":"southeast"}]},
  {"id":743,"x":300,"y":1000,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["Broken bits of pottery, discarded mining picks, and remains of clothing and rags lie scattered about the floor.  The rock walls climb up around you, sealing out sound and lending a cramped feeling to the air."],"exits":[{"to":744,"exit":"south","move":"south"},{"to":742,"exit":"northwest","move":"northwest"}]},
  {"id":744,"x":300,"y":1020,"z":0,"title":"Silverwater Mines, Tunnel","descriptions":["Old rusting hooks are still embedded in the rough walls of the tunnel, though they hold little but air these days.  Lichen grows in small clumps on the walls, filling the room with a fitful, unearthly illumination.  Scintillating out of the corner of your eye, minerals glitter in a Fae sugar-coating on the rocks and stones."],"exits":[{"to":743,"exit":"north","move":"north"},{"to":733,"exit":"southeast","move":"southeast"}]},
  {"id":745,"x":330,"y":960,"z":0,"title":"Silverwater Mines, Alcove","descriptions":["This alcove, tucked away from the rest of the mine, sits like a lost child between the two wider service tunnels.  The floor holds a scattering of dirt across its surface along with an assorted collection of rubble.  A small shelf has been carved into one of the walls, its surface all but hidden by the shadows."],"exits":[{"to":737,"exit":"east","move":"east"},{"to":741,"exit":"west","move":"west"}]},
  {"id":746,"x":320,"y":1020,"z":0,"title":"Silverwater Mines, Cavern of Glass","descriptions":["The west side of the cave slopes gradually downward, ending in a gentle curve where it meets the floor and creating a small cup in which subterranean water has begun to pool.  A sickly green glow -- the color of a wounded forest -- emanates from the water, casting the room in its light."],"exits":[{"to":733,"exit":"south","move":"south"}]},
  {"id":747,"x":360,"y":1080,"z":0,"title":"Silverwater Mines, A Sheltered Ledge","descriptions":["Set back from the rest of the shaft, this recessed ledge appears to have been safe enough for miners to set up a few bunks for sleeping in.  Sadly, all that remains of the cots are a rusting iron frame and clinging tatters of rotting canvas."],"exits":[{"to":731,"exit":"out","move":"out"},{"to":748,"exit":"climb","move":"climb rickety ladder"}]},
  {"id":748,"x":340,"y":1080,"z":0,"title":"Silverwater Mines, Along the Ladder","descriptions":["The steady drip of water trickling down the sides of the smooth obsidian walls reverberates with a cascade of echoes throughout the dark shaft.  Creaking loudly with any weight placed upon its shabby rungs, the old ladder adds readily to the strange music.  The absence of a few rungs requires the use of nearby handholds eroded out of the otherwise slick surface of the rock."],"exits":[{"to":749,"exit":"climb","move":"climb handholds"},{"to":747,"exit":"climb","move":"climb rickety ladder"}]},
  {"id":749,"x":320,"y":1080,"z":0,"title":"Silverwater Mines, Along the Ladder","descriptions":["Damp and dark, the narrow shaft forms a perfect environment for the propagation of various types of lichen that cling in crusty patches to the surface of the smooth walls.  Even the rickety old ladder with its missing rungs is not immune to their scaly invasion.  Only a few fragile handholds formed of jagged rock protruding from the slick surface bring any hope of retreat."],"exits":[{"to":750,"exit":"climb","move":"climb ladder"},{"to":748,"exit":"climb","move":"climb handholds"}]},
  {"id":750,"x":300,"y":1080,"z":0,"title":"Silverwater Mines, Along the Ladder","descriptions":["Every few seconds, harsh creaks reverberate through the shaft as a wooden platform attached to a thick steel cable whizzes past.  Anyone foolish enough to attempt this climb along the ladder would be wise to keep themselves plastered closely against the smooth wall.  Overhead, a small niche is crudely chiseled into the surface of the rock."],"exits":[{"to":751,"exit":"climb","move":"climb small niche"},{"to":749,"exit":"climb","move":"climb ladder"}]},
  {"id":751,"x":280,"y":1080,"z":0,"title":"Silverwater Mines, Along the Ladder","descriptions":["Traces of minerals embedded in the obsidian walls reflect faint beams of light that occasionally filter down the narrow shaft.  The dim rays provide just enough light to reveal a series of illegible markings scratched into the wall, much like fingernails that have missed their reach."],"exits":[{"to":752,"exit":"climb","move":"climb ladder"},{"to":750,"exit":"climb","move":"climb small niche"}]},
  {"id":752,"x":260,"y":1080,"z":0,"title":"Silverwater Mines, Along the Ladder","descriptions":["Every sound is magnified tenfold in the hollowness of the dank shaft, including the occasional scream from less capable climbers below.  Looking as though it might fall from the rotted wood at any moment, an old oil lamp hanging from one of the few remaining rungs of the ladder proves that others have also attempted this climb up the shaft.  The obvious lack of any further handholds, either man-made or natural, makes it clear that retreat is now the only possible means of escape."],"exits":[{"to":751,"exit":"climb","move":"climb ladder"}]},
  {"id":753,"x":300,"y":1180,"z":0,"title":"Gazit Lair, Grotto","descriptions":["A slight breeze mingles fresh, damp air from the outside with the musty dryness of this ancient cave.  The ground rises slightly as it heads north into the center of the lair."],"exits":[{"to":755,"exit":"north","move":"north"},{"to":754,"exit":"northeast","move":"northeast"},{"to":756,"exit":"northwest","move":"northwest"},{"to":729,"exit":"out","move":"out"}],"color":"#00FFFF","aliases":["Gazit Lair"]},
  {"id":754,"x":320,"y":1160,"z":0,"title":"Gazit Lair, Grotto","descriptions":["An array of intertwining crystalline vines laces the jagged rock walls, their smooth, dry surfaces gleaming dully in the ambient light.  Crude steps chiseled into the walls lead up to a wide stone ledge.  A fine patina of dust covers the floor, roiling into brown clouds with the slightest disturbance."],"exits":[{"to":759,"exit":"north","move":"north"},{"to":753,"exit":"southwest","move":"southwest"},{"to":755,"exit":"west","move":"west"},{"to":758,"exit":"northwest","move":"northwest"},{"to":763,"exit":"climb","move":"climb crude steps"}],"color":"#00FFFF"},
  {"id":755,"x":300,"y":1160,"z":0,"title":"Gazit Lair, Fire Pit","descriptions":["Rows of stacked stones surround a deep firepit in the center of the dirt floor.  A mass of ash, pieces of blackened wood and small bits of fire-greyed bone fill the pit, their presence adding a slight scent of char to the air.  Several large stone benches line the walls, chiseled from the cave's native limestone."],"exits":[{"to":758,"exit":"north","move":"north"},{"to":759,"exit":"northeast","move":"northeast"},{"to":754,"exit":"east","move":"east"},{"to":753,"exit":"south","move":"south"},{"to":756,"exit":"west","move":"west"},{"to":757,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":756,"x":280,"y":1160,"z":0,"title":"Gazit Lair, Grotto","descriptions":["Ambient light dances across the face of a large crystalline formation that stretches from floor to ceiling, teasing ever-changing shadows across the room.  To the left of the crystals, a flow of smooth limestone has shaped itself into a natural staircase leading up to the rock lip encircling the chamber."],"exits":[{"to":757,"exit":"north","move":"north"},{"to":758,"exit":"northeast","move":"northeast"},{"to":755,"exit":"east","move":"east"},{"to":753,"exit":"southeast","move":"southeast"},{"to":760,"exit":"climb","move":"climb natural staircase"}],"color":"#00FFFF"},
  {"id":757,"x":280,"y":1140,"z":0,"title":"Gazit Lair, Grotto","descriptions":["Milky-white deposits of limestone cascade down the northwest wall in formation created long ago but long since dried and dead.  A casualty of the near-total darkness, a spindly, single-leafed stalk hangs limply over the edge of a cracked clay pot that squats near one of the doors set into the walls of the cavern."],"exits":[{"to":758,"exit":"east","move":"east"},{"to":755,"exit":"southeast","move":"southeast"},{"to":756,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":758,"x":300,"y":1140,"z":0,"title":"Gazit Lair, Grotto","descriptions":["Velvety limestone draperies flow down the far wall, adding a superficial appearance of softness to the rock's surface.  A number of flat, grey stones have been stacked into a tower of precarious steps leading up to a wide rock lip that encirles the entire cavern."],"exits":[{"to":759,"exit":"east","move":"east"},{"to":754,"exit":"southeast","move":"southeast"},{"to":755,"exit":"south","move":"south"},{"to":756,"exit":"southwest","move":"southwest"},{"to":757,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":759,"x":320,"y":1140,"z":0,"title":"Gazit Lair, Grotto","descriptions":["Silent stalactites glint far overhead with an eerie iridescence that lights the entire cavern in a pale, green glow.  A pile of large boulders along one wall give shelter to a tiny opening nestled in the rock face."],"exits":[{"to":754,"exit":"south","move":"south"},{"to":755,"exit":"southwest","move":"southwest"},{"to":758,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":760,"x":250,"y":1160,"z":0,"title":"Gazit Lair, Karik Rim","descriptions":["A stream of cool water trickles from a narrow crack in the rock wall and onto the floor, forming a small pool.  An even smaller rivulet dribbles from the other side of the pool, spreading across the nearby rock to evaporate into the warm, dry air."],"exits":[{"to":764,"exit":"northeast","move":"northeast"},{"to":761,"exit":"southeast","move":"southeast"},{"to":756,"exit":"climb","move":"climb rock staircase"}],"color":"#00FFFF"},
  {"id":761,"x":290,"y":1200,"z":0,"title":"Gazit Lair, Karik Rim","descriptions":["A painting of a huge, four-legged creature dominates the near wall of this section of the chamber.  A plethora of runic symbols encircle the figure, interspersed between them the outlines of several large handprints.  The entire piece has been painted in the same, unvarying ochre hue."],"exits":[{"to":762,"exit":"east","move":"east"},{"to":760,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":762,"x":310,"y":1200,"z":0,"title":"Gazit Lair, Karik Rim","descriptions":["A pile of discarded skulls and bones lies at the base of one wall, gleaming dully in the dim light.  The walls here are stained a smokey grey, darker near the lower areas where an abandoned firepit is slowly being consumed by the steady accumulation of dust on the cavern's floor."],"exits":[{"to":763,"exit":"northeast","move":"northeast"},{"to":761,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":763,"x":350,"y":1160,"z":0,"title":"Gazit Lair, Karik Rim","descriptions":["This large stone ledge, wide enough for a yak caravan to travel, circles the entire rim of the cavern.  A series of crude drawings have been sketched along the walls, their images showing miniature Gor'Togs standing in an endless battle against creatures frozen in time."],"exits":[{"to":762,"exit":"southwest","move":"southwest"},{"to":764,"exit":"northwest","move":"northwest"},{"to":754,"exit":"climb","move":"climb crude steps"}],"color":"#00FFFF"},
  {"id":764,"x":300,"y":1110,"z":0,"title":"Gazit Lair, Karik Rim","descriptions":["A row of stalagmites form a natural railing along the lip of the stone walkway underfoot, lending a modicum of protection against falling to the cavern floor below.  The air is slightly warmer here than the rest of the cave."],"exits":[{"to":763,"exit":"southeast","move":"southeast"},{"to":760,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":765,"x":480,"y":1170,"z":0,"title":"Silverwater Lake, Shore","descriptions":["The dull, listless waters of Silverwater Lake spread out before you, a rippling matte mirror.  Except for the choppy slap of the waves against the black sands of the shore, the lake is quiet and devoid of any sign of fish or wildlife."],"exits":[{"to":766,"exit":"northeast","move":"northeast"},{"to":719,"exit":"go","move":"go forest path"}]},
  {"id":766,"x":500,"y":1150,"z":0,"title":"Silverwater Lake, Shore","descriptions":["A steep bank of rocks and dirt climbs up to the east, creating a short but unclimbable wall.  To the west the water of Silverwater Lake thrashes in its death throes, sucking away at the pebbled sands of the shore.  The stillness is unsettling, and a little frightening."],"exits":[{"to":765,"exit":"southwest","move":"southwest"},{"to":767,"exit":"northwest","move":"northwest"}]},
  {"id":767,"x":480,"y":1130,"z":0,"title":"Silverwater Lake, Shore","descriptions":["Quarry piled along the shore and the remnants of a deep channel that leads up to the mines indicates that this may have once been the place where the miners dumped the remains of the day's excursions.  A fine, gritty layer of black covers everything, and the water is noticeably darker by comparison to the rest of the lake."],"exits":[{"to":766,"exit":"southeast","move":"southeast"},{"to":768,"exit":"northwest","move":"northwest"}]},
  {"id":768,"x":460,"y":1110,"z":0,"title":"Silverwater Lake, Shore","descriptions":["The shoreline becomes more and more rocky until it finally turns into the treacherous mountainside.  Tall and majestic, the range cups the lake in a halfmoon shape.  An earthquake from time immemorial has split the part of the mountain's side that faces Silverwater, leaving a sheer wall of granite that dives straight down into the water with reckless abandon.  A splendid and awe-inspiring cataract topples aimlessly over the straightest cliff, feeding the lake but never dispelling its grim hue."],"exits":[{"to":767,"exit":"southeast","move":"southeast"}]},
  {"id":769,"x":750,"y":1980,"z":0,"title":"Fillop's Knollshop","descriptions":["The dark earth walls of this round chamber are lined with fine green mosses and delicate white starflowers.  Her black eyes sparkling above rosy apple cheeks, a bustling Halfling woman beams brightly at her customers as she combines the latest gossip with an expert patter about the quality knoll landscapes she purveys."],"exits":[{"to":599,"exit":"out","move":"out"},{"to":770,"exit":"go","move":"go low tunnel"}],"color":"#FF0000","aliases":["Fillop's Knollshop"]},
  {"id":770,"x":760,"y":1980,"z":0,"title":"Fillop's Finest Knolls","descriptions":["Nestling within a spacious antechamber, the root-lined walls of Fillop's more exclusive gallery are hung with hundreds of tiny glass jars, each containing a brightly-glowing firefly.  The gentle yellow light softly illuminates the rotund proprietor's cheery smile as he enthusiastically discusses the custom landscapes he creates for Halflings of a higher class."],"exits":[{"to":769,"exit":"go","move":"go low tunnel"}],"color":"#FF0000"},
  {"id":771,"x":660,"y":1990,"z":0,"title":"Berry Knolls, Bungles's Backyard","descriptions":["A cobblestone walk lined with lush taffelberry bushes points the way to a large greenhouse nestled amid colorful thornberry shrubs and maiden tress vines.  Brightly painted wooden benches are scattered around a small pond that rests at the base of a large mound dotted with fiddlehead ferns.  The greenhouse's glass door has been cheerfully painted with colorful flowers of all shapes and sizes."],"exits":[{"to":772,"exit":"go","move":"go glass door"},{"to":773,"exit":"climb","move":"climb large mound"},{"to":602,"exit":"go","move":"go wooden gate"}]},
  {"id":772,"x":650,"y":1990,"z":0,"title":"Berry Knolls, Bungles's Greenhouse","descriptions":["Warm damp air heavy with the smell of moist earth and intermingled with the scent of blooming flowers permeates the area.  Rickety tables, overburdened with heavy clay pots bearing yellow gardenias, snapdragon stalks, and black orchids, are sprinkled throughout the room and almost obscure an ivy-covered screen that leads to a small work area.  Centered strategically with the best available light sits a sturdy oak table bearing a huge potted bibbleberry bush."],"exits":[{"to":771,"exit":"go","move":"go glass door"}]},
  {"id":773,"x":660,"y":2000,"z":0,"title":"Berry Knolls, Open Field","descriptions":["At the top of the mound, a large open field emerges.  Speckled with occasional gooseberry, thimbleberry, and mintberry bushes, it provides a perfect area for picnics or fairs.  Pink clover and sweet woodruff cover the ground profusely, marred only by several tamped down patches indicating where tents and wagons have previously rested."],"exits":[{"to":771,"exit":"climb","move":"climb large mound"}]},
  {"id":774,"x":-40,"y":301,"z":0,"title":"Lava Forge, Lobby and Book Store","descriptions":["Dust drifts through the archway over the cooled lava floor and piles in the corners of the stone building.  A bored Human attendant relaxes on a stool near a leather curtain that closes off the rest of the forge."],"exits":[{"to":665,"exit":"out","move":"out"},{"to":775,"exit":"go","move":"go curtain"}],"color":"#FF0000","aliases":["Lava Forge","Forging Society","Forging Book Store"]},
  {"id":775,"x":-40,"y":340,"z":0,"title":"Lava Forge, Supplies","descriptions":["A rickety wooden table stands near a battered rack that leans against the granite wall.  A Human smithy attendant, looking rather harried, watches people pass by as he restocks the supplies."],"exits":[{"to":776,"exit":"northeast","move":"northeast"},{"to":779,"exit":"east","move":"east"},{"to":780,"exit":"south","move":"south"},{"to":778,"exit":"west","move":"west"},{"to":777,"exit":"northwest","move":"northwest"},{"to":774,"exit":"go","move":"go curtain"}],"color":"#FF0000","aliases":["Forging Supplies"]},
  {"id":776,"x":-20,"y":320,"z":0,"title":"Lava Forge, Maker's Mark Ordering","descriptions":["Away from the din of the main forging area, this small room carved out of the hardened lava serves as a respite from the hustle and bustle of the busy lobby.  Future master smiths plot their technique choices as they study charts detailing their future career options.  All the while, master smiths deliberate over the design of their soon to be made new master crafter's mark."],"exits":[{"to":775,"exit":"southwest","move":"southwest"}],"color":"#FF0000","aliases":["Forging Makers Mark"]},
  {"id":777,"x":-60,"y":320,"z":0,"title":"Lava Forge, Tool Store","descriptions":["Throughout this cavernous room the floor has been scuffed and scratched as boxes and crates of components needed for finally assembly of the various forged items have been hauled into place.  Groans can be heard often because restocking is constantly in progress."],"exits":[{"to":775,"exit":"southeast","move":"southeast"}],"color":"#FF0000","aliases":["Forging Tool Store"]},
  {"id":778,"x":-60,"y":340,"z":0,"title":"Lava Forge, Foundry","descriptions":["Windows high up in the stone walls provide just a hint of fresh air over the stench of burning coal and molten metal.  Supported by chains from a wooden beam, a heavy ceramic crucible swings over the fire or over to the molds lined against the wall."],"exits":[{"to":775,"exit":"east","move":"east"},{"to":782,"exit":"southwest","move":"southwest"},{"to":781,"exit":"west","move":"west"}]},
  {"id":779,"x":-20,"y":340,"z":0,"title":"Lava Forge, Foundry","descriptions":["Heat from the coal-fed fire is absorbed and radiated back by the hardened lava floor, while over the flames a battered iron crucible dangles from chains attached to a granite beam that stretches to the molds arrayed along the wall."],"exits":[{"to":783,"exit":"east","move":"east"},{"to":784,"exit":"southeast","move":"southeast"},{"to":775,"exit":"west","move":"west"}]},
  {"id":780,"x":-40,"y":360,"z":0,"title":"Lava Forge, Foundry","descriptions":["The scent of overheated metal hangs thickly in the air, adding to the discomfort of the heat of the coal-stoked fire in the firepit.  Suspended from a thick wooden beam, an obsidian crucible swings, with effort, between the molds lined up against the wall and the fire."],"exits":[{"to":775,"exit":"north","move":"north"},{"to":786,"exit":"southeast","move":"southeast"},{"to":785,"exit":"southwest","move":"southwest"}]},
  {"id":781,"x":-80,"y":340,"z":0,"title":"Lava Forge, Forge","descriptions":["A massive iron anvil crouches in the center of the black floor.  Against the wall, a glowing iron forge awaits things to heat, casting a reddish glow over the room.  Small windows high in the wall draw some of the heat outside to mingle with the dusty air."],"exits":[{"to":778,"exit":"go","move":"go arch"}]},
  {"id":782,"x":-80,"y":360,"z":0,"title":"Smelting and Grinding Area","descriptions":["Metal shrieks against stone as the grindstones spin.  The industrious forge attendants, who bustle about while seeming not to move, keep the black, pitted lava floor clean.  Muffled pounding sounds from elsewhere in the forge, and a wall of heat comes from the foundry to the northeast, but this grinding room is a relative oasis of coolness in the granite building."],"exits":[{"to":778,"exit":"northeast","move":"northeast"}]},
  {"id":783,"x":0,"y":340,"z":0,"title":"Lava Forge, Forge","descriptions":["The hard ash-speckled lava floor is hot to the touch, not from the nearby volcano but from the fires within the glowing forge near the south wall.  Sparks fly as hammers strike heated metal on a battered anvil against the north wall.  The clanging bounces around the small room until the granite walls seem to ring in harmony."],"exits":[{"to":779,"exit":"go","move":"go arch"}]},
  {"id":784,"x":0,"y":360,"z":0,"title":"Forge and Grinding Area","descriptions":["A scream greets the newcomer to this area.  The source is not the apprentice at one of the grindstones along the perimeter of the room, but the blade he is grinding.  Other apprentices keep the grindstone spinning, panting with the effort."],"exits":[{"to":779,"exit":"northwest","move":"northwest"}]},
  {"id":785,"x":-60,"y":380,"z":0,"title":"Lava Forge, Forge","descriptions":["Silent figures in robes flit from room to room, apprentices bent on their labors.  Here, a black anvil set on an oak base stands near one wall, opposite a hulking iron forge.  Waves of heat wash across the room to be absorbed by the granite walls."],"exits":[{"to":780,"exit":"go","move":"go arch"}]},
  {"id":786,"x":-20,"y":380,"z":0,"title":"Smelting and Grinding Area","descriptions":["A row of grindstones circles the granite-walled room.  A few robed Humans work in tandem to spin a grindstone while another carefully presses an unfinished blade against the stone, causing sparks to scatter over the pitted floor.  The scraping of the metal reverberates along the walls."],"exits":[{"to":780,"exit":"northwest","move":"northwest"}]},
  {"id":787,"x":100,"y":220,"z":0,"title":"His Daring Exploit","descriptions":["Most of the passengers on this low riding barge have descended into quiet conversation, not wishing to stir the night.  A single lantern, swinging from the fore rail, pushes its dull gold rays across the dark water."],"exits":[{"to":81,"exit":"go","move":"go north docks"},{"to":0,"exit":"go","move":"go riverhaven docks"}],"linksTo":"Map998_Transports.xml"},
  {"id":788,"x":510,"y":990,"z":0,"title":"Paper Mill, Upper Chutes","descriptions":["Cut blocks of wood, trimmed of all their bark, are piled in neat stacks all around this area.  A large saw lies suspended over a nearby cutting table, looking heavy enough to require four people to use.  Several discarded pieces of half-folded origami lie next to a wooden bench, as if their creator became disinterested halfway through the project."],"exits":[{"to":789,"exit":"south","move":"south"},{"to":264,"exit":"climb","move":"climb narrow stairs"}]},
  {"id":789,"x":510,"y":1000,"z":0,"title":"Paper Mill, Upper Chutes","descriptions":["The center of this room is dominated by a large metallic grinder, apparently used to turn logs of wood into chips for papermaking.  A large half-covered hole near the grinder shows an enormous pile of cut wood chips in the room below.  Near the southern wall, a second chute lies open, apparently made for dumping discarded bark and other waste into the scrap yard."],"exits":[{"to":788,"exit":"north","move":"north"},{"to":790,"exit":"west","move":"west"}]},
  {"id":790,"x":500,"y":1000,"z":0,"title":"Paper Mill, Rooftop","descriptions":["The slightly slanted rooftop of the paper mill is covered with piles of sawdust, creating little piles of powder that resemble dirty snow.  Jet black tiling peeks through the heavy layer of dust occasionally, in vague shapes that sometimes resemble footprints.  A sizable storm drain edges the roof, likely used to collect runoff water to be used for other purposes."],"exits":[{"to":791,"exit":"north","move":"north"},{"to":789,"exit":"east","move":"east"}]},
  {"id":791,"x":500,"y":990,"z":0,"title":"Paper Mill, Rooftop","descriptions":["This small area of the rooftop is relatively bare except for an empty bird's nest tucked into one corner of the storm drains.  A few bits of eggshell still remain inside the random-looking bundle of twigs and bark.  The roof is fairly flat in this area, only a slight angle directing rainwater into the trough lining its edge."],"exits":[{"to":790,"exit":"south","move":"south"}]},
  {"id":794,"x":300,"y":2410,"z":0,"title":"DiSilveron, Front Gate","descriptions":["Grand alabaster lions flank a regal wrought-iron gate that is accented in heavy silver leaf.  To either side of these gargantuan works of art are high hedges of jasmine intertwined with woodrose, which continue on for several yards before banking out of sight.  A silver-tinged, multi-gabled roof is visible just above the hedges."],"exits":[{"to":313,"exit":"go","move":"go freshly-planted pathway"}],"aliases":["DiSilveron"],"linksTo":"Map7c_DiSilveron.xml"},
  {"id":795,"x":480,"y":2470,"z":0,"title":"Warrior Mage Guild, Storage","descriptions":["Crates of food are stacked in this place, leaving very little room to move about.  Some of the crates are marked \"For Cats Only\", obviously nourishment for familiars when the season grows too cold for them to hunt on their own.  A counter on one wall is piled with odds and ends not yet packed away for storage."],"exits":[{"to":434,"exit":"east","move":"east"}],"aliases":["donation2","storage"]},
  {"id":796,"x":560,"y":2490,"z":0,"title":"Warrior Mage Guild, Storage","descriptions":["A small space has been set aside in the guild for the storage of goods.  Numerous crates are stacked up against the walls leaving an open area in the center of the room.  The room is dimly lit by a small lantern which sits atop a wooden box near the wall opposite an iron door.  Behind the box sits an apprentice, his eyes focused intently on a ledger before him."],"exits":[{"to":291,"exit":"go","move":"go iron door"}],"aliases":["WM Shop","Warrior Mage Shop"]},
  {"id":797,"x":580,"y":2470,"z":0,"title":"Warrior Mage Guild, Warrens","descriptions":["This small cavern is filled with ledge upon ledge perfectly suited to fit the varied bodies of familiars.  A small stone in the center of the room glows with a subdued red light, providing heat for those incarnated into cold-blooded bodies."],"exits":[]},
  {"id":798,"x":630,"y":2000,"z":0,"title":"Yulugri Wala, Floor Seating","descriptions":["Bright red upholstered seats allow guests to sit in comfort for the performances.  This section of the floor seating provides few frills, but does allow a clear view of the stage -- as long as the occupants of the seats farther forward are not too tall."],"exits":[{"to":607,"exit":"out","move":"out"}]},
  {"id":799,"x":580,"y":1310,"z":0,"title":"Deep Forest, Dilapidated Cabin","descriptions":["The trees thin slightly here, opening up around the ruins of a cabin.  The vine-choked structure struggles to stand under the weight of a fallen tree, with the occasional foreboding creak emanating from its boards.  Off to one side, a pile of rocks marks the location of a crumbling well."],"exits":[{"to":800,"exit":"go","move":"go dilapidated cabin"},{"to":381,"exit":"go","move":"go narrow trail"},{"to":859,"exit":"east","move":""},{"to":860,"exit":"southeast","move":""}]},
  {"id":800,"x":600,"y":1290,"z":0,"title":"Dilapidated Cabin","descriptions":["A strong odor of rotting vegetation fills this small cabin, despite planks missing at varying intervals leaving the area open to the outside.  Dead branches reach through the broken ceiling above like long, bony fingers, in contrast to the tender seedlings pushing up through the floorboards.  A small, rotting area rug is pulled back in one corner, revealing a trapdoor."],"exits":[{"to":801,"exit":"go","move":"go trapdoor"},{"to":799,"exit":"go","move":"go crooked doorway"}]},
  {"id":801,"x":620,"y":1290,"z":0,"title":"Dilapidated Cabin, Basement","descriptions":["A rusted lantern hanging from above shines a gentle glow over this space, which is little more than a cave carved in the vague shape of a room.  Makeshift tables and shelves line the walls, covered with an assortment of gears and metal scraps.  Heavy wooden supports stand at the north and south ends of the area, framing parts of the cavern that were left in their natural states."],"exits":[{"to":802,"exit":"north","move":"north"},{"to":808,"exit":"south","move":"south"},{"to":800,"exit":"climb","move":"climb wooden steps"}]},
  {"id":802,"x":620,"y":1270,"z":0,"title":"Dilapidated Cabin, Tunnel","descriptions":["The rough rock forms a jagged arch overhead that curves to the south and northeast along the tunnel.  Piles of stones line the sides of the path, each scarred by chisel marks."],"exits":[{"to":803,"exit":"northeast","move":"northeast"},{"to":801,"exit":"south","move":"south"}]},
  {"id":803,"x":640,"y":1250,"z":0,"title":"Dilapidated Cabin, Tunnel","descriptions":["The path curves sharply to the southwest and southeast, hugging a cluster of stalactites and stalagmites.  A gear is deeply embedded in the rock, almost appearing as though it was naturally formed along with the stone."],"exits":[{"to":804,"exit":"southeast","move":"southeast"},{"to":802,"exit":"southwest","move":"southwest"}]},
  {"id":804,"x":660,"y":1270,"z":0,"title":"Dilapidated Cabin, Tunnel","descriptions":["Deep gouges are cut in the walls, like scars in the stone, forming clean furrows as though the tool used was slicing through clay instead of hard rock.  A ruddy stain, vaguely resembling a handprint, mars the surface alongside the gash."],"exits":[{"to":805,"exit":"southeast","move":"southeast"},{"to":803,"exit":"northwest","move":"northwest"}]},
  {"id":805,"x":680,"y":1290,"z":0,"title":"Dilapidated Cabin, Tunnel","descriptions":["Curving gently, the tunnel is shaped in such a way that it makes it difficult to tell which directions various skittering noises are coming from.  Overhead, roots squeeze through cracks, further dampening sounds."],"exits":[{"to":806,"exit":"southwest","move":"southwest"},{"to":804,"exit":"northwest","move":"northwest"}]},
  {"id":806,"x":660,"y":1310,"z":0,"title":"Dilapidated Cabin, Tunnel","descriptions":["The coolness of the air is heightened by the addition of moisture and creating a scent similar to dust after the rain.  Droplets of water cling to the stone walls, making them look as though they're perspiring."],"exits":[{"to":805,"exit":"northeast","move":"northeast"},{"to":807,"exit":"southwest","move":"southwest"}]},
  {"id":807,"x":640,"y":1330,"z":0,"title":"Dilapidated Cabin, Tunnel","descriptions":["Cracks spread across the stone walls in an intricate cobweb pattern, as if something with massive strength punched the rock.  A small clump of lichen clings to one of the fractures, following the jagged line like a tiny, greenish lightning bolt."],"exits":[{"to":806,"exit":"northeast","move":"northeast"},{"to":808,"exit":"northwest","move":"northwest"}]},
  {"id":808,"x":620,"y":1310,"z":0,"title":"Dilapidated Cabin, Tunnel","descriptions":["A deep shelf is carved into the wall, in which is stored locked chests bound by chains.  Strange symbols are crudely etched into the rock wall above each one, though their relation is unclear."],"exits":[{"to":801,"exit":"north","move":"north"},{"to":807,"exit":"southeast","move":"southeast"}]},
  {"id":809,"x":390,"y":2590,"z":0,"title":"The Bardess' Fete, Deck","descriptions":["Silken rigging suspends the sweeping teak sloop's deck from the semi-rigid envelope above.  Shaded silk-cushioned benches along the bow's rail offer comfort and a spectacular view from the ship.  A cylindrical copper device, about the size of a large bread oven, snakes a half dozen tubes upward into the bottom of the segmented balloon.  Aft of the device, the quarterdeck rises to elevate the ship's wheel, while beyond, a cherrywood door marks the entrance to a small cabin.  To the left of the door hangs a framed painting, and to the right is a small porthole."],"exits":[{"to":271,"exit":"climb","move":"climb ladder"}],"color":"#FF00FF","aliases":["airship"]},
  {"id":810,"x":120,"y":1820,"z":0,"title":"Foothills, Rocky Pass","descriptions":["Cracked boulders cast long shadows over the narrow path that carefully picks its way through the rocky outcrops and mossy slopes of the rolling hillside.  Loose scree covers the ground, marking the trail's track and lending a subtle treachery to it at the same time.","Cracked boulders cast ugly, malformed shadows over the narrow path that carefully picks its way through the rocky outcrops and mossy slopes of the rolling hillside.  The trail is all but lost in the night, the glint of minerals in the scree that is scattered over the overgrown track the only indicator that you are not lost in a world of darkness."],"exits":[{"to":811,"exit":"south","move":"south"},{"to":464,"exit":"climb","move":"climb tumbled boulders"}],"aliases":["Giant Bear"]},
  {"id":811,"x":120,"y":1840,"z":0,"title":"Foothills, Rocky Pass","descriptions":["The shoulders of the hillside shove up close to each other, the steep slopes lending no purchase and instilling a sense of claustrophobia.  Tender shoots of grass poke up between the cracks in the fractured stones that are crammed into the looming hills, their greyed and weathered surface resembling the rotting teeth of a grinning giant."],"exits":[{"to":810,"exit":"north","move":"north"},{"to":812,"exit":"southwest","move":"southwest"},{"to":821,"exit":"go","move":"go cave entrance"}]},
  {"id":812,"x":100,"y":1860,"z":0,"title":"Foothills, Rocky Pass","descriptions":["Densely packed scrub and the rise of a few hardy and wind-twisted trees skirt the narrow pass.  The shadow of the jealous hillside swallows all that lies in its grip, leaving little purchase for sunlight.  Scattered bird calls echo between the tiny valleys created by the insurmountable slopes, belying the emptiness that fills in the gaps the pass has created.","Densely packed scrub and the rise of a few hardy and wind-twisted trees skirt the narrow pass.  The night is enhanced by the looming presence of the tyrannical hillside that casts its long, looming shadow over all who dare step foot beneath it.  The breathy thunder of wingbeats floats through the air as bats and birds of prey go about their business."],"exits":[{"to":811,"exit":"northeast","move":"northeast"},{"to":813,"exit":"south","move":"south"}]},
  {"id":813,"x":100,"y":1880,"z":0,"title":"Foothills, Rocky Pass","descriptions":["The hillside fans outward to the west and narrows into a cramped pass to the east.  The gentle slope of a valley sweeps up to meet the pass, the green grass short and spikey and surprisingly lush."],"exits":[{"to":812,"exit":"north","move":"north"},{"to":850,"exit":"east","move":"east"},{"to":814,"exit":"climb","move":"climb hillside"}]},
  {"id":814,"x":80,"y":1900,"z":0,"title":"Wooded Hills, East Slope","descriptions":["The smooth surface of the slope curves gently in a wave of smooth, blood dark grass.  Due to a thick mist, the valley floor is inscrutable save for the flash of odd architectural protrusions that claw upwards in a futile attempt to escape the darkness.","The smooth surface of the slope curves gently in a wave of glass green foliage.  A mist demurely hides the valley floor from prying eyes, offering only teasing glimpses of the tops of jagged marble structures and obelisks that happen to escape its swirling grey clutches.  Overhead, the sky is obscured by the rise of stoney hills as the footrail travels restlessly up and down the hillside."],"exits":[{"to":819,"exit":"southwest","move":"southwest"},{"to":815,"exit":"northwest","move":"northwest"},{"to":813,"exit":"climb","move":"climb hillside"}],"aliases":["Onyx Gargoyles","Gargoyles"]},
  {"id":815,"x":60,"y":1880,"z":0,"title":"Vale, Journalai Outskirts","descriptions":["A glowing white marble marker lies in two whole pieces, its rune-covered surface rendered illegible from years of work by eolian forces.  Despite the presence of ivy and lichen on the other marble architecture in the area, the marker remains remarkably clear of encroaching foliage.  The darkened hillside that cups the valley flows gently down to the foot of the toppled stone giant, treating it with more deference than the city's conquerers and subsequent plunderers did.","A massive white marble marker lies in two whole pieces, its rune-covered surface rendered illegible from years of work by eolian forces.  Despite the presence of ivy and lichen on the other marble architecture in the area, the marker remains remarkably clear of encroaching foliage.  The hillside that cups the valley flows gently down to the foot of the toppled stone giant, treating it with more deference than the city's conquerers and subsequent plunderers did."],"exits":[{"to":814,"exit":"southeast","move":"southeast"},{"to":820,"exit":"southwest","move":"southwest"},{"to":816,"exit":"up","move":"up"}]},
  {"id":816,"x":20,"y":1880,"z":0,"title":"Wooded Hills, East Slope","descriptions":["Springy aspens, shimmering maples, and rampant wild rose vines nervously huddle along the sides of the slope, hedging in the vale floor with a barrier that is at times impenetrable and at other times suspiciously thin.  The hoots of gloom-loving owls and the cackle of corbies haunt the treetops, weaving in and out of the all-blanketing mist like lost souls."],"exits":[{"to":817,"exit":"south","move":"south"},{"to":815,"exit":"down","move":"down"}]},
  {"id":817,"x":20,"y":1900,"z":0,"title":"Wooded Hills, Top of Hill","descriptions":["Trees and other vegetation clear out at the top of the hilltop, creating a bare space whipped by the wind and weather.  Bare rocks fight with lichens and other hardy species to cling to the slope.  The clearing allows a more expansive view across the valley and the further reaches, showing glimpses of abandoned ruins in the distance."],"exits":[{"to":816,"exit":"north","move":"north"},{"to":818,"exit":"south","move":"south"}]},
  {"id":818,"x":20,"y":1920,"z":0,"title":"Wooded Hills, East Slope","descriptions":["Heavy, black-leafed bushes cluster around the trees that form the overgrown barrier of the Journalai Vale.  The air is bone-numbingly chill here, cutting through the thickest clothing to bite at the very soul.  Down the slope, the lonely and broken remains of the city just barely push up through the mist."],"exits":[{"to":817,"exit":"north","move":"north"},{"to":819,"exit":"down","move":"down"},{"to":823,"exit":"go","move":"go rocky glade"}]},
  {"id":819,"x":60,"y":1920,"z":0,"title":"Vale, Journalai Outskirts","descriptions":["The vale meets up with the steep curve of the hills that protect it here.  The occluding mists combine with the darkness to create a powerfully limited range of vision.  Faint grunts and other unidentifiable sounds come from above, soft but nonetheless insidious.","The vale meets up with the steep curve of the hills that protect it here.  Though the occluding mist limits vision, the faint outlines of dark trees can be detected bordering the top of the hill, creating a tangible boundary between the ruins and the hinterland that surrounds it.  Hazy figures move like ghostly shadows through the wilderness, a hint of something sinister amidst the cemetary-like stillness of the dead city."],"exits":[{"to":814,"exit":"northeast","move":"northeast"},{"to":854,"exit":"south","move":"south"},{"to":820,"exit":"northwest","move":"northwest"},{"to":818,"exit":"up","move":"up"}]},
  {"id":820,"x":40,"y":1900,"z":0,"title":"Vale, Journalai Ruins","descriptions":["A cracked and perilous-looking pylon marks the gateway into the city, its lintel carved with the defaced visage of an unknown goddess who yet beckons all to pass beneath her with outspread arms.  Moss, ivy, and lichen have crept steadily into the cracks in the gateway, slowly nibbling away at what must have once been a proud testimony to some artisan's genius.  The collapsed rubble that was once the outer curtain of the city's walls yet serves as a barrier."],"exits":[{"to":815,"exit":"northeast","move":"northeast"},{"to":819,"exit":"southeast","move":"southeast"}]},
  {"id":821,"x":140,"y":1840,"z":0,"title":"Foothills Cave, Front","descriptions":["Gnawed and broken bones litter the cavern's entrance, some so old they shatter at a touch, others so new that they still have bits of meat rotting on them.  Set into the deep dirt floor are a number of depressions covered with coarse hair that appear to be sleeping spots for the denizens of this spacious cave.  A deep musky odor pervades the space, further testimony to the bestial nature of the inhabitants."],"exits":[{"to":822,"exit":"east","move":"east"},{"to":811,"exit":"go","move":"go cave entrance"}]},
  {"id":822,"x":160,"y":1840,"z":0,"title":"Foothills Cave, Back","descriptions":["Sloping downwards towards the back of the cave, the rocky ceiling merges with the slate floor and shunts all further progress into a narrow crevice leading deeper underground.  Dirt has drifted into the cracks and corners, adding to the cramped feeling at the edges of the cavern.  There are fewer signs of the inhabitants here, perhaps because they find it more cramped than the entrance."],"exits":[{"to":848,"exit":"east","move":"east"},{"to":821,"exit":"west","move":"west"}]},
  {"id":823,"x":0,"y":1920,"z":0,"title":"Wooded Hills, Rocky Glade","descriptions":["Cupped within the hills, this small glade is strewn with boulders and rocks amongst the swaying grasses of the dell's floor.  Towering trees rim the area, enclosing it within the forest's welcoming embrace."],"exits":[{"to":826,"exit":"southwest","move":"southwest"},{"to":824,"exit":"west","move":"west"},{"to":818,"exit":"go","move":"go rocky slope"}]},
  {"id":824,"x":-20,"y":1920,"z":0,"title":"Wooded Hills, Rocky Glade","descriptions":["Bending in the slightest breeze, some cattails mark a small declivity that gathers moisture from the surrounding hillsides.  Birds flit from the forest's edge to the puddle, their cries filling the daytime sky with song and noise.","Almost invisible in the darkness, some cattails mark a small declavity that gathers moisture from the surrounding hillsides.  The hunting cries of nightjars fill the sky as they hunt for insects on the wing."],"exits":[{"to":823,"exit":"east","move":"east"},{"to":826,"exit":"south","move":"south"},{"to":825,"exit":"west","move":"west"}]},
  {"id":825,"x":-40,"y":1920,"z":0,"title":"Wooded Hills, Rocky Glade","descriptions":["Swaying grasses fill the space between the trees, hiding any movement of small animals near the ground.  A few boulders peek above the vegetation, their glossy black surfaces gleaming in any available light."],"exits":[{"to":824,"exit":"east","move":"east"},{"to":826,"exit":"southeast","move":"southeast"}]},
  {"id":826,"x":-20,"y":1940,"z":0,"title":"Wooded Hills, Rocky Glade","descriptions":["Standing alone in the swaying grasses, a giant oak tree spreads its limbs widely in the glade.  An interloper from the surrounding forested hillsides, the sprawling branches provide ample space for nesting birds."],"exits":[{"to":824,"exit":"north","move":"north"},{"to":823,"exit":"northeast","move":"northeast"},{"to":825,"exit":"northwest","move":"northwest"}]},
  {"id":828,"x":440,"y":490,"z":0,"title":"Ashen Valley, Footpath","descriptions":["Puffs of ash rise from the ground with every footfall or breath of wind.  A winding path runs between the drifts of cinders that obscure the once-thriving valley.  An occasional whiff of sulfur is carried on the breeze from the distant volcanoes."],"exits":[{"to":829,"exit":"north","move":"north"},{"to":833,"exit":"northwest","move":"northwest"},{"to":155,"exit":"go","move":"go ash-covered footpath"}]},
  {"id":829,"x":440,"y":470,"z":0,"title":"Ashen Valley, Footpath","descriptions":["Cloven footprints overlap on the trail, marking the passage of many animals through this ash-choked valley.  A few rotting stumps stand above the volcanic debris littering the hillsides. Occasional breezes stir the ash into movement that helps pile the drifts higher."],"exits":[{"to":828,"exit":"south","move":"south"},{"to":830,"exit":"northwest","move":"northwest"}]},
  {"id":830,"x":420,"y":450,"z":0,"title":"Ashen Valley, Stumpy Field","descriptions":["Tracks carpet the ground while a few stumps stand next to fallen logs."],"exits":[{"to":832,"exit":"north","move":"north"},{"to":829,"exit":"southeast","move":"southeast"},{"to":833,"exit":"south","move":"south"},{"to":831,"exit":"west","move":"west"}]},
  {"id":831,"x":400,"y":450,"z":0,"title":"Ashen Valley, Abandoned Woodlot","descriptions":["What was once a grove of trees is now a tangle of downed logs, decaying stumps, and drifts of the choking ash that destroyed the area after a volcanic eruption.  The air is heavy with the odors of burnt wood and sulfur while the colorless drifts of ash blanket the ground.  The imprints of myriad cloven hooves are the only sign of life throughout this grey expanse."],"exits":[{"to":832,"exit":"northeast","move":"northeast"},{"to":830,"exit":"east","move":"east"},{"to":841,"exit":"go","move":"go twisting trail"}]},
  {"id":832,"x":420,"y":430,"z":0,"title":"Ashen Valley, Stumpy Field","descriptions":["What was once a sheltered forest snuggled up against a hillside is now a barren expanse of ash with just a few decomposing stumps sticking above the leaden-colored debris.  The once-verdant hillsides are likewise carpeted with volcanic detritus, although one trail leading around a hill is free of rubble and could provide a way to scramble up the hill."],"exits":[{"to":830,"exit":"south","move":"south"},{"to":831,"exit":"southwest","move":"southwest"},{"to":834,"exit":"go","move":"go hillside trail"}]},
  {"id":833,"x":420,"y":470,"z":0,"title":"Ashen Valley, Footpath","descriptions":["The stench of rotting eggs fills the area, carried from the western mountains and the volcanic Fists of Heaven that dominate the range.  Beside the game trail, a lone tree stands leafless and dead, a victim of the distant volcano's eruption and destruction."],"exits":[{"to":830,"exit":"north","move":"north"},{"to":828,"exit":"southeast","move":"southeast"}]},
  {"id":834,"x":420,"y":410,"z":0,"title":"Ashen Valley, Ash-covered Ledge","descriptions":["Curling around the barren hillside, a narrow ledge is a welcome area free of the ever-present ash and cinders of the area.  A few spots of volcanic debris are scattered across the otherwise-bare rock.  The higher vantage point affords a better view of the western mountains and the twin cones of the Fists of Heaven."],"exits":[{"to":835,"exit":"northeast","move":"northeast"},{"to":832,"exit":"go","move":"go hillside trail"}]},
  {"id":835,"x":440,"y":390,"z":0,"title":"Ashen Valley, Hillside","descriptions":["Winding across the ash-covered hillside, cloven hoofprints cover a narrow game trail that testifies that not everything in this valley is dead.  An occasional cinder breaks free of the neighboring debris and rolls down the slope, each one leaving a meandering line in the ash."],"exits":[{"to":836,"exit":"east","move":"east"},{"to":834,"exit":"southwest","move":"southwest"}]},
  {"id":836,"x":460,"y":390,"z":0,"title":"Ashen Valley, Hillside","descriptions":["Views across the valley reveal a monotonous panorama of destruction and ruin.  Ash covers everything in a choking blanket of monochromatic grey.  Rotting logs and stumps mark where there were once thriving groves of trees before the volcanoes to the west erupted and smothered out most vegetation."],"exits":[{"to":835,"exit":"west","move":"west"}]},
  {"id":837,"x":600,"y":330,"z":0,"title":"Watchtower, Command Center","descriptions":["Thick wooden beams line the room, supporting large, smooth stones that make up the walls and ceiling.  Arranged in a semi-circle are some basic oaken chairs that face a massive table covered with maps of the local area and a pot of roasted coffee.  A well-worn footlocker is pushed against one wall, the surface stained from years serving as a makeshift table.  A wide stone staircase affixed to the wall offers access to the roof."],"exits":[{"to":838,"exit":"up","move":"up"},{"to":89,"exit":"go","move":"go door"},{"to":170,"exit":"climb","move":"climb ladder"}],"aliases":["Northern Watch","Watch"]},
  {"id":838,"x":600,"y":310,"z":0,"title":"Watchtower, Recreation Room","descriptions":["Mirroring the architecture of the rest of the tower, thick wooden beams rise from floor to ceiling to provide solid support for the roof above.  Mounted prominently against one wall is a well-worn dartboard whose surface and the wall surrounding it bear numerous puncture marks.  Running the entire span of the room is an impressive bar with numerous bottles of various alcohol stacked behind it, all in different degrees of consumption and labeled with 'Property of the Northern Watch'.  The room serves as a comfortable yet lively retreat, where defenders can unwind and enjoy moments of camaraderie."],"exits":[{"to":839,"exit":"up","move":"up"},{"to":837,"exit":"down","move":"down"}]},
  {"id":839,"x":600,"y":290,"z":0,"title":"Watchtower, Roof","descriptions":["The tower offers a commanding view of the surrounding countryside.  Through the crenelations in the wall, you can look out for miles in any direction.  A strange apparatus in the center of the roof appears to be some sort of signalling device."],"exits":[{"to":838,"exit":"down","move":"down"}]},
  {"id":841,"x":380,"y":450,"z":0,"title":"Ashen Valley, Trail","descriptions":["The atmosphere is heavy with the scents of smoldering wood and sulfur, as the desolate landscape is shrouded in a colorless layer of ash.  Once trees thrived in the valley, but now they stand lifeless and scorched, victims of the nearby volcanoes.  The game trail twists among the stumps as if it was a serpent chasing prey."],"exits":[{"to":831,"exit":"go","move":"go twisting trail"},{"to":845,"exit":"southwest","move":"southwest"},{"to":842,"exit":"northwest","move":"northwest"}]},
  {"id":842,"x":360,"y":430,"z":0,"title":"Ashen Valley, Trail","descriptions":["Here and there, a handful of decaying stumps rise above the volcanic detritus that litters the ground, their silent forms mute testimony to the destructive power of the nearby Fists of Heaven.  Every breath of breeze causes small puffs of ash to rise listlessly from the ground, but the ash soon settles back as if the effort to break free was too much."],"exits":[{"to":841,"exit":"southeast","move":"southeast"},{"to":843,"exit":"southwest","move":"southwest"}]},
  {"id":843,"x":340,"y":450,"z":0,"title":"Ashen Valley, Trail","descriptions":["A once-thriving grove of trees has transformed into a chaotic maze of fallen logs, decomposing stumps, and heaps of ash that engulfed the region in the aftermath of a volcanic eruption.  The trail splits here, branching in many directions as if unsure of which is the best exit from this desolate landscape.  Now and then, a faint hint of sulfur drifts on the breeze, a distant reminder of the active volcanoes in the vicinity."],"exits":[{"to":842,"exit":"northeast","move":"northeast"},{"to":844,"exit":"east","move":"east"},{"to":846,"exit":"west","move":"west"}]},
  {"id":844,"x":360,"y":450,"z":0,"title":"Ashen Valley, Trail","descriptions":["Once, a sheltered forest thrived here, but now, it lies transformed into a desolate stretch of ash, with only a handful of decaying stumps protruding from the leaden-hued wreckage.  Occasionally something drops from the bare branches, sending a small puff of ash up from the ground where it lands."],"exits":[{"to":845,"exit":"south","move":"south"},{"to":843,"exit":"west","move":"west"}]},
  {"id":845,"x":360,"y":470,"z":0,"title":"Ashen Valley, Cliff","descriptions":["Ash and debris from the nearby volcanoes blankets the ground, choking the vegetation and muffling sound.  A short cliff rises above the dead trees, its sheer face sporting a few handholds that could allow a daring adventurer to ascend the cliff."],"exits":[{"to":844,"exit":"north","move":"north"},{"to":841,"exit":"northeast","move":"northeast"}]},
  {"id":846,"x":320,"y":450,"z":0,"title":"Ashen Valley, Trail","descriptions":["A pervasive odor of putrid eggs saturates the vicinity, emanating from the western mountains and the towering volcanic peaks known as the Fists of Heaven that command the horizon.  Cloven hoofprints on the game trail give evidence of some life still clinging to this ashen desert."],"exits":[{"to":847,"exit":"northeast","move":"northeast"},{"to":843,"exit":"east","move":"east"}]},
  {"id":847,"x":340,"y":430,"z":0,"title":"Ashen Valley, Deadfall","descriptions":["Heaped in large stacks, decaying logs and limbs block the trail.  The hoofprints mill about in the ash, indicating the confusion of the area's denizens when faced with the obstacle.  The odor of decay has driven out the sulfur scents that normally permeate this desolate valley."],"exits":[{"to":846,"exit":"southwest","move":"southwest"}]},
  {"id":848,"x":180,"y":1840,"z":0,"title":"Foothills Cave, Crevice","descriptions":["Granite walls twist and turn as the narrow space runs deeper underground.  Musky scents of animals mingle with the smells of decaying refuse dragged in by the cave system's denizens.  A few tufts of fur are caught in the rough outcrops of stone."],"exits":[{"to":849,"exit":"northeast","move":"northeast"},{"to":822,"exit":"west","move":"west"}]},
  {"id":849,"x":200,"y":1820,"z":0,"title":"Foothills Cave, Cleft","descriptions":["Piles of fetid debris lie heaped against the walls, mingling with animal dung and rotting carcasses to permeate the area with a pungent odor.  In the distance, an occasional *plink* sounds as water drips within the cave system.  Bones and other refuse make the footing treacherous underfoot."],"exits":[{"to":848,"exit":"southwest","move":"southwest"}]},
  {"id":850,"x":120,"y":1880,"z":0,"title":"Foothills, Rocky Ravine","descriptions":["Thick clumps of grass cling to the rocky ground, interspersed with a multitude of boulders and rubble littering the terrain.  Surrounding the narrow valley are steep hills, their sides bare of trees."],"exits":[{"to":851,"exit":"east","move":"east"},{"to":853,"exit":"southeast","move":"southeast"},{"to":813,"exit":"west","move":"west"}]},
  {"id":851,"x":140,"y":1880,"z":0,"title":"Foothills, Rocky Ravine","descriptions":["Thick clumps of grass cling to the rocky ground, interspersed with a multitude of boulders and rubble littering the terrain.  Surrounding the narrow valley are steep hills, their sides bare of trees."],"exits":[{"to":851,"exit":"south","move":"south"},{"to":852,"exit":"southeast","move":"southeast"},{"to":850,"exit":"west","move":"west"}]},
  {"id":852,"x":160,"y":1900,"z":0,"title":"Foothills, Rocky Ravine","descriptions":["Grey hills empty of all but rocks curve around the valley floor.  Shrubs and grasses rise amongst the rocks and boulders of the valley bottom, clinging to whatever purchase they can find."],"exits":[{"to":851,"exit":"northwest","move":"northwest"},{"to":853,"exit":"west","move":"west"}]},
  {"id":853,"x":140,"y":1900,"z":0,"title":"Foothills, Rocky Ravine","descriptions":["Hidden by a screen of reeds, the meager stream empties into a modest pool.  A few rocks break the surface while more reeds emerge from the muddy banks.  Barren hills rise above the valley but do nothing to block the ever-present wind."],"exits":[{"to":850,"exit":"northwest","move":"northwest"},{"to":851,"exit":"north","move":"north"},{"to":852,"exit":"east","move":"east"}]},
  {"id":854,"x":60,"y":1940,"z":0,"title":"Vale, Ravine","descriptions":["Wisps of fog drift above the rock-strewn ground, while denser banks of mist roil overhead, obscuring the sky and the upper walls of the canyon.  Scrubby bushes and clumps of grass cling desperately to the loose scree at the foot of the cliffs, their stunted size and pale leaves testimony to the barren nature of the area."],"exits":[{"to":855,"exit":"east","move":"east"},{"to":857,"exit":"southeast","move":"southeast"},{"to":819,"exit":"north","move":"north"}]},
  {"id":855,"x":80,"y":1940,"z":0,"title":"Vale, Ravine","descriptions":["Granite walls loom out of the ever-present mist, towering high above the stony canyon floor.  Mist and fog flow across the ground and ooze amongst the occasional bush that grows in the scanty soil.  An occasional crash echoes through the ravine, but the source remains unknown."],"exits":[{"to":854,"exit":"west","move":"west"},{"to":856,"exit":"southeast","move":"southeast"},{"to":857,"exit":"south","move":"south"}]},
  {"id":856,"x":100,"y":1960,"z":0,"title":"Vale, Rock Pile","descriptions":["Some long-forgotten catastrophe has brought down one cliff, creating a rockslide that blocks further progress.  A small start has been made at clearing the rockfall, but the small piles that have been removed only serve to show how much more remains in clearing the blockade.  What is unclear is who or what would be working to clear the impediment and why they would want to."],"exits":[{"to":855,"exit":"northwest","move":"northwest"},{"to":857,"exit":"west","move":"west"}]},
  {"id":857,"x":80,"y":1960,"z":0,"title":"Vale, Ravine","descriptions":["Large boulders cover the ground, having fallen from the steep cliffs lining the ravine.  One has crashed into a tree, splintering it and scattering limbs and branches across the ground.  A few clumps of grass grow near a few small puddles formed in some of the craters created when rocks from above hit the ground."],"exits":[{"to":854,"exit":"northwest","move":"northwest"},{"to":855,"exit":"north","move":"north"},{"to":856,"exit":"east","move":"east"}]},
  {"id":858,"x":580,"y":1970,"z":0,"title":"Feta's Kitchen, Tea-time Catering","descriptions":["The bright and cheerful room bustles with young Halflings carrying food for catering orders, as well as returning empty baskets and platters to be refilled.  Attached to one wall and flanking a painted sign, planters of fresh herbs bring a splash of color to the room.  An open window reveals a clean, straw-filled stable."],"exits":[{"to":588,"exit":"south","move":""}],"color":"#FF0000"},
  {"id":859,"x":600,"y":1310,"z":0,"title":"Deep Forest, Derelict Garden","descriptions":["What was once a garden lies in disarray, its beds little more than outlines in the soil.  A few twisted stakes jut up from the earth, tangled with brittle vines long gone to seed.  Scattered stones trace the faint remains of a boundary wall, half-buried beneath moss and leaf litter."],"exits":[{"to":860,"exit":"south","move":"south"},{"to":799,"exit":"west","move":"west"}]},
  {"id":860,"x":600,"y":1330,"z":0,"title":"Deep Forest, Collapsed Shed","descriptions":["Near the edge of the clearing, a small outbuilding has given way to time.  Its sagging roof folds inward, beams rotted through and swallowed by creeping ivy under the open sky.  Rusted tools jut from the debris, their edges dulled and spotted, as if left in place on the last day they were used."],"exits":[{"to":859,"exit":"north","move":"north"},{"to":799,"exit":"northwest","move":"northwest"}]}
 ],
