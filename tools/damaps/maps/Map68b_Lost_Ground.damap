  {"id":27,"x":440,"y":120,"z":0,"title":"Blackthorn Canyon, Lost Ground","descriptions":["Bleak shadows weave their way in and out among the trees and overgrown shrubbery.  At once both foreboding and mysterious, the heavy forest gradually shifts and shapes itself to fully invade the once-thriving bailey."],"exits":[{"to":28,"exit":"northeast","move":"northeast"},{"to":9,"exit":"east","move":"east"},{"to":25,"exit":"south","move":"south"}]},
