{
 "format": "damap",
 "version": 1,
 "id": "1j",
 "name": "Market Plaza",
 "file": "Map1j_Market_Plaza.xml",
 "rooms": [
  {"id":1,"x":240,"y":140,"z":0,"title":"The Crossing, Mongers' Square","descriptions":["Set into the center of the bazaar's main square is a bronzed fountain depicting the fatherly figure of Divyaush, his long chiseled beard covering the top of his robes and his painted azure eyes gazing into the water below.  Children and shoppers stop on their way past, often wetting their hands or their faces in the cool clear water.  To the southwest, brightly covered pennants sail above the sea of canvas that is the Traders' Market tent."],"exits":[{"to":2,"exit":"go","move":"go market plaza"}],"aliases":["Mongers' Square","Bazaar","Crossing"],"linksTo":"Map1_Crossing.xml"},
  {"id":2,"x":140,"y":140,"z":0,"title":"Market Plaza, Foyer","descriptions":["The high ceiling and sand rose painted walls make this entry feel open and expansive.  A large round ironwood table is centered on a thickly-piled rug that covers the middle of the polished marble floor.  Large copper urns filled with preserved peacock feathers and fronds have been placed at each corner of a large listings board.  Rich brown leather couches line the opposite wall."],"exits":[{"to":3,"exit":"north","move":"north"},{"to":19,"exit":"go","move":"go archway"},{"to":18,"exit":"go","move":"go office"},{"to":1,"exit":"go","move":"go iron gate"}],"color":"#00FF00","aliases":["Foyer","listings board","board"]},
  {"id":3,"x":140,"y":80,"z":0,"title":"Market Plaza, Sun Room","descriptions":["Painted a soft blue, the walls compliment the matching sunburst stained glass windows that are set in deep frames on each wall.  Low wicker benches with moss green cushions are positioned between the entries to the individual shops.  Shoppers move along leisurely, arms laden with baskets and bags overflowing with their latest finds."],"exits":[{"to":4,"exit":"east","move":"east"},{"to":11,"exit":"southeast","move":"southeast"},{"to":2,"exit":"south","move":"south"},{"to":14,"exit":"southwest","move":"southwest"},{"to":10,"exit":"west","move":"west"},{"to":7,"exit":"go","move":"go hallway"},{"to":29,"exit":"climb","move":"climb marble staircase"},{"to":35,"exit":"go","move":"go spiral ramp"}],"aliases":["Sun Room"]},
  {"id":4,"x":260,"y":80,"z":0,"title":"Market Plaza, Water Room","descriptions":["Rounded benches ring a small fountain in the middle of the room.  Light from a centralized chandelier reflects off polished glass pieces that have been strewn in the clear crystal water.  Small tables with decorated jars holding bamboo shoots are positioned between the entries to each shop."],"exits":[{"to":5,"exit":"northeast","move":"northeast"},{"to":3,"exit":"west","move":"west"}],"aliases":["Water Room"]},
  {"id":5,"x":320,"y":10,"z":0,"title":"Market Plaza, Grass Room","descriptions":["Intricately woven reeds are displayed in a starburst matting, the differing sized rays pointing to each shop, as if it direct shoppers to their destinations.  Baskets are piled artistically along the two long walls of this rectangular room.  Guards pass quietly among the shoppers, alert behind their relaxed facade."],"exits":[{"to":4,"exit":"southwest","move":"southwest"},{"to":6,"exit":"northwest","move":"northwest"}],"aliases":["Grass Room"]},
  {"id":6,"x":260,"y":-60,"z":0,"title":"Market Plaza, Solarium","descriptions":["The night sky can be seen through the long panes of glass set along the walls near the ceiling.  Lantern light softens the edges of the two rows of topiary animals and intricately manicured miniature evergreens in large marble urns.  Gaps have been left to allow entry into the various shops.","Long panes of glass are set into the long walls near the ceiling.  Too high to provide a view of the outside, they allow sunlight for the two rows of topiary animals intermingled with intricately manicured miniature evergreens in large marble urns.  Gaps have been left to allow entry into the various shops."],"exits":[{"to":5,"exit":"southeast","move":"southeast"},{"to":7,"exit":"southwest","move":"southwest"},{"to":17,"exit":"go","move":"go garden"}],"aliases":["Solarium"]},
  {"id":7,"x":140,"y":60,"z":0,"title":"Market Plaza, Food Court","descriptions":["Small wrought-iron tables with two to four matching chairs are situated sporadically around this large room.  A young Elven maid moves quietly around the area filling a large bin with used glasses and cutlery.  A row of carts with large wheels line two opposite walls.  Soft music from a lyre player provides a comfortable background for the low conversations between diners and passing shoppers."],"exits":[{"to":6,"exit":"northeast","move":"northeast"},{"to":8,"exit":"northwest","move":"northwest"},{"to":3,"exit":"go","move":"go hallway"}],"aliases":["Food Court"]},
  {"id":8,"x":20,"y":-60,"z":0,"title":"Market Plaza, Forest Room","descriptions":["Carved totems have been arranged in a casual snaking pattern down the length of the room.  With enough space between them for easy passage to the shop entries, shoppers pause and point out the animals and birds easily recognized in the wood."],"exits":[{"to":7,"exit":"southeast","move":"southeast"},{"to":9,"exit":"southwest","move":"southwest"},{"to":17,"exit":"go","move":"go garden"}],"aliases":["Forest Room"]},
  {"id":9,"x":-40,"y":10,"z":0,"title":"Market Plaza, Dimly-Lit Storage","descriptions":["Defying gravity, crates, boxes and stacked tables are piled high along the walls to the ceiling.  With a wide cleared path running down the center, light from the entry way quickly diminishes down the length of the room, leaving the far end barely discernable.  A push cart holding a large box stands ready for the rest of the inventory to be loaded."],"exits":[{"to":8,"exit":"northeast","move":"northeast"},{"to":10,"exit":"southeast","move":"southeast"}],"aliases":["Dimly-Lit Storage","Storage"]},
  {"id":10,"x":20,"y":80,"z":0,"title":"Market Plaza, Meeting Room","descriptions":["Carpeting spans the room from wall to wall, muffling the footsteps of the few errant shoppers that have lost their way.  A long table with straight-backed chairs pushed tightly against it is the only furniture present.  A portrait of a dignified S'kra Mur gentleman hangs at the head."],"exits":[{"to":3,"exit":"east","move":"east"},{"to":9,"exit":"northwest","move":"northwest"}],"aliases":["Meeting Room"]},
  {"id":11,"x":160,"y":100,"z":0,"title":"Market Plaza, Moon Room","descriptions":["A mural of a horizon with a setting sun surrounds the room in variegated shades of rose and purple near the base, moving towards a brushing of silvery grey at the ceiling.  On three separate walls, the three moons of Elanthia are in various stages of rising or waning.  Constellations have been painted on the floor in splashes of white against the black marble."],"exits":[{"to":12,"exit":"east","move":"east"},{"to":13,"exit":"south","move":"south"},{"to":3,"exit":"northwest","move":"northwest"}],"aliases":["Moon Room"]},
  {"id":12,"x":180,"y":100,"z":0,"title":"Market Plaza, Armor Room","descriptions":["Deep-set niches in the walls hold a variety of helms, armets and other head armor.  Placed centrally in the room, a tall mannequin fully bedecked in a set of ornamental heavy plate has been polished to a pristine shine.  Low chairs have been placed on each side of the shop entrances, the high backs formed from obsidian-bossed tower shields."],"exits":[{"to":11,"exit":"west","move":"west"}],"aliases":["Armor Room"]},
  {"id":13,"x":160,"y":120,"z":0,"title":"Market Plaza, Lodge Room","descriptions":["Windows looking out over a snow-covered mountain terrain have been painted onto the walls.  Large game trophies on cherrywood bases are mounted above two lit fieldstone fireplaces on either side of the room.  Leather couches draped with snowbeast throws have been placed back to back in the center of the room, a place to rest in comfort before embarking on the next round of shops."],"exits":[{"to":11,"exit":"north","move":"north"}],"aliases":["Lodge Room"]},
  {"id":14,"x":120,"y":100,"z":0,"title":"Market Plaza, Gladiolus Room","descriptions":["Hanging tight to the ceiling, gaethzen lamps in the shapes of large humming birds and butterflies in flight provide a bright light that flows over the enormous round marble planter in the center of the room.  Gladiolus in rich soil provides the room with a warm scent and a vivid display of color, ranging from white to shades of deep purple.  Elven ivy has been planted around the edge of the flowers and flows over the side to the floor."],"exits":[{"to":3,"exit":"northeast","move":"northeast"},{"to":16,"exit":"south","move":"south"},{"to":15,"exit":"west","move":"west"}],"aliases":["Gladiolus Room"]},
  {"id":15,"x":100,"y":100,"z":0,"title":"Market Plaza, Fire Room","descriptions":["Passing shoppers stop to take in the vivid mural of the Greater Fist that covers two walls with the artistic rendition of lava flowing into swirls on the shining maple floor.  Prickly plants with bright crimson blooms line a burgundy runner laid down the center of the room.  Flickering torches in brass sconces are set on either side of the entrances to the trader shops along the walls."],"exits":[{"to":14,"exit":"east","move":"east"}],"aliases":["Fire Room"]},
  {"id":16,"x":120,"y":120,"z":0,"title":"Market Plaza, Library","descriptions":["Bookcases filled with volumes of varying bindings and size line both lengths of the room, built even above the shop entrances to provide more space.  Two rows of benches with padded seats have been placed back to back in the center.  An attendant moves about quietly, picking up the stray volumes and at times stopping to climb a small ladder he carries to get a book for anyone interested."],"exits":[{"to":14,"exit":"north","move":"north"}],"aliases":["Library"]},
  {"id":17,"x":140,"y":-60,"z":0,"title":"Market Plaza, Garden","descriptions":["Tall shepherd's hooks hold oil lanterns that throw shadows over the hedges of varying heights that have been grown in amazing patterns throughout the garden.  In various corners small white tables, chairs and benches are set to provide a resting spot or a site for intimate conversations.  A bronzed statue of a man is in the center, its base ringed with candles.","Hedges of varying heights have been grown in amazing patterns throughout the garden.  In various corners small white tables, chairs and benches are set to provide a resting spot or a site for intimate conversations.  A bronzed statue of a man is in the center, its base ringed with vibrant roses and myrtle."],"exits":[{"to":6,"exit":"east","move":"east"},{"to":8,"exit":"west","move":"west"}],"aliases":["Garden"]},
  {"id":18,"x":140,"y":160,"z":0,"title":"Market Plaza, Office","descriptions":["Four desks are situated behind a long counter that spans across the busy room.  A clerk nods and rushes forward to swing open a half-door to allow entry for groups of traders usually in deep discussions with a vendor or other merchants.  A large cork board has various announcements and billings arranged meticulously in rows."],"exits":[{"to":2,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Office"]},
  {"id":19,"x":60,"y":180,"z":0,"title":"Furniture Gallery, Foyer","descriptions":["Masterful presentation skill is present in every aspect of the gallery foyer.  Neatly trimmed decor surrounds the ornate entrances leading in all directions, and helpful attendants stroll casually about, tending to the needs of their customers."],"exits":[{"to":20,"exit":"north","move":"north"},{"to":21,"exit":"southeast","move":"southeast"},{"to":22,"exit":"south","move":"south"},{"to":23,"exit":"southwest","move":"southwest"},{"to":24,"exit":"west","move":"west"},{"to":25,"exit":"northwest","move":"northwest"},{"to":2,"exit":"out","move":"out"}],"aliases":["Furniture Gallery"]},
  {"id":20,"x":60,"y":140,"z":0,"title":"Furniture Gallery, Tables","descriptions":["Tastefully arranged tables of various materials fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":26,"exit":"north","move":"north"},{"to":19,"exit":"south","move":"south"},{"to":27,"exit":"west","move":"west"},{"to":28,"exit":"northwest","move":"northwest"}],"color":"#FF0000","aliases":["Tables"]},
  {"id":21,"x":80,"y":200,"z":0,"title":"Furniture Gallery, Floors","descriptions":["Tastefully arranged panels of various materials fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":19,"exit":"northwest","move":"northwest"}],"color":"#FF0000","aliases":["Floors"]},
  {"id":22,"x":60,"y":200,"z":0,"title":"Furniture Gallery, Walls","descriptions":["Tastefully arranged panels of various materials fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":19,"exit":"north","move":"north"}],"color":"#FF0000","aliases":["Walls"]},
  {"id":23,"x":40,"y":200,"z":0,"title":"Furniture Gallery, Counters","descriptions":["Tastefully arranged counters of various materials fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":19,"exit":"northeast","move":"northeast"}],"color":"#FF0000","aliases":["Counters"]},
  {"id":24,"x":40,"y":180,"z":0,"title":"Furniture Gallery, Entrances","descriptions":["Tastefully arranged entrances of various shapes and sizes fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":19,"exit":"east","move":"east"}],"color":"#FF0000","aliases":["Entrances"]},
  {"id":25,"x":40,"y":160,"z":0,"title":"Furniture Gallery, Backroom Doors","descriptions":["Tastefully arranged doors of various shapes and sizes fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":19,"exit":"southeast","move":"southeast"}],"color":"#FF0000","aliases":["Backroom Doors","Doors"]},
  {"id":26,"x":60,"y":120,"z":0,"title":"Furniture Gallery, Wall Hangings","descriptions":["Tastefully arranged racks of various materials fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":20,"exit":"south","move":"south"}],"color":"#FF0000","aliases":["Wall Hangings"]},
  {"id":27,"x":40,"y":140,"z":0,"title":"Furniture Gallery, Trunks","descriptions":["Tastefully arranged trunks of various materials fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":20,"exit":"east","move":"east"}],"color":"#FF0000","aliases":["Trunks"]},
  {"id":28,"x":40,"y":120,"z":0,"title":"Furniture Gallery, Cabinets","descriptions":["Tastefully arranged cabinets of various materials fill the room, each cordoned off by a red velvet cord and lit with gaethzen orbs.  A sign stands on a prominent easel, summarizing what the furniture in this room can be used for."],"exits":[{"to":20,"exit":"southeast","move":"southeast"}],"color":"#FF0000","aliases":["Cabinets"]},
  {"id":29,"x":220,"y":60,"z":0,"title":"Market Plaza Cellar, Tasting Room","descriptions":["Glossy mahogany wainscoting covers the lower halves of the stacked limestone walls.  Paintings depicting famous vineyards grace the upper halves, bracketed by the downward curves of the brick ceiling toward the pillars that support it.  Comfortable chairs and low tables are arranged companionably near a polished black marble bar containing wines to sample, and a conservatively-dressed male Prydaen stands by to assist."],"exits":[{"to":30,"exit":"north","move":"north"},{"to":3,"exit":"climb","move":"climb marble staircase"}],"aliases":["Cellar","Tasting Room"]},
  {"id":30,"x":220,"y":40,"z":0,"title":"Market Plaza Cellar, Bottle Room","descriptions":["Racks upon racks of wine bottles line the walls, and between them heavy square columns rise up to join the vaulted ceiling.  Each column bears a framed watercolor painting depicting a different wine variety."],"exits":[{"to":31,"exit":"north","move":"north"},{"to":29,"exit":"south","move":"south"}],"aliases":["Bottle Room"]},
  {"id":31,"x":220,"y":20,"z":0,"title":"Market Plaza Cellar, Stomping Room","descriptions":["Arched brick ceilings converge from four different directions, forming a large double-vaulted room full of compound curves and lined with buttressing columns.  An assortment of grape-pressing equipment is lined up along one wall, leaving enough open space that several couples could dance here with room to spare."],"exits":[{"to":32,"exit":"north","move":"north"},{"to":34,"exit":"east","move":"east"},{"to":30,"exit":"south","move":"south"},{"to":33,"exit":"west","move":"west"}],"aliases":["Stomping Room"]},
  {"id":32,"x":220,"y":0,"z":0,"title":"Market Plaza Cellar, Fermentation Room","descriptions":["Huge vats line a stacked limestone wall at the cellar's end.  An arched brick ceiling looms low overhead, supported by a double row of heavy stone columns that march back toward the center of the cellar on either side.  Shop entrances pierce the walls between the columns."],"exits":[{"to":31,"exit":"south","move":"south"}],"aliases":["Fermentation Room"]},
  {"id":33,"x":200,"y":20,"z":0,"title":"Market Plaza Cellar, Cooper Room","descriptions":["Broad square pillars rise up to support the barrel-vaulted brick ceiling, and shop entrances pierce the stacked stone walls in between.  This area also contains a working cooperage, and shoppers can pause a while to watch the coopers at hard at work on unfinished barrels with their tools, firepits and racks of supplies close at hand.","Broad square pillars rise up to support the barrel-vaulted brick ceiling, and shop entrances pierce the stacked stone walls in between.  This area also contains a working cooperage by day, and nighttime shoppers can pause a while to have a look at the neatly-stored tools and unfinished barrels."],"exits":[{"to":31,"exit":"east","move":"east"}],"aliases":["Cooper Room"]},
  {"id":34,"x":240,"y":20,"z":0,"title":"Market Plaza Cellar, Barrel Room","descriptions":["Arched openings line the room, formed by the pillars that hold up the low tunnel-vaulted ceiling.  Within the openings, the round faces of massive oaken casks protrude, each resting upon a sturdy brick cradle.  At the far end, smaller barrels are stacked against the wall, awaiting shipment to wholesale customers."],"exits":[{"to":31,"exit":"west","move":"west"}],"aliases":["Barrel Room"]},
  {"id":35,"x":60,"y":60,"z":0,"title":"Market Plaza Upstairs, Volcano Room","descriptions":["A model of the Greater Fist rests on a display table in the middle of this area, complete with tiny caravans and surrounding towns and villages.  The broad white walls between the shops exhibit a collection of fine paintings of volcanoes in varying stages of activity and dormancy."],"exits":[{"to":36,"exit":"east","move":"east"},{"to":42,"exit":"west","move":"west"},{"to":3,"exit":"go","move":"go spiral ramp"}],"aliases":["Upstairs","Volcano Room"]},
  {"id":36,"x":80,"y":60,"z":0,"title":"Market Plaza Upstairs, Palm Room","descriptions":["An atrium of sorts, this room has a high glass ceiling, with tall palm trees in wide planters rising nearly to its peak.  A cluster of chairs and small tables underneath allow shoppers to relax and regroup while taking in a grand view of Crossing through the mostly-glass south and east walls.","An atrium of sorts, this room has a high glass ceiling currently darkened by night.  Palm trees rise up into the darkness out of wide planters underneath.  A cluster of chairs and small tables at the base of the trees allow shoppers to relax and regroup while taking in a the night lights of Crossing through the mostly-glass south and east walls."],"exits":[{"to":37,"exit":"northeast","move":"northeast"},{"to":35,"exit":"west","move":"west"}],"aliases":["Palm Room"]},
  {"id":37,"x":100,"y":40,"z":0,"title":"Market Plaza Upstairs, Ocean Room","descriptions":["Reclaimed teak flooring and cypress woodwork, both heavily varnished, give this room a decidedly nautical air.  Broad white walls between each pair of shops display a collection of maritime antiques including a ship's bell.  The windows on the east wall look out over eastern Crossing, and far beyond that lies the dull blue-gray line of open water.","Reclaimed teak flooring and cypress woodwork, both heavily varnished, give this room a decidedly nautical air.  Broad white walls between each pair of shops display a collection of maritime antiques including a ship's bell.  The windows on the east wall look out over the nighttime lights of eastern Crossing."],"exits":[{"to":36,"exit":"southwest","move":"southwest"},{"to":38,"exit":"northwest","move":"northwest"}],"aliases":["Ocean Room"]},
  {"id":38,"x":80,"y":20,"z":0,"title":"Market Plaza Upstairs, Tundra Room","descriptions":["A massive set of curved mammoth tusks has pride of place in the center of the broad corridor, mounted upon a large glass display.  More specimens of tundra life decorate the walls between the shops, allowing visitors to see and learn as they shop."],"exits":[{"to":37,"exit":"southeast","move":"southeast"},{"to":39,"exit":"southwest","move":"southwest"}],"aliases":["Tundra Room"]},
  {"id":39,"x":60,"y":40,"z":0,"title":"Market Plaza Upstairs, Jungle Room","descriptions":["Stained glass windows with polished teak casements portray various lush jungle scenes, offering filtered light in jewel-like tones.  Shop entrances line up opposite, with vases of vibrant jungle flowers mounted on the walls between each set of doors.","Currently darkened by night, stained glass windows with polished teak casements grace the north side of the room.  Shop entrances line up opposite, with vases of vibrant jungle flowers mounted on the walls between each set of doors."],"exits":[{"to":38,"exit":"northeast","move":"northeast"},{"to":40,"exit":"northwest","move":"northwest"}],"aliases":["Jungle Room"]},
  {"id":40,"x":40,"y":20,"z":0,"title":"Market Plaza Upstairs, Savannah Room","descriptions":["A framed panoramic painting of a savannah scene occupies the broad white wall between a pair of shop entrances, and glassy-eyed hunting trophies line each wall overhead.  Windows on the northern side of the room overlook the Crossing bazaar and the north end of town.","A framed panoramic painting of a savannah scene occupies the broad white wall between a pair of shop entrances, and glassy-eyed hunting trophies line each wall overhead.  Night-darkened windows on the northern side of the room overlook the torch-lit Crossing bazaar and the northern end of town."],"exits":[{"to":39,"exit":"southeast","move":"southeast"},{"to":41,"exit":"southwest","move":"southwest"}],"aliases":["Savannah Room"]},
  {"id":41,"x":20,"y":40,"z":0,"title":"Market Plaza Upstairs, Desert Room","descriptions":["Windows look out over western Crossing on one side, and shop entrances are spaced out along the wall opposite them.  An exhibit of desert artifacts dominates the center of the room, laid out in a long freestanding glass counter, with a tall potted cactus standing nearby.","Darkened windows look out over western Crossing's night lights on one side, and shop entrances are spaced out along the wall opposite.  An exhibit of desert artifacts dominates the center of the room, laid out in a long freestanding glass counter, with a tall potted cactus standing nearby."],"exits":[{"to":40,"exit":"northeast","move":"northeast"},{"to":42,"exit":"southeast","move":"southeast"}],"aliases":["Desert Room"]},
  {"id":42,"x":40,"y":60,"z":0,"title":"Market Plaza Upstairs, River Room","descriptions":["An exhibit of framed paintings depicting barges at work and other river scenes decorates the walls between the shops.  Windows to the southwest give a panoramic view of the joining of the Segoltha and Oxenwaithe, with the rest of Crossing sprawled around them.","An exhibit of framed paintings depicting barges at work and other river scenes decorates the walls between the shops.  Darkened windows to the southwest give a panoramic view of Crossing's city lights."],"exits":[{"to":35,"exit":"east","move":"east"},{"to":41,"exit":"northwest","move":"northwest"}],"aliases":["River Room"]}
 ],
 "labels": [
  {"text":"Furniture Gallery","x":20,"y":210,"z":0},
  {"text":"Mongers' Square","x":201,"y":149,"z":0},
  {"text":"Market Plaza","x":107,"y":-25,"z":0},
  {"text":"Upstairs","x":32,"y":-1,"z":0},
  {"text":"Cellar","x":227,"y":27,"z":0}
 ]
}
