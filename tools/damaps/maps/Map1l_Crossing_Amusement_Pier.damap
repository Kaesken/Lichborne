{
 "format": "damap",
 "version": 1,
 "id": "1l",
 "name": "Crossing Amuesment Pier",
 "file": "Map1l_Crossing_Amusement_Pier.xml",
 "rooms": [
  {"id":1,"x":120,"y":0,"z":0,"title":"The Crossing, Esplanade Eluned","descriptions":["An apparent contradiction, the toney esplanade here is right in the midst of a group of warehouses to the north and the customs and storage house of Riverfront Portage to the west.  The strollers and workers mingle, with most of the leisure traffic centering around the noisy amusement pier to the south."],"exits":[{"to":0,"exit":"east","move":"east"},{"to":0,"exit":"southwest","move":"southwest"},{"to":0,"exit":"west","move":"west"},{"to":0,"exit":"northwest","move":"northwest"},{"to":2,"exit":"go","move":"go amusement pier"},{"to":0,"exit":"go","move":"go mahogany building"}],"aliases":["Crossing"],"linksTo":"Map1_Crossing.xml"},
  {"id":2,"x":120,"y":20,"z":0,"title":"Amusement Pier, Entrance","descriptions":["Throngs of children mill around, licking lollipops and poking at one another.  Salty air drifts upon the wind, causing bits of old paper to dance around freshly painted garbage bins.  Various buildings and attractions are visible further down the wide wooden and metal pier.","Salty air drifts upon the wind causing bits of old paper to dance around half-full garbage bins, while sweepers go by cleaning up the day's refuse.  Various buildings and attractions are visible in the torchlight further down the wide wooden and metal pier."],"exits":[{"to":3,"exit":"southeast","move":"southeast"},{"to":4,"exit":"south","move":"south"},{"to":5,"exit":"southwest","move":"southwest"},{"to":1,"exit":"go","move":"go elaborate gate"}],"aliases":["Amusement Pier"]},
  {"id":3,"x":160,"y":60,"z":0,"title":"Amusement Pier, Este Lane","descriptions":["Gentle waves lap against the huge poles that bear the weight of this busy pier.  Sturdy rails are placed along the edges, keeping stray children from tumbling off into the cold waters below.","Gentle waves lap against the huge poles that bear the weight of this quiet pier.  Sturdy rails are placed along the edges, keeping stray children from tumbling off into the cold waters below.  Brightly lit lanterns attract colorful moths to dance within their flames."],"exits":[{"to":6,"exit":"south","move":"south"},{"to":4,"exit":"west","move":"west"},{"to":2,"exit":"northwest","move":"northwest"}]},
  {"id":4,"x":120,"y":60,"z":0,"title":"Amusement Pier, Centre Lane","descriptions":["The breeze carries with it a tangy citrus scent from a small wooden stand whose base is carved with painted lemons.  A few stools offer seating for those wishing to enjoy the fruity lemonade sold by a Gnome maid who wears a pointed hat dusted with glitter.","The breeze carries with it a tangy citrus scent from a small wooden stand whose base is carved with painted lemons.  A few stools offer seating for those wishing to enjoy the fruity lemonade sold by a Gnome maid who wears a pointed hat dusted with glitter.  The torchlight gives her face a warm glow as she smiles at customers."],"exits":[{"to":2,"exit":"north","move":"north"},{"to":3,"exit":"east","move":"east"},{"to":5,"exit":"west","move":"west"}]},
  {"id":5,"x":80,"y":60,"z":0,"title":"Amusement Pier, Wilde Lane","descriptions":["Gentle waves lap against the huge poles that bear the weight of this busy pier.  Sturdy rails are placed along the edges, keeping stray children from tumbling off into the cold waters below.","Gentle waves lap against the huge poles that bear the weight of this quiet pier.  Sturdy rails are placed along the edges, keeping stray children from tumbling off into the cold waters below.  Brightly lit lanterns attract colorful moths to dance within their flames."],"exits":[{"to":2,"exit":"northeast","move":"northeast"},{"to":4,"exit":"east","move":"east"},{"to":8,"exit":"south","move":"south"},{"to":47,"exit":"go","move":"go canvas tent"}]},
  {"id":6,"x":160,"y":100,"z":0,"title":"Amusement Pier, Este Lane","descriptions":["Along the edge of the pier, rows of benches are set in a half-circle, all facing a big wooden theater.  Clothed in darkness, the images on its painted doors are barely visible in the flickering torchlight.  Sea birds often land upon the roof, squawking as though performing for a crowd.","Placed along the edge of the pier an area is set up with rows of benches all facing a big wooden theater.  Clothed in darkness it sits, the images on its painted doors barely seen by the flickering torches placed near it.  Sea birds often land upon it, squawking as if performing for a crowd."],"exits":[{"to":3,"exit":"north","move":"north"},{"to":9,"exit":"south","move":"south"},{"to":7,"exit":"west","move":"west"},{"to":25,"exit":"go","move":"go row"}]},
  {"id":7,"x":120,"y":100,"z":0,"title":"Amusement Pier, Centre Lane","descriptions":["Miniature boats dart between cast-pewter figures of birds in flight that adorn a nearby fountain, cheered on by the calls of children.  The fountain also provides a haven for real birds who splash with gleeful abandon in the water, sending up waves that nearly swamp the tiny vessels.","Miniature boats drift lazily between cast-pewter figures of birds in flight that adorn a nearby fountain.  Late night romance blooms as a young Bard plays softly on a flute, his thoughts his own in the night's dim light."],"exits":[{"to":6,"exit":"east","move":"east"},{"to":10,"exit":"south","move":"south"},{"to":8,"exit":"west","move":"west"}]},
  {"id":8,"x":80,"y":100,"z":0,"title":"Amusement Pier, Wilde Lane","descriptions":["A bright red shop roofed with dark brown shingles stands here, with its wide-paned windows painted with apples.  Barrels filled with various kinds of apples stand against the shop, a small Gnome guarding them with a pointy broom.  The scent of fresh apples permeates the air, inviting all to enter and partake."],"exits":[{"to":5,"exit":"north","move":"north"},{"to":7,"exit":"east","move":"east"},{"to":42,"exit":"go","move":"go red shop"}]},
  {"id":9,"x":160,"y":160,"z":0,"title":"Amusement Pier, Este Lane","descriptions":["A dark establishment stands starkly in contrast with the gaiety surrounding it.  Wind gently swings the sign that names this place, Zackes.  An arched door stands open with a hint of ale drifting out upon the sea air.","A dark establishment stands starkly in contrast with the gaiety surrounding it.  Wind gently swings the sign that names this place, Zackes.  An arched door stands open with a hint of ale drifting out upon the night air."],"exits":[{"to":6,"exit":"north","move":"north"},{"to":14,"exit":"south","move":"south"},{"to":10,"exit":"west","move":"west"},{"to":44,"exit":"go","move":"go arched door"}]},
  {"id":10,"x":120,"y":160,"z":0,"title":"Amusement Pier, Centre Lane","descriptions":["Big brawny lads and giggling maidens gather round to see who is the strongest in the lands.  A few Halfling children gawk at the huge Gor'Tog that blocks their view of the next contestant.","Torches flicker as big brawny lads and giggling maidens gather round to see who is the strongest in the lands.  A couple of huge Gor'Togs snicker amongst themselves as a Gnome attempts the tower of strength."],"exits":[{"to":7,"exit":"north","move":"north"},{"to":9,"exit":"east","move":"east"},{"to":13,"exit":"south","move":"south"},{"to":11,"exit":"west","move":"west"},{"to":32,"exit":"go","move":"go crowd"}]},
  {"id":11,"x":80,"y":160,"z":0,"title":"Amusement Pier, Wilde Lane","descriptions":["Crowds gather round to enter a man-made cave that slopes down into the water and off the edge of the pier.  A huge sign above it is decorated with the image of a dragon, a mighty warrior within its claws.  A couple of maidens dressed in gossamer and silk direct people into the cave in a disorderly fashion."],"exits":[{"to":10,"exit":"east","move":"east"},{"to":12,"exit":"south","move":"south"}]},
  {"id":12,"x":80,"y":200,"z":0,"title":"Amusement Pier, Wilde Lane","descriptions":["Nifty Gifts! proclaims the sign that hangs from above a picture of daisies and ribbons.  Brightly painted, this shop is crowded with young and old alike as they chatter about the goodies inside.  The scent of fresh-baked cookies drifts from the half-open door."],"exits":[{"to":11,"exit":"north","move":"north"},{"to":13,"exit":"east","move":"east"},{"to":33,"exit":"go","move":"go painted shop"}]},
  {"id":13,"x":120,"y":200,"z":0,"title":"Amusement Pier, Carousel","descriptions":["Bright ribbons dance upon the air as the huge carousel goes round and round.  Fun-loving passengers scamper through a black iron gate to reach the various carved animals supported by beribboned poles.  A young Elven lass has a bright smile for all as she stands ready to take their coin in exchange for a ride."],"exits":[{"to":10,"exit":"north","move":"north"},{"to":14,"exit":"east","move":"east"},{"to":12,"exit":"west","move":"west"},{"to":26,"exit":"go","move":"go painted stall"},{"to":28,"exit":"go","move":"go iron gate"}]},
  {"id":14,"x":160,"y":200,"z":0,"title":"Amusement Pier, Este Lane","descriptions":["Gentle waves can be heard lapping against the huge poles that bear the weight of this pier.  Sturdy rails have been placed along the edges, keeping stray children from tumbling off into the cold waters below.","Gentle waves can be heard lapping against the huge poles that bear the weight of this pier.  Sturdy rails have been placed along to the edges to keep stray children from tumbling off into the cold waters below.  Large lanterns have been lit, where the moths gather to dance within their light."],"exits":[{"to":9,"exit":"north","move":"north"},{"to":15,"exit":"south","move":"south"},{"to":13,"exit":"west","move":"west"},{"to":27,"exit":"go","move":"go squat building"}]},
  {"id":15,"x":160,"y":260,"z":0,"title":"Amusement Pier, Este Lane","descriptions":["Gentle waves lap against the pilings that support the weight of this busy pier.  Construction appears to be going on as boards are stacked up and barrels of various tools and nails are piled along the pier's railings."],"exits":[{"to":14,"exit":"north","move":"north"},{"to":18,"exit":"south","move":"south"},{"to":16,"exit":"west","move":"west"}]},
  {"id":16,"x":120,"y":260,"z":0,"title":"Amusement Pier, Centre Lane","descriptions":["Ribbon spirals up poles bearing colorful paper lanterns that line the walkway leading to the doors of a gaily-decorated shop.  A gigantic catapult stands toward the end of the pier, giving patrons cause to look carefully around when exiting the shop to make sure there is no one flying in their direction."],"exits":[{"to":15,"exit":"east","move":"east"},{"to":19,"exit":"south","move":"south"},{"to":17,"exit":"west","move":"west"},{"to":35,"exit":"go","move":"go gaily-decorated shop"}]},
  {"id":17,"x":80,"y":260,"z":0,"title":"Amusement Pier, Wilde Lane","descriptions":["A simple wooden booth stands here with faded colors reflecting the passage of time.  Laughter dances upon the air drifting from inside the gaming booth that offers a place to enjoy a bit of leisure time.","A simple wooden booth stands here with faded colors reflecting the passage of time.  Small paper lanterns hang from it, surrounding it with a playful glow.  Laughter dances upon the air drifting from inside the gaming booth that offers a place to enjoy a bit of leisure time."],"exits":[{"to":16,"exit":"east","move":"east"},{"to":20,"exit":"south","move":"south"}]},
  {"id":18,"x":160,"y":300,"z":0,"title":"Amusement Pier, Este Lane","descriptions":["A decrepit shop, its doors stiff from rusted hinges, stands silent vigil over the street.  Coated windows stare blindly out, covered with some dark smelly substance -- though what it is exactly is anyone's guess.  At times the door quickly opens and shuts with a horrific squeal, allowing a person to rush away from the facade, their bowed head echoing the protective clasp on the bundles they carry off greedily."],"exits":[{"to":15,"exit":"north","move":"north"},{"to":21,"exit":"southwest","move":"southwest"},{"to":19,"exit":"west","move":"west"},{"to":39,"exit":"go","move":"go decrepit shop"}]},
  {"id":19,"x":120,"y":300,"z":0,"title":"Amusement Pier, Centre Lane","descriptions":["Piles of hay lie scattered on the ground, providing a soft landing place for those flung from the catapult.  Giggles of children playing hide and seek mingle with the cheers of catapult spectators as they watch a particularly rough landing.","Piles of hay lie scattered on the ground, providing a soft landing place for those flung from the catapult.  Giggles of young maidens playing hide and seek mingle with the cheers of catapult spectators as they watch a particularly rough landing."],"exits":[{"to":16,"exit":"north","move":"north"},{"to":18,"exit":"east","move":"east"},{"to":21,"exit":"south","move":"south"},{"to":20,"exit":"west","move":"west"}]},
  {"id":20,"x":80,"y":300,"z":0,"title":"Amusement Pier, Wilde Lane","descriptions":["Wave after gentle wave slowly laps against the pilings that support the weight of the busy pier.  Sturdy railings along the edges keep stray children from tumbling into the cold waters below.","Wave after gentle wave slowly laps against the pilings that support the weight of the busy pier.  Sturdy railings are visible in the torchlight, keeping those patrons who reel in the wake of the local ale from tumbling into the cold waters below."],"exits":[{"to":17,"exit":"north","move":"north"},{"to":19,"exit":"east","move":"east"},{"to":21,"exit":"southeast","move":"southeast"}]},
  {"id":21,"x":120,"y":340,"z":0,"title":"Bouncer's, Catapult","descriptions":["Dominating this area of the pier is a massive catapult, its poles decorated with yellow and blue streamers.  Children watch amazed as daring adventurers take their turn in the catapult's wicker basket.","Dominating this area of the pier is a massive catapult, its poles decorated with yellow and blue streamers.  The polished wooden frame reflects glints of light from the numerous paper lanterns used to light the area."],"exits":[{"to":19,"exit":"north","move":"north"},{"to":18,"exit":"northeast","move":"northeast"},{"to":22,"exit":"south","move":"south"},{"to":20,"exit":"northwest","move":"northwest"}]},
  {"id":22,"x":120,"y":360,"z":0,"title":"Amusement Pier, Centre Lane","descriptions":["A small inn sits at the end of this long pier, its wide doors painted with multi-colored flowers.  A porch made of dark blue and misty-green tile makes a semi-circle beneath the door.  A soft tinkling sound emits from the porch when visitors step on it, informing the owners that potential guests are near."],"exits":[{"to":21,"exit":"north","move":"north"},{"to":23,"exit":"east","move":"east"},{"to":24,"exit":"west","move":"west"},{"to":52,"exit":"go","move":"go wide doors"}]},
  {"id":23,"x":140,"y":360,"z":0,"title":"Fisherman's Corner, Este Lane","descriptions":["The music of the sea is heard in the soft lulling sound of the waves lapping against the base of the pier and in the echoing calls of seagulls to one another.  A lone bench rests near the railing with fishing equipment casually leaning against it.","The music of the sea is heard in the soft lulling sound of the waves lapping against the base of the pier and in the echoing calls of seagulls to one another.  Flickering lanterns cast a dim pool of radiance over a lone bench resting near the railing, glittering on the metal bits of the fishing pole leaning against it."],"exits":[{"to":22,"exit":"west","move":"west"}]},
  {"id":24,"x":100,"y":360,"z":0,"title":"Fisherman's Corner, Wilde Lane","descriptions":["Cantankerous old Humans come here, vying with one another for the best fishing spot.  Occasionally cheers are raised as one particularly large fish is reeled in.  The view off the pier is spectacular as ships sail by, friendly sailors waving from their decks.","Soft, flickering flames dance from torches placed along the end of the pier, providing romantic lighting to nighttime strollers.  A slight breeze causes some to snuggle close to one another, while a scattering of Bards can be heard playing various instruments."],"exits":[{"to":22,"exit":"east","move":"east"}],"aliases":["Fishing"]},
  {"id":25,"x":170,"y":100,"z":0,"title":"Nightingale's Rest Theater, Seating","descriptions":["Carved benches are strategically placed to face the theater, each with a perfect view of the entertainers that often perform.  The stage is decorated in bright colors with lit sconces laid along the base for nighttime viewing."],"exits":[{"to":6,"exit":"out","move":"out"}]},
  {"id":26,"x":140,"y":180,"z":0,"title":"Prize Stall","descriptions":["Rough wooden beams hold up this small prize stall.  Painted brown bears dance upon colorful balls along the walls, interspersed with prancing horses.  Each shelf is draped in decorative lace that holds assorted prizes, just out of the reach of small children.  A colorful sign has been nailed upon one wall, giving information about the different prizes."],"exits":[{"to":13,"exit":"out","move":"out"}],"aliases":["Prize Stall"]},
  {"id":27,"x":200,"y":200,"z":0,"title":"Prickle Tattoo Shop","descriptions":["Pale oak walls are covered with various examples of the designs in skin art, ranging from the simple to extreme in detail.  The smell of fresh ink permeates the room, wafting from the shelves that line the far wall.  A couch lies in one corner, covered in dark tapestries with a footstool placed nearby, while some tables are evenly spaced about the shop."],"exits":[{"to":14,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Prickle Tattoo Shop","Tattoo Shop"]},
  {"id":28,"x":30,"y":160,"z":0,"title":"A Carousel","descriptions":["The gaily decorated carousel is painted with scenes of leaping fish, soaring birds, and fierce beasts.  Several carved and painted wooden animals are suspended by poles, beckoning a ride."],"exits":[{"to":29,"exit":"east","move":"east"},{"to":31,"exit":"south","move":"south"},{"to":13,"exit":"out","move":"out"}]},
  {"id":29,"x":40,"y":160,"z":0,"title":"A Carousel","descriptions":["The gaily decorated carousel is painted with scenes of leaping fish, soaring birds, and fierce beasts.  Several carved and painted wooden animals are suspended by poles, beckoning a ride."],"exits":[{"to":30,"exit":"south","move":"south"},{"to":28,"exit":"west","move":"west"},{"to":13,"exit":"out","move":"out"}]},
  {"id":30,"x":40,"y":170,"z":0,"title":"A Carousel","descriptions":["The gaily decorated carousel is painted with scenes of leaping fish, soaring birds, and fierce beasts.  Several carved and painted wooden animals are suspended by poles, beckoning a ride."],"exits":[{"to":29,"exit":"north","move":"north"},{"to":31,"exit":"west","move":"west"},{"to":13,"exit":"out","move":"out"},{"to":13,"exit":"none","move":"none"}]},
  {"id":31,"x":30,"y":170,"z":0,"title":"A Carousel","descriptions":["The gaily decorated carousel is painted with scenes of leaping fish, soaring birds, and fierce beasts.  Several carved and painted wooden animals are suspended by poles, beckoning a ride."],"exits":[{"to":28,"exit":"north","move":"north"},{"to":30,"exit":"east","move":"east"},{"to":13,"exit":"out","move":"out"}]},
  {"id":32,"x":100,"y":140,"z":0,"title":"Mighty Warriors, Strength Test Game","descriptions":["Off to one side, a metal pole towers high above the crowds.  A sturdy wooden lever squats on the ground at its base, while a bronze bell tops the tall structure.  A roustabout leans on a heavy sledgehammer, hawking his game to passers-by."],"exits":[{"to":10,"exit":"out","move":"out"}]},
  {"id":33,"x":40,"y":200,"z":0,"title":"Nifty Gifts, Front Room","descriptions":["Like many other shops in the province, an array of wares is displayed for shoppers on shelves and racks.  A pot of tea is brewing in the corner, where the owner also keeps a crossbow loaded, prepped and ready for any would-be thieves.  Scents of homemade candy emanate from the beaded curtain that leads into the back room."],"exits":[{"to":12,"exit":"out","move":"out"},{"to":34,"exit":"go","move":"go beaded curtain"}],"color":"#FF0000","aliases":["Nifty Gifts"]},
  {"id":34,"x":30,"y":200,"z":0,"title":"Nifty Gifts, Back Room","descriptions":["A cloth-covered counter bears today's offerings to soothe a customer's sweet tooth.  Behind the counter a young Halfling works to keep up with the demand for sugar-coated jellies and frosting-covered cookies.  A small sign crookedly hung above the door reads, Tasty treats by the handful, enjoy!"],"exits":[{"to":33,"exit":"go","move":"go beaded curtain"}],"color":"#FF0000","aliases":["Back Room"]},
  {"id":35,"x":120,"y":240,"z":0,"title":"Simply Souvenirs, Lobby","descriptions":["The lobby is wide open and welcoming without any clutter, with carpeted runners leading off to the different parts of the store.  Prisms of all shapes and sizes hang from the ceiling, catching the light filtering in from the hexagonal window, causing tiny rainbows to dance across the walls."],"exits":[{"to":36,"exit":"northeast","move":"northeast"},{"to":38,"exit":"northwest","move":"northwest"},{"to":16,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Simply Souvenirs","Souvenirs"]},
  {"id":36,"x":130,"y":230,"z":0,"title":"Simply Souvenirs, Amazing Accessories","descriptions":["Knick-knacks and trinkets are placed all over the room, giving it a closed-in, cluttered feel.  A wide rack hangs on one wall, elegantly displaying a number of finely crafted fans that are for sale.  Next to the rack stands a tall fanciful tree made from glass, holding various accessories."],"exits":[{"to":35,"exit":"southwest","move":"southwest"},{"to":37,"exit":"northwest","move":"northwest"}],"color":"#FF0000","aliases":["Amazing Accessories"]},
  {"id":37,"x":120,"y":220,"z":0,"title":"Simply Souvenirs, Random Rarities","descriptions":["Far from the sounds of the busy pier, this room is cozy and comfortably furnished.  A playfully carved archway, depicting cartwheeling clowns is set in the south wall, with a thick felt curtain covering its contents.  Along the opposite wall stands a line of chairs, mismatched but all focused on the same point, a tall cushioned pedestal in the center of the room."],"exits":[{"to":36,"exit":"southeast","move":"southeast"},{"to":38,"exit":"southwest","move":"southwest"}],"color":"#FF0000","aliases":["Random Rarities"]},
  {"id":38,"x":110,"y":230,"z":0,"title":"Simply Souvenirs, Plush Presents","descriptions":["A huge comical plush tree stands in the middle of the room, with a big goofy face painted on its front.  Its branches completely cover the ceiling, with long strips of green cloth hanging down like weeping leaves.  A round wooden counter painted to resemble a short stone wall encircles the soft tree."],"exits":[{"to":37,"exit":"northeast","move":"northeast"},{"to":35,"exit":"southeast","move":"southeast"}],"color":"#FF0000","aliases":["Plush Presents"]},
  {"id":39,"x":200,"y":300,"z":0,"title":"Shop of Horrors, Outer Chamber","descriptions":["Rotted boards forming the walls are roughly thrown together, leaving splits large enough to reach into in some places.  Shadows obscure a shelf along the back wall, while on the side wall something heavy dangles from a hook.  A smoky lantern hangs from a pole in the center of the room, the only source of illumination."],"exits":[{"to":40,"exit":"go","move":"go crooked arch"},{"to":18,"exit":"go","move":"go creaky door"}],"color":"#FF0000","aliases":["Shop of Horrors"]},
  {"id":40,"x":210,"y":300,"z":0,"title":"Shop of Horrors, Inner Sanctum","descriptions":["A thick cobweb covers the one small window, tiny trapped bodies in neatly wrapped packages here and there in its strands.  A shadowed figure lurks in the corner, larger than the rest, its eyes reflecting in the lantern-light.  An assortment of dark silhouettes rests on a rickety shelf, a crumbling display case squatting under it.  Remnants of carpeting lump under a lopsided table in one corner, the goods on it tilting sideways as if trying to hang onto the surface."],"exits":[{"to":41,"exit":"climb","move":"climb wooden ladder"},{"to":39,"exit":"go","move":"go crooked arch"}],"color":"#FF0000","aliases":["Inner Sanctum"]},
  {"id":41,"x":220,"y":300,"z":0,"title":"Shop of Horrors, Drowned Cellar","descriptions":["The sound of lapping water reverberates against the distorted walls that seem to melt into the water around your legs, but on second glance it's only the noxious slime dripping down its surface and into the fetid liquid.  Mold covers everything else, including the hole-riddled ladder missing several rungs in one corner."],"exits":[{"to":40,"exit":"climb","move":"climb wooden ladder"}],"color":"#FF0000","aliases":["Drowned Cellar"]},
  {"id":42,"x":40,"y":100,"z":0,"title":"Gnoshy and Sons, Orchard's Bounty Ordering Room","descriptions":["A long wide counter dominates the small, but functional, lobby of Gnoshy's hastily constructed retail outpost.  A small, hand-lettered sign has been tacked to the back wall, next to a more elaborate menu.  Through large chinks and gaps in the wall, smells of cinnamon, honey, and chocolate drift pleasingly."],"exits":[{"to":43,"exit":"west","move":"west"},{"to":8,"exit":"go","move":"go swinging doors"}],"color":"#FF0000","aliases":["Gnoshy and Sons"]},
  {"id":43,"x":30,"y":100,"z":0,"title":"Gnoshy and Sons, Orchard's Bounty Store","descriptions":["Empty bins, buckets, barrels, and crates lie in organized piles in the corners of the room, out of the way of the patrons and the occasional workers, who scurry to and fro amidst the browsing clientele.  Two long, low tables are situated near the back wall of this well-lit room.  A strong, cidery smell tinged with sweet and sugary undertones pervades the air."],"exits":[{"to":42,"exit":"east","move":"east"}]},
  {"id":44,"x":210,"y":160,"z":0,"title":"Zackes' Place, Bar","descriptions":["Many a seaman calls this rough and tumble place home.  Its tall stools and carved oak bar are perfect for carousing the night away with friends.  On either side of the bar are different areas for letting off steam."],"exits":[{"to":46,"exit":"east","move":"east"},{"to":45,"exit":"west","move":"west"},{"to":9,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Zackes' Place"]},
  {"id":45,"x":200,"y":160,"z":0,"title":"Zackes' Place, The Pit","descriptions":["The pit, as it is fondly called by the finest of warriors, is where the bravest grapple amongst taunts and cheers.  Water is often thrown over the encircling benches, clearing off excess mud.  Those daring enough to watch are often pulled in, to the amusement of all concerned."],"exits":[{"to":44,"exit":"east","move":"east"}]},
  {"id":46,"x":220,"y":160,"z":0,"title":"Zackes' Place, Baths","descriptions":["Warmth emanates from steaming hot tubs, giving off scents of musk and pine.  Small candles flicker against the dark wood walls from sconces placed in the corners.  Here is a quiet place that offers relaxation for those weary from the day's journey."],"exits":[{"to":44,"exit":"west","move":"west"},{"to":50,"exit":"go","move":"go porcelain tub"},{"to":51,"exit":"go","move":"go wooden tub"}]},
  {"id":47,"x":80,"y":40,"z":0,"title":"The Dragon's Horde, Front Room","descriptions":["Intricately designed woven rugs line the floor of this spacious area.  Scents of jasmine and rose float through the air from candles lit on tall candelabras.  Highly polished counters and gilt inlaid racks hold various items for purchase with attentive clerks ready to assist those in need."],"exits":[{"to":49,"exit":"northeast","move":"northeast"},{"to":48,"exit":"northwest","move":"northwest"},{"to":5,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Front Room"]},
  {"id":48,"x":70,"y":30,"z":0,"title":"The Dragon's Horde, Hunter's Room","descriptions":["Polished armor gleams on tables of yew and oak, with edged weapons and bows carefully displayed on heavy pine racks.  The smell of new leather and fragrant candles mix with the scents of the pungent shoppers that often come to glance at the merchandise."],"exits":[{"to":47,"exit":"southeast","move":"southeast"}],"color":"#FF0000","aliases":["Hunter's Room"]},
  {"id":49,"x":90,"y":30,"z":0,"title":"The Dragon's Horde, Furniture Palace","descriptions":["Wooly rugs and ornate tapestries accent pieces of fine furniture that are orderly placed throughout the room.  Some clerks, wearing bright colorful smocks, assist shoppers with purchases while others wield cleaning rags and battle the dust that finds its way in."],"exits":[{"to":47,"exit":"southwest","move":"southwest"}],"aliases":["Furniture Palace"]},
  {"id":50,"x":220,"y":140,"z":0,"title":"Bath, Hot Porcelain Tub","descriptions":["Hot water caresses the senses and brings relief to aches and pains.  Inhaling the soapy scents can cause you to drift into a nap, while the extremely hot water can give even the hardiest Dwarf a nice pink tinge."],"exits":[{"to":46,"exit":"out","move":"out"}]},
  {"id":51,"x":220,"y":180,"z":0,"title":"Bath, Hot Wooden Tub","descriptions":["Hot water caresses the senses and brings relief to aches and pains.  Inhaling the soapy scents can cause you to drift into a nap, while the extremely hot water can give even the hardiest Dwarf a nice pink tinge."],"exits":[{"to":46,"exit":"out","move":"out"}]},
  {"id":52,"x":120,"y":385,"z":0,"title":"Rosealea's Inn, Front Room","descriptions":["All who enter this small establishment are greeted by the smiling face of Rosealea or one of her many daughters.  Off to one side a spiral staircase leads to the rooms upstairs, while beyond a brightly polished wood arch is seen the main dining room.  Several seascapes line the walls, and its huge front window is outlined with rows of various seashells."],"exits":[{"to":22,"exit":"out","move":"out"},{"to":53,"exit":"climb","move":"climb staircase"},{"to":54,"exit":"go","move":"go wood arch"}]},
  {"id":53,"x":120,"y":420,"z":0,"title":"Rosealea's Inn, Hallway","descriptions":["Whitewashed walls are covered with paintings of children and small sea mementos.  A corner shelf holds odd fragments of crystallized rocks, seemingly out of place in this otherwise sea-oriented room."],"exits":[{"to":52,"exit":"down","move":"down"},{"to":55,"exit":"go","move":"go white door"},{"to":56,"exit":"go","move":"go oak door"},{"to":57,"exit":"go","move":"go cherrywood door"}]},
  {"id":54,"x":100,"y":405,"z":0,"title":"Rosealea's Inn, Main Room","descriptions":["This room buzzes with activity, from harried servers bringing out steaming dishes to customers talking animatedly among themselves.  Red-checkered tablecloths atop wide oak tables have vases placed on them full of fragrant flowers.  Though crowded, the room fits everyone comfortably and offers a magnificent view of the river."],"exits":[{"to":52,"exit":"out","move":"out"},{"to":58,"exit":"go","move":"go arched doorway"}],"color":"#FF0000"},
  {"id":55,"x":140,"y":420,"z":0,"title":"Rosealea's Inn, Family Room","descriptions":["Neat and tidy, this room is made to accommodate those with children.  The huge bed in the middle of the room is covered with many colorful pillows and knitted blankets.  A sofa along one wall is big enough sleep a couple of children, and makes a nice setting for lace pillows and a cross-eyed teddy bear."],"exits":[{"to":53,"exit":"go","move":"go white door"}]},
  {"id":56,"x":120,"y":440,"z":0,"title":"Rosealea's Inn, Bard's Rest","descriptions":["Midnight silk covers the full-sized bed in this room while the fragrance of roses drifts from a vase full of the colorful blooms.  In the corner stands a gilded stool with a thickly cushioned seat.  A stand has been placed before the stool, offering a place to practice for any visiting bards."],"exits":[{"to":53,"exit":"go","move":"go oak door"}]},
  {"id":57,"x":100,"y":420,"z":0,"title":"Rosealea's Inn, Honeymoon Suite","descriptions":["A four-poster cherrywood bed towers over the other furnishings, framed by dark plum silk draperies.  The scent of jasmine creates a romantic ambiance for the newly bonded.  From its elegant settee to the champagne chilling on the bedside table, no expense has been spared to offer the visiting couple their perfect holiday.  Lace draperies flutter in the window that looks out over the water, while a fragrant fire crackles in the fireplace."],"exits":[{"to":53,"exit":"go","move":"go cherrywood door"}]},
  {"id":58,"x":80,"y":405,"z":0,"title":"Rosealea's Inn, Dance Hall","descriptions":["Dark crystal sconces hold candles whose soft light seems to flicker in time with music being played by local bards congregating in the corner.  Several low couches surround the dark wood dance floor, offering a place to chat and relax."],"exits":[{"to":54,"exit":"out","move":"out"},{"to":59,"exit":"go","move":"go gilded alcove"}]},
  {"id":59,"x":60,"y":405,"z":0,"title":"Rosealea's Inn, Rendezvous Room","descriptions":["Aptly named the Rendezvous Room, a smiling Human man stands behind a dark mahogany bar, ready to take orders for drinks or to offer advice to any would-be listener.  The windows, which are normally thrown wide open, are drawn closed and covered in dark plum silk."],"exits":[{"to":58,"exit":"out","move":"out"}],"color":"#FF0000"}
 ],
